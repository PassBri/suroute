  },
  "cu_plan_libre": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ستتحرر في %1$@ (%2$ld شهرًا) وتدفع نحو %3$@ فوائد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du bist im %1$@ frei (%2$ld Monate) und zahlst rund %3$@ Zinsen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You’ll be free by %1$@ (%2$ld months) and pay about %3$@ in interest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Quedas libre en %1$@ (%2$ld meses) y pagas cerca de %3$@ en intereses."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu seras libre en %1$@ (%2$ld mois) et paieras environ %3$@ d’intérêts."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप %1$@ तक मुक्त होंगे (%2$ld महीने) और लगभग %3$@ ब्याज देंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sarai libero a %1$@ (%2$ld mesi) e pagherai circa %3$@ di interessi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ に完済（%2$ld か月）、利息は約 %3$@ です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@에 상환 완료(%2$ld개월), 이자는 약 %3$@예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você fica livre em %1$@ (%2$ld meses) e paga cerca de %3$@ em juros."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Свободен в %1$@ (%2$ld мес.), проценты около %3$@."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你将在 %1$@ 还清（%2$ld 个月），利息约 %3$@。"
     }
    }
   }
  },
