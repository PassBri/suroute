  "onb_compromiso_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنا %1$@، ألتزم اليوم ببدء الصعود نحو قمّتي الشخصية. وألتزم بـ:"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich, %1$@, verpflichte mich heute, den Aufstieg zu meinem persönlichen Gipfel anzutreten. Ich verpflichte mich:"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I, %1$@, commit today to begin the ascent toward my Personal Summit. I commit to:"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Yo, %1$@, me comprometo hoy a emprender el ascenso hacia mi Cumbre Personal. Me comprometo a:"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Moi, %1$@, je m'engage aujourd'hui à entreprendre l'ascension vers mon Sommet Personnel. Je m'engage à :"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं, %1$@, आज अपनी निजी चोटी की ओर चढ़ाई शुरू करने का संकल्प लेता हूँ। मैं वादा करता हूँ कि मैं:"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Io, %1$@, mi impegno oggi a intraprendere la salita verso la mia Vetta Personale. Mi impegno a:"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "私、%1$@は、今日からパーソナル・サミットへの登頂に踏み出すことを誓います。次のことを約束します:"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나 %1$@은(는) 오늘 나의 개인 정상을 향한 등반을 시작하겠다고 다짐합니다. 다음을 약속해요:"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Eu, %1$@, me comprometo hoje a iniciar a subida rumo ao meu Cume Pessoal. Me comprometo a:"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я, %1$@, обязуюсь сегодня начать восхождение к своей Личной Вершине. Я обязуюсь:"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我，%1$@，今天承诺踏上通往我个人山巅的攀登之路。我承诺："
     }
    }
   }
  },
  "onb_cumbre_frase": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
