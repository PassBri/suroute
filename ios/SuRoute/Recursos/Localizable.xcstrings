  "ios_idioma_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يستخدم SuRoute لغة iPhone. لتغييرها في SuRoute فقط، اضغط هنا واختر «اللغة» في الإعدادات."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute verwendet die Sprache deines iPhone. Um sie nur für SuRoute zu ändern, tippe hier und wähle „Sprache“ in den Einstellungen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute uses your iPhone's language. To change it just for SuRoute, tap here and choose “Language” in iPhone Settings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute usa el idioma de tu iPhone. Para cambiarlo solo en SuRoute, toca aquí y elige «Idioma» en los ajustes del iPhone."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute utilise la langue de votre iPhone. Pour la changer uniquement dans SuRoute, touchez ici et choisissez « Langue » dans les Réglages."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute आपके iPhone की भाषा इस्तेमाल करता है। केवल SuRoute के लिए बदलने हेतु यहाँ टैप करें और सेटिंग्स में “भाषा” चुनें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute usa la lingua del tuo iPhone. Per cambiarla solo in SuRoute, tocca qui e scegli «Lingua» nelle Impostazioni."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute は iPhone の言語を使います。SuRoute だけ変えるには、ここをタップして設定の「言語」を選んでください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute는 iPhone의 언어를 사용합니다. SuRoute만 바꾸려면 여기를 눌러 설정에서 ‘언어’를 선택하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O SuRoute usa o idioma do seu iPhone. Para mudá-lo só no SuRoute, toque aqui e escolha «Idioma» nos Ajustes do iPhone."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute использует язык iPhone. Чтобы изменить его только для SuRoute, нажмите здесь и выберите «Язык» в Настройках."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute 使用 iPhone 的语言。若只想更改 SuRoute 的语言，请轻点此处，在 iPhone 设置中选择“语言”。"
     }
    }
   }
  },
