  "cu_cif_copiado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم نسخ الرمز: الصقه في مكان آمن ثم احذفه من الحافظة"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Code kopiert: Füge ihn an einem sicheren Ort ein und lösche ihn dann aus der Zwischenablage"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Code copied: paste it somewhere safe, then delete it from the clipboard"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Código copiado: pégalo en un lugar seguro y luego bórralo del portapapeles"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Code copié : colle-le dans un lieu sûr, puis efface-le du presse-papiers"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कोड कॉपी हो गया: इसे किसी सुरक्षित जगह पेस्ट करें, फिर क्लिपबोर्ड से मिटा दें"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Codice copiato: incollalo in un luogo sicuro e poi cancellalo dagli appunti"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "フレーズをコピーしました。安全な場所に貼り付けてから、クリップボードから削除してください"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "코드를 복사했어요. 안전한 곳에 붙여 넣은 뒤 클립보드에서 지우세요"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Código copiado: cole-o em um lugar seguro e depois apague-o da área de transferência"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Код скопирован: вставь его в надёжное место, а затем удали из буфера обмена"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
