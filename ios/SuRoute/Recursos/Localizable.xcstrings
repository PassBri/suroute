    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يراجع فريق SuRoute كل مدرب قبل ظهوره هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Coach wird vom SuRoute-Team geprüft, bevor er hier erscheint."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every coach is reviewed by the SuRoute team before appearing here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada coach es revisado por el equipo de SuRoute antes de aparecer aquí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque coach est vérifié par l’équipe SuRoute avant d’apparaître ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर कोच को यहाँ दिखने से पहले SuRoute टीम जाँचती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni coach viene verificato dal team SuRoute prima di apparire qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "すべてのコーチは掲載前に SuRoute チームが確認します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모든 코치는 이곳에 나오기 전에 SuRoute 팀이 검토해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada coach é revisado pela equipe do SuRoute antes de aparecer aqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждого коуча проверяет команда SuRoute, прежде чем он появится здесь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每位教练在出现在这里之前都经过 SuRoute 团队审核。"
     }
    }
   }
  },
  "coach_dir_2": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت تقرر مشاركة تقدمك، ويمكنك التوقف متى شئت."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du entscheidest, ob du deinen Fortschritt teilst, und kannst jederzeit aufhören."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You decide whether to share your progress, and you can stop anytime."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tú decides si compartes tu avance, y puedes dejar de hacerlo cuando quieras."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous décidez de partager votre progression, et vous pouvez arrêter quand vous voulez."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "प्रगति साझा करनी है या नहीं, आप तय करते हैं और कभी भी रोक सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Decidi tu se condividere i tuoi progressi e puoi smettere quando vuoi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "進捗を共有するかはあなたが決め、いつでもやめられます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "진행 상황 공유는 당신이 정하고, 언제든 멈출 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você decide se compartilha seu avanço e pode parar quando quiser."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы решаете, делиться ли прогрессом, и можете перестать в любой момент."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "是否分享进度由你决定，随时可以停止。"
     }
    }
   }
  },
  "coach_dir_3": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يمكنك إنهاء المرافقة في أي وقت."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du kannst die Begleitung jederzeit beenden."
     }
    },
    "en": {
