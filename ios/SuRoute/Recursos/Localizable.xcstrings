  "cv_g6_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "احفظ المنشور للعودة إليه. ويمكنك أيضًا حفظ رسالة مختومة وقراءتها يوم فتحها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Speichere den Beitrag, um später darauf zurückzukommen. Du kannst auch einen versiegelten Brief aufbewahren und ihn an dem Tag lesen, an dem er sich öffnet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Save the post to come back to it. You can also save a sealed letter and read it the day it opens."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarda la publicación para volver a ella. También sirve para guardar una carta sellada y leerla el día que se abra."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Enregistre la publication pour y revenir. Ça sert aussi à garder une lettre scellée et à la lire le jour où elle s'ouvre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पोस्ट को बाद में देखने के लिए सहेजें। आप सील किया गया पत्र भी सहेज सकते हैं और खुलने के दिन पढ़ सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salva il post per tornarci sopra. Serve anche a conservare una lettera sigillata e leggerla il giorno in cui si apre."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿を保存して、あとで見返せます。封をした手紙を保存して、開封日に読むこともできます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "게시물을 저장해 두고 다시 볼 수 있어요. 봉인된 편지를 저장해 두었다가 열리는 날 읽을 수도 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarde a publicação para voltar a ela. Também serve para guardar uma carta selada e lê-la no dia em que abrir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сохрани публикацию, чтобы вернуться к ней. Так же можно сохранить запечатанное письмо и прочитать его в день, когда оно откроется."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "保存动态，方便以后再看。也可以用来保存封存的信，等开启那天再读。"
     }
    }
   }
  },
