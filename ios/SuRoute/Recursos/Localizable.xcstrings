  "paso_habitos_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "18 عادة صغيرة، 3 لكل محور. واحدة يوميًا تبدأ سلسلتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "18 kleine Gewohnheiten, 3 pro Achse. Eine pro Tag startet deine Serie."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "18 small habits, 3 per axis. One a day starts your streak."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "18 hábitos pequeños, 3 por eje. Con uno al día ya empieza tu racha."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "18 petites habitudes, 3 par axe. Une par jour suffit pour lancer ta série."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "18 छोटी आदतें, हर आयाम की 3। रोज़ एक से आपकी लय शुरू हो जाती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "18 piccole abitudini, 3 per asse. Una al giorno avvia la tua serie."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "小さな習慣が18個、各軸に3つ。1日1つで連続記録が始まります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "작은 습관 18개, 축마다 3개. 하루 하나면 연속 기록이 시작돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "18 hábitos pequenos, 3 por eixo. Com um por dia sua sequência já começa."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "18 маленьких привычек, по 3 на ось. Одна в день — и серия началась."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "18 个小习惯，每个维度 3 个。每天做一个就开始连续记录。"
     }
    }
   }
  },
  "paso_hoy_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اضغط على هدف إذا خطوت نحوه اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Tippe auf ein Ziel, wenn du heute einen Schritt gemacht hast."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tap a goal if you took a step on it today."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca una meta si hoy le diste un paso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touchez un objectif si vous avez avancé aujourd'hui."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अगर आज किसी लक्ष्य की ओर कदम बढ़ाया तो उसे टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca un obiettivo se oggi hai fatto un passo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日一歩進んだ目標をタップしましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 한 걸음 나아간 목표를 누르세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque numa meta se hoje você deu um passo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нажмите на цель, если сегодня сделали к ней шаг."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果今天为某个目标迈出了一步，就点一下它。"
     }
    }
   }
  },
