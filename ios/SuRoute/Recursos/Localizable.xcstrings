  "cv_g11_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "جبل ارتفاعه 8,848,000 مم نصعده معًا: تُحتسب المنشورات والأضواء وكل يوم مُعلَّم في فرق الحبال والتحديات."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Berg von 8.848.000 mm, den wir gemeinsam besteigen: Beiträge, Lichter und jeder abgehakte Tag in Seilschaften und Challenges zählen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "An 8,848,000 mm mountain we all climb together: posts, lights and every day checked in rope teams and challenges add up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una montaña de 8.848.000 mm que subimos entre todos: suman las publicaciones, las luces y cada día marcado en cordadas y retos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une montagne de 8 848 000 mm que nous gravissons ensemble : publications, lumières et chaque jour coché en cordées et défis s’additionnent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "8,848,000 मिमी का पहाड़ जिसे हम सब मिलकर चढ़ते हैं: पोस्ट, रोशनियाँ और रस्सी-टीमों व चुनौतियों में चिह्नित हर दिन जुड़ते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una montagna di 8.848.000 mm che scaliamo insieme: contano i post, le luci e ogni giorno segnato in cordate e sfide."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "みんなで登る 8,848,000 mm の山：投稿、光、ザイルパーティーやチャレンジでチェックした毎日が積み重なります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모두 함께 오르는 8,848,000 mm의 산: 게시물, 빛, 로프 팀과 챌린지에서 체크한 하루하루가 더해집니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma montanha de 8.848.000 mm que subimos juntos: somam as publicações, as luzes e cada dia marcado em cordadas e desafios."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Гора в 8 848 000 мм, на которую мы поднимаемся вместе: считаются публикации, огни и каждый отмеченный день в связках и челленджах."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "一座 8,848,000 毫米的山，我们一起攀登：帖子、光，以及在绳队和挑战中打卡的每一天都会累计。"
     }
    }
   }
  },
