  "cu_informe_pie": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أعدّه SuRoute من دفتر حساباتك. هذا التحليل دليل للقرار ولا يغني عن استشارة مختص مالي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erstellt von SuRoute aus deinem Kassenbuch. Diese Analyse ist eine Entscheidungshilfe und ersetzt keine Finanzberatung."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Generated by SuRoute from your account book. This analysis is a guide for deciding; it does not replace advice from a financial professional."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Generado por SuRoute con los datos de tu libro de cuentas. Este análisis es una guía para decidir; no reemplaza la asesoría de un profesional financiero."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Généré par SuRoute à partir de votre livre de comptes. Cette analyse aide à décider ; elle ne remplace pas l'avis d'un professionnel."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute ने आपकी खाता-बही से बनाया। यह निर्णय में मदद है; वित्तीय विशेषज्ञ की सलाह का विकल्प नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Generato da SuRoute con i dati del tuo libro dei conti. È una guida per decidere; non sostituisce un consulente finanziario."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute があなたの家計簿から作成しました。判断の参考であり、専門家の助言に代わるものではありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute가 가계부를 바탕으로 만들었습니다. 결정을 돕는 안내이며 전문가 상담을 대신하지 않습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Gerado pelo SuRoute com os dados do seu livro de contas. Esta análise é um guia para decidir; não substitui a orientação de um profissional financeiro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Создано SuRoute по вашей книге учёта. Анализ помогает принимать решения и не заменяет консультацию специалиста."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "由 SuRoute 根据你的账本生成。本分析仅供决策参考，不能替代专业理财建议。"
     }
    }
   }
  },
  "cu_informe_plan": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مع خطتك تتحرر من الديون في %1$@ وتدفع نحو %2$@ فوائد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mit deinem Plan bist du im %1$@ schuldenfrei und zahlst etwa %2$@ Zinsen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "With your plan you are debt-free in %1$@ and pay about %2$@ in interest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con tu plan quedas libre en %1$@ y pagas cerca de %2$@ en intereses."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Avec votre plan, vous êtes libre en %1$@ et payez environ %2$@ d'intérêts."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी योजना से आप %1$@ में कर्ज़-मुक्त होंगे और लगभग %2$@ ब्याज देंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con il tuo piano sei libero a %1$@ e paghi circa %2$@ di interessi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "計画どおりなら %1$@ に完済し、利息は約 %2$@ です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계획대로라면 %1$@에 빚에서 벗어나고 이자는 약 %2$@입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Com seu plano você fica livre em %1$@ e paga cerca de %2$@ em juros."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "По вашему плану вы избавитесь от долгов в %1$@ и заплатите около %2$@ процентов."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "按你的计划，你将在 %1$@ 还清债务，利息约 %2$@。"
     }
    }
   }
  },
