  "audio_sin_voz": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا يوجد صوت إسباني في هاتفك. ثبّته من الإعدادات › النظام › اللغات › تحويل النص إلى كلام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Telefon hat keine spanische Stimme. Installiere sie unter Einstellungen › System › Sprachen › Sprachausgabe."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your phone has no Spanish voice. Install it in Settings › System › Languages › Text-to-speech output."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu teléfono no tiene voz en español. Instálala en Ajustes › Sistema › Idiomas › Salida de texto a voz."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton téléphone n’a pas de voix en espagnol. Installe-la dans Paramètres › Système › Langues › Synthèse vocale."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके फ़ोन में स्पेनिश आवाज़ नहीं है। सेटिंग › सिस्टम › भाषाएँ › टेक्स्ट-टू-स्पीच में इंस्टॉल करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il telefono non ha una voce in spagnolo. Installala in Impostazioni › Sistema › Lingue › Sintesi vocale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "スペイン語の音声がありません。設定 › システム › 言語 › テキスト読み上げ でインストールしてください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "스페인어 음성이 없습니다. 설정 › 시스템 › 언어 › TTS 출력에서 설치하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu telefone não tem voz em espanhol. Instale em Configurações › Sistema › Idiomas › Saída de conversão de texto em voz."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В телефоне нет испанского голоса. Установи его: Настройки › Система › Языки › Синтез речи."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "手机没有西班牙语语音。请在 设置 › 系统 › 语言 › 文字转语音 中安装。"
     }
    }
   }
  },
