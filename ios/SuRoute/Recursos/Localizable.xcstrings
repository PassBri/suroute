  "bi_h_caja_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شهيق 4، احبس 4، زفير 4، احبس 4. دقيقة واحدة تخفض توتر الجسم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein 4, halten 4, aus 4, halten 4. Eine Minute senkt die Anspannung des Körpers."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale 4, hold 4, exhale 4, hold 4. One minute lowers your body's activation."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhala 4, sostén 4, exhala 4, sostén 4. Un minuto baja la activación del cuerpo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspire 4, retiens 4, expire 4, retiens 4. Une minute fait baisser l'activation du corps."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "4 तक साँस लें, 4 रोकें, 4 छोड़ें, 4 रोकें। एक मिनट में शरीर का तनाव घटता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira 4, trattieni 4, espira 4, trattieni 4. Un minuto abbassa l'attivazione del corpo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "4秒吸って、4秒止め、4秒吐いて、4秒止める。1分で体の緊張が下がります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "4초 들이쉬고, 4초 멈추고, 4초 내쉬고, 4초 멈춥니다. 1분이면 몸의 긴장이 내려갑니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspire 4, segure 4, expire 4, segure 4. Um minuto baixa a ativação do corpo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вдох 4, задержка 4, выдох 4, задержка 4. Одна минута снижает напряжение тела."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气 4 秒，屏住 4 秒，呼气 4 秒，屏住 4 秒。一分钟就能让身体平静下来。"
     }
    }
   }
  },
