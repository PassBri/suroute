  "prioridad_c_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عاجل لكن أثره الاستراتيجي منخفض. فوّضه أو أنجزه بسرعة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dringend, aber mit geringer strategischer Wirkung. Delegiere oder erledige es schnell."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgent, but low strategic impact. Delegate or handle quickly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgente, pero de bajo impacto estratégico. Delega o atiende rápido."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgent, mais de faible impact stratégique. Délègue ou traite vite."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "तुरंत, पर रणनीतिक असर कम। किसी को सौंपें या जल्दी निपटाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgente, ma di basso impatto strategico. Delega o sbrigala in fretta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "緊急だが、戦略的な影響は小さい。任せるか、さっと片付けましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "급하지만 전략적 영향은 작아요. 위임하거나 빠르게 처리하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgente, mas de baixo impacto estratégico. Delegue ou resolva rápido."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Срочно, но мало влияет на стратегию. Делегируй или быстро реши."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "紧急，但战略影响较小。委托他人或尽快处理。"
     }
    }
   }
  },
