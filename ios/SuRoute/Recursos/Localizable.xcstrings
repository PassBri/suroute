  "ng_nota_salud": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا تُحتسب في صحتك المالية الشخصية. أما ما تدفعه لنفسك فيُحتسب: يصل كدخل في أموالك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sie zählen nicht zu deiner persönlichen Finanzgesundheit. Was du dir auszahlst schon: es kommt als Einkommen in deine Finanzen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "These don't count in your personal Financial health. What you pay yourself does: it arrives as income in your finances."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No cuentan en tu Salud financiera personal. Lo que te pagas sí: llega como ingreso de tus finanzas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ils ne comptent pas dans votre Santé financière personnelle. Ce que vous vous versez, si : il arrive comme revenu dans vos finances."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ये आपकी निजी वित्तीय सेहत में नहीं गिने जाते। जो आप खुद को देते हैं वह गिना जाता है: आपके वित्त में आय के रूप में आता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non contano nella tua Salute finanziaria personale. Quanto ti paghi sì: arriva come entrata nelle tue finanze."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "個人の財務の健康には含まれません。自分への支払いは含まれ、家計の収入として入ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "개인 재무 건강에는 포함되지 않아요. 나에게 지급한 돈은 포함되어 재무의 수입으로 들어가요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não contam na sua Saúde financeira pessoal. O que você se paga conta: chega como receita nas suas finanças."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не учитываются в вашем личном финансовом здоровье. Выплаты себе учитываются: приходят как доход в ваши финансы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这些不计入你个人的财务健康。给自己的钱会计入：作为收入进入你的财务。"
     }
    }
   }
  },
