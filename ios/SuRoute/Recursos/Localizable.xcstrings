  "ng_i_pe_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ما تحتاج إلى بيعه شهريًا كي لا تخسر: مصروفات التشغيل ÷ هامش الربح الإجمالي. تبيع اليوم %1$@ شهريًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was du pro Monat verkaufen musst, um nicht zu verlieren: Betriebskosten ÷ Bruttomarge. Heute verkaufst du %1$@ im Monat."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What you need to sell each month not to lose money: operating expenses ÷ gross margin. Today you sell %1$@ a month."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que necesitas vender al mes para no perder: gastos de operación ÷ margen bruto. Hoy vendes %1$@ al mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce que vous devez vendre par mois pour ne pas perdre : charges d'exploitation ÷ marge brute. Aujourd'hui vous vendez %1$@ par mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "घाटे से बचने के लिए हर महीने कितना बेचना है: परिचालन खर्च ÷ सकल मार्जिन। अभी आप हर महीने %1$@ बेचते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quanto devi vendere al mese per non perdere: spese operative ÷ margine lordo. Oggi vendi %1$@ al mese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "赤字にならないために毎月必要な売上：営業費用 ÷ 粗利率。いまの月の売上は %1$@。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "손해 보지 않으려면 매달 팔아야 하는 금액: 운영비 ÷ 매출총이익률. 지금은 매달 %1$@ 팔고 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quanto você precisa vender por mês para não perder: despesas operacionais ÷ margem bruta. Hoje você vende %1$@ por mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сколько нужно продавать в месяц, чтобы не терять: операционные расходы ÷ валовая маржа. Сейчас вы продаёте %1$@ в месяц."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每月至少要卖多少才不亏：运营费用 ÷ 毛利率。目前你每月卖 %1$@。"
     }
    }
   }
  },
