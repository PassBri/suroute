  "ios_crear_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمتك وبوصلتك وعاداتك على كل أجهزتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Gipfel, dein Kompass und deine Gewohnheiten – auf all deinen Geräten."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your summit, your compass and your habits, on all your devices."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cumbre, tu brújula y tus hábitos, en todos tus dispositivos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Votre sommet, votre boussole et vos habitudes, sur tous vos appareils."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका शिखर, आपका कम्पास और आपकी आदतें, आपके सभी डिवाइस पर।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vetta, la tua bussola e le tue abitudini, su tutti i tuoi dispositivi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの頂上、コンパス、習慣を、すべてのデバイスで。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나의 정상, 나침반, 습관을 모든 기기에서."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu cume, sua bússola e seus hábitos, em todos os seus dispositivos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ваша вершина, компас и привычки — на всех ваших устройствах."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的顶峰、指南针和习惯，在你所有的设备上。"
     }
    }
   }
  },
