  "fase_1_diag": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنا مرتبك بشأن اتجاهي. ليس لديّ وضوح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich bin unsicher, welche Richtung ich einschlagen soll. Mir fehlt die Klarheit."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I'm confused about my direction. I have no clarity."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estoy confundido sobre mi dirección. No tengo claridad."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je suis perdu quant à ma direction. Je n'ai aucune clarté."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं अपनी दिशा को लेकर उलझन में हूँ। मुझे स्पष्टता नहीं है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sono confuso sulla mia direzione. Non ho chiarezza."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "進む方向に迷っていて、はっきりしない。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내가 가는 방향이 헷갈려요. 명확하지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Estou confuso sobre minha direção. Não tenho clareza."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я не понимаю, куда двигаться. Нет ясности."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我对自己的方向感到迷茫，不够清晰。"
     }
    }
