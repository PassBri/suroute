  "cu_avalancha_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الانهيار: الأعلى فائدة أولًا. تدفع فوائد أقل إجمالًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lawine: zuerst die mit dem höchsten Zins. Du zahlst insgesamt weniger Zinsen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Avalanche: highest interest first. You pay less interest overall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Avalancha: primero la de interés más alto. Pagas menos intereses en total."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Avalanche : d’abord celle au taux le plus élevé. Tu paies moins d’intérêts au total."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "एवलांच: सबसे ज़्यादा ब्याज वाला पहले। कुल ब्याज कम लगता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Valanga: prima quello con l’interesse più alto. Paghi meno interessi in totale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "雪崩法：金利の高いものから。利息の合計が少なくなります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "눈사태: 금리가 가장 높은 것부터. 총이자가 줄어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Avalanche: primeiro a de juros mais altos. Você paga menos juros no total."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Лавина: сначала самый высокий процент. Платишь меньше процентов."
