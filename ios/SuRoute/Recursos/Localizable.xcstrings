  "bi_g_1_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قبل الرد على ما أزعجك، تنفس تنفسًا مربعًا وانتظر دقيقة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bevor du auf etwas antwortest, das dich gestört hat, mach eine Box-Atmung und warte eine Minute."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Before answering something that bothered you, do a box breath and wait a minute."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Antes de responder algo que te molestó, haz una respiración en caja y espera un minuto."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Avant de répondre à ce qui t'a dérangé, fais une respiration carrée et attends une minute."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किसी बात से परेशान होकर जवाब देने से पहले बॉक्स श्वास लें और एक मिनट रुकें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prima di rispondere a qualcosa che ti ha infastidito, fai una respirazione quadrata e aspetta un minuto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "嫌なことに返事をする前に、ボックス呼吸をして1分待ちましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "불편했던 일에 답하기 전에 박스 호흡을 하고 1분 기다리세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Antes de responder algo que incomodou, faça uma respiração quadrada e espere um minuto."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Прежде чем ответить на то, что задело, сделай квадратное дыхание и подожди минуту."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在回应让你不快的事之前，做一次方块呼吸，等一分钟。"
     }
    }
   }
  },
