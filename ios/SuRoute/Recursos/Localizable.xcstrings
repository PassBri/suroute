  "mf_nueva_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختر النوع والمبلغ. مع الموعد ستعرف كم تدخر شهريًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wähle die Art und den Betrag. Mit Datum weißt du die monatliche Rate."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pick the type and how much you want to save. With a date you'll know how much to contribute monthly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escoge el tipo y escribe cuánto quieres reunir. Con la fecha sabrás cuánto aportar al mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisissez le type et le montant. Avec une date, vous saurez combien verser par mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "प्रकार और राशि चुनें। तारीख से पता चलेगा हर महीने कितना जमा करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scegli il tipo e quanto. Con la data saprai quanto versare al mese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "種類と金額を選びます。期限があれば毎月の積立額がわかります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "유형과 금액을 고르세요. 기한이 있으면 매달 적립액을 알 수 있습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolha o tipo e quanto quer juntar. Com a data você saberá quanto aportar por mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выберите тип и сумму. Со сроком узнаете ежемесячный взнос."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "选择类型和金额。有了期限就知道每月存多少。"
     }
    }
   }
  },
