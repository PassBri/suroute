  "propositos_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتب حتى 10 أهداف طويلة المدى، بعدد السنوات الذي تختاره (%1$ld/10)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib bis zu 10 langfristige Ziele, so viele Jahre voraus, wie du willst (%1$ld/10)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write up to 10 long-term purposes, as many years ahead as you choose (%1$ld/10)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escribe hasta 10 propósitos a largo plazo, a los años que tú elijas (%1$ld/10)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écris jusqu’à 10 objectifs à long terme, à l’horizon que tu choisis (%1$ld/10)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "10 तक दीर्घकालिक उद्देश्य लिखें, जितने साल आप चुनें (%1$ld/10)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrivi fino a 10 propositi a lungo termine, con gli anni che scegli tu (%1$ld/10)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "長期的な目的を最大10個書きましょう。年数は自由に選べます（%1$ld/10）。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "장기 목표를 최대 10개까지 적어 보세요. 기간은 원하는 만큼 정할 수 있어요 (%1$ld/10)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escreva até 10 propósitos de longo prazo, com os anos que você escolher (%1$ld/10)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши до 10 долгосрочных целей на любое число лет (%1$ld/10)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "写下最多 10 个长期目标，年数由你决定（%1$ld/10）。"
     }
    }
   }
  },
  "propositos_vacio_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تخيّل حياتك المثالية بعد 5 أو 10 أو 20 سنة. ما الإنجازات التي ستجعلك فخورًا؟ اكتب هنا الأهداف التي ستغيّر حياتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Stell dir dein ideales Leben in 5, 10 oder 20 Jahren vor. Welche Erfolge würden dich stolz machen? Schreib hier die Ziele auf, die dein Leben verändern."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Imagine your ideal life in 5, 10 or 20 years. What achievements would make you proud? Write the goals that will transform your life."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Imagina tu vida ideal dentro de 5, 10 o 20 años. ¿Qué logros te harían sentir orgulloso? Escribe aquí las metas que transformarán tu vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Imagine ta vie idéale dans 5, 10 ou 20 ans. Quelles réussites te rendraient fier ? Écris ici les objectifs qui transformeront ta vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "5, 10 या 20 वर्षों बाद के अपने आदर्श जीवन की कल्पना करें। कौन-सी उपलब्धियाँ आपको गर्व देंगी? यहाँ वे लक्ष्य लिखें जो आपका जीवन बदल देंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Immagina la tua vita ideale tra 5, 10 o 20 anni. Quali traguardi ti renderebbero orgoglioso? Scrivi qui gli obiettivi che trasformeranno la tua vita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "5年後、10年後、20年後の理想の人生を想像しよう。どんな達成が誇りになる？人生を変える目標をここに書こう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "5년, 10년, 20년 후의 이상적인 삶을 상상해 보세요. 어떤 성취가 자랑스러울까요? 삶을 바꿀 목표를 여기에 적으세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Imagine sua vida ideal daqui a 5, 10 ou 20 anos. Que conquistas te deixariam orgulhoso? Escreva aqui as metas que vão transformar sua vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Представь свою идеальную жизнь через 5, 10 или 20 лет. Какие достижения сделают тебя гордым? Запиши цели, которые изменят твою жизнь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "想象 5、10 或 20 年后的理想生活。哪些成就会让你自豪？在这里写下将改变你人生的目标。"
     }
    }
   }
  },
