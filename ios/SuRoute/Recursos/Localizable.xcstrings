  "rec_privadas": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صورك الخاصة (%1$ld) لن تُنشر: تُنشر فقط الصور التي شاركتها."
