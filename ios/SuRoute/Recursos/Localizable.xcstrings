  "modelo_c8_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في نهاية العام تكتب 7 دروس، وتحفظها في مذكرات حياتك، وتبدأ جبلًا جديدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Am Jahresende schreibst du 7 Lektionen, speicherst sie in deinem Lebenstagebuch und beginnst einen neuen Berg."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "At the end of the year you write 7 lessons, save them in your life journal and start a new mountain."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al terminar el año escribes 7 lecciones, las guardas en tu diario de vida y empiezas una nueva montaña."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "À la fin de l'année tu écris 7 leçons, tu les gardes dans ton journal de vie et tu commences une nouvelle montagne."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "साल के अंत में आप 7 सबक लिखते हैं, उन्हें अपनी जीवन डायरी में रखते हैं और एक नया पर्वत शुरू करते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alla fine dell'anno scrivi 7 lezioni, le salvi nel tuo diario di vita e inizi una nuova montagna."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "年末に7つの教訓を書き、人生日記に保存して、新しい山を始めます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "한 해가 끝나면 7가지 교훈을 쓰고 인생 일기에 저장한 뒤 새로운 산을 시작합니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ao terminar o ano você escreve 7 lições, guarda no seu diário de vida e começa uma nova montanha."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В конце года ты пишешь 7 уроков, сохраняешь их в дневнике жизни и начинаешь новую гору."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "年底写下 7 条收获，存入你的人生日记，然后开始一座新的山。"
     }
    }
   }
  },
