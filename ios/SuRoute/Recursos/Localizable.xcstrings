    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपने शिविरों में एक तस्वीर जोड़ें: आपकी चोटी कैसी दिखती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggiungi un'immagine ai tuoi campi: com'è la tua vetta."
