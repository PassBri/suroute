    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gefühle genau zu benennen ist der erste Schritt, mit ihnen umzugehen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Naming what you feel precisely is the first step to handling it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Nombrar con precisión lo que sientes es el primer paso para manejarlo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Nommer précisément ce que tu ressens est le premier pas pour le gérer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जो महसूस हो रहा है उसे सटीक नाम देना उसे सँभालने का पहला कदम है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nominare con precisione ciò che senti è il primo passo per gestirlo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "感じていることを正確に言葉にするのが、うまく付き合う第一歩です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "느낌을 정확히 이름 붙이는 것이 다루는 첫걸음입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nomear com precisão o que sente é o primeiro passo para lidar com isso."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Точно назвать чувство — первый шаг, чтобы с ним справиться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "准确说出你的感受，是管理它的第一步。"
     }
    }
   }
  },
