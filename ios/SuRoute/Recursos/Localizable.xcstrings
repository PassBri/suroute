  "modo_demo_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنشئ حسابك لتشارك إنجازاتك وتصوّت وتلهم المتسلّقين الآخرين."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erstelle dein Konto, um deine Erfolge zu teilen, abzustimmen und andere Wanderer zu inspirieren."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Create your account to share your achievements, vote and inspire other hikers."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Crea tu cuenta para compartir tus logros, votar e inspirar a otros senderistas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Crée ton compte pour partager tes réussites, voter et inspirer d'autres randonneurs."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी उपलब्धियाँ साझा करने, वोट देने और दूसरे ट्रेकरों को प्रेरित करने के लिए अकाउंट बनाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crea il tuo account per condividere i tuoi traguardi, votare e ispirare altri escursionisti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アカウントを作成すると、成果を共有したり、投票したり、仲間のトレッカーを励ましたりできます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계정을 만들면 성과를 공유하고, 투표하고, 다른 트레커들에게 영감을 줄 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Crie sua conta para compartilhar suas conquistas, votar e inspirar outros trilheiros."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Создай аккаунт, чтобы делиться достижениями, голосовать и вдохновлять других путников."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "创建账号，分享你的成就、投票，并激励其他徒步者。"
     }
    }
   }
  },
