  "mf_vacio_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الهدف الواضح نصف الطريق. اختر هدفًا وحدد المبلغ والموعد: سأخبرك بكم تدخر شهريًا وهل أنت في الموعد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein klares Ziel ist der halbe Weg. Wähle eins, wie viel und bis wann: Ich sage dir, wie viel du monatlich einzahlst und ob du im Plan bist."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A clear goal is half the way. Pick one, say how much and by when: I'll tell you how much to contribute each month and whether you're on time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una meta clara es la mitad del camino. Escoge una, di cuánto y para cuándo: te diré cuánto aportar cada mes y si vas a tiempo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un objectif clair, c'est la moitié du chemin. Choisissez-en un, combien et pour quand : je vous dirai combien verser chaque mois et si vous êtes dans les temps."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "साफ़ लक्ष्य आधा रास्ता है। एक चुनें, कितना और कब तक बताएँ: मैं बताऊँगा हर महीने कितना जमा करें और आप समय पर हैं या नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un obiettivo chiaro è metà del cammino. Scegline uno, quanto e per quando: ti dirò quanto versare al mese e se sei in tempo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "明確な目標は道のりの半分。ひとつ選んで金額と期限を決めれば、毎月の積立額と順調かどうかをお知らせします。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "분명한 목표는 절반의 성공입니다. 하나를 골라 금액과 기한을 정하면 매달 얼마를 모아야 하는지, 제때인지 알려 드립니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma meta clara é metade do caminho. Escolha uma, diga quanto e para quando: eu digo quanto aportar por mês e se você está no prazo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ясная цель — половина пути. Выберите одну, сумму и срок: я скажу, сколько откладывать в месяц и успеваете ли вы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "明确的目标就是成功的一半。选一个，定金额和期限：我会告诉你每月存多少、是否按时。"
     }
    }
   }
  },
  "mf_vacio_t": {
