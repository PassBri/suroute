  "cu_impacto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أسرع بـ %1$@ وفوائد أقل بـ %2$@ من دفع الحد الأدنى فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ früher und %2$@ weniger Zinsen als nur mit ihrer Mindestrate."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ sooner and %2$@ less interest than paying only its minimum."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ antes y %2$@ menos en intereses que pagando solo su mínimo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ plus tôt et %2$@ d’intérêts en moins qu’en payant seulement son minimum."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सिर्फ़ न्यूनतम भुगतान से %1$@ पहले और %2$@ कम ब्याज।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ prima e %2$@ di interessi in meno rispetto al solo minimo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最低返済だけより %1$@ 早く、利息は %2$@ 少なくなります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최소 상환만 할 때보다 %1$@ 빨리, 이자는 %2$@ 적게."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ antes e %2$@ a menos em juros do que pagando só o mínimo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "На %1$@ раньше и на %2$@ меньше процентов, чем платя только минимум."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "比只还最低额提前 %1$@，少付利息 %2$@。"
     }
    }
   }
  },
  "cu_impacto_igual": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بدفع الحد الأدنى ينتهي في %1$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mit ihrer Mindestrate endet sie im %1$@."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Paying its minimum it ends in %1$@."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando su mínimo termina en %1$@."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "En payant son minimum elle se termine en %1$@."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "न्यूनतम भुगतान से यह %1$@ में खत्म होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando il minimo finisce a %1$@."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最低返済だと %1$@ に完済します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최소 상환으로는 %1$@에 끝나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando o mínimo ela termina em %1$@."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Платя минимум, закончишь в %1$@."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "只还最低额将在 %1$@ 还清。"
     }
    }
   }
  },
  "cu_impacto_nunca": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بالحد الأدنى فقط لن تنهيه أبدًا: بخطتك ستنهيه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nur mit der Mindestrate würdest du sie nie tilgen: mit deinem Plan schon."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "With only its minimum you would never finish it: with your plan you do."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con solo su mínimo nunca la terminarías: con tu plan sí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Avec seulement son minimum tu ne la finirais jamais : avec ton plan, si."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सिर्फ़ न्यूनतम से यह कभी खत्म नहीं होगा: आपकी योजना से होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con il solo minimo non la finiresti mai: con il tuo piano sì."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最低返済だけでは終わりません。あなたの計画なら完済できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최소 상환만으로는 끝나지 않아요: 내 계획이면 끝낼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando só o mínimo você nunca a quitaria: com seu plano, sim."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Платя только минимум, ты его никогда не погасишь: с твоим планом погасишь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "只还最低额永远还不完：按你的计划可以还清。"
     }
    }
   }
  },
