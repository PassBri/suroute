  "fin_dia_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل ما دخل وما خرج اليوم. يجمعه الشهر في حصيلته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Trag ein, was heute rein- und rausging. Der Monat summiert es in seiner Bilanz."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Log what came in and went out today. The month adds it up in its review."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anota lo que entró y salió hoy. El mes lo suma en su balance."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Note ce qui est entré et sorti aujourd’hui. Le mois l’additionne dans son bilan."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज क्या आया और गया, लिखें। महीना इसे अपनी समीक्षा में जोड़ता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Annota ciò che è entrato e uscito oggi. Il mese lo somma nel suo bilancio."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日の収入と支出を書きましょう。月の振り返りで合計されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 들어오고 나간 돈을 적으세요. 월간 결산에서 합산돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Anote o que entrou e saiu hoje. O mês soma no balanço."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши, что сегодня пришло и ушло. Месяц сложит это в своём итоге."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "记下今天的收入和支出，本月回顾里会自动汇总。"
     }
    }
   }
  },
