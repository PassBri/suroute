      "value": "ライフコーチになる"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "라이프 코치 되기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ser coach de vida"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Стать лайф-коучем"
     }
