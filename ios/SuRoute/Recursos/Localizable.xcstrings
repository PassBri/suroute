  "vida_anio_futuro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هذا العام لم يأتِ بعد. تخيّل كيف تريده وأضفه إلى رؤيتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieses Jahr ist noch nicht da. Stell dir vor, wie es sein soll, und füge es deiner Vision hinzu."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This year hasn’t arrived yet. Imagine how you want it to be and add it to your vision."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Este año todavía no llega. Imagina cómo quieres que sea y súmalo a tu visión."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Cette année n’est pas encore arrivée. Imagine-la et ajoute-la à ta vision."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह वर्ष अभी आया नहीं है। कल्पना कीजिए कि आप इसे कैसा चाहते हैं और इसे अपनी दृष्टि में जोड़िए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quest’anno non è ancora arrivato. Immagina come vuoi che sia e aggiungilo alla tua visione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この年はまだ来ていません。どんな年にしたいか思い描き、ビジョンに加えましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 오지 않은 해예요. 어떤 해가 되길 바라는지 그려 보고 비전에 추가하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Este ano ainda não chegou. Imagine como você quer que ele seja e adicione à sua visão."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Этот год ещё не наступил. Представь, каким он должен быть, и добавь его в свою визию."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这一年还没到来。想象你希望它的样子，把它加入你的愿景。"
     }
    }
   }
  },
