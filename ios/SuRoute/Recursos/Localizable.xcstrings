    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$@에는 %1$ld년의 어떤 목표를 할까요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quais metas de %1$ld trabalho em %2$@?"
