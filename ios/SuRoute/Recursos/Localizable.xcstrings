      "state": "translated",
      "value": "इस सप्ताह %2$ld में से %1$ld आदतें पूरी हुईं"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld abitudini su %2$ld rispettate questa settimana"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今週は%2$ld個中%1$ld個の習慣を達成"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 주 습관 %2$ld개 중 %1$ld개 달성"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld de %2$ld hábitos cumpridos esta semana"
     }
    },
    "ru": {
     "stringUnit": {
