  "cumbres_en_anio_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أهدافك بعيدة المدى التي تمر بهذا العام، وما تقدمه لها في %1$ld."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine langfristigen Vorhaben, die durch dieses Jahr gehen, und was du %1$ld dazu beiträgst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your long-term purposes that run through this year, and what you give them in %1$ld."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus propósitos de largo plazo que pasan por este año, y lo que les aportas en %1$ld."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
