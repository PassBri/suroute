  "vv_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمتك في المركز وما يسندها حولها. المس مخيمًا لترى أهدافه وتخطط لها حسب السنة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Gipfel in der Mitte und was ihn trägt. Tippe auf ein Lager, um seine Ziele nach Jahr zu sehen und zu planen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your summit in the center and what holds it up. Tap a camp to see and plan its goals by year."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cumbre al centro y lo que la sostiene. Toca un campamento para ver y planear sus metas por año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton sommet au centre et ce qui le soutient. Touche un camp pour voir et planifier ses objectifs par année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बीच में आपका शिखर और उसे थामने वाली चीज़ें। किसी कैंप को छूकर उसके लक्ष्य साल के हिसाब से देखें और योजना बनाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vetta al centro e ciò che la sostiene. Tocca un campo per vedere e pianificare i suoi obiettivi per anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "中央にあなたの頂上、その周りに支えるもの。キャンプをタップすると年ごとの目標を見て計画できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "가운데는 나의 정상, 주변은 그것을 받치는 것들. 캠프를 눌러 연도별 목표를 보고 계획하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu cume no centro e o que o sustenta. Toque um acampamento para ver e planejar suas metas por ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В центре — твоя вершина, вокруг — то, что её держит. Нажми на лагерь, чтобы увидеть и спланировать его цели по годам."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的顶峰在中心，周围是支撑它的一切。点一个营地，按年份查看并规划它的目标。"
     }
    }
   }
  },
  "vv_brujula": {
