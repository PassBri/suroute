  "decision_eliminar_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم يعد الهدف ذا صلة أو ممكنًا. حرّر الموارد لأولويات أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Ziel ist nicht mehr relevant oder machbar. Gib Ressourcen für andere Prioritäten frei."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The goal is no longer relevant or viable. Free up resources for other priorities."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La meta ya no es relevante o viable. Libera recursos para otras prioridades."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'objectif n'est plus pertinent ni réalisable. Libère des ressources pour d'autres priorités."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य अब प्रासंगिक या संभव नहीं रहा। संसाधन दूसरी प्राथमिकताओं के लिए मुक्त करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'obiettivo non è più rilevante o fattibile. Libera risorse per altre priorità."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この目標はもう意味がないか、実現が難しい状態です。他の優先事項にリソースを回しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표가 더 이상 의미 없거나 실현 불가능해요. 다른 우선순위에 자원을 돌리세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A meta já não é relevante nem viável. Libere recursos para outras prioridades."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цель больше не актуальна или нереальна. Освободи ресурсы для других приоритетов."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目标已不再相关或不可行。把资源释放给其他优先事项。"
     }
    }
   }
  },
