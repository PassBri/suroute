  "coach_vida_privacidad": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ترى فقط ما اختار هذا الشخص مشاركته معك، ويتوقف ذلك إن أوقفه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du siehst nur, was diese Person mit dir teilt – und nichts mehr, wenn sie es abschaltet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You only see what this person chose to share with you, and it stops if they turn it off."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Solo ves lo que esta persona decidió compartir contigo, y deja de verse si ella lo desactiva."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu ne vois que ce que cette personne a choisi de partager, et plus rien si elle le désactive."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप केवल वही देखते हैं जो इस व्यक्ति ने साझा करना चुना, और बंद करने पर दिखना बंद हो जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Vedi solo ciò che questa persona ha scelto di condividere, e nulla se lo disattiva."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "相手が共有を選んだ内容だけが見え、オフにすると見えなくなります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 사람이 공유하기로 한 것만 보이며, 끄면 더 이상 보이지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você só vê o que esta pessoa decidiu compartilhar, e deixa de ver se ela desativar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты видишь только то, чем человек решил поделиться, и перестаёшь видеть, если он это отключит."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你只能看到对方选择分享的内容；对方关闭后将不再可见。"
     }
    }
   }
  },
  "coach_vida_promedio": {
