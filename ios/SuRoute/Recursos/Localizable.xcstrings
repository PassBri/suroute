  },
  "ejes_vacio_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قيّم كل محور من 1 إلى 10 بحسب وضعك الحالي: لا حيث تريد أن تكون، بل حيث أنت اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bewerte jede Achse von 1 bis 10 nach deiner AKTUELLEN Situation: nicht, wo du sein möchtest, sondern wo du HEUTE stehst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rate each axis from 1 to 10 based on your CURRENT situation: not where you want to be, but where you ARE today."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Evalúa cada eje del 1 al 10 según tu situación ACTUAL: no donde quieres estar, sino donde ESTÁS hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Évalue chaque axe de 1 à 10 selon ta situation ACTUELLE : pas là où tu veux être, mais là où tu EN ES aujourd'hui."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर अक्ष को अपनी वर्तमान स्थिति के आधार पर 1 से 10 के बीच आँकें: जहाँ आप होना चाहते हैं वहाँ नहीं, बल्कि जहाँ आप आज हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Valuta ogni asse da 1 a 10 in base alla tua situazione ATTUALE: non dove vorresti essere, ma dove SEI oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "各軸を1〜10で評価してください。なりたい姿ではなく、今の自分を基準に。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "각 축을 현재 상황에 맞춰 1에서 10까지 평가하세요. 되고 싶은 모습이 아니라 오늘 실제로 서 있는 곳이에요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Avalie cada eixo de 1 a 10 conforme sua situação ATUAL: não onde você quer estar, mas onde você ESTÁ hoje."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Оцени каждую ось от 1 до 10 по своей ТЕКУЩЕЙ ситуации: не там, где хочешь быть, а там, где ты СЕЙЧАС."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "按你的当前状态给每个维度打 1 到 10 分：不是你想要的位置，而是你今天真实所处的位置。"
     }
    }
   }
  },
  "ejes_vacio_titulo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قبل أن تصعد، عليك أن تعرف أين تقف"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bevor du aufsteigst, musst du wissen, wo du stehst"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Before you climb, you need to know where you stand"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Antes de ascender, debes saber dónde estás parado"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Avant de monter, il faut savoir où tu te trouves"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चढ़ने से पहले जानना ज़रूरी है कि आप कहाँ खड़े हैं"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prima di salire, devi sapere dove ti trovi"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "登る前に、今いる場所を知ろう"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오르기 전에, 지금 어디에 서 있는지 알아야 해요"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Antes de subir, você precisa saber onde está pisando"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Прежде чем подниматься, нужно знать, где ты стоишь"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "出发之前，先要知道自己站在哪里"
     }
    }
   }
  },
