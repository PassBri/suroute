  "cv_g9_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختم منشورًا حتى تاريخ معين: سيرى الآخرون الظرف بختمه الشمعي وسيقرؤونه عندما يُفتح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Versiegle einen Beitrag bis zu einem Datum: Die anderen sehen den Umschlag mit Wachssiegel und lesen ihn, wenn er sich öffnet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seal a post until a date: others will see the envelope with its wax seal and read it when it opens."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sella una publicación hasta una fecha: los demás verán el sobre con su lacre y la leerán cuando se abra."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Scelle une publication jusqu'à une date : les autres verront l'enveloppe et son sceau de cire, et la liront quand elle s'ouvrira."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किसी पोस्ट को एक तारीख़ तक सील करें: दूसरों को लाख की मुहर वाला लिफ़ाफ़ा दिखेगा और खुलने पर वे इसे पढ़ सकेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigilla un post fino a una data: gli altri vedranno la busta con la ceralacca e lo leggeranno quando si aprirà."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿を指定の日まで封印できます。ほかの人には封蠟つきの封筒が表示され、開封日に読めるようになります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "게시물을 특정 날짜까지 봉인하세요. 다른 사람들은 밀랍 봉인이 찍힌 봉투를 보다가 열리는 날 읽을 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sele uma publicação até uma data: os outros verão o envelope com o lacre e poderão lê-la quando abrir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запечатай публикацию до определённой даты: остальные увидят конверт с сургучной печатью и прочитают письмо, когда оно откроется."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "把一条动态封存到某个日期：其他人会看到盖着火漆印的信封，等开启时才能阅读。"
     }
    }
   }
  },
