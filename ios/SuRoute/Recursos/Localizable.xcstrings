  "bi_g_2_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل ليلة اكتب خطوة صغيرة خطوتها نحو قمتك، حتى في يوم صعب."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib jeden Abend einen kleinen Schritt Richtung Gipfel auf, auch an schweren Tagen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each night write one small step you took toward your summit, even on a hard day."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada noche escribe un paso pequeño que diste hacia tu cumbre, aunque el día haya sido difícil."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque soir, écris un petit pas fait vers ton sommet, même un jour difficile."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर रात अपने शिखर की ओर उठाया एक छोटा कदम लिखें, चाहे दिन कठिन रहा हो।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni sera scrivi un piccolo passo fatto verso la tua vetta, anche in una giornata difficile."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎晩、山頂へ向けて進んだ小さな一歩を書きましょう。つらい日でも。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "매일 밤, 힘든 날이라도 정상을 향해 내디딘 작은 한 걸음을 적으세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toda noite escreva um pequeno passo que deu rumo ao seu cume, mesmo num dia difícil."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый вечер записывай маленький шаг к своей вершине, даже в трудный день."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每晚写下你朝山顶迈出的一小步，即使那天很难。"
     }
    }
   }
  },
