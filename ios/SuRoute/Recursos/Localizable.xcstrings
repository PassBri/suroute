  "cu_propio_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ترتيبي: أنت تحدد الترتيب بالأسهم، مثلًا الدين الأثقل عليك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Meine Reihenfolge: du legst sie mit den Pfeilen fest, zum Beispiel die, die dich am meisten belastet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "My order: you choose the order with the arrows, for example the one that weighs on you most."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mi orden: tú decides el orden con las flechas, por ejemplo la que más te pesa."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mon ordre : tu choisis l’ordre avec les flèches, par exemple celle qui te pèse le plus."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मेरा क्रम: तीरों से आप खुद क्रम तय करें, जैसे जो सबसे भारी लगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il mio ordine: decidi tu l’ordine con le frecce, per esempio quella che ti pesa di più."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自分の順番：矢印で順番を決めます。たとえば一番重く感じるものから。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 순서: 화살표로 직접 순서를 정해요. 예를 들어 가장 부담되는 빚부터."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Minha ordem: você decide a ordem com as setas, por exemplo a que mais pesa."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Мой порядок: ты сам выбираешь порядок стрелками, например тот долг, что тяготит больше всего."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我的顺序：用箭头自己决定顺序，例如最让你有压力的那笔。"
     }
    }
   }
  },
