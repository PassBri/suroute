  "legal_error": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعذّر الحفظ. تحقق من اتصالك وحاول مرة أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Speichern fehlgeschlagen. Prüfe deine Verbindung und versuche es erneut."
