  "bloqueado_aviso": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حظرت %1$@. لن ترى منشوراته بعد الآن."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast %1$@ blockiert. Du siehst die Beiträge nicht mehr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You blocked %1$@. You won't see their posts anymore."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bloqueaste a %1$@. Ya no verás sus publicaciones."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as bloqué %1$@. Tu ne verras plus ses publications."
