  "cu_isf_escala": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مؤشر الصحة المالية: 80-100 ممتاز · 50-79 جيد · 20-49 متوسط · أقل من 20 في خطر"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Index der finanziellen Gesundheit: 80-100 ausgezeichnet · 50-79 gut · 20-49 mäßig · unter 20 riskant"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Financial Health Index: 80-100 excellent · 50-79 good · 20-49 moderate · under 20 at risk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Índice de Salud Financiera: 80-100 excelente · 50-79 buena · 20-49 moderada · menos de 20 en riesgo"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Indice de santé financière : 80-100 excellent · 50-79 bon · 20-49 modéré · moins de 20 à risque"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "वित्तीय सेहत सूचकांक: 80-100 उत्कृष्ट · 50-79 अच्छा · 20-49 मध्यम · 20 से कम जोखिम"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Indice di salute finanziaria: 80-100 eccellente · 50-79 buona · 20-49 moderata · sotto 20 a rischio"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "お金の健康指数：80〜100 優秀・50〜79 良好・20〜49 普通・20未満 危険"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "재정 건강 지수: 80-100 우수 · 50-79 양호 · 20-49 보통 · 20 미만 위험"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Índice de Saúde Financeira: 80-100 excelente · 50-79 boa · 20-49 moderada · abaixo de 20 em risco"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Индекс финансового здоровья: 80–100 отлично · 50–79 хорошо · 20–49 умеренно · ниже 20 риск"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "财务健康指数：80-100 优秀 · 50-79 良好 · 20-49 一般 · 低于 20 有风险"
     }
    }
   }
  },
