    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今月のスコア、目標、習慣、ウェルビーイング、振り返り、家計。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 달의 점수, 목표, 습관, 웰빙, 결산, 재정."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pontuação, metas, hábitos, bem-estar, balanço e finanças do mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Оценка, цели, привычки, самочувствие, итоги и финансы месяца."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
