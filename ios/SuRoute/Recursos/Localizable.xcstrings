  "album_incluir_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لديك %1$ld ذكريات من %2$ld مضبوطة على «أنا فقط». إذا أدرجتها فستظهر في يومياتك بالظهور الذي اخترته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast %1$ld Erinnerungen aus %2$ld auf „Nur ich“. Wenn du sie einbeziehst, erscheinen sie mit der gewählten Sichtbarkeit in deinem Tagebuch."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You have %1$ld memories from %2$ld set to “Only me”. If you include them, they’ll show in your journal with the visibility you chose."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tienes %1$ld recuerdos de %2$ld marcados como «Solo yo». Si los incluyes, se verán en tu diario con la visibilidad que elegiste."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as %1$ld souvenirs de %2$ld en « Moi seul ». Si tu les inclus, ils apparaîtront dans ton journal avec la visibilité choisie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी %2$ld की %1$ld यादें «सिर्फ़ मैं» पर हैं। शामिल करने पर वे चुनी गई दृश्यता के साथ डायरी में दिखेंगी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai %1$ld ricordi del %2$ld impostati su «Solo io». Se li includi, appariranno nel diario con la visibilità scelta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$ld年の思い出のうち%1$ld件が「自分のみ」です。含めると、選んだ公開範囲で日記に表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$ld년 추억 %1$ld개가 ‘나만 보기’예요. 포함하면 선택한 공개 범위로 일기에 보여요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você tem %1$ld lembranças de %2$ld marcadas como «Só eu». Se incluí-las, aparecerão no seu diário com a visibilidade escolhida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "У тебя %1$ld воспоминаний за %2$ld с пометкой «Только я». Если включить их, они появятся в дневнике с выбранной видимостью."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你有 %1$ld 条 %2$ld 年的回忆设为“仅自己”。如果包含它们，它们会以你选择的可见范围显示在日记中。"
     }
    }
   }
  },
  "album_incluir_titulo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
