  "cu_fijo_saltado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حُذف لهذا الشهر فقط؛ يبقى ثابتًا في غيره"
