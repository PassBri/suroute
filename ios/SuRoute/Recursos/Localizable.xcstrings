  "comodines_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إذا مرّ يوم دون أي عادة، تحمي بطاقة الحماية سلسلتك. تكسب واحدة كل 7 أيام متتالية (حتى 2)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du an einem Tag keine Gewohnheit abhakst, schützt ein Joker deine Serie. Für je 7 Tage am Stück bekommst du einen (höchstens 2)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If you miss a day, a streak saver protects your streak. You earn one for every 7 days in a row (up to 2)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si un día no marcas ningún hábito, un comodín protege tu racha. Ganas uno por cada 7 días seguidos (máximo 2)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Si un jour tu ne coches aucune habitude, un joker protège ta série. Tu en gagnes un tous les 7 jours d’affilée (2 au maximum)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किसी दिन कोई आदत न हो तो एक कवच आपकी लगातार गिनती बचाता है। हर 7 लगातार दिनों पर एक मिलता है (अधिकतम 2)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se un giorno non segni nessuna abitudine, un jolly protegge la tua serie. Ne guadagni uno ogni 7 giorni di fila (massimo 2)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "習慣を1つも記録しない日があっても、保護がストリークを守ります。7日連続ごとに1つもらえます（最大2つ）。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루 습관을 하나도 체크하지 못해도 보호권이 연속 기록을 지켜 줘요. 7일 연속마다 하나씩 받아요(최대 2개)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se em um dia você não marcar nenhum hábito, um coringa protege sua sequência. Você ganha um a cada 7 dias seguidos (máximo 2)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если в какой-то день ты не отметишь ни одной привычки, защита сохранит серию. Одна даётся за каждые 7 дней подряд (максимум 2)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果某天没有打卡任何习惯，护卡会保住你的连续天数。每连续 7 天获得一张（最多 2 张）。"
     }
    }
   }
  },
  "comodines_leyenda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الأيام الزرقاء غطّتها بطاقة حماية."
