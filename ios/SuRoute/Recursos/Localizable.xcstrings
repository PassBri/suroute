  "etapa_1": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اعرف نفسك"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lerne dich kennen"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Know yourself"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Conócete"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Apprends à te connaître"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "खुद को जानें"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Conosciti"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自分を知る"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나를 알기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Conheça-se"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Узнай себя"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "认识自己"
     }
    }
   }
  },
  "etapa_1_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتشف قمّتك، وحدّد مرحلتك، وقيّم محاورك الستة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Entdecke deinen Gipfel, bestimme deine Phase und bewerte deine 6 Achsen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Discover your summit, diagnose your phase and assess your 6 axes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Descubre tu cumbre, diagnostica tu fase y evalúa tus 6 ejes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Découvre ton sommet, diagnostique ta phase et évalue tes 6 axes."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी चोटी खोजें, अपना चरण पहचानें और अपने 6 अक्षों का आकलन करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scopri la tua vetta, individua la tua fase e valuta i tuoi 6 assi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの山頂を見つけ、今のフェーズを診断し、6つの軸を評価しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나의 정상을 발견하고, 현재 단계를 진단하고, 6개의 축을 평가해 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Descubra seu cume, diagnostique sua fase e avalie seus 6 eixos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Открой свою вершину, определи свою фазу и оцени 6 осей."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "发现你的山巅，诊断你所处的阶段，评估你的 6 大维度。"
     }
    }
   }
  },
  "etapa_2": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ارسم طريقك"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zeichne deine Route"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Chart your route"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Traza tu ruta"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Trace ta route"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपना रास्ता बनाएँ"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Traccia il tuo percorso"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ルートを描く"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "길 그리기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Trace sua rota"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Проложи маршрут"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "规划路线"
     }
    }
   }
  },
  "etapa_2_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صمّم الرحلة، واجمع محاورك في مشاريع، وحوّل غايتك إلى قيمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gestalte die Reise, verbinde deine Achsen zu Projekten und mach aus deinem Sinn echten Wert."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Design the journey, join your axes into projects and turn your purpose into value."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Diseña el viaje, une tus ejes en proyectos y convierte tu propósito en valor."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Dessine le voyage, réunis tes axes dans des projets et transforme ta raison d'être en valeur."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सफ़र की रूपरेखा बनाएँ, अपने अक्षों को प्रोजेक्ट में जोड़ें और अपने उद्देश्य को मूल्य में बदलें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Progetta il viaggio, unisci i tuoi assi in progetti e trasforma il tuo scopo in valore."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "旅を設計し、軸をプロジェクトにつなげ、あなたの想いを価値に変えましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "여정을 설계하고, 축들을 프로젝트로 엮고, 나의 목적을 가치로 바꿔 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Desenhe a jornada, una seus eixos em projetos e transforme seu propósito em valor."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Спроектируй путь, объедини оси в проекты и преврати свою цель в ценность."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "设计旅程，把各个维度整合进项目，让你的初心转化为价值。"
     }
    }
   }
  },
  "etapa_3": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "انطلق في المسير"
