  "metodo_dificultad": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الخطوة الجديدة تطلب الآن %1$ld أيام عمل"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein neuer Schritt verlangt jetzt %1$ld Tage"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A new step now asks for %1$ld work days"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ahora un paso nuevo pide %1$ld jornadas"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un nouveau pas demande maintenant %1$ld journées"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अब एक नया कदम %1$ld दिन माँगता है"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ora un nuovo passo chiede %1$ld giornate"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今、新しいステップには%1$ld日必要です"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
