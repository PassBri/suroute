  "contactos_redes_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "واتساب وإنستغرام وفيسبوك وتيك توك وX لا تسمح باستيراد جهات الاتصال. شارك رابطك: من يفتحه سيراك فورًا ويمكنه متابعتك ومراسلتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok und X erlauben keinen Kontaktimport. Teile deinen Link: Wer ihn öffnet, sieht dich sofort und kann dir folgen und schreiben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok and X don't allow importing contacts. Share your link: anyone who opens it will see you right away and can follow and message you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok y X no dejan importar contactos. Comparte tu enlace: quien entre con él te verá al instante y podrá seguirte y escribirte."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok et X ne permettent pas d'importer des contacts. Partagez votre lien : qui l'ouvre vous verra tout de suite et pourra vous suivre et vous écrire."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok और X संपर्क आयात नहीं करने देते। अपना लिंक साझा करें: जो इसे खोलेगा, वह तुरंत आपको देखेगा और आपको फ़ॉलो कर सकेगा और संदेश भेज सकेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok e X non permettono di importare contatti. Condividi il tuo link: chi lo apre ti vedrà subito e potrà seguirti e scriverti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp、Instagram、Facebook、TikTok、X では連絡先を取り込めません。リンクを共有しましょう。開いた人はすぐにあなたを見つけ、フォローやメッセージができます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok, X는 연락처 가져오기를 허용하지 않습니다. 링크를 공유하세요. 링크를 연 사람은 바로 당신을 보고 팔로우하고 메시지를 보낼 수 있습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok e X não permitem importar contatos. Compartilhe seu link: quem entrar por ele verá você na hora e poderá seguir e escrever para você."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp, Instagram, Facebook, TikTok и X не позволяют импортировать контакты. Поделитесь ссылкой: кто её откроет, сразу увидит вас и сможет подписаться и написать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "WhatsApp、Instagram、Facebook、TikTok 和 X 不允许导入联系人。分享你的链接：打开链接的人会立刻看到你，并可以关注你、给你发消息。"
     }
    }
   }
  },
