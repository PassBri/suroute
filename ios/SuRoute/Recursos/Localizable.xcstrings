      "state": "translated",
      "value": "Sperre mit Fingerabdruck oder Gesicht"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lock with fingerprint or face"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
