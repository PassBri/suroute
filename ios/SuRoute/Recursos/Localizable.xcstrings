  "cp_mes_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل شهر، تشاركاها بصوت عالٍ. هذه مراجعة %1$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Teilt es jeden Monat laut miteinander. Das ist die für %1$@."
