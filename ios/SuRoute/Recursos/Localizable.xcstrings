  "bi_indice_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "آخر 7 أيام وفق أهداف منظمة الصحة العالمية. السلسلة: %1$ld أيام بتحقيق 4 من 6 عادات. يوم ضعيف لا يمحو طريقك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die letzten 7 Tage, mit den WHO-Zielen. Serie: %1$ld Tage mit 4 von 6 Gewohnheiten. Ein schwacher Tag löscht deinen Weg nicht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The last 7 days, with WHO targets. Streak: %1$ld days with 4 of 6 habits met. A slow day doesn't erase your path."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los últimos 7 días, con las metas de la OMS. Racha: %1$ld días con 4 de 6 hábitos cumplidos. Un día flojo no borra tu camino."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les 7 derniers jours, avec les objectifs de l'OMS. Série : %1$ld jours avec 4 habitudes sur 6. Un jour faible n'efface pas ton chemin."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पिछले 7 दिन, WHO लक्ष्यों के साथ। लगातार: %1$ld दिन 6 में से 4 आदतें पूरी। एक कमज़ोर दिन आपका रास्ता नहीं मिटाता।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Gli ultimi 7 giorni, con gli obiettivi dell'OMS. Serie: %1$ld giorni con 4 abitudini su 6. Un giorno storto non cancella il tuo cammino."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "直近7日間、WHOの目標で計算。連続：6つ中4つを達成した日が %1$ld 日。調子の悪い日があっても、歩んだ道は消えません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최근 7일, WHO 목표 기준. 연속: 6개 중 4개를 지킨 날 %1$ld일. 하루 부진해도 걸어온 길은 지워지지 않습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os últimos 7 dias, com as metas da OMS. Sequência: %1$ld dias com 4 de 6 hábitos cumpridos. Um dia fraco não apaga seu caminho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Последние 7 дней по целям ВОЗ. Серия: %1$ld дн. с 4 из 6 привычек. Один слабый день не стирает твой путь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "最近 7 天，参照世卫组织目标。连续：%1$ld 天达成 6 项中的 4 项。一天状态不好不会抹去你的路。"
     }
    }
   }
  },
  "bi_inhala": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شهيق"
     }
    },
