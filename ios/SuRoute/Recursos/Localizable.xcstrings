  "cordadas_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "فريق الحبل مجموعة من 3 إلى 6 أشخاص مربوطين بالحبل نفسه: تحدٍّ لعدة أيام، يسجّل كلٌّ يومه ويشجّع بعضكم بعضًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Eine Seilschaft sind 3 bis 6 Menschen am selben Seil: eine mehrtägige Herausforderung, jede Person hakt ihren Tag ab und ihr feuert euch an."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A rope team is a group of 3 to 6 people tied to the same rope: a multi-day challenge where each person checks off their day and you cheer each other on."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una cordada es un grupo de 3 a 6 personas que suben atadas a la misma cuerda: un reto de varios días, cada quien marca su día y se dan ánimo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une cordée, c’est 3 à 6 personnes encordées : un défi sur plusieurs jours, chacun coche sa journée et vous vous encouragez."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "रोप टीम 3 से 6 लोगों का समूह है जो एक ही रस्सी से बँधा है: कई दिनों की चुनौती, हर कोई अपना दिन चिह्नित करता है और सब एक-दूसरे का हौसला बढ़ाते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una cordata è un gruppo di 3–6 persone legate alla stessa corda: una sfida di più giorni, ognuno segna il suo giorno e vi incoraggiate."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ザイルパーティは同じロープでつながる3〜6人の仲間。数日間のチャレンジで各自が毎日チェックし、励まし合います。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "로프 팀은 같은 줄에 묶인 3~6명이에요. 며칠간의 도전에서 각자 하루를 체크하고 서로 응원해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma cordada é um grupo de 3 a 6 pessoas presas à mesma corda: um desafio de vários dias, cada um marca seu dia e vocês se apoiam."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Связка — это 3–6 человек на одной верёвке: многодневный вызов, каждый отмечает свой день, и вы поддерживаете друг друга."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "结组是 3 到 6 人系在同一根绳上：一起完成多天的挑战，每人打卡自己的一天，互相鼓励。"
     }
    }
   }
  },
  "cordadas_invitacion": {
