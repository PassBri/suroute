  "ios_publicar_error": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعذّر النشر. تحقّق من اتصالك وحاول مرة أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Posten nicht möglich. Prüfe die Verbindung und versuche es erneut."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Couldn't post. Check your connection and try again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo publicar. Revisa tu conexión e inténtalo otra vez."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Publication impossible. Vérifiez votre connexion et réessayez."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पोस्ट नहीं हो सका। कनेक्शन जाँचें और फिर कोशिश करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossibile pubblicare. Controlla la connessione e riprova."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿できませんでした。接続を確認してもう一度お試しください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "게시하지 못했어요. 연결을 확인하고 다시 시도하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não foi possível publicar. Verifique sua conexão e tente de novo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не удалось опубликовать. Проверьте подключение и попробуйте снова."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "发布失败。请检查网络后重试。"
     }
    }
   }
  },
