  "org_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "انقل كل بطاقة لأعلى أو لأسفل كما تشاء. يُستخدم الترتيب أيضًا في SuRoute على الويب."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Verschieben Sie jede Karte nach oben oder unten. Die Reihenfolge gilt auch in SuRoute Web."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Move each card up or down as you like. The order is also used on SuRoute Web."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube o baja cada tarjeta a tu gusto. El orden también se usa en SuRoute Web."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Montez ou descendez chaque carte à votre goût. L’ordre s’applique aussi à SuRoute Web."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर कार्ड को अपनी पसंद से ऊपर या नीचे करें। यही क्रम SuRoute वेब पर भी लागू होता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sposta ogni scheda su o giù come preferisci. L’ordine vale anche su SuRoute Web."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "カードを好きな順に上下へ動かせます。この順番は SuRoute Web にも反映されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "각 카드를 원하는 대로 위아래로 옮기세요. 순서는 SuRoute 웹에도 적용됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suba ou desça cada cartão como preferir. A ordem também vale no SuRoute Web."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Перемещайте карточки вверх и вниз как удобно. Порядок действует и в SuRoute Web."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "按你的喜好上下移动每张卡片。此顺序也适用于 SuRoute 网页版。"
     }
    }
   }
  },
