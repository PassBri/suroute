  "cu_capa_bloqueo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُفتح الوحدة بالبصمة أو الوجه أو رمز الهاتف وتُغلق بعد 5 دقائق أو عند الخروج. على الويب تطلب رمزًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Modul öffnet sich mit Fingerabdruck, Gesicht oder Handy-PIN und schließt sich nach 5 Minuten oder beim Verlassen. Im Web wird eine PIN verlangt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The module opens with your fingerprint, face or phone PIN and closes after 5 minutes or when you leave. On the web it asks for a PIN."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El módulo se abre con tu huella, rostro o PIN del teléfono y se cierra a los 5 minutos o al salir. En la web pide un PIN."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le module s’ouvre avec ton empreinte, ton visage ou le code du téléphone et se ferme après 5 minutes ou quand tu sors. Sur le web, un PIN est demandé."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मॉड्यूल फ़िंगरप्रिंट, चेहरे या फ़ोन पिन से खुलता है और 5 मिनट बाद या बाहर जाने पर बंद होता है। वेब पर पिन माँगता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il modulo si apre con impronta, volto o PIN del telefono e si chiude dopo 5 minuti o uscendo. Sul web chiede un PIN."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "指紋・顔・端末の PIN で開き、5分後か退出時に閉じます。ウェブでは PIN を求めます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지문·얼굴·휴대폰 PIN으로 열리고 5분 후나 나갈 때 잠겨요. 웹에서는 PIN을 물어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O módulo abre com digital, rosto ou PIN do telefone e fecha após 5 minutos ou ao sair. Na web pede um PIN."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Модуль открывается отпечатком, лицом или PIN телефона и закрывается через 5 минут или при выходе. В вебе нужен PIN."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "模块需用指纹、面部或手机密码打开，5 分钟后或离开时自动锁定。网页版需输入 PIN。"
     }
    }
   }
  },
  "cu_capa_cuenta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
