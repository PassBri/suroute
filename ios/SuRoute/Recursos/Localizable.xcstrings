  "suspension_permanente": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بشكل دائم. يمكنك مواصلة استخدام مسارك، لكن دون المشاركة في المجتمع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dauerhaft. Du kannst deine Route weiter nutzen, aber nicht an der Community teilnehmen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Permanently. You can keep using your path, but not take part in the community."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De forma permanente. Puedes seguir usando tu ruta, pero no participar en la comunidad."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "De façon définitive. Tu peux continuer à utiliser ta route, mais pas participer à la communauté."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "स्थायी रूप से। तुम अपना रास्ता इस्तेमाल कर सकते हो, पर समुदाय में भाग नहीं ले सकते।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "In modo permanente. Puoi continuare a usare il tuo percorso, ma non partecipare alla community."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "無期限です。自分のルートは使えますが、コミュニティには参加できません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "영구 정지예요. 루트는 계속 쓸 수 있지만 커뮤니티에는 참여할 수 없어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "De forma permanente. Você pode continuar usando sua rota, mas não participar da comunidade."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Навсегда. Можно пользоваться своим маршрутом, но не участвовать в сообществе."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "永久暂停。你仍可使用自己的路线，但不能参与社区。"
     }
    }
   }
  },
