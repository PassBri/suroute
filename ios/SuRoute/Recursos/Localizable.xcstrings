  "resumen_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عامي %1$ld في SuRoute: %2$ld يومًا مع عادات، %3$ld عادة منجزة، أفضل سلسلة %4$ld يومًا و%5$ld أهداف منجزة."
