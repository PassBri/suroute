  "tarjeta_evo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إن كنت اليوم كما كنت قبل شهر، فأنا أتراجع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn ich heute derselbe bin wie vor einem Monat, gehe ich rückwärts."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If I'm the same today as a month ago, I'm going backwards."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si hoy soy igual que hace un mes, estoy retrocediendo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Si je suis le même qu'il y a un mois, je recule."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अगर आज मैं एक महीने पहले जैसा ही हूँ, तो मैं पीछे जा रहा हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se oggi sono uguale a un mese fa, sto tornando indietro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日が1か月前と同じなら、後退しているということ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘의 내가 한 달 전과 같다면 뒤로 가고 있는 거예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se hoje sou igual a um mês atrás, estou retrocedendo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если сегодня я такой же, как месяц назад, я иду назад."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果今天的我和一个月前一样，那我就是在退步。"
     }
    }
   }
  },
