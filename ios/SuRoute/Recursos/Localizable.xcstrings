    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी %1$ld निजी तस्वीरें प्रकाशित नहीं होंगी: केवल साझा की गई तस्वीरें जाएँगी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le tue %1$ld foto private non vengono pubblicate: solo quelle già condivise."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "非公開の写真 %1$ld 枚は公開されません。共有済みの写真だけが公開されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "비공개 사진 %1$ld장은 게시되지 않습니다. 이미 공유한 사진만 게시됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suas %1$ld fotos privadas não são publicadas: só vão as que você já compartilhou."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ваши личные фото (%1$ld) не публикуются: только те, которыми вы уже поделились."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的 %1$ld 张私密照片不会发布：只发布已分享的照片。"
     }
    }
   }
