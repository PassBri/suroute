  "bi_g_3_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في محادثة واحدة يوميًا، استمع دون مقاطعة وأعد ما فهمته قبل أن تبدي رأيك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hör in einem Gespräch pro Tag zu, ohne zu unterbrechen, und wiederhole, was du verstanden hast."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "In one conversation a day, listen without interrupting and repeat what you understood before giving your view."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "En una conversación al día, escucha sin interrumpir y repite lo que entendiste antes de opinar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Dans une conversation par jour, écoute sans interrompre et reformule avant de donner ton avis."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दिन में एक बातचीत में बिना टोके सुनें और राय देने से पहले जो समझा उसे दोहराएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "In una conversazione al giorno, ascolta senza interrompere e ripeti ciò che hai capito prima di dire la tua."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1日1回の会話で、さえぎらずに聴き、理解したことを繰り返してから意見を言いましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루 한 번의 대화에서 끼어들지 않고 듣고, 이해한 것을 되짚은 뒤 의견을 말하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Em uma conversa por dia, escute sem interromper e repita o que entendeu antes de opinar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В одном разговоре в день слушай не перебивая и повтори, что понял, прежде чем высказаться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每天在一次对话中，不打断地倾听，先复述你理解的内容再发表意见。"
     }
    }
   }
  },
