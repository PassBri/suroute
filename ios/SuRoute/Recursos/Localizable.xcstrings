  "actividades_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتب ما ستفعله في كل ساعة واختر هدف الشهر الذي يخدمه: عند تعليمه منجزًا يُحتسب اليوم في ذلك الهدف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib, was du zu jeder Stunde tust, und wähle das Monatsziel dazu: Hakst du es ab, zählt der Tag für dieses Ziel."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write what you’ll do each hour and choose which monthly goal it serves: when you mark it done, the day counts toward that goal."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escribe lo que harás a cada hora y elige a qué meta del mes aporta: al marcarla hecha, el día cuenta en esa meta."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écris ce que tu feras à chaque heure et choisis l’objectif du mois qu’elle sert : une fois cochée, la journée compte pour cet objectif."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर घंटे क्या करेंगे लिखें और चुनें कि यह महीने के किस लक्ष्य में योगदान देता है: पूरा चिह्नित करने पर दिन उस लक्ष्य में गिना जाएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrivi cosa farai ogni ora e scegli a quale obiettivo del mese contribuisce: segnandola fatta, il giorno conta per quell’obiettivo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "各時間にすることを書き、どの月の目標につながるか選びましょう。完了にすると、その日が目標に記録されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "시간마다 할 일을 적고 어떤 이달의 목표에 기여하는지 고르세요. 완료로 표시하면 그날이 그 목표에 반영돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escreva o que fará a cada hora e escolha a que meta do mês contribui: ao marcá-la feita, o dia conta nessa meta."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши, что будешь делать каждый час, и выбери цель месяца: когда отметишь дело выполненным, день засчитается в эту цель."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "写下每个小时要做的事，并选择它服务的本月目标：标记完成后，这一天就计入该目标。"
     }
    }
   }
  },
