  "paso_cumbre_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "جملة عمّن تريد أن تصبح. كل ما في التطبيق ينطلق من هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Satz darüber, wer du werden willst. Alles andere in der App baut darauf auf."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "One sentence about who you want to become. Everything else in the app grows from here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una frase sobre quién quieres llegar a ser. Todo lo demás de la app sale de aquí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une phrase sur qui tu veux devenir. Tout le reste de l’app part de là."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप कौन बनना चाहते हैं, एक वाक्य में। ऐप का बाकी सब यहीं से निकलता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una frase su chi vuoi diventare. Tutto il resto dell’app nasce da qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "なりたい自分をひと言で。アプリのすべてはここから始まります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "되고 싶은 나를 한 문장으로. 앱의 모든 것이 여기서 시작돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma frase sobre quem você quer se tornar. Todo o resto do app nasce daqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Одна фраза о том, кем ты хочешь стать. Всё остальное в приложении растёт отсюда."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用一句话写下你想成为的人。应用里的一切都从这里出发。"
     }
    }
   }
  },
