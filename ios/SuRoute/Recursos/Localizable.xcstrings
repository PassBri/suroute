  "brujula_anio_cumbre": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في %1$ld أعيش عام %2$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld lebe ich das Jahr der %2$@."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "In %1$ld I live the year of %2$@."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "En %1$ld vivo el año de %2$@."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "En %1$ld, je vis l’année de %2$@."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld में मैं %2$@ का साल जीता हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nel %1$ld vivo l’anno di %2$@."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld年、私は%2$@の年を生きる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld년, 나는 %2$@의 해를 산다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Em %1$ld vivo o ano de %2$@."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В %1$ld я проживаю год «%2$@»."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld 年，我活出 %2$@ 之年。"
     }
    }
   }
  },
  "brujula_anio_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تولد من كلمة عامك وأهدافك لعام %1$ld: قمة للعام و8 مخيمات بخطواتها الـ64. بوصلتك العامة لا تتغير."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Entsteht aus deinem Wort des Jahres und deinen Zielen für %1$ld: ein Gipfel für das Jahr und 8 Lager mit ihren 64 Schritten. Dein allgemeiner Kompass bleibt gleich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Born from your word of the year and your %1$ld goals: one summit for the year and 8 camps with their 64 steps. Your general Compass stays the same."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Nace de tu palabra del año y de tus metas de %1$ld: una cumbre para el año y 8 campamentos con sus 64 pasos. Tu Brújula general no cambia."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Elle naît de votre mot de l’année et de vos objectifs %1$ld : un sommet pour l’année et 8 camps avec leurs 64 pas. Votre Boussole générale ne change pas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह आपके साल के शब्द और %1$ld के लक्ष्यों से बनता है: साल का एक शिखर और 64 कदमों वाले 8 पड़ाव। आपका सामान्य कंपास नहीं बदलता।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nasce dalla tua parola dell’anno e dai tuoi obiettivi del %1$ld: una cima per l’anno e 8 campi con i loro 64 passi. La tua Bussola generale non cambia."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今年の言葉と%1$ld年の目標から生まれます。1年の頂上と8つのキャンプ、64の歩み。全体のコンパスは変わりません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "올해의 단어와 %1$ld년 목표에서 시작해요. 한 해의 정상 하나와 64걸음을 가진 8개의 캠프. 전체 나침반은 그대로예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nasce da sua palavra do ano e das suas metas de %1$ld: um cume para o ano e 8 acampamentos com seus 64 passos. Sua Bússola geral não muda."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Рождается из вашего слова года и целей на %1$ld: одна вершина на год и 8 лагерей с 64 шагами. Ваш общий Компас не меняется."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "来自你的年度关键词和 %1$ld 年目标：一年一个顶峰，8 个营地和 64 步。你的总指南针保持不变。"
     }
    }
   }
  },
