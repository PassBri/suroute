  "cu_ind_endeuda_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الالتزامات ÷ الأصول. أقل من 30 %: مثالي؛ أكثر من 50 %: خطر مرتفع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schulden ÷ Vermögen. Unter 30 %: optimal; über 50 %: hohes Risiko."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Liabilities ÷ assets. Under 30 %: optimal; over 50 %: high risk."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasivos ÷ activos. Menos del 30 %: óptimo; más del 50 %: riesgo alto."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Passifs ÷ actifs. Moins de 30 % : optimal ; plus de 50 % : risque élevé."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "देनदारी ÷ संपत्ति। 30 % से कम: बेहतरीन; 50 % से ज़्यादा: बड़ा जोखिम।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Passività ÷ attivi. Sotto il 30 %: ottimale; oltre il 50 %: rischio alto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "負債 ÷ 資産。30 % 未満は最適、50 % 超は高リスク。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "부채 ÷ 자산. 30 % 미만 최적, 50 % 초과 고위험."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Passivos ÷ ativos. Menos de 30 %: ótimo; mais de 50 %: risco alto."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пассивы ÷ активы. До 30 % — отлично; выше 50 % — высокий риск."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "负债 ÷ 资产。低于 30 % 最佳，高于 50 % 风险高。"
     }
    }
   }
  },
