    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "뱅크에서 목표를 골라 내게 맞게 바꾸거나, 직접 써 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolha uma meta do banco e adapte-a, ou escreva a sua."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выбери цель из банка и подстрой её под себя или напиши свою."
     }
    },
