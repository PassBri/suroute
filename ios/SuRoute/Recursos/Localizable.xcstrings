  "tr_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا شيء جارٍ في هذا اليوم. أضف معاملة أو إجراءً أو قسطًا كي لا تفوتك المهلة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "An diesem Tag läuft nichts. Füge einen Antrag, ein Verfahren oder eine Rate hinzu, um keine Frist zu verpassen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Nothing in progress this day. Add a procedure, process or installment so you don’t miss the deadline."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Nada en curso este día. Agrega un trámite, un proceso o una cuota para no perder el plazo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rien en cours ce jour. Ajoute une démarche, une procédure ou une échéance pour ne pas rater le délai."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस दिन कुछ चालू नहीं है। समय-सीमा न छूटे, इसलिए कोई प्रक्रिया, मामला या किस्त जोड़ें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Niente in corso oggi. Aggiungi una pratica, un procedimento o una rata per non perdere la scadenza."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この日は進行中のものはありません。期限を逃さないよう、手続きやプロセス、分割払いを追加しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이날 진행 중인 건이 없어요. 기한을 놓치지 않도록 절차, 진행 건, 할부를 추가하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nada em andamento neste dia. Adicione um trâmite, processo ou parcela para não perder o prazo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В этот день ничего не идёт. Добавь процедуру, процесс или платёж, чтобы не пропустить срок."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这一天没有进行中的事项。添加手续、流程或分期，以免错过期限。"
     }
    }
   }
  },
