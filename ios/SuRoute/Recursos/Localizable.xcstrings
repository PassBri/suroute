  "estado_avanzada_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أُنجز معظم العمل؛ بقي الإغلاق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der größte Teil der Arbeit ist getan; es fehlt nur noch der Abschluss."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Most of the work is done; only the finish remains."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La mayor parte del trabajo está hecha; falta el cierre."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'essentiel du travail est fait ; il reste la finalisation."
