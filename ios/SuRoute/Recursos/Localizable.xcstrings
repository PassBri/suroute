  },
  "pap_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "احكِ المسار الكامل لهدف أو غاية حققتها: من أين انطلقت، وكل خطوة، والقمة. من يبدأ للتو يستفيد من الطريق أكثر من صورة القمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erzähle den ganzen Weg zu einem erreichten Ziel: wo du losgegangen bist, jeden Schritt und den Gipfel. Wer gerade anfängt, hat von einem Weg mehr als von einem Gipfelfoto."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tell the whole route of a goal or purpose you achieved: where you started, each step and the summit. Someone just starting gains more from a path than from a summit photo."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuenta el recorrido completo de una meta o un propósito que lograste: de dónde saliste, cada paso y la cumbre. A quien apenas empieza le sirve más un camino que una foto de la cima."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Racontez le parcours complet d’un objectif ou d’un projet atteint : votre point de départ, chaque étape et le sommet. À qui commence, un chemin sert plus qu’une photo du sommet."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपने हासिल किए लक्ष्य या उद्देश्य का पूरा सफ़र बताइए: कहाँ से शुरू किया, हर कदम और शिखर। शुरुआत करने वाले को शिखर की फ़ोटो से ज़्यादा रास्ता काम आता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Racconta tutto il percorso di un obiettivo raggiunto: da dove sei partito, ogni passo e la vetta. A chi inizia serve più un cammino che una foto dalla vetta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "達成した目標や志の道のりをすべて伝えましょう。出発点、一歩一歩、そして頂上。これから始める人には、頂上の写真より道のりが役立ちます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이룬 목표나 소망의 전체 여정을 들려주세요. 어디서 출발했는지, 각 걸음, 그리고 정상까지. 이제 막 시작한 사람에게는 정상 사진보다 길이 더 도움이 됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Conte o percurso completo de uma meta ou propósito que você alcançou: de onde saiu, cada passo e o cume. Para quem está começando, um caminho vale mais que uma foto do cume."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Расскажите весь путь к цели, которой вы достигли: откуда начали, каждый шаг и вершину. Тому, кто только начинает, путь полезнее фото с вершины."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "讲述你实现某个目标或志向的完整路线：从哪里出发、每一步和顶峰。对刚起步的人来说，一条路比一张山顶照片更有用。"
     }
    }
   }
  },
