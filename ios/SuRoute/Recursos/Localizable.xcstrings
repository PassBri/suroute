  "ruta_puntos_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل نقطة تمثل سنة. اضغط على واحدة لتنزل إلى أشهرها وأسابيعها وأيامها. تشير الراية إلى سنة هدف بعيد المدى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Punkt ist ein Jahr. Tippe auf einen, um zu seinen Monaten, Wochen und Tagen hinabzusteigen. Die Fahne markiert das Jahr eines langfristigen Ziels."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each dot is a year. Tap one to drill down into its months, weeks and days. The flag marks the year of a long-term goal."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada punto es un año. Toca uno para bajar a sus meses, semanas y días. La bandera marca el año de una meta a largo plazo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque point est une année. Touche-en un pour descendre vers ses mois, ses semaines et ses jours. Le drapeau marque l'année d'un objectif à long terme."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर बिंदु एक वर्ष है। किसी पर टैप करके उसके महीनों, हफ़्तों और दिनों में उतरें। झंडा किसी दीर्घकालिक लक्ष्य का वर्ष दर्शाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni punto è un anno. Toccane uno per scendere ai suoi mesi, settimane e giorni. La bandiera segna l'anno di un obiettivo a lungo termine."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ひとつの点が1年です。タップすると、その年の月・週・日に降りていけます。旗は長期目標の年を示しています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "점 하나가 1년이에요. 점을 탭하면 그 해의 월, 주, 일로 내려가 볼 수 있어요. 깃발은 장기 목표가 있는 해를 나타내요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada ponto é um ano. Toque em um para descer até seus meses, semanas e dias. A bandeira marca o ano de uma meta de longo prazo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждая точка — это год. Нажми на любую, чтобы спуститься к её месяцам, неделям и дням. Флажок отмечает год долгосрочной цели."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每个圆点代表一年。点按一个圆点，即可深入查看它的月、周和日。旗帜标记着长期目标所在的年份。"
     }
    }
   }
  },
  "ruta_puntos_sin_fecha": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أضف تاريخ ميلادك في الملف الشخصي لترى خريطة حياتك، نقطة لكل سنة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gib im Profil dein Geburtsdatum an, um deine Lebenskarte zu sehen, ein Punkt pro Jahr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Add your date of birth in Profile to see your life map, one dot per year."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agrega tu fecha de nacimiento en Perfil para ver el mapa de tu vida, un punto por año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajoute ta date de naissance dans Profil pour voir la carte de ta vie, un point par année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "प्रोफ़ाइल में अपनी जन्मतिथि जोड़ें ताकि आप अपने जीवन का नक्शा देख सकें, हर साल एक बिंदु।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggiungi la tua data di nascita nel Profilo per vedere la mappa della tua vita, un punto per anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "プロフィールに生年月日を追加すると、1年を1つの点で表した人生の地図が見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "프로필에 생년월일을 추가하면 1년에 점 하나로 그린 인생 지도를 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicione sua data de nascimento no Perfil para ver o mapa da sua vida, um ponto por ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Укажите дату рождения в профиле, чтобы увидеть карту своей жизни: одна точка — один год."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在个人资料中添加出生日期，即可看到你的人生地图：每年一个点。"
     }
    }
   }
  },
