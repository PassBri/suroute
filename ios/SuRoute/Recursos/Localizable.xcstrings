  "metas_anio_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ابنِ سنتك الاستثنائية: أهدافك العشرة لهذه السنة (المخيمات الأساسية)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gestalte dein außergewöhnliches Jahr: deine 10 Jahresziele (Basislager)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Build your extraordinary year: your 10 goals for the year (base camps)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Construye tu año extraordinario: tus 10 metas del año (campamentos base)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Construis ton année extraordinaire : tes 10 objectifs de l'année (camps de base)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपना असाधारण साल गढ़ें: साल के आपके 10 लक्ष्य (बेस कैंप)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Costruisci il tuo anno straordinario: i tuoi 10 obiettivi dell'anno (campi base)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "特別な1年をつくりましょう。今年の10個の目標(ベースキャンプ)です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "특별한 한 해를 만들어 보세요: 올해의 목표 10개 (베이스캠프)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Construa seu ano extraordinário: suas 10 metas do ano (acampamentos base)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Построй свой выдающийся год: твои 10 целей на год (базовые лагеря)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "打造你非凡的一年：你的 10 个年度目标（大本营）。"
     }
    }
   }
  },
  "metas_anio_vacio_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أضف أهداف هذه السنة: النشاط، القرار، الأولوية، التقدّم، العقبة، الإجراء التالي وتاريخ المراجعة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Füge die Ziele dieses Jahres hinzu: Aktivität, Entscheidung, Priorität, Fortschritt, Hindernis, nächste Aktion und Überprüfungsdatum."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Add this year's goals: activity, decision, priority, progress, obstacle, next action and review date."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agrega las metas de este año: actividad, decisión, prioridad, avance, obstáculo, próxima acción y fecha de revisión."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajoute les objectifs de cette année : activité, décision, priorité, avancement, obstacle, prochaine action et date de révision."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस साल के लक्ष्य जोड़ें: गतिविधि, निर्णय, प्राथमिकता, प्रगति, बाधा, अगला कदम और समीक्षा की तारीख़।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggiungi gli obiettivi di quest'anno: attività, decisione, priorità, avanzamento, ostacolo, prossima azione e data di revisione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今年の目標を追加しましょう。活動、決定、優先度、進捗、障害、次のアクション、見直し日を入力します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "올해의 목표를 추가하세요: 활동, 결정, 우선순위, 진행률, 장애물, 다음 행동, 점검 날짜."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicione as metas deste ano: atividade, decisão, prioridade, progresso, obstáculo, próxima ação e data de revisão."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Добавь цели этого года: дело, решение, приоритет, прогресс, препятствие, следующее действие и дата проверки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "添加今年的目标：活动、决策、优先级、进展、障碍、下一步行动和复盘日期。"
     }
    }
   }
  },
