  "estado_en_curso_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الهدف نشط ويتقدّم بثبات."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Ziel ist aktiv und kommt stetig voran."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The goal is active and moving steadily."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La meta está activa y avanza de forma sostenida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'objectif est actif et progresse de façon soutenue."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य सक्रिय है और लगातार आगे बढ़ रहा है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'obiettivo è attivo e avanza in modo costante."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標は動いていて、着実に進んでいます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표가 활발하게 꾸준히 나아가고 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A meta está ativa e avança de forma constante."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цель активна и стабильно движется вперёд."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目标正在推进，进展稳定。"
     }
    }
   }
  },
