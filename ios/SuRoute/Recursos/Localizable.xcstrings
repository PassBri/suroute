  "cu_pago_efecto_cuota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عليك %1$@. ينخفض قسطك من %2$@ إلى %3$@ وتنتهي في الموعد نفسه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du schuldest %1$@. Deine Rate sinkt von %2$@ auf %3$@, das Enddatum bleibt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You owe %1$@. Your installment drops from %2$@ to %3$@ and you finish on the same date."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Debes %1$@. Tu cuota baja de %2$@ a %3$@ y terminas en la misma fecha."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous devez %1$@. Votre mensualité passe de %2$@ à %3$@ et la date de fin reste la même."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बकाया %1$@। किस्त %2$@ से घटकर %3$@, अंतिम तारीख वही।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Devi %1$@. La rata scende da %2$@ a %3$@ e la data di fine resta uguale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "残高 %1$@。返済額が %2$@ から %3$@ に下がり、完済日は変わりません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "남은 빚 %1$@. 상환액이 %2$@에서 %3$@로 줄고 종료일은 같습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você deve %1$@. Sua parcela cai de %2$@ para %3$@ e termina na mesma data."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Остаток %1$@. Платёж снизится с %2$@ до %3$@, срок не изменится."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你还欠 %1$@。月供从 %2$@ 降到 %3$@，结束日期不变。"
     }
    }
   }
  },
  "cu_pago_efecto_interes": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "من هذه الدفعة نحو %1$@ للفوائد و%2$@ لأصل الدين. يتبقى عليك %3$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Von dieser Zahlung gehen etwa %1$@ an Zinsen und %2$@ in die Tilgung. Du schuldest noch %3$@."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Of this payment, about %1$@ goes to interest and %2$@ to principal. You still owe %3$@."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De este pago, unos %1$@ van a intereses y %2$@ a capital. Quedas debiendo %3$@."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sur ce paiement, environ %1$@ vont aux intérêts et %2$@ au capital. Il vous reste %3$@ à payer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस भुगतान में से लगभग %1$@ ब्याज और %2$@ मूलधन में। बकाया %3$@।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Di questo pagamento, circa %1$@ vanno agli interessi e %2$@ al capitale. Resti debitore di %3$@."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この支払いのうち約 %1$@ が利息、%2$@ が元金です。残高 %3$@。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 상환 중 약 %1$@는 이자, %2$@는 원금입니다. 남은 빚 %3$@."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Deste pagamento, cerca de %1$@ vão para juros e %2$@ para o capital. Fica devendo %3$@."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Из этого платежа около %1$@ пойдёт на проценты и %2$@ на основной долг. Остаток %3$@."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这笔还款中约 %1$@ 付利息，%2$@ 还本金。还欠 %3$@。"
     }
    }
   }
  },
  "cu_pago_efecto_plazo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عليك %1$@. بنفس القسط تنتهي قبل %2$ld أقساط: يتبقى %3$ld."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du schuldest %1$@. Mit gleicher Rate bist du %2$ld Raten früher fertig: noch %3$ld."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You owe %1$@. With the same installment you finish %2$ld installments sooner: %3$ld left."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Debes %1$@. Con la misma cuota terminas %2$ld cuotas antes: te quedan %3$ld."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous devez %1$@. Avec la même mensualité, vous finissez %2$ld échéances plus tôt : il en reste %3$ld."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बकाया %1$@। उसी किस्त से %2$ld किस्तें पहले खत्म: %3$ld बाकी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Devi %1$@. Con la stessa rata finisci %2$ld rate prima: ne restano %3$ld."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "残高 %1$@。同じ返済額で %2$ld 回早く完済：残り %3$ld 回。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "남은 빚 %1$@. 같은 상환액으로 %2$ld회 일찍 끝납니다: %3$ld회 남음."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você deve %1$@. Com a mesma parcela termina %2$ld parcelas antes: restam %3$ld."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Остаток %1$@. С тем же платежом закончите на %2$ld платежей раньше: осталось %3$ld."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你还欠 %1$@。月供不变，提前 %2$ld 期还清：还剩 %3$ld 期。"
     }
    }
   }
  },
