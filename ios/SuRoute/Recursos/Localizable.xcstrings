  "cu_mochilas_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "من كتاب Cima financiera: الأساسيات نحو %1$ld %%، والمتغيرة نحو %2$ld %%، وما لا يقل عن %3$ld %% لمستقبلك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aus dem Buch Cima financiera: das Nötigste etwa %1$ld %%, Variables etwa %2$ld %% und mindestens %3$ld %% für deine Zukunft."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "From the book Cima financiera: essentials near %1$ld %%, variable spending near %2$ld %% and at least %3$ld %% for your future."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Del libro Cima financiera: lo esencial cerca del %1$ld %%, lo variable cerca del %2$ld %% y al menos el %3$ld %% para tu futuro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "D’après le livre Cima financiera : l’essentiel près de %1$ld %%, le variable près de %2$ld %% et au moins %3$ld %% pour ton avenir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "Cima financiera पुस्तक से: ज़रूरी लगभग %1$ld %%, बदलते खर्च लगभग %2$ld %% और भविष्य के लिए कम से कम %3$ld %%।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dal libro Cima financiera: l’essenziale vicino al %1$ld %%, il variabile vicino al %2$ld %% e almeno il %3$ld %% per il tuo futuro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "『Cima financiera』より：必需品は約 %1$ld %%、変動費は約 %2$ld %%、未来には最低 %3$ld %%。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "『Cima financiera』에서: 필수는 약 %1$ld %%, 변동은 약 %2$ld %%, 미래에는 최소 %3$ld %%."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Do livro Cima financiera: o essencial perto de %1$ld %%, o variável perto de %2$ld %% e pelo menos %3$ld %% para o seu futuro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Из книги Cima financiera: необходимое около %1$ld %%, переменные около %2$ld %% и не меньше %3$ld %% на будущее."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "出自《Cima financiera》：必需约 %1$ld %%，可变约 %2$ld %%，至少 %3$ld %% 留给未来。"
     }
    }
   }
  },
