     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "生年月を追加"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "생년월 추가"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicionar meu nascimento"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Добавить дату рождения"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "添加出生日期"
     }
    }
   }
  },
  "paso_nacimiento_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مع شهر وسنة ميلادك، يعرض «مساري» كل سنة عشتها والقادمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mit Geburtsmonat und -jahr zeigt Meine Route jedes gelebte und kommende Jahr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "With your birth month and year, My route shows every year lived and those to come."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con tu mes y año de nacimiento, Mi ruta te muestra cada año vivido y los que vienen."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Avec ton mois et ton année de naissance, Ma route montre chaque année vécue et celles à venir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जन्म का महीना और साल देने पर, मेरा मार्ग बीते और आने वाले हर साल को दिखाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con mese e anno di nascita, La mia rotta mostra ogni anno vissuto e quelli a venire."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "生まれた年月を入れると、マイルートに過ごした年とこれからの年が表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "태어난 연월을 입력하면 내 경로가 지나온 해와 다가올 해를 보여줘요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Com seu mês e ano de nascimento, Minha rota mostra cada ano vivido e os que virão."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Укажи месяц и год рождения — «Мой путь» покажет каждый прожитый и будущий год."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "填写出生年月后，“我的路线”会显示你走过和将来的每一年。"
     }
    }
   }
  },
