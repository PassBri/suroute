  "ejes_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عبور المراحل السبع × تفعيل المحاور الستة = قمّتك الشخصية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die 7 Phasen durchlaufen × die 6 Achsen aktivieren = dein persönlicher Gipfel."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Going through the 7 phases × activating the 6 axes = your Personal Summit."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Atravesar las 7 fases × activar los 6 ejes = tu Cumbre Personal."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Traverser les 7 phases × activer les 6 axes = ton Sommet Personnel."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "7 चरण पार करना × 6 अक्ष सक्रिय करना = आपकी निजी चोटी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attraversare le 7 fasi × attivare i 6 assi = la tua Vetta Personale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "7つのフェーズを歩む × 6つの軸を活性化する = あなたのパーソナル・サミット。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "7단계를 거치기 × 6개 축을 깨우기 = 나의 개인 정상."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Atravessar as 7 fases × ativar os 6 eixos = seu Cume Pessoal."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пройти 7 фаз × задействовать 6 осей = твоя Личная Вершина."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "走过 7 个阶段 × 激活 6 大维度 = 你的个人山巅。"
     }
    }
   }
  },
  "ejes_sin_evaluar": {
   "extractionState": "manual",
   "localizations": {
