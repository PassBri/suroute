  "bi_oms": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تتبع الأهداف توصيات منظمة الصحة العالمية للبالغين. إن كانت لديك حالة صحية فاتبع إرشادات طبيبك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Ziele folgen den WHO-Empfehlungen für Erwachsene. Bei gesundheitlichen Problemen folge dem Rat deiner Ärztin oder deines Arztes."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Targets follow WHO recommendations for adults. If you have a health condition, follow your doctor's advice."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las metas siguen las recomendaciones de la OMS para adultos. Si tienes una condición de salud, sigue lo que te indique tu médico."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les objectifs suivent les recommandations de l'OMS pour les adultes. Si tu as un problème de santé, suis l'avis de ton médecin."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य वयस्कों के लिए WHO सिफ़ारिशों पर आधारित हैं। कोई स्वास्थ्य समस्या हो तो अपने डॉक्टर की सलाह मानें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Gli obiettivi seguono le raccomandazioni dell'OMS per adulti. Se hai una condizione di salute, segui le indicazioni del tuo medico."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標は成人向けのWHO推奨に基づいています。持病がある場合は医師の指示に従ってください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표는 성인을 위한 WHO 권고를 따릅니다. 건강 문제가 있다면 의사의 지시를 따르세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "As metas seguem as recomendações da OMS para adultos. Se você tem uma condição de saúde, siga o que seu médico indicar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цели основаны на рекомендациях ВОЗ для взрослых. Если у тебя есть заболевание, следуй советам врача."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目标依据世卫组织对成年人的建议。如有健康问题，请遵循医生建议。"
     }
    }
   }
  },
