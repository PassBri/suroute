  "cord_marcado_meta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم تعليم اليوم! يُحتسب أيضًا في هدف الشهر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Tag abgehakt! Er zählt auch für dein Monatsziel."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Checked in! It also counts toward your monthly goal."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¡Día marcado! También cuenta en tu meta del mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Jour coché ! Il compte aussi pour ton objectif du mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दिन चिह्नित! यह महीने के लक्ष्य में भी गिना गया।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Giorno segnato! Conta anche per il tuo obiettivo del mese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "チェックしました！月の目標にも記録されました。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "체크 완료! 이달의 목표에도 반영됐어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Dia marcado! Também conta na sua meta do mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "День отмечен! Засчитано и в цель месяца."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "已打卡！也计入了你的本月目标。"
     }
    }
   }
  },
  "cord_meta_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عند تعليم يومك، يُحتسب أيضًا في هدف الشهر هذا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du deinen Tag abhakst, zählt er auch für dieses Monatsziel."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When you check in, it also counts toward this monthly goal."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al marcar tu día, también cuenta en esta meta del mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quand tu coches ton jour, il compte aussi pour cet objectif du mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दिन चिह्नित करने पर यह इस महीने के लक्ष्य में भी गिना जाएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando segni il tuo giorno, conta anche per questo obiettivo del mese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "日をチェックすると、この月の目標にも記録されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루를 체크하면 이 이달의 목표에도 반영돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ao marcar seu dia, também conta nesta meta do mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отметка дня засчитается и в эту цель месяца."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "打卡时，也会计入这个本月目标。"
     }
    }
   }
  },
  "cord_paso_1": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنشئ الفريق بتحدّيه ومدته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erstelle die Seilschaft mit Herausforderung und Dauer."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Create the team with its challenge and length."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Crea la cordada con su reto y su duración."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Crée la cordée avec son défi et sa durée."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चुनौती और अवधि के साथ टीम बनाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crea la cordata con la sfida e la durata."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "挑戦と期間を決めてパーティーを作る。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "도전과 기간을 정해 팀을 만드세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Crie a cordada com o desafio e a duração."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Создай связку с вызовом и сроком."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "创建结组，写好挑战和时长。"
     }
    }
   }
  },
  "cord_paso_2": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ادعُ بالرمز المكوّن من 6 أحرف (عبر واتساب مثلًا)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lade mit dem 6-stelligen Code ein (z. B. per WhatsApp)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Invite people with the 6-letter code (by WhatsApp, for example)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Invita con el código de 6 letras (por WhatsApp, por ejemplo)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Invite avec le code de 6 lettres (par WhatsApp, par exemple)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "6 अक्षरों के कोड से आमंत्रित करें (जैसे WhatsApp से)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Invita con il codice di 6 lettere (via WhatsApp, per esempio)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "6 文字のコードで招待する（WhatsApp などで）。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "6자리 코드로 초대하세요(예: WhatsApp)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Convide com o código de 6 letras (pelo WhatsApp, por exemplo)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пригласи по коду из 6 букв (например, в WhatsApp)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用 6 位邀请码邀请大家（例如通过 WhatsApp）。"
     }
    }
   }
  },
  "cord_paso_3": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "علّم يومك كلما أنجزت؛ يمكنك ربطه بهدف الشهر ليُحتسب هناك أيضًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hak deinen Tag ab, wenn du es schaffst; verknüpf ihn mit einem Monatsziel, damit er dort auch zählt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Check in each day you do it; link it to a monthly goal so it counts there too."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marca tu día cada vez que cumplas; puedes unirlo a una meta del mes para que cuente allá también."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Coche ton jour chaque fois que tu réussis ; relie-le à un objectif du mois pour qu’il compte aussi là."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर बार पूरा करने पर दिन चिह्नित करें; इसे महीने के लक्ष्य से जोड़ें ताकि वहाँ भी गिना जाए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Segna il tuo giorno ogni volta che ce la fai; collegalo a un obiettivo del mese perché conti anche lì."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "できた日はチェック。月の目標につなげれば、そちらにも記録されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "해낸 날마다 체크하세요. 이달의 목표에 연결하면 거기에도 반영돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Marque seu dia sempre que cumprir; você pode ligá-lo a uma meta do mês para contar lá também."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отмечай день, когда справился; свяжи с целью месяца, чтобы засчитывалось и там."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每次完成就打卡；可以关联本月目标，让它也计入那里。"
     }
    }
   }
  },
