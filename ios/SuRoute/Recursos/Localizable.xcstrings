  "esperanza_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "متوسط العمر المتوقع في بلدك نحو %1$ld عامًا. اختر إلى أي عمر يمتد طريقك (حتى 120)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Geschätzte Lebenserwartung in deinem Land: %1$ld Jahre. Wähle, bis zu welchem Alter dein Weg reicht (max. 120)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Estimated life expectancy in your country: %1$ld years. Choose how far your road goes (up to 120)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esperanza de vida estimada en tu país: %1$ld años. Elige hasta qué edad trazas tu camino (máximo 120)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Espérance de vie estimée dans ton pays : %1$ld ans. Choisis jusqu’à quel âge tracer ton chemin (120 max)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके देश में अनुमानित जीवन प्रत्याशा: %1$ld वर्ष। चुनें कि आपकी राह किस आयु तक जाए (अधिकतम 120)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aspettativa di vita stimata nel tuo paese: %1$ld anni. Scegli fino a che età tracciare il cammino (max 120)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの国の平均寿命はおよそ%1$ld歳。何歳までの道を描くか選びましょう（最大120）。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "우리나라 기대 수명은 약 %1$ld세예요. 몇 살까지의 길을 그릴지 고르세요 (최대 120)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Expectativa de vida estimada no seu país: %1$ld anos. Escolha até que idade traçar seu caminho (máximo 120)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ожидаемая продолжительность жизни в твоей стране: около %1$ld лет. Выбери, до какого возраста идёт твой путь (до 120)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你所在国家的预期寿命约 %1$ld 岁。选择你的道路规划到几岁（最多 120）。"
     }
    }
   }
  },
