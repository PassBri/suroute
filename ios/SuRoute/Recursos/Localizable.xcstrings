   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "طويل الأجل: لا يُحتسب في السيولة الجارية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Langfristig: zählt nicht zur Liquidität."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Long-term: not counted in the current ratio."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De largo plazo: no cuenta en la liquidez corriente."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "À long terme : ne compte pas dans la liquidité générale."
