  },
  "foco_sin_dias": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا أيام فيها تقدّم بعد هذا الشهر"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Tage mit Fortschritt diesen Monat"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No days with progress yet this month"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún sin días con avance este mes"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore de jours avec progrès ce mois-ci"
     }
    },
    "hi": {
     "stringUnit": {
