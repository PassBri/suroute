    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib deine Wünsche und Träume für dieses Jahr, einen pro Zeile. Mach dann Ziele daraus."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write your longings and dreams for that year, one per line. Then turn them into goals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escribe tus anhelos y sueños para ese año, uno por línea. Después conviértelos en metas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écris tes désirs et tes rêves pour cette année, un par ligne. Puis transforme-les en objectifs."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "उस साल की अपनी चाहतें और सपने लिखें, हर पंक्ति में एक। फिर उन्हें लक्ष्य बनाइए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrivi desideri e sogni per quell’anno, uno per riga. Poi trasformali in obiettivi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "その年の願いと夢を 1 行に 1 つ書きましょう。あとで目標に変えられます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "그해의 바람과 꿈을 한 줄에 하나씩 적으세요. 그다음 목표로 바꾸세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escreva seus anseios e sonhos para esse ano, um por linha. Depois transforme-os em metas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши желания и мечты на этот год, по одному в строке. Потом преврати их в цели."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "写下你对那一年的渴望和梦想，每行一个。然后把它们变成目标。"
     }
    }
   }
  },
  "vida_anhelos_ejemplo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "زيارة باتاغونيا\nافتتاح مدرستي"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Patagonien sehen\nMeine Schule eröffnen"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "See Patagonia\nOpen my school"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Conocer la Patagonia\nAbrir mi escuela"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Voir la Patagonie\nOuvrir mon école"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पैटागोनिया देखना\nअपना स्कूल खोलना"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Vedere la Patagonia\nAprire la mia scuola"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "パタゴニアへ行く\n自分の学校を開く"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "파타고니아 가기\n나의 학교 열기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Conhecer a Patagônia\nAbrir minha escola"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Увидеть Патагонию\nОткрыть свою школу"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "去巴塔哥尼亚\n开办我的学校"
     }
    }
   }
  },
