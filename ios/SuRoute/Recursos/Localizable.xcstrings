    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Открыть руководство"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "打开指南"
     }
    }
   }
  },
  "paso_guia_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "«اكتشف قمّتك الشخصية» يرشدك خطوة بخطوة. ويمكنك الاستماع إليه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "„Entdecke deinen persönlichen Gipfel“ führt dich Schritt für Schritt. Du kannst ihn auch anhören."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "“Discover your Personal Summit” guides you step by step. You can also listen to it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "«Descubre tu Cumbre Personal» te lleva paso a paso. También puedes escucharla."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "« Découvre ton Sommet Personnel » te guide pas à pas. Tu peux aussi l’écouter."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "“अपना निजी शिखर खोजें” आपको कदम-दर-कदम ले जाती है। इसे सुन भी सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "«Scopri la tua Vetta Personale» ti guida passo passo. Puoi anche ascoltarla."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「あなたの頂を見つける」が一歩ずつ導きます。音声でも聴けます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "‘나의 정상 발견하기’가 한 걸음씩 안내해요. 들을 수도 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "“Descubra seu Cume Pessoal” guia você passo a passo. Também dá para ouvir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "«Открой свою личную вершину» ведёт шаг за шагом. Её можно и послушать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "《发现你的个人巅峰》一步步带领你，也可以收听。"
     }
    }
   }
  },
