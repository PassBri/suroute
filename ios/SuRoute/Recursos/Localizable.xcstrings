     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今の空：太陽の高さ %1$ld°、月は %2$ld%% 輝いています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지금의 하늘: 해는 %1$ld°, 달은 %2$ld%% 밝아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O céu agora: o sol a %1$ld°, a lua %2$ld%% iluminada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Небо сейчас: Солнце на %1$ld°, Луна освещена на %2$ld %%."
