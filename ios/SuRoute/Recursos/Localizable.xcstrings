      "value": "봉인됨 · 열 수 있어요"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Selada · pronta para abrir"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запечатана · можно открыть"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "已封存 · 可以打开"
     }
    }
   }
  },
  "lb_llenando_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُختم في نهاية الشهر وتُفتح في %1$@. حتى ذلك الحين، تدخلها كل صورة وكل خطوة وكل يوم مثابرة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sie wird am Monatsende versiegelt und öffnet sich am %1$@. Bis dahin kommt jedes Foto, jeder Schritt und jeder Tag der Beständigkeit hinein."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It seals when the month ends and opens on %1$@. Meanwhile, every photo, every step and every consistent day goes in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se sella al terminar el mes y se abre el %1$@. Mientras tanto, cada foto, cada paso y cada día de constancia van entrando."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Elle se scelle à la fin du mois et s'ouvre le %1$@. En attendant, chaque photo, chaque pas et chaque jour de constance y entrent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "महीने के अंत में यह सील होगा और %1$@ को खुलेगा। तब तक हर फ़ोटो, हर कदम और लगातार हर दिन इसमें जुड़ता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Si sigilla alla fine del mese e si apre il %1$@. Nel frattempo vi entrano ogni foto, ogni passo e ogni giorno di costanza."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "月末に封印され、%1$@ に開きます。それまで、写真や一歩、続けた日がどんどん入ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "달이 끝나면 봉인되고 %1$@에 열려요. 그동안 모든 사진, 걸음, 꾸준한 날이 담겨요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ela se sela ao fim do mês e abre em %1$@. Enquanto isso, cada foto, cada passo e cada dia de constância vão entrando."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Она запечатывается в конце месяца и откроется %1$@. А пока в неё попадает каждое фото, каждый шаг и каждый день постоянства."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "月底封存，%1$@ 开启。在此之前，每张照片、每一步、每个坚持的日子都会放进来。"
     }
    }
   }
  },
  "lb_llenando_t": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كبسولتك لشهر %1$@ تمتلئ"
     }
    },
    "de": {
