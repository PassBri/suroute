  "red_avisos_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عندما يدعم أحد صعودك أو يعلّق عليه أو يبدأ بمتابعتك، ستراه هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn jemand deinen Aufstieg unterstützt, kommentiert oder dir folgt, siehst du es hier."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When someone boosts, comments on or follows your climb, you will see it here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando alguien impulse, comente o empiece a seguir tu ascenso, lo verás aquí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quand quelqu’un encourage, commente ou suit votre ascension, vous le verrez ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जब कोई आपकी चढ़ाई को बढ़ावा दे, टिप्पणी करे या आपको फ़ॉलो करे, तो वह यहाँ दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando qualcuno dà slancio, commenta o inizia a seguire la tua salita, lo vedrai qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "誰かがあなたの登山を応援、コメント、フォローすると、ここに表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "누군가 내 등반을 응원하거나 댓글을 달거나 팔로우하면 여기에 표시돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando alguém impulsionar, comentar ou começar a seguir sua subida, você verá aqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда кто-то поддержит, прокомментирует ваше восхождение или подпишется на вас, вы увидите это здесь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "有人为你的攀登助力、评论或开始关注你时，会显示在这里。"
     }
    }
   }
  },
