  "decision_acelerar_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الهدف عالي الإمكانات. زِد الموارد أو الوقت أو الجهد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Ziel hat großes Potenzial. Erhöhe Ressourcen, Zeit oder Einsatz."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The goal has high potential. Increase resources, time or effort."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La meta tiene alto potencial. Aumenta recursos, tiempo o esfuerzo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'objectif a un fort potentiel. Augmente les ressources, le temps ou l'effort."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य में बड़ी संभावना है। संसाधन, समय या मेहनत बढ़ाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'obiettivo ha un alto potenziale. Aumenta risorse, tempo o impegno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標の可能性は大きいです。リソース、時間、労力を増やしましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표의 잠재력이 커요. 자원, 시간, 노력을 늘리세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A meta tem alto potencial. Aumente recursos, tempo ou esforço."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "У цели большой потенциал. Добавь ресурсов, времени или усилий."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目标潜力很大。增加资源、时间或投入。"
     }
    }
   }
  },
