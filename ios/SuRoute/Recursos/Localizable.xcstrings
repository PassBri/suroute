      "state": "translated",
      "value": "आज का विचार खोलने के लिए चिह्न पर टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca il simbolo per aprire la frase di oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "シンボルをタップして今日の言葉を開きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "심볼을 탭해 오늘의 문장을 여세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque no símbolo para abrir a frase de hoje."
     }
    },
