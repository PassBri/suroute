    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Choose the level of the cascade. Everything you do below moves the levels above forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elige el nivel de la cascada. Todo lo que hagas abajo hará avanzar lo de arriba."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisis le niveau de la cascade. Tout ce que tu fais en bas fait avancer ce qui est en haut."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "झरने का स्तर चुनें। नीचे जो भी करेंगे वह ऊपर वाले को आगे बढ़ाएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scegli il livello della cascata. Tutto ciò che fai in basso fa avanzare ciò che sta in alto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "カスケードのレベルを選びましょう。下で積み重ねたことが、上の進捗になります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "폭포의 단계를 고르세요. 아래에서 하는 모든 일이 위의 목표를 앞으로 이끌어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolha o nível da cascata. Tudo o que você fizer embaixo faz avançar o que está em cima."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выбери уровень каскада. Всё, что ты делаешь внизу, продвигает то, что выше."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "选择瀑布的层级。你在下层做的每一件事，都会推动上层前进。"
     }
    }
   }
  },
