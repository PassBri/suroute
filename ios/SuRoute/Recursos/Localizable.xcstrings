  "fg_entrada_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تحدّث مع مجتمعك عن خطوة في صعودك. في النهاية، يأخذ كل شخص شيئًا لخطوته غدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sprich mit deiner Gemeinschaft über einen Schritt deines Aufstiegs. Am Ende nimmt jede Person etwas für ihren Schritt von morgen mit."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Talk with your community about a step in your climb. At the end, everyone takes something away for tomorrow's step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Habla con tu comunidad sobre un paso de tu ascenso. Al final, cada quien se lleva algo para su paso de mañana."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Parlez avec votre communauté d'une étape de votre ascension. À la fin, chacun emporte quelque chose pour son pas de demain."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी चढ़ाई के किसी कदम के बारे में अपने समुदाय से बात करें। अंत में हर कोई कल के कदम के लिए कुछ साथ ले जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parla con la tua comunità di un passo della tua salita. Alla fine, ognuno porta via qualcosa per il passo di domani."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "登山の一歩についてコミュニティと話しましょう。最後に、みんなが明日の一歩のために何かを持ち帰ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "등반의 한 걸음에 대해 커뮤니티와 이야기해 보세요. 마지막에는 모두가 내일의 한 걸음을 위해 무언가를 가져갑니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Converse com sua comunidade sobre um passo da sua subida. No final, cada pessoa leva algo para o passo de amanhã."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Поговорите с сообществом о шаге вашего восхождения. В конце каждый унесёт что-то для своего завтрашнего шага."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "和你的社区聊聊你攀登中的一步。最后，每个人都会为明天的一步带走一点东西。"
     }
    }
   }
  },
