      "value": "あなたのアカウントだけ"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 계정만"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Só a sua conta"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Только твой аккаунт"
     }
    },
