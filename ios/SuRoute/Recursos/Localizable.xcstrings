  "inicio_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تلقائي: المجتمع إذا كان لديك حساب وكتبت قمتك؛ وإلا فمساري. يُطبَّق في المرة القادمة التي تفتح فيها التطبيق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Automatisch: Community, wenn du ein Konto hast und deinen Gipfel geschrieben hast; sonst Meine Route. Gilt beim nächsten Öffnen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Automatic: Community if you have an account and have written your summit; otherwise, My route. Applies next time you open the app."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Automático: en Comunidad si tienes cuenta y ya escribiste tu cumbre; si no, en Mi ruta. Se aplica la próxima vez que abras la app."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Automatique : Communauté si vous avez un compte et avez écrit votre sommet ; sinon, Mon itinéraire. S’applique à la prochaine ouverture."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपने आप: अगर आपका खाता है और आपने अपना शिखर लिखा है तो समुदाय; नहीं तो मेरा रास्ता। अगली बार ऐप खोलने पर लागू होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Automatico: Comunità se hai un account e hai scritto la tua vetta; altrimenti La mia rotta. Vale dalla prossima apertura."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自動：アカウントがあり頂上を書いていればコミュニティ、そうでなければマイルート。次にアプリを開いたときから適用されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "자동: 계정이 있고 정상을 적었다면 커뮤니티, 아니면 나의 길로 엽니다. 다음에 앱을 열 때 적용됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Automático: em Comunidade se você tem conta e já escreveu seu cume; senão, em Minha rota. Vale na próxima vez que abrir o app."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Автоматически: «Сообщество», если у вас есть аккаунт и вы записали свою вершину; иначе «Мой маршрут». Применится при следующем запуске."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "自动：如果你有账号并已写下你的顶峰，进入社区；否则进入我的路线。下次打开应用时生效。"
     }
    }
   }
  },
