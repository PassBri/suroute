  "ruta_mapa_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المس سنة لعرضها؛ المسها مرة أخرى لفتحها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Tippe auf ein Jahr, um es zu sehen; tippe erneut, um es zu öffnen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tap a year to view it; tap it again to open it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca un año para verlo; tócalo otra vez para abrirlo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touche une année pour la voir ; touche-la encore pour l’ouvrir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "साल देखने के लिए छुएँ; खोलने के लिए फिर से छुएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca un anno per vederlo; toccalo di nuovo per aprirlo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "年をタップで表示、もう一度タップで開きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연도를 누르면 보이고, 한 번 더 누르면 열려요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque um ano para vê-lo; toque de novo para abri-lo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нажми на год, чтобы увидеть его; нажми ещё раз, чтобы открыть."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "点一下年份查看；再点一次打开。"
     }
    }
   }
  },
