  "contactos_telefono_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اعرف من في جهات اتصالك موجود بالفعل في SuRoute. الأرقام والبريد لا تغادر هاتفك: تُرسل بصمة مشفرة فقط للمقارنة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sieh, wer aus deinen Kontakten schon bei SuRoute ist. Nummern und E-Mails verlassen dein Handy nicht: Nur ein verschlüsselter Fingerabdruck wird zum Abgleich gesendet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "See who in your contacts is already on SuRoute. Numbers and emails never leave your phone: only an encrypted fingerprint is sent to compare."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Revisa quién de tu agenda ya está en SuRoute. Los números y correos no salen de tu teléfono: solo se envía una huella cifrada para compararla."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Voyez qui, dans votre répertoire, est déjà sur SuRoute. Les numéros et e-mails ne quittent pas votre téléphone : seule une empreinte chiffrée est envoyée pour comparer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "देखें कि आपके संपर्कों में से कौन पहले से SuRoute पर है। नंबर और ईमेल आपके फ़ोन से बाहर नहीं जाते: तुलना के लिए केवल एक एन्क्रिप्टेड फ़िंगरप्रिंट भेजा जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scopri chi della tua rubrica è già su SuRoute. Numeri ed e-mail non escono dal tuo telefono: si invia solo un'impronta cifrata per confrontarli."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "連絡先の中で、すでに SuRoute にいる人を確認できます。番号やメールはスマホの外に出ません。照合用の暗号化された指紋だけを送ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연락처 중 이미 SuRoute에 있는 사람을 확인하세요. 번호와 이메일은 휴대폰 밖으로 나가지 않고, 비교용 암호화 지문만 전송됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Veja quem da sua agenda já está no SuRoute. Números e e-mails não saem do seu celular: só é enviada uma impressão cifrada para comparar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Узнайте, кто из ваших контактов уже в SuRoute. Номера и почта не покидают телефон: для сравнения отправляется только зашифрованный отпечаток."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "看看通讯录里谁已经在 SuRoute。号码和邮箱不会离开你的手机：只发送加密指纹用于比对。"
     }
    }
   }
  },
