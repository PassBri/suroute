  "contactos_ninguno": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا أحد من جهات اتصالك في SuRoute بعد (أو لم يسمح بالعثور عليه)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Keiner deiner Kontakte ist schon bei SuRoute (oder hat das Finden nicht erlaubt)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "None of your contacts is on SuRoute yet (or hasn't allowed being found)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ninguno de tus contactos está todavía en SuRoute (o no activó que lo encuentren)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucun de vos contacts n'est encore sur SuRoute (ou n'a pas autorisé à être trouvé)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके संपर्कों में से अभी कोई SuRoute पर नहीं है (या उसने खोजे जाने की अनुमति नहीं दी)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessuno dei tuoi contatti è ancora su SuRoute (o non ha permesso di essere trovato)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "連絡先にはまだ SuRoute の利用者がいません（または検索を許可していません）。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연락처 중 아직 SuRoute에 있는 사람이 없습니다(또는 찾기를 허용하지 않았습니다)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nenhum dos seus contatos está no SuRoute ainda (ou não permitiu ser encontrado)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Никого из ваших контактов пока нет в SuRoute (или они не разрешили себя находить)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的联系人还没有人加入 SuRoute（或未允许被找到）。"
     }
    }
   }
  },
  "contactos_permiso": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا يوجد إذن لقراءة جهات الاتصال. يمكنك منحه من إعدادات الهاتف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Keine Berechtigung für deine Kontakte. Du kannst sie in den Handy-Einstellungen erteilen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No permission to read your contacts. You can grant it in your phone settings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sin permiso para leer tus contactos. Puedes darlo en los ajustes del teléfono."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas d'autorisation pour lire vos contacts. Vous pouvez l'accorder dans les réglages du téléphone."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "संपर्क पढ़ने की अनुमति नहीं है। आप इसे फ़ोन की सेटिंग में दे सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessun permesso per leggere i contatti. Puoi darlo nelle impostazioni del telefono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "連絡先を読む権限がありません。スマホの設定で許可できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연락처를 읽을 권한이 없습니다. 휴대폰 설정에서 허용할 수 있습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sem permissão para ler seus contatos. Você pode dá-la nos ajustes do celular."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нет доступа к контактам. Его можно дать в настройках телефона."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "没有读取联系人的权限。你可以在手机设置中开启。"
     }
    }
   }
  },
