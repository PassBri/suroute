  "frase_sellada_clave": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "افتح عبارة اليوم برمزك السري."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Öffne das Zitat des Tages mit deinem Code."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open today's quote with your passcode."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre la frase de hoy con tu clave."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ouvre la citation du jour avec ton code."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपने पासकोड से आज का विचार खोलें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Apri la frase di oggi con il tuo codice."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "パスコードで今日の言葉を開きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "비밀번호로 오늘의 문장을 여세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Abra a frase de hoje com sua senha."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Открой фразу дня своим кодом."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用密码打开今天的语录。"
     }
    }
   }
  },
  "frase_sellada_rostro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "افتح عبارة اليوم بوجهك أو ببصمتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Öffne das Zitat des Tages mit Gesicht oder Fingerabdruck."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open today's quote with your face or fingerprint."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre la frase de hoy con tu rostro o tu huella."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ouvre la citation du jour avec ton visage ou ton empreinte."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपने चेहरे या फ़िंगरप्रिंट से आज का विचार खोलें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Apri la frase di oggi con il volto o l’impronta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "顔または指紋で今日の言葉を開きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "얼굴이나 지문으로 오늘의 문장을 여세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Abra a frase de hoje com o rosto ou a digital."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Открой фразу дня лицом или отпечатком пальца."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用面孔或指纹打开今天的语录。"
     }
    }
   }
  },
  "frase_sellada_toque": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المس الرمز لفتح عبارة اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Tippe auf das Symbol, um das Zitat des Tages zu öffnen."
     }
    },
    "en": {
     "stringUnit": {
