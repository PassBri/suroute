     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "클라우드에서 삭제"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Apagar da nuvem"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Удалить из облака"
     }
    },
    "zh-Hans": {
