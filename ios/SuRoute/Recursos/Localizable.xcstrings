  "fin_feed_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الجبل باقٍ غدًا. الآن خُذ خطوتك لهذا اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Berg ist morgen noch da. Jetzt geh deinen eigenen Schritt für heute."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The mountain will still be there tomorrow. Now take your own step for today."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La montaña sigue ahí mañana. Ahora, da tu propio paso de hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La montagne sera encore là demain. Maintenant, fais ton propre pas du jour."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पहाड़ कल भी वहीं रहेगा। अब आज का अपना कदम उठाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La montagna sarà lì anche domani. Ora fai il tuo passo di oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "山は明日もそこにあります。さあ、今日のあなたの一歩を。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "산은 내일도 그 자리에 있어요. 이제 오늘의 한 걸음을 내디뎌요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A montanha continua lá amanhã. Agora, dê o seu passo de hoje."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Гора никуда не денется. А теперь сделайте свой шаг на сегодня."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "山明天依然在。现在，迈出你今天的一步。"
     }
    }
   }
  },
