    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que te inspirou vira algo que você faz."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "То, что вдохновило, становится тем, что вы делаете."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "激励你的东西会变成你去做的事。"
     }
    }
   }
  },
