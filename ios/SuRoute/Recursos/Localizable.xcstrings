    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सहेजा नहीं जा सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossibile salvare. Controlla la connessione e riprova."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "保存できませんでした。接続を確認してもう一度お試しください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "저장하지 못했어요. 연결을 확인하고 다시 시도해 주세요."
     }
    },
    "pt": {
