  "metas_mes_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل إنجاز كل هدف بالضغط على الأيام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Halte die Erfüllung jedes Ziels fest, indem du auf die Tage tippst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Track each goal by tapping the days."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Registra el cumplimiento de cada meta tocando los días."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Note l'avancement de chaque objectif en touchant les jours."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दिनों पर टैप करके हर लक्ष्य की पूर्ति दर्ज करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Registra il raggiungimento di ogni obiettivo toccando i giorni."
     }
    },
    "ja": {
     "stringUnit": {
