    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी का आकाश: सूर्य %1$ld° पर, चंद्रमा %2$ld%% प्रकाशित।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
