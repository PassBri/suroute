  "ex_pausa_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتب الآن خطوتك الأولى في البوصلة: هكذا تقرّبك كل قمة تراها من قمّتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib jetzt deinen ersten Schritt in den Kompass: So bringt dich jeder Gipfel, den du siehst, deinem näher."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Now write your first step in the Compass: that way every summit you see brings you closer to yours."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ahora escribe tu primer paso en la Brújula: así cada cima que veas te acerca a la tuya."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écrivez maintenant votre premier pas dans la Boussole : chaque sommet que vous voyez vous rapprochera du vôtre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अब अपने कम्पास में पहला कदम लिखें: ताकि हर शिखर जो आप देखें, आपको अपने शिखर के करीब ले जाए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ora scrivi il tuo primo passo nella Bussola: così ogni cima che vedi ti avvicina alla tua."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コンパスに最初の一歩を書きましょう。見る頂上のひとつひとつが、あなたの頂上に近づけてくれます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이제 나침반에 첫 걸음을 적어 보세요. 보는 정상마다 당신의 정상에 더 가까워집니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Agora escreva seu primeiro passo na Bússola: assim cada cume que você vê te aproxima do seu."
     }
    },
    "ru": {
