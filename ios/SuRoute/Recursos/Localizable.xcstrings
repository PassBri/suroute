  "cv_g10_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تحديات من 7 إلى 90 يومًا تضم حتى 6 أشخاص. إذا لم يسجّل أحدهم منذ 3 أيام، يلقي إليه رفاقه حبلًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Challenges von 7 bis 90 Tagen mit bis zu 6 Personen. Wenn jemand 3 Tage nichts abgehakt hat, werfen ihm die anderen ein Seil zu."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Challenges of 7 to 90 days with up to 6 people. If someone hasn't checked in for 3 days, their teammates throw them a rope."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Retos de 7 a 90 días con hasta 6 personas. Si alguien lleva 3 días sin marcar, sus compañeros le lanzan una cuerda."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Des défis de 7 à 90 jours, jusqu'à 6 personnes. Si quelqu'un n'a rien coché depuis 3 jours, ses coéquipiers lui lancent une corde."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "6 लोगों तक के साथ 7 से 90 दिनों की चुनौतियाँ। अगर कोई 3 दिनों से निशान नहीं लगाता, तो उसके साथी उसकी ओर रस्सी फेंकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sfide da 7 a 90 giorni con fino a 6 persone. Se qualcuno non segna da 3 giorni, i compagni gli lanciano una corda."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "6 人までで挑む 7〜90 日のチャレンジ。誰かが 3 日間チェックしていなければ、仲間がロープを投げます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최대 6명이 함께하는 7~90일 챌린지예요. 누군가 3일째 체크하지 않으면 동료들이 로프를 던져 줘요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Desafios de 7 a 90 dias com até 6 pessoas. Se alguém está há 3 dias sem marcar, os companheiros jogam uma corda."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Испытания от 7 до 90 дней, до 6 человек. Если кто-то не отмечается 3 дня, товарищи бросают ему верёвку."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "7 到 90 天的挑战，最多 6 人。如果有人 3 天没有打卡，队友就会向 TA 抛一根绳子。"
     }
    }
   }
  },
