  "pub_medios_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حتى 10 صور، أو فيديو حتى 60 ثانية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
