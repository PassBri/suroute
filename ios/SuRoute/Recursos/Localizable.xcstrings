  "fg_apagar_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيغادر الجميع وسيكتب كل شخص ما يأخذه لخطوته غدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Alle verlassen es, und jede Person schreibt, was sie für ihren Schritt von morgen mitnimmt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Everyone will leave and each person will write what they take away for tomorrow's step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todas las personas saldrán y cada una escribirá qué se lleva para su paso de mañana."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tout le monde partira et chacun écrira ce qu'il emporte pour son pas de demain."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सभी लोग बाहर हो जाएँगे और हर व्यक्ति लिखेगा कि वह कल के कदम के लिए क्या ले जा रहा है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tutti usciranno e ognuno scriverà cosa porta via per il passo di domani."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "全員が退出し、それぞれが明日の一歩のために持ち帰ることを書きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모두가 나가고, 각자 내일의 한 걸음을 위해 가져갈 것을 적습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Todas as pessoas sairão e cada uma escreverá o que leva para o passo de amanhã."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Все выйдут, и каждый напишет, что уносит для завтрашнего шага."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "所有人都会离开，每个人会写下为明天的一步带走了什么。"
     }
    }
   }
  },
