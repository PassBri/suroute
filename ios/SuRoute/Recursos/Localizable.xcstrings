  "cielo_evento_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. المس لمعرفة المزيد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. Tippe für mehr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. Tap to learn more."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. Toca para saber más."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. Touche pour en savoir plus."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@। अधिक जानने के लिए टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. Tocca per saperne di più."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@。タップして詳しく。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. 눌러서 자세히 보기."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. Toque para saber mais."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@. Нажмите, чтобы узнать больше."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@。点按了解更多。"
     }
    }
   }
  },
  "cielo_exp_conjuncion": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يظهر %1$@ و%2$@ متقاربين جدًا، بفارق %3$@° (أقل من إصبع والذراع ممدودة). إنه اصطفاف ظاهري: في الحقيقة تفصلهما ملايين الكيلومترات."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ und %2$@ stehen fast beieinander, %3$@° auseinander (weniger als ein Finger bei ausgestrecktem Arm). Das ist nur scheinbar: In Wirklichkeit liegen Millionen Kilometer dazwischen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ and %2$@ appear almost together, %3$@° apart (less than a finger at arm's length). It is an apparent alignment: in reality they are millions of kilometres apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ y %2$@ se ven casi juntos, a %3$@° (menos que un dedo con el brazo estirado). Es una alineación aparente: en realidad están a millones de kilómetros."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ et %2$@ semblent presque collés, à %3$@° (moins qu'un doigt à bout de bras). C'est un alignement apparent : en réalité, ils sont à des millions de kilomètres."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ और %2$@ लगभग साथ दिखते हैं, %3$@° की दूरी पर (हाथ फैलाने पर एक उंगली से भी कम)। यह केवल दिखावटी संरेखण है: असल में वे लाखों किलोमीटर दूर हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ e %2$@ appaiono quasi insieme, a %3$@° (meno di un dito a braccio teso). È un allineamento apparente: in realtà sono a milioni di chilometri."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@と%2$@がほとんど並んで見えます。離れているのは %3$@°（腕を伸ばした指一本より狭い）。見かけの並びで、実際は何百万キロも離れています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@와 %2$@가 거의 붙어 보여요. 간격은 %3$@°(팔을 뻗었을 때 손가락 하나보다 좁아요). 겉보기 정렬일 뿐, 실제로는 수백만 킬로미터 떨어져 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ e %2$@ aparecem quase juntos, a %3$@° (menos que um dedo com o braço esticado). É um alinhamento aparente: na verdade estão a milhões de quilômetros."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ и %2$@ видны почти рядом, в %3$@° друг от друга (меньше пальца на вытянутой руке). Это кажущееся сближение: на самом деле их разделяют миллионы километров."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@与%2$@看起来几乎挨在一起，相距 %3$@°（比伸直手臂时的一根手指还窄）。这只是视觉上的对齐：实际上它们相隔数百万公里。"
     }
    }
   }
  },
  "cielo_exp_equinoccio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعبر الشمس خط الاستواء السماوي: يتساوى اليوم الليل والنهار تقريبًا في كل الكوكب. في كولومبيا تمر الشمس ظهرًا فوق رأسك تقريبًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Sonne überquert den Himmelsäquator: Heute sind Tag und Nacht überall auf der Erde fast gleich lang. In Kolumbien steht die Sonne mittags fast genau über dir."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The Sun crosses the celestial equator: today day and night last almost the same everywhere on Earth. In Colombia, at midday, the Sun passes almost straight overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El sol cruza el ecuador del cielo: hoy el día y la noche duran casi lo mismo en todo el planeta. En Colombia, a mediodía, el sol pasa casi por encima de tu cabeza."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le Soleil traverse l'équateur céleste : aujourd'hui, le jour et la nuit durent presque autant partout sur la planète. En Colombie, à midi, le Soleil passe presque au-dessus de ta tête."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सूर्य खगोलीय विषुवत रेखा को पार करता है: आज पूरी पृथ्वी पर दिन और रात लगभग बराबर होते हैं। कोलंबिया में दोपहर को सूर्य लगभग सिर के ऊपर से गुजरता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il Sole attraversa l'equatore celeste: oggi il giorno e la notte durano quasi uguale in tutto il pianeta. In Colombia, a mezzogiorno, il Sole passa quasi sopra la tua testa."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "太陽が天の赤道を横切ります。今日は地球のどこでも昼と夜の長さがほぼ同じです。コロンビアでは正午に太陽がほぼ真上を通ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "해가 천구의 적도를 지나요. 오늘은 지구 어디서나 낮과 밤의 길이가 거의 같아요. 콜롬비아에서는 정오에 해가 거의 머리 위를 지나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O Sol cruza o equador celeste: hoje o dia e a noite duram quase o mesmo em todo o planeta. Na Colômbia, ao meio-dia, o Sol passa quase sobre a sua cabeça."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Солнце пересекает небесный экватор: сегодня день и ночь почти равны по всей планете. В Колумбии в полдень Солнце проходит почти над головой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "太阳穿过天赤道：今天全球昼夜几乎等长。在哥伦比亚，正午时太阳几乎从头顶经过。"
     }
    }
   }
  },
  "cielo_exp_lluvia": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعبر الأرض الغبار الذي خلّفه مذنّب: كل خط مضيء حبة تحترق عند دخولها الهواء. ابحث عن مكان مظلم وانظر نحو %1$@ بعد منتصف الليل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Erde durchquert den Staub, den ein Komet hinterlassen hat: Jede Spur ist ein Körnchen, das beim Eintritt in die Luft verglüht. Such dir einen dunklen Ort und schau nach Mitternacht in Richtung %1$@."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Earth crosses the dust a comet left behind: each streak is a grain burning up as it enters the air. Find a dark place and look toward %1$@ after midnight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La Tierra cruza el polvo que dejó un cometa: cada estela es un grano que arde al entrar al aire. Busca un lugar oscuro y mira hacia %1$@ después de medianoche."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La Terre traverse la poussière laissée par une comète : chaque traînée est un grain qui brûle en entrant dans l'air. Trouve un endroit sombre et regarde vers %1$@ après minuit."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पृथ्वी किसी धूमकेतु की छोड़ी धूल से गुजरती है: हर रेखा हवा में घुसते ही जलता एक कण है। किसी अंधेरी जगह पर आधी रात के बाद %1$@ की ओर देखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La Terra attraversa la polvere lasciata da una cometa: ogni scia è un granello che brucia entrando nell'aria. Cerca un luogo buio e guarda verso %1$@ dopo mezzanotte."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "地球が彗星の残したちりの中を通ります。流れ星の一筋一筋は、大気に入って燃えるちりの粒です。暗い場所で、真夜中すぎに%1$@の方角を見てみましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지구가 혜성이 남긴 먼지를 지나가요. 별똥별 하나하나는 공기에 들어오며 타는 먼지 알갱이예요. 어두운 곳에서 자정 이후 %1$@ 쪽을 바라보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A Terra atravessa a poeira deixada por um cometa: cada rastro é um grão que queima ao entrar no ar. Procure um lugar escuro e olhe para %1$@ depois da meia-noite."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Земля пересекает пыль, оставленную кометой: каждый след — это крупинка, сгорающая в воздухе. Найдите тёмное место и смотрите в сторону созвездия %1$@ после полуночи."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "地球穿过彗星留下的尘埃：每一道流光都是一粒进入大气后燃烧的尘埃。找个黑暗的地方，午夜后望向%1$@。"
     }
    }
   }
  },
  "cielo_exp_luna_parcial": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يقضم ظل الأرض جزءًا من القمر. يُرى بالعين المجردة دون مرشح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Erdschatten beißt ein Stück vom Mond ab. Mit bloßem Auge sichtbar, ohne Filter."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Earth's shadow takes a bite out of the Moon. You can watch it with the naked eye, no filter needed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La sombra de la Tierra muerde una parte de la luna. Se ve a simple vista, sin ningún filtro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'ombre de la Terre croque une partie de la Lune. Elle se voit à l'œil nu, sans filtre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पृथ्वी की छाया चंद्रमा का एक हिस्सा ढक लेती है। इसे नंगी आँखों से देख सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'ombra della Terra morde una parte della Luna. Si vede a occhio nudo, senza filtri."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "地球の影が月の一部を欠けさせます。フィルターなしの肉眼で見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지구 그림자가 달의 일부를 가려요. 필터 없이 맨눈으로 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A sombra da Terra morde uma parte da Lua. Dá para ver a olho nu, sem filtro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Тень Земли откусывает часть Луны. Смотреть можно невооружённым глазом, без фильтров."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "地球的影子咬掉了月亮的一部分。肉眼即可观看，无需滤镜。"
     }
    }
   }
  },
  "cielo_exp_luna_penumbral": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يمر القمر في شبه ظل الأرض فيخفت قليلًا. الأمر خفيف: تأمله بهدوء وقارنه بليالٍ أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Mond durchquert den Halbschatten der Erde und wird nur leicht dunkler. Es ist subtil: Schau in Ruhe hin und vergleiche mit anderen Nächten."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The Moon passes through Earth's faint outer shadow and dims only slightly. It is subtle: look calmly and compare it with other nights."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La luna pasa por la penumbra de la Tierra y se oscurece apenas. Es sutil: mírala con calma y compárala con otras noches."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La Lune traverse la pénombre de la Terre et s'assombrit à peine. C'est subtil : regarde-la calmement et compare avec d'autres nuits."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चंद्रमा पृथ्वी की उपच्छाया से गुजरता है और थोड़ा-सा मंद होता है। यह सूक्ष्म है: शांति से देखें और दूसरी रातों से तुलना करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La Luna attraversa la penombra della Terra e si scurisce appena. È sottile: guardala con calma e confrontala con altre notti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "月が地球の半影を通り、わずかに暗くなります。かすかな変化なので、ゆっくり眺めて他の夜と比べてみましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "달이 지구의 반그림자를 지나며 아주 조금 어두워져요. 미묘하니 천천히 보며 다른 밤과 비교해 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A Lua passa pela penumbra da Terra e escurece só um pouco. É sutil: olhe com calma e compare com outras noites."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Луна проходит через полутень Земли и лишь слегка тускнеет. Это едва заметно: смотрите спокойно и сравните с другими ночами."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "月亮穿过地球的半影，只是稍微变暗。变化很细微：静静观看，并和其他夜晚比较。"
     }
    }
   }
  },
  "cielo_exp_luna_total": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تمر الأرض بين الشمس والقمر وتغطيه بظلها فيصير القمر نحاسي اللون. يُرى بالعين المجردة دون أي مرشح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Erde schiebt sich zwischen Sonne und Mond und bedeckt ihn mit ihrem Schatten: Der Mond wird kupferrot. Mit bloßem Auge sichtbar, ohne Filter."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Earth moves between the Sun and the Moon and covers it with its shadow: the Moon turns copper. You can watch it with the naked eye, no filter needed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La Tierra se pone entre el sol y la luna y la cubre con su sombra: la luna se vuelve color cobre. Se ve a simple vista, sin ningún filtro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La Terre se place entre le Soleil et la Lune et la couvre de son ombre : la Lune devient cuivrée. Elle se voit à l'œil nu, sans filtre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पृथ्वी सूर्य और चंद्रमा के बीच आकर उसे अपनी छाया से ढक लेती है: चंद्रमा तांबे जैसा हो जाता है। इसे बिना किसी फ़िल्टर के नंगी आँखों से देख सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La Terra si mette tra il Sole e la Luna e la copre con la sua ombra: la Luna diventa color rame. Si vede a occhio nudo, senza filtri."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "地球が太陽と月の間に入り、影で月を覆います。月は銅色に染まります。フィルターなしの肉眼で見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지구가 해와 달 사이에 들어가 그림자로 달을 덮어요. 달이 구릿빛으로 변해요. 필터 없이 맨눈으로 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A Terra se põe entre o Sol e a Lua e a cobre com sua sombra: a Lua fica cor de cobre. Dá para ver a olho nu, sem filtro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Земля встаёт между Солнцем и Луной и накрывает её своей тенью: Луна становится медной. Смотреть можно невооружённым глазом, без фильтров."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "地球运行到太阳和月亮之间，用影子遮住月亮：月亮变成铜红色。肉眼即可观看，无需任何滤镜。"
     }
    }
   }
  },
  "cielo_exp_sol": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يمر القمر أمام الشمس ويحجب من كولومبيا %1$ld%% منها. لا تنظر إليها مباشرة أبدًا: استخدم نظارات كسوف معتمدة (ISO 12312-2) أو اعرضها عبر ثقب في ورق مقوى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Mond schiebt sich vor die Sonne und verdeckt von Kolumbien aus %1$ld %% davon. Schau nie direkt hin: Nutze zertifizierte Eclipse-Brillen (ISO 12312-2) oder projiziere sie durch ein Loch in einem Karton."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The Moon passes in front of the Sun and, from Colombia, covers %1$ld%% of it. Never look at it directly: use certified eclipse glasses (ISO 12312-2) or project it through a pinhole in cardboard."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La luna pasa delante del sol y desde Colombia tapa el %1$ld %%. Nunca lo mires directo: usa gafas de eclipse certificadas (ISO 12312-2) o proyéctalo con un cartón perforado."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La Lune passe devant le Soleil et, depuis la Colombie, en cache %1$ld %%. Ne le regarde jamais directement : utilise des lunettes d'éclipse certifiées (ISO 12312-2) ou projette-le à travers un carton percé."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चंद्रमा सूर्य के सामने से गुजरता है और कोलंबिया से उसका %1$ld%% ढक लेता है। इसे कभी सीधे न देखें: प्रमाणित ग्रहण चश्मा (ISO 12312-2) पहनें या छेद वाले गत्ते से उसकी छवि बनाएं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La Luna passa davanti al Sole e, dalla Colombia, ne copre il %1$ld%%. Non guardarlo mai direttamente: usa occhiali per eclissi certificati (ISO 12312-2) o proiettalo con un cartoncino forato."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "月が太陽の前を通り、コロンビアからは太陽の %1$ld%% を隠します。絶対に直接見ないでください。認証済みの日食グラス（ISO 12312-2）を使うか、穴をあけた厚紙で投影して見ましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "달이 해 앞을 지나며 콜롬비아에서는 해의 %1$ld%%를 가려요. 절대 직접 보지 마세요. 인증된 일식 안경(ISO 12312-2)을 쓰거나 구멍 뚫은 판지로 투영해 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A Lua passa na frente do Sol e, da Colômbia, cobre %1$ld%% dele. Nunca olhe diretamente: use óculos de eclipse certificados (ISO 12312-2) ou projete-o com um papelão furado."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Луна проходит перед Солнцем и из Колумбии закрывает %1$ld %% его диска. Никогда не смотрите прямо: используйте сертифицированные очки для затмений (ISO 12312-2) или проецируйте через отверстие в картоне."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "月亮从太阳前方经过，在哥伦比亚可遮住太阳的 %1$ld%%。切勿直视：请使用认证的日食眼镜（ISO 12312-2），或用带小孔的纸板投影观看。"
     }
    }
   }
  },
  "cielo_exp_solsticio_diciembre": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تبلغ الشمس أقصى نقطة لها جنوبًا في السنة. في كولومبيا يشير ظلك ظهرًا نحو الشمال."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Sonne erreicht ihren südlichsten Punkt des Jahres. In Kolumbien zeigt dein Schatten mittags nach Norden."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The Sun reaches its southernmost point of the year. In Colombia, at midday, your shadow points north."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El sol llega a su punto más al sur del año. En Colombia, a mediodía, tu sombra apunta hacia el norte."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le Soleil atteint son point le plus au sud de l'année. En Colombie, à midi, ton ombre pointe vers le nord."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सूर्य साल के अपने सबसे दक्षिणी बिंदु पर पहुँचता है। कोलंबिया में दोपहर को आपकी छाया उत्तर की ओर होती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il Sole raggiunge il suo punto più a sud dell'anno. In Colombia, a mezzogiorno, la tua ombra punta verso nord."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "太陽が一年で最も南に来ます。コロンビアでは正午にあなたの影が北を向きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "해가 한 해 중 가장 남쪽에 와요. 콜롬비아에서는 정오에 그림자가 북쪽을 가리켜요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O Sol chega ao seu ponto mais ao sul do ano. Na Colômbia, ao meio-dia, sua sombra aponta para o norte."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Солнце достигает самой южной точки года. В Колумбии в полдень ваша тень указывает на север."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "太阳到达一年中最南的位置。在哥伦比亚，正午时你的影子指向北方。"
     }
    }
   }
  },
  "cielo_exp_solsticio_junio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تبلغ الشمس أقصى نقطة لها شمالًا في السنة. في كولومبيا يشير ظلك ظهرًا نحو الجنوب."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Sonne erreicht ihren nördlichsten Punkt des Jahres. In Kolumbien zeigt dein Schatten mittags nach Süden."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The Sun reaches its northernmost point of the year. In Colombia, at midday, your shadow points south."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El sol llega a su punto más al norte del año. En Colombia, a mediodía, tu sombra apunta hacia el sur."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le Soleil atteint son point le plus au nord de l'année. En Colombie, à midi, ton ombre pointe vers le sud."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सूर्य साल के अपने सबसे उत्तरी बिंदु पर पहुँचता है। कोलंबिया में दोपहर को आपकी छाया दक्षिण की ओर होती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il Sole raggiunge il suo punto più a nord dell'anno. In Colombia, a mezzogiorno, la tua ombra punta verso sud."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "太陽が一年で最も北に来ます。コロンビアでは正午にあなたの影が南を向きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "해가 한 해 중 가장 북쪽에 와요. 콜롬비아에서는 정오에 그림자가 남쪽을 가리켜요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O Sol chega ao seu ponto mais ao norte do ano. Na Colômbia, ao meio-dia, sua sombra aponta para o sul."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Солнце достигает самой северной точки года. В Колумбии в полдень ваша тень указывает на юг."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "太阳到达一年中最北的位置。在哥伦比亚，正午时你的影子指向南方。"
     }
    }
   }
  },
  "cielo_exp_superluna": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يتزامن البدر مع أقرب نقطة له من الأرض (%1$@ كم): يبدو أكبر وأكثر سطوعًا قليلًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Vollmond fällt mit seinem erdnächsten Punkt zusammen (%1$@ km): Er wirkt etwas größer und heller."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The full Moon coincides with its closest approach to Earth (%1$@ km): it looks a little bigger and brighter."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La luna llena coincide con su paso más cercano a la Tierra (%1$@ km): se ve un poco más grande y más brillante."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La pleine Lune coïncide avec son passage au plus près de la Terre (%1$@ km) : elle paraît un peu plus grande et plus brillante."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पूर्णिमा का चंद्रमा पृथ्वी के सबसे निकट (%1$@ किमी) होता है: थोड़ा बड़ा और ज़्यादा चमकीला दिखता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La Luna piena coincide con il suo passaggio più vicino alla Terra (%1$@ km): appare un po' più grande e luminosa."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "満月が地球に最も近づく時期と重なります（%1$@ km）。少し大きく、明るく見えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "보름달이 지구와 가장 가까워지는 때와 겹쳐요(%1$@ km). 조금 더 크고 밝아 보여요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A lua cheia coincide com sua passagem mais próxima da Terra (%1$@ km): parece um pouco maior e mais brilhante."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Полнолуние совпадает с наибольшим сближением Луны с Землёй (%1$@ км): она выглядит чуть крупнее и ярче."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "满月恰逢月亮离地球最近之时（%1$@ 公里）：看起来更大、更亮一些。"
     }
    }
   }
  },
