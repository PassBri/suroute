  "acerca_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · طريق أهدافك طويلة المدى والسنوية والشهرية واليومية، مبني على منهج «الطريق إلى القمة»."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Dein Weg mit langfristigen, Jahres-, Monats- und Tageszielen, basierend auf der Methode Ruta a la Cima."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Your route for long-term, yearly, monthly and daily goals, based on the Route to the Summit method."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Tu ruta de metas a largo plazo, anuales, mensuales y diarias, basada en el método Ruta a la Cima."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Ta route d’objectifs à long terme, annuels, mensuels et quotidiens, basée sur la méthode Ruta a la Cima."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · दीर्घकालिक, सालाना, मासिक और दैनिक लक्ष्यों की आपकी राह, जो Ruta a la Cima पद्धति पर आधारित है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Il tuo percorso di obiettivi a lungo termine, annuali, mensili e giornalieri, basato sul metodo Ruta a la Cima."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Ruta a la Cimaメソッドにもとづく、長期・年間・月間・毎日の目標ルート。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · 장기, 연간, 월간, 일간 목표로 이어지는 나만의 길. Ruta a la Cima 방법론을 기반으로 해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Sua rota de metas de longo prazo, anuais, mensais e diárias, baseada no método Ruta a la Cima."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · Твой маршрут долгосрочных, годовых, месячных и ежедневных целей по методу «Путь к вершине»."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute %1$@ · 基于「Ruta a la Cima」方法，为你规划长期、年度、月度和每日的目标之路。"
     }
    }
   }
  },
