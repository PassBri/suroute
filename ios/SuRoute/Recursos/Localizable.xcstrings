  "eje_vol_pregunta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هل لديّ وضوح تام بشأن ما يحرّكني من الأعماق؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Habe ich absolute Klarheit darüber, was mich im Innersten antreibt?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Am I absolutely clear about what moves me deeply?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Tengo claridad absoluta sobre lo que me mueve profundamente?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Suis-je absolument clair sur ce qui me meut profondément ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "क्या मुझे बिल्कुल साफ़ पता है कि मुझे भीतर से क्या प्रेरित करता है?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ho una chiarezza assoluta su ciò che mi muove nel profondo?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自分を深く動かすものが、はっきりわかっていますか?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나를 깊이 움직이는 것이 무엇인지 분명히 알고 있나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenho clareza absoluta sobre o que me move profundamente?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Есть ли у меня полная ясность в том, что меня глубоко движет?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我是否完全清楚是什么在深深地驱动我？"
     }
    }
   }
  },
