  "fase_5_diag": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حققت هدفًا مهمًا: أنا على القمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich habe ein wichtiges Ziel erreicht: Ich stehe auf dem Gipfel."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I've reached an important goal: I'm at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "He alcanzado una meta importante: estoy en la cima."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "J'ai atteint un objectif important : je suis au sommet."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैंने एक बड़ा लक्ष्य हासिल कर लिया है: मैं शिखर पर हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ho raggiunto un obiettivo importante: sono in vetta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "大きな目標を達成した。今、山頂にいる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "중요한 목표를 이뤘어요. 지금 정상에 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Alcancei uma meta importante: estou no cume."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я достиг(ла) важной цели: я на вершине."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我已经实现了一个重要目标：我站在山顶了。"
     }
    }
   }
  },
