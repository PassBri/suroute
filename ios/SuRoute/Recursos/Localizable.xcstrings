  "siempre_en_tu_diario": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يبقى دائمًا في مذكرات حياتك، حتى لو كان خاصًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es bleibt immer in deinem Lebenstagebuch, auch wenn es privat ist."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It always stays in your life journal, even if it's private."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siempre queda en tu diario de vida, aunque sea privada."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Elle reste toujours dans ton journal de vie, même si elle est privée."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह निजी होने पर भी हमेशा आपकी जीवन-डायरी में रहता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Resta sempre nel tuo diario di vita, anche se è privato."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "非公開でも、あなたの人生の記録にはいつも残ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "비공개로 해도 항상 나의 인생 일기에 남아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sempre fica no seu diário de vida, mesmo que seja privada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запись всегда остаётся в твоём дневнике жизни, даже если она приватная."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "即使设为私密，它也会一直保存在你的人生日记里。"
     }
    }
   }
  },
