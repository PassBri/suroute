  "etapa_finanzas_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سبعة أدلة لإدارة أموالك جيدًا، من الأساس إلى الصعود"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sieben Leitfäden für gutes Geldmanagement, von den Grundlagen bis zum Aufstieg"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seven guides to manage your money well, from the basics to the ascent"
