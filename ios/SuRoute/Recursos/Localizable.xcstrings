  "web_error_sincronizar": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعذّرت المزامنة. تحقّق من اتصالك؛ ستُعاد المحاولة تلقائيًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Synchronisierung fehlgeschlagen. Prüfe deine Verbindung; es wird automatisch erneut versucht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Couldn’t sync. Check your connection; it will try again on its own."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo sincronizar. Revisa tu conexión; se volverá a intentar solo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Synchronisation impossible. Vérifie ta connexion ; une nouvelle tentative se fera automatiquement."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सिंक नहीं हो सका। अपना कनेक्शन जाँचें; यह अपने आप फिर कोशिश करेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sincronizzazione non riuscita. Controlla la connessione; riproverà da solo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "同期できませんでした。接続を確認してください。自動でもう一度試します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "동기화하지 못했어요. 연결을 확인하세요. 자동으로 다시 시도해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não foi possível sincronizar. Verifique sua conexão; vai tentar de novo sozinho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не удалось синхронизировать. Проверь подключение; попытка повторится сама."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "同步失败。请检查网络连接，稍后会自动重试。"
     }
    }
   }
  },
  "web_error_vincular": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعذّر الربط. تنتهي صلاحية الرمز بعد 5 دقائق: أنشئ رمزًا جديدًا في الويب وحاول مرة أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Verknüpfen fehlgeschlagen. Der Code läuft nach 5 Minuten ab: Erzeuge im Web einen neuen und versuche es erneut."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Couldn’t link. Codes expire after 5 minutes: get a new one on the web and try again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo vincular. El código vence a los 5 minutos: genera uno nuevo en la web y vuelve a intentarlo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Association impossible. Le code expire au bout de 5 minutes : génère-en un nouveau sur le web et réessaie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लिंक नहीं हो सका। कोड 5 मिनट में समाप्त हो जाता है: वेब पर नया कोड बनाएँ और फिर से कोशिश करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossibile collegare. Il codice scade dopo 5 minuti: generane uno nuovo sul web e riprova."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "リンクできませんでした。コードの有効期限は5分です。Web で新しいコードを出して、もう一度お試しください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연결하지 못했어요. 코드는 5분 후 만료돼요. 웹에서 새 코드를 만들고 다시 시도하세요."
     }
    },
    "pt": {
     "stringUnit": {
