  "fo_nadie": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم يضف أحد حطبًا هذه المرة. ادعُ فريقك في المرة القادمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Diesmal hat niemand Holz nachgelegt. Lade beim nächsten Mal deine Seilschaft ein."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No one added wood this time. Next time, invite your rope team."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esta vez nadie le echó leña. La próxima, invita a tu cordada."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Personne n'a ajouté de bois cette fois. La prochaine fois, invitez votre cordée."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस बार किसी ने लकड़ी नहीं डाली। अगली बार अपनी टोली को बुलाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questa volta nessuno ha aggiunto legna. La prossima, invita la tua cordata."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今回は誰も薪をくべませんでした。次はザイルパーティを誘いましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번엔 아무도 장작을 넣지 않았어요. 다음엔 로프 팀을 초대해 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Desta vez ninguém pôs lenha. Na próxima, convide sua cordada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В этот раз никто не подбросил дров. В следующий раз позовите свою связку."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这次没人添柴。下次邀请你的绳队吧。"
     }
    }
   }
  },
