  "bi_causa": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ما الذي سببه؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was hat es ausgelöst?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What triggered it?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Qué lo provocó?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Qu'est-ce qui l'a provoqué ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इसकी वजह क्या थी?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cosa l'ha provocato?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "きっかけは？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "무엇 때문인가요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que provocou?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Что это вызвало?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "是什么引起的？"
     }
    }
   }
  },
  "bi_causas_mal": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أكثر ما يجلب العاصفة أو الضباب: %1$@. معرفة ذلك تساعدك على الاستعداد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was am meisten Gewitter oder Nebel bringt: %1$@. Das zu wissen hilft dir, dich vorzubereiten."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What most brings storm or fog: %1$@. Knowing it helps you prepare."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que más te trae tormenta o niebla: %1$@. Saberlo te permite prepararte."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce qui amène le plus l'orage ou le brouillard : %1$@. Le savoir aide à te préparer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सबसे ज़्यादा तूफ़ान या कोहरा लाने वाली बातें: %1$@। यह जानकर आप तैयारी कर सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ciò che più porta tempesta o nebbia: %1$@. Saperlo ti aiuta a prepararti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "嵐や霧をいちばん呼ぶもの：%1$@。知っておけば備えられます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "폭풍이나 안개를 가장 많이 부르는 것: %1$@. 알면 미리 대비할 수 있습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que mais traz tempestade ou neblina: %1$@. Saber isso ajuda a se preparar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Чаще всего грозу или туман приносит: %1$@. Зная это, легче подготовиться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "最常带来暴风雨或迷雾的：%1$@。了解它能帮你提前准备。"
     }
    }
   }
  },
