  "cu_pagar_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عليك اليوم %1$@. يُسجَّل الدفع في دفتر اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Heute geschuldet: %1$@. Die Zahlung wird im heutigen Kassenbuch erfasst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You owe %1$@ today. The payment is recorded in today’s ledger."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Debes hoy %1$@. El pago se anota en tu libro de cuentas de hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu dois %1$@ aujourd’hui. Le paiement est noté dans le livre du jour."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज बकाया %1$@। भुगतान आज के खाते में दर्ज होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Oggi devi %1$@. Il pagamento viene annotato nel libro di oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "現在の借金は %1$@。支払いは今日の帳簿に記録されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "현재 빚 %1$@. 상환은 오늘 장부에 기록돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você deve hoje %1$@. O pagamento é anotado no livro de hoje."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сейчас долг %1$@. Платёж запишется в сегодняшнюю книгу."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "今日欠款 %1$@。还款会记入今天的账本。"
     }
    }
   }
  },
