  "usuario_correo_aviso": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يشبه الآن بريدك الإلكتروني وسيراه المجتمع كله."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Er sieht gerade wie deine E-Mail aus und die ganze Community würde ihn sehen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Right now it looks like your email, and the whole community would see it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ahora se parece a tu correo y toda la comunidad lo vería."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il ressemble à votre e-mail et toute la communauté le verrait."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी यह आपके ईमेल जैसा दिखता है और पूरा समुदाय इसे देख सकता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ora somiglia alla tua e-mail e tutta la comunità la vedrebbe."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今はメールアドレスに似ていて、コミュニティ全体に見えてしまいます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지금은 이메일과 비슷해서 커뮤니티 전체에 보입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Agora ele parece seu e-mail e toda a comunidade o veria."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сейчас он похож на вашу почту, и её увидит всё сообщество."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "它现在像你的邮箱，整个社区都会看到。"
     }
    }
   }
  },
