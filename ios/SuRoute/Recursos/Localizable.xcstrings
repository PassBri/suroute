  "ex_pausa_hecho_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تابع المشاهدة بهدوء. الجبل باقٍ غدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schau in Ruhe weiter. Der Berg ist morgen noch da."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep browsing calmly. The mountain will still be there tomorrow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue mirando con calma. La montaña sigue ahí mañana."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Continuez à regarder calmement. La montagne sera encore là demain."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आराम से देखते रहें। पहाड़ कल भी वहीं रहेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a guardare con calma. La montagna sarà lì anche domani."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "落ち着いて見続けましょう。山は明日もそこにあります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "천천히 계속 보세요. 산은 내일도 그 자리에 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue olhando com calma. A montanha continua aí amanhã."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Смотрите дальше спокойно. Гора будет на месте и завтра."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "放松地继续看吧。山明天还在。"
     }
    }
   }
  },
  "ex_pausa_hecho_t": {
   "extractionState": "manual",
