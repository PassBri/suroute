     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたのパーソナル・サミットを一言で(あとで書いてもOK):"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나의 개인 정상을 한 문장으로 (나중에 써도 돼요):"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
