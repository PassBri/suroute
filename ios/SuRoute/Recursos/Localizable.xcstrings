    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "私は……大切にしているのは……私を動かすのは……"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나는… 내가 소중히 여기는 것은… 나를 움직이는 것은…"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Eu sou… Valorizo… Me move…"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я… Я ценю… Меня движет…"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我是……我看重……推动我的是……"
     }
    }
   }
  },
  "mv_quien_soy_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عرّف بنفسك في بضعة أسطر: من أنت اليوم، وما الذي تقدّره، وما الذي يحرّكك. المس للكتابة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Beschreibe dich in wenigen Zeilen: wer du heute bist, was dir wichtig ist und was dich antreibt. Tippe zum Schreiben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Describe yourself in a few lines: who you are today, what you value and what drives you. Tap to write."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuéntate en pocas líneas: quién eres hoy, qué valoras y qué te mueve. Toca para escribir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Décris-toi en quelques lignes : qui tu es aujourd'hui, ce qui compte pour toi et ce qui te fait avancer. Touche pour écrire."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कुछ पंक्तियों में बताइए: आज आप कौन हैं, आप किसे महत्व देते हैं और आपको क्या प्रेरित करता है। लिखने के लिए छुएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Raccontati in poche righe: chi sei oggi, cosa conta per te e cosa ti muove. Tocca per scrivere."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今のあなたは誰か、何を大切にし、何に突き動かされているかを数行で書きましょう。タップして入力。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지금의 나는 누구인지, 무엇을 소중히 여기고 무엇이 나를 움직이는지 몇 줄로 적어 보세요. 탭해서 쓰기."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Conte em poucas linhas quem você é hoje, o que valoriza e o que te move. Toque para escrever."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Расскажите о себе в нескольких строках: кто вы сегодня, что цените и что вас движет. Нажмите, чтобы написать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用几句话介绍自己：今天的你是谁，你看重什么，是什么在推动你。点按即可书写。"
     }
    }
   }
  },
