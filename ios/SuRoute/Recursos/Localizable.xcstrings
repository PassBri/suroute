  "frases_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم تفتح أي عبارة هذا العام بعد. ستنتظرك عبارة جديدة غدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast dieses Jahr noch kein Zitat geöffnet. Morgen wartet ein neues auf dich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You haven't opened any quotes this year yet. Another one awaits you tomorrow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no has abierto ninguna frase este año. Mañana te espera otra."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu n'as encore ouvert aucune citation cette année. Une autre t'attend demain."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस साल आपने अभी तक कोई विचार नहीं खोला है। कल एक और विचार आपका इंतज़ार करेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quest'anno non hai ancora aperto nessuna frase. Domani ne troverai un'altra."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今年はまだ言葉を開いていません。明日、また新しい言葉が待っています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "올해는 아직 연 문장이 없어요. 내일 또 다른 문장이 기다리고 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ainda não abriu nenhuma frase este ano. Amanhã outra espera por você."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В этом году ты ещё не открыл(а) ни одной фразы. Завтра тебя ждёт новая."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "今年你还没有打开任何语录。明天还有新的等着你。"
     }
    }
   }
  },
