     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप अकेले नहीं चढ़ते"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non sali da solo"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "一人で登らない"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "혼자 오르지 않아요"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você não sobe sozinho"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты не поднимаешься один"
     }
    },
