  "cp_paralela_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لكلٍّ منكما جبله، لكنكما تتشاركان الوادي. مثالي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder hat seinen Berg, aber ihr teilt das Tal. Ideal."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each of you has your own mountain, but you share the valley. Ideal."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada uno tiene su montaña, pero comparten el valle. Ideal."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chacun a sa montagne, mais vous partagez la vallée. Idéal."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर किसी का अपना पर्वत है, पर घाटी साझा है। आदर्श।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ognuno ha la sua montagna, ma condividete la valle. Ideale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "それぞれに自分の山があり、谷は共有している。理想的。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "각자 자기 산이 있지만 계곡은 함께 나눠요. 이상적이에요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada um tem sua montanha, mas vocês compartilham o vale. Ideal."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "У каждого своя гора, но долина у вас общая. Идеально."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "各有各的山，但共享同一片山谷。理想。"
     }
    }
   }
  },
