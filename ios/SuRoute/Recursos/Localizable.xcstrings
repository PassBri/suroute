  "modelo_tiempo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هناك بوصلة عامة لحياتك كلها وبوصلة لكل عام، من العام التالي لميلادك حتى هدف حياتك. اختر العام لترى قمته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es gibt einen allgemeinen Kompass für dein ganzes Leben und einen für jedes Jahr, vom Jahr nach deiner Geburt bis zu deinem Lebensziel. Wähle ein Jahr, um seinen Gipfel zu sehen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "There is a General Compass for your whole life and one for each year, from the year after your birth to your life goal. Choose a year to see that year's summit."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hay una Brújula General para toda tu vida y una para cada año, desde el año después de tu nacimiento hasta tu meta de vida. Elige el año y verás la cumbre de ese año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il y a une Boussole générale pour toute ta vie et une pour chaque année, de l'année qui suit ta naissance jusqu'à ton objectif de vie. Choisis l'année pour voir son sommet."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पूरे जीवन के लिए एक सामान्य कम्पास है और हर साल का एक, आपके जन्म के अगले साल से आपके जीवन लक्ष्य तक। साल चुनें और उस साल का शिखर देखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "C'è una Bussola generale per tutta la vita e una per ogni anno, dall'anno dopo la tua nascita al tuo traguardo di vita. Scegli l'anno per vedere la sua vetta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "人生全体の総合コンパスと、生まれた翌年から人生の目標までの年ごとのコンパスがあります。年を選ぶとその年の頂上が見えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "평생을 위한 종합 나침반과, 태어난 다음 해부터 인생 목표까지 해마다의 나침반이 있습니다. 해를 고르면 그해의 정상이 보입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Há uma Bússola Geral para toda a sua vida e uma para cada ano, do ano seguinte ao seu nascimento até a sua meta de vida. Escolha o ano e verá o cume desse ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Есть общий Компас на всю жизнь и по одному на каждый год — от года после рождения до твоей жизненной цели. Выбери год, чтобы увидеть его вершину."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "有一个贯穿一生的总指南针，也有每一年的指南针，从你出生后的第一年到你的人生目标。选择年份即可看到那一年的山顶。"
     }
    }
   }
  },
