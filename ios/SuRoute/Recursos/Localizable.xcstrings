  "brujula_nueva_montana_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُفرَّغ الخطوات المكتسبة (تبقى في يوميات حياتك مع أدلتها) وتُملأ بخطوات جديدة. والتي في منتصف الطريق تحتفظ بأيامها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Verdiente Schritte werden frei (sie bleiben mit ihren Beweisen im Lebenstagebuch) und neu gefüllt. Halbfertige behalten ihre Tage."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Earned steps are cleared (they stay in your life diary with their evidence) and refilled with new steps. The ones halfway keep their work days."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los pasos ganados se liberan (siguen en tu diario de vida con sus evidencias) y se llenan con pasos nuevos. Los que van a medio camino se quedan con sus jornadas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les pas gagnés sont libérés (ils restent dans ton journal de vie avec leurs preuves) et remplacés par de nouveaux. Ceux à mi-chemin gardent leurs journées."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कमाए गए कदम खाली हो जाते हैं (सबूतों के साथ जीवन-डायरी में रहते हैं) और नए कदम आते हैं। आधे रास्ते वाले अपने दिन रखते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "I passi conquistati si liberano (restano nel diario di vita con le prove) e si riempiono di nuovi. Quelli a metà conservano le giornate."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "獲得したステップは空になり（証拠とともに人生日記に残ります）、新しいステップが入ります。途中のステップは日数を保ちます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "획득한 단계는 비워지고(증거와 함께 인생 일기에 남아요) 새 단계로 채워져요. 진행 중인 단계는 실행한 날을 유지해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os passos conquistados são liberados (continuam no diário de vida com suas evidências) e recebem passos novos. Os que estão no meio do caminho mantêm suas jornadas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Заработанные шаги освобождаются (остаются в дневнике жизни с доказательствами) и заполняются новыми. Начатые сохраняют свои дни."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "已赢得的步骤会被清空（连同证据保留在人生日记中）并填入新步骤。进行中的步骤保留其行动日。"
     }
    }
   }
  },
