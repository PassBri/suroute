  "foco_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم تختر بعد ما ستعمل عليه في %1$@. اختر بعض أهداف %2$ld: ستضيف أفعالك اليومية إليها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast noch nicht gewählt, woran du im %1$@ arbeitest. Wähle ein paar Ziele für %2$ld: Jeden Tag zahlen deine Aktionen darauf ein."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You haven't chosen what to work on in %1$@ yet. Pick a few %2$ld goals: each day, your actions will add to them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no eliges qué trabajar en %1$@. Escoge unas pocas metas de %2$ld: en cada día, tus acciones aportarán a ellas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous n'avez pas encore choisi sur quoi travailler en %1$@. Choisissez quelques objectifs de %2$ld : chaque jour, vos actions y contribueront."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने अभी तक नहीं चुना कि %1$@ में किस पर काम करेंगे। %2$ld के कुछ लक्ष्य चुनें: हर दिन आपके काम उनमें जुड़ेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non hai ancora scelto su cosa lavorare a %1$@. Scegli alcuni obiettivi del %2$ld: ogni giorno le tue azioni contribuiranno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@に取り組むことをまだ選んでいません。%2$ld年の目標をいくつか選びましょう。毎日の行動がそれに積み上がります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 %1$@에 무엇을 할지 고르지 않았어요. %2$ld년 목표 몇 개를 고르세요. 매일의 행동이 그 목표에 더해집니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ainda não escolheu o que trabalhar em %1$@. Escolha algumas metas de %2$ld: a cada dia, suas ações vão somar a elas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы ещё не выбрали, над чем работать в %1$@. Выберите несколько целей на %2$ld: каждый день ваши действия будут их приближать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你还没选择%1$@要做什么。挑几个 %2$ld 年的目标：每天的行动都会为它们助力。"
     }
    }
   }
  },
