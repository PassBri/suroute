  "foco_mes_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حدّد أهداف السنة التي ستعمل عليها هذا الشهر. كل يوم تسهم أفعالك في أحدها وتُعلَّم الأيام هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Markiere die Jahresziele, an denen du diesen Monat arbeitest. Jeden Tag zahlen deine Aktionen auf eines davon ein, und die Tage werden hier markiert."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Check the goals of the year you’ll work on this month. Each day, your actions feed one of them and the days are marked here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marca las metas del año que trabajarás este mes. En cada día, tus acciones aportan a una de ellas y los días se marcan aquí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Coche les objectifs de l’année que tu travailleras ce mois-ci. Chaque jour, tes actions nourrissent l’un d’eux et les jours se marquent ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस महीने जिन सालाना लक्ष्यों पर काम करेंगे, उन्हें चुनें। हर दिन आपके काम उनमें से किसी एक में योगदान देते हैं और दिन यहाँ दर्ज होते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Segna gli obiettivi dell’anno su cui lavorerai questo mese. Ogni giorno le tue azioni contribuiscono a uno di essi e i giorni si segnano qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今月取り組む年間目標にチェックしましょう。毎日の行動がそのどれかに貢献し、日付がここに記録されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 달에 할 올해 목표를 체크하세요. 매일의 행동이 그중 하나에 기여하고, 날짜가 여기에 표시돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Marque as metas do ano que você vai trabalhar este mês. A cada dia, suas ações contribuem para uma delas e os dias são marcados aqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отметь цели года, над которыми будешь работать в этом месяце. Каждый день твои действия вкладываются в одну из них, а дни отмечаются здесь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "勾选这个月要推进的年度目标。每天的行动都会为其中一个目标出力，天数会记在这里。"
     }
    }
   }
  },
  "foco_mes_titulo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ما أهداف %1$ld التي أعمل عليها في %2$@؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Welche Ziele von %1$ld bearbeite ich im %2$@?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Which %1$ld goals do I work on in %2$@?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Qué metas de %1$ld trabajo en %2$@?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quels objectifs de %1$ld je travaille en %2$@ ?"
