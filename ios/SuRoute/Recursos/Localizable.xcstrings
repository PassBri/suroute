  "cu_activos_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الأصل يضع المال في جيبك أو يحفظ قيمة: حسابات، استثمارات، منزلك، عملك. اكتب قيمته اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Vermögenswert bringt Geld oder hält Wert: Konten, Anlagen, Haus, Geschäft. Trage den heutigen Wert ein."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "An asset puts money in your pocket or holds value: accounts, investments, your home, your business. Enter today’s value."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un activo pone dinero en tu bolsillo o guarda valor: cuentas, inversiones, tu casa, tu negocio. Escribe su valor de hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un actif met de l’argent dans ta poche ou garde de la valeur : comptes, placements, ta maison, ton entreprise. Indique sa valeur actuelle."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "संपत्ति पैसा लाती है या मूल्य रखती है: खाते, निवेश, घर, व्यवसाय। आज का मूल्य लिखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un attivo mette soldi in tasca o conserva valore: conti, investimenti, casa, attività. Scrivi il valore di oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "資産はお金を生むか価値を保つもの：口座、投資、家、事業。今日の価値を入力します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "자산은 돈을 벌어 주거나 가치를 지켜요: 계좌, 투자, 집, 사업. 오늘의 가치를 적으세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Um ativo coloca dinheiro no seu bolso ou guarda valor: contas, investimentos, sua casa, seu negócio. Escreva o valor de hoje."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Актив приносит деньги или хранит стоимость: счета, вложения, дом, бизнес. Укажи стоимость на сегодня."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "资产能带来收入或保值：账户、投资、房子、生意。填写今天的价值。"
     }
    }
   }
  },
