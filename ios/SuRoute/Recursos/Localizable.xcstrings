  "cu_sin_bloqueo_tel": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هاتفك بلا قفل شاشة. اضبط قفلًا (بصمة أو وجه أو رمز) لحماية أموالك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Handy hat keine Displaysperre. Richte eine ein (Fingerabdruck, Gesicht oder PIN), um deine Finanzen zu schützen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your phone has no screen lock. Set one up (fingerprint, face or PIN) to protect your finances."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu teléfono no tiene bloqueo de pantalla. Configúralo (huella, rostro o PIN) para proteger tus finanzas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton téléphone n’a pas de verrouillage d’écran. Configure-en un (empreinte, visage ou code) pour protéger tes finances."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके फ़ोन में स्क्रीन लॉक नहीं है। अपने वित्त की सुरक्षा के लिए फ़िंगरप्रिंट, चेहरा या पिन सेट करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il telefono non ha un blocco schermo. Impostalo (impronta, volto o PIN) per proteggere le tue finanze."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "スマホに画面ロックがありません。指紋・顔・PIN を設定してお金を守りましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "휴대폰에 화면 잠금이 없어요. 지문·얼굴·PIN을 설정해 재정을 보호하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu telefone não tem bloqueio de tela. Configure um (digital, rosto ou PIN) para proteger suas finanças."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "На телефоне нет блокировки экрана. Настрой отпечаток, лицо или PIN, чтобы защитить финансы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的手机没有锁屏。请设置（指纹、面部或密码）来保护你的财务。"
     }
    }
   }
  },
