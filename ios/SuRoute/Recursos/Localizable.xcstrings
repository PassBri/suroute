  "modelo_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حياتك جبل. القمة هي وجهتك، والبوصلة تمنعك من الضياع، وكل يوم خطوة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Leben ist ein Berg. Der Gipfel ist dein Ziel, der Kompass hält dich auf Kurs und jeder Tag ist ein Schritt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your life is a mountain. The summit is where you are going, the compass keeps you from getting lost and every day is a step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu vida es una montaña. La cumbre es hacia dónde vas, la brújula es cómo no perderte y cada día es un paso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta vie est une montagne. Le sommet est là où tu vas, la boussole t'empêche de te perdre et chaque jour est un pas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका जीवन एक पर्वत है। शिखर वह है जहाँ आप जा रहे हैं, कम्पास आपको भटकने से बचाता है और हर दिन एक कदम है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vita è una montagna. La vetta è dove vai, la bussola ti impedisce di perderti e ogni giorno è un passo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの人生は一つの山です。頂上は向かう場所、コンパスは迷わないための道具、そして毎日が一歩です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 삶은 하나의 산입니다. 정상은 가야 할 곳, 나침반은 길을 잃지 않게 해 주는 것, 그리고 하루하루가 한 걸음입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sua vida é uma montanha. O cume é para onde você vai, a bússola é como não se perder e cada dia é um passo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя жизнь — это гора. Вершина — то, куда ты идёшь, компас не даёт сбиться с пути, а каждый день — это шаг."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的人生是一座山。山顶是你要去的地方，指南针让你不迷路，每一天都是一步。"
     }
    }
   }
  },
