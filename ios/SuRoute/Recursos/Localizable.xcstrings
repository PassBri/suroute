  "lz_quitar": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أرسلت «%1$@». انقر لإزالته؛ اضغط مطولًا لاختيار غيره"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast „%1$@“ gegeben. Tippen zum Entfernen; halten für ein anderes"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You gave «%1$@». Tap to remove; hold to choose another"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Diste «%1$@». Toca para quitarla; mantén para elegir otra"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as donné « %1$@ ». Touche pour la retirer ; maintiens pour en choisir une autre"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने «%1$@» दिया। हटाने के लिए टैप करें; दूसरी चुनने के लिए दबाए रखें"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai dato «%1$@». Tocca per toglierla; tieni premuto per sceglierne un’altra"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」を贈りました。タップで取り消し、長押しでほかを選ぶ"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」을(를) 보냈어요. 탭하면 취소, 길게 누르면 다른 빛 선택"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você deu «%1$@». Toque para tirar; segure para escolher outra"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы дали «%1$@». Нажмите, чтобы убрать; удерживайте, чтобы выбрать другой"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你送出了「%1$@」。轻点取消；长按选择其他"
     }
    }
   }
  },
