  "cu_ind_rotneg_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مبيعات السنة ÷ قيمة مشروعك (أصول من نوع «مشروع»). كم يبيع بما لديه. المثالي: 1 أو أكثر."
