  "bi_g_4_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اشكر أو قدّر شيئًا محددًا في شخص كل يوم، بصوتك أو كتابةً."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Danke oder würdige jeden Tag etwas Konkretes an einem Menschen, laut oder schriftlich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Thank or recognize something specific in one person each day, out loud or in writing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agradece o reconoce algo concreto a una persona cada día, en voz alta o por escrito."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Remercie ou reconnais quelque chose de concret chez une personne chaque jour, à voix haute ou par écrit."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर दिन किसी एक व्यक्ति को कुछ ठोस बात के लिए धन्यवाद या सराहना दें, बोलकर या लिखकर।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ringrazia o riconosci qualcosa di concreto a una persona ogni giorno, a voce o per iscritto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎日ひとりに、具体的な感謝や称賛を声か文字で伝えましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "매일 한 사람에게 구체적인 감사나 인정을 말이나 글로 전하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Agradeça ou reconheça algo concreto em uma pessoa por dia, em voz alta ou por escrito."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый день благодари или отмечай что-то конкретное в одном человеке — вслух или письменно."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每天向一个人具体地表达感谢或认可，口头或书面皆可。"
     }
    }
   }
  },
