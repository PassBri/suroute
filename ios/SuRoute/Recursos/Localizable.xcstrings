  "cu_cif_mal": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هذا الرمز لا يفتح أموالك: راجع الكلمات الـ12"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieser Code öffnet deine Finanzen nicht: Prüfe die 12 Wörter"
