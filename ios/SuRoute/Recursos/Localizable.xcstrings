  "tipo_logro_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "احتفل بشيء حققته. كل انتصار يُحسب."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Feiere etwas, das du erreicht hast. Jeder Sieg zählt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebrate something you accomplished. Every win counts."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebra algo que conseguiste. Cada victoria cuenta."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Célèbre quelque chose que tu as accompli. Chaque victoire compte."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जो आपने हासिल किया उसका जश्न मनाएँ। हर जीत मायने रखती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebra qualcosa che hai ottenuto. Ogni vittoria conta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "達成したことをお祝いしましょう。どの勝利も大切です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이룬 것을 축하하세요. 모든 승리는 소중해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebre algo que você conseguiu. Cada vitória conta."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отпразднуй то, чего добился(лась). Каждая победа важна."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "庆祝你取得的成绩。每一次胜利都算数。"
     }
    }
   }
  },
