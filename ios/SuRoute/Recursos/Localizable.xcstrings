  "cu_hibrido_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هجين: أولًا الديون التي يمكنك إغلاقها خلال 3 أشهر أو أقل، ثم الانهيار الجليدي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hybrid: zuerst die, die du in 3 Monaten oder weniger tilgen kannst; danach Lawine."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hybrid: first the ones you can close in 3 months or less; then avalanche."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Híbrido: primero las que puedes cerrar en 3 meses o menos; después, avalancha."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Hybride : d’abord celles que tu peux solder en 3 mois ou moins ; ensuite, avalanche."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हाइब्रिड: पहले वे कर्ज़ जो 3 महीने या कम में बंद हो सकें; फिर एवलांच।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ibrido: prima quelle che puoi chiudere in 3 mesi o meno; poi valanga."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ハイブリッド：3か月以内に完済できるものから。その後はアバランチ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "혼합법: 3개월 안에 갚을 수 있는 빚부터, 그다음은 눈사태법."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Híbrido: primeiro as que você pode quitar em 3 meses ou menos; depois, avalanche."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Гибрид: сначала долги, которые можно закрыть за 3 месяца или быстрее; потом лавина."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "混合法：先还 3 个月内能还清的；之后用雪崩法。"
     }
    }
   }
  },
