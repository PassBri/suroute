   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "متزامنة مع بوصلتك: أول 8 هي خطواتها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mit deinem Kompass synchron: Die ersten 8 sind seine Schritte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Synced with your Compass: the first 8 are its steps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sincronizada con tu Brújula: las 8 primeras son sus pasos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Synchronisé avec ta Boussole : les 8 premiers sont ses étapes."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके कम्पास से सिंक: पहले 8 उसके कदम हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sincronizzato con la tua Bussola: i primi 8 sono i suoi passi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コンパスと同期：最初の8つがそのステップです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나침반과 동기화됨: 처음 8개가 그 단계예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sincronizada com sua Bússola: as 8 primeiras são seus passos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Синхронизировано с компасом: первые 8 — его шаги."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "已与你的罗盘同步：前 8 个就是它的步骤。"
     }
    }
   }
  },
