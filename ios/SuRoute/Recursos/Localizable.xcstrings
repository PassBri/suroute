  "reportada_gracias": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شكرًا لحرصك على المجتمع: سنراجعه ولن تراه مجددًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Danke, dass du auf die Community achtest: Wir prüfen es, und du siehst es nicht mehr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Thanks for looking after the community: we'll review it and you won't see it again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gracias por cuidar la comunidad: la revisaremos y ya no la verás."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Merci de prendre soin de la communauté : nous l'examinerons et tu ne la verras plus."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "समुदाय का ध्यान रखने के लिए धन्यवाद: हम इसकी समीक्षा करेंगे और यह अब नहीं दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Grazie per prenderti cura della comunità: la esamineremo e non la vedrai più."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コミュニティを守ってくれてありがとう。確認します。今後は表示されません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "커뮤니티를 지켜 주셔서 고마워요. 검토할게요. 더는 보이지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Obrigado por cuidar da comunidade: vamos revisar e você não a verá mais."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Спасибо, что бережёте сообщество: мы проверим это, и вы больше этого не увидите."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "感谢你守护社区：我们会审核，你将不再看到它。"
     }
    }
   }
  },
  "reportar_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لن تراه بعد الآن. إذا أبلغ عنه عدة أشخاص يُخفى عن الجميع حتى مراجعته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du siehst ihn nicht mehr. Melden ihn mehrere Personen, wird er bis zur Prüfung für alle ausgeblendet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You won’t see it anymore. If several people report it, it’s hidden for everyone until reviewed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dejarás de verla. Si varias personas la reportan, se oculta para todos hasta revisarla."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu ne la verras plus. Si plusieurs personnes la signalent, elle est masquée pour tous jusqu’à examen."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप इसे अब नहीं देखेंगे। कई लोग रिपोर्ट करें तो समीक्षा तक सबके लिए छिप जाएगी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non la vedrai più. Se più persone la segnalano, viene nascosta a tutti fino alla revisione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今後表示されません。複数の人が報告すると、確認まで全員に非表示になります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "더 이상 보이지 않아요. 여러 사람이 신고하면 검토 전까지 모두에게 숨겨집니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você deixará de vê-la. Se várias pessoas denunciarem, ela fica oculta para todos até ser revisada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы больше её не увидите. Если пожалуются несколько человек, она скроется для всех до проверки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你将不再看到它。若多人举报，它将对所有人隐藏直至审核。"
     }
    }
   }
  },
