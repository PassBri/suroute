  },
  "nube_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هذا الحساب يحفظ مسارك بالفعل (من الويب أو من هاتف آخر). أحضره إلى هذا الهاتف: سيُستبدل ما هنا بما في السحابة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieses Konto hat deine Route schon gespeichert (aus dem Web oder von einem anderen Handy). Hol sie auf dieses Handy: Was hier ist, wird durch die Cloud ersetzt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This account already has your route saved (from the web or another phone). Bring it to this phone: what is here is replaced by what is in the cloud."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esta cuenta ya tiene tu ruta guardada (de la web o de otro teléfono). Tráela a este teléfono: lo que hay aquí se reemplaza por lo de la nube."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce compte a déjà votre itinéraire enregistré (depuis le web ou un autre téléphone). Ramenez-le sur ce téléphone : ce qui s’y trouve est remplacé par le cloud."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस खाते में आपका रास्ता पहले से सहेजा है (वेब या किसी दूसरे फ़ोन से)। इसे इस फ़ोन पर लाएँ: यहाँ जो है वह क्लाउड वाले से बदल जाएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo account ha già la tua rotta salvata (dal web o da un altro telefono). Portala su questo telefono: ciò che c’è qui viene sostituito dal cloud."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "このアカウントにはすでにルートが保存されています（ウェブまたは別のスマホから）。このスマホに取り込むと、ここにある内容はクラウドの内容に置き換わります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 계정에는 이미 길이 저장되어 있어요(웹 또는 다른 휴대폰에서). 이 휴대폰으로 가져오면 여기 있는 내용이 클라우드 내용으로 바뀝니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Esta conta já tem sua rota salva (da web ou de outro celular). Traga-a para este celular: o que há aqui é substituído pelo que está na nuvem."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В этом аккаунте уже сохранён ваш маршрут (из веб-версии или с другого телефона). Перенесите его на этот телефон: то, что здесь, заменится облачным."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这个账号已经保存了你的路线（来自网页或另一部手机）。把它带到这部手机：这里现有的内容会被云端内容替换。"
     }
    }
   }
  },
