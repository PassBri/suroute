  "ng_i_neto_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الربح ÷ المبيعات بعد التكاليف ومصروفات التشغيل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gewinn ÷ Umsatz, nach Kosten und Betriebsausgaben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Profit ÷ sales, after costs and operating expenses."
     }
    },
    "es": {
