     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "和人聊聊"
     }
    }
   }
  },
  "bi_h_hablar_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أخبر شخصًا تثق به. قوله بصوت عالٍ يجعله أخف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erzähl es einer Vertrauensperson. Laut ausgesprochen wird es leichter."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tell someone you trust. Saying it out loud makes it lighter."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuéntaselo a una persona de confianza. Nombrarlo en voz alta lo hace más liviano."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Raconte-le à une personne de confiance. Le dire à voix haute l'allège."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किसी भरोसेमंद व्यक्ति को बताएँ। बोलकर कहने से बोझ हल्का होता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Raccontalo a una persona di fiducia. Dirlo ad alta voce lo alleggerisce."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "信頼できる人に話しましょう。口に出すと軽くなります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "믿을 수 있는 사람에게 이야기하세요. 소리 내어 말하면 가벼워집니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Conte a uma pessoa de confiança. Dizer em voz alta deixa mais leve."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Расскажи человеку, которому доверяешь. Сказанное вслух становится легче."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "告诉一个你信任的人。说出来会轻松许多。"
     }
    }
   }
  },
