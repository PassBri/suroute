     }
    }
   }
  },
  "cp_conflicto_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بلوغ قمتك يعيق قمته. سيضحي أحدكما دائمًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deinen Gipfel zu erreichen verhindert den des anderen. Einer wird immer verzichten."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reaching your summit blocks theirs. One of you will always sacrifice."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Alcanzar tu cumbre impide la suya. Uno siempre sacrificará."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Atteindre ton sommet empêche le sien. L'un des deux se sacrifiera toujours."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका शिखर पाना उनके शिखर को रोकता है। कोई एक हमेशा त्याग करेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Raggiungere la tua vetta impedisce la sua. Uno dei due sacrificherà sempre."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自分の頂に届くことが相手の頂を妨げる。どちらかがいつも犠牲になる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나의 정상에 오르면 상대의 정상이 막혀요. 한 사람은 늘 희생하게 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Alcançar o seu cume impede o do outro. Um sempre vai sacrificar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Достижение твоей вершины мешает его/её вершине. Кто-то один всегда будет жертвовать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "抵达你的顶峰会阻碍对方的。总有一方要牺牲。"
     }
    }
   }
  },
