  "cu_salud_vacia": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد حركات في هذه الفترة بعد لقياس صحتك المالية. سجّل ما يدخل وما يخرج وستظهر مؤشراتك هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "In diesem Zeitraum gibt es noch keine Buchungen, um deine finanzielle Gesundheit zu messen. Trag Ein- und Ausgänge ein, dann siehst du hier deine Kennzahlen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "There are no entries in this period yet to measure your financial health. Log what comes in and goes out and your indicators will show here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay movimientos en este periodo para medir tu salud financiera. Anota lo que entra y sale y aquí verás tus indicadores."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore de mouvements sur cette période pour mesurer ta santé financière. Note ce qui entre et sort et tes indicateurs apparaîtront ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस अवधि में अभी कोई लेन-देन नहीं है जिससे वित्तीय सेहत मापी जा सके। आने-जाने वाला पैसा लिखें, यहाँ आपके सूचक दिखेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non ci sono ancora movimenti in questo periodo per misurare la tua salute finanziaria. Annota entrate e uscite e qui vedrai i tuoi indicatori."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この期間はまだ記録がなく、お金の健康を測れません。入出金を記録すると、ここに指標が表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 기간에는 아직 기록이 없어 재정 건강을 잴 수 없어요. 들어오고 나간 돈을 적으면 여기에 지표가 나와요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há movimentos neste período para medir sua saúde financeira. Anote o que entra e sai e aqui verá seus indicadores."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "За этот период ещё нет записей, чтобы оценить финансовое здоровье. Записывай доходы и расходы — здесь появятся показатели."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这个时间段还没有记录，无法衡量你的财务健康。记下收入和支出，这里就会显示指标。"
     }
    }
   }
  },
