  "inspiracion_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختر هدفًا من البنك وعدّله، أو اكتب هدفك الخاص."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
