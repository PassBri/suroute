  "eje_tra_pregunta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هل لحياتي معنى يتجاوز احتياجاتي الفردية؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hat mein Leben einen Sinn, der über meine eigenen Bedürfnisse hinausgeht?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Does my life have a meaning that goes beyond my individual needs?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Mi vida tiene un sentido que trasciende mis necesidades individuales?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ma vie a-t-elle un sens qui dépasse mes besoins individuels ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "क्या मेरे जीवन का ऐसा अर्थ है जो मेरी निजी ज़रूरतों से परे जाता है?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La mia vita ha un senso che va oltre i miei bisogni individuali?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの人生には、自分の欲求を超えた意味がありますか?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 삶에는 나 개인의 필요를 넘어서는 의미가 있나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Minha vida tem um sentido que transcende minhas necessidades individuais?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Есть ли в моей жизни смысл, выходящий за рамки моих личных потребностей?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我的人生是否有超越个人需求的意义？"
     }
    }
   }
  },
