  "fin_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد حركات بعد في %1$@. سجّل الدخل والمصروفات في المتابعة المالية لكل يوم وسترى الشهر كاملًا هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Einträge im %1$@. Trag Einnahmen und Ausgaben in der Finanzübersicht jedes Tages ein, dann siehst du hier den ganzen Monat."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No entries yet in %1$@. Log income and spending in each day’s money tracker and you’ll see the whole month here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay movimientos en %1$@. Anota ingresos y gastos en el control financiero de cada día y aquí verás el mes completo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucun mouvement en %1$@ pour l’instant. Note revenus et dépenses dans le suivi financier de chaque jour et tu verras le mois entier ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ में अभी कोई लेन-देन नहीं। हर दिन के वित्तीय रिकॉर्ड में आय और खर्च लिखें, यहाँ पूरा महीना दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun movimento a %1$@. Annota entrate e spese nel controllo finanziario di ogni giorno e qui vedrai il mese intero."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ の記録はまだありません。毎日のお金の記録に収入と支出を書くと、ここで 1 か月分が見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@에는 아직 기록이 없어요. 매일 재정 기록에 수입과 지출을 적으면 여기서 한 달 전체를 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há movimentos em %1$@. Anote receitas e gastos no controle financeiro de cada dia e aqui verá o mês inteiro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В %1$@ пока нет записей. Записывай доходы и расходы в финансовом блоке каждого дня — здесь появится весь месяц."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 还没有记录。在每天的财务记录里写下收入和支出，这里就会显示整个月。"
     }
    }
