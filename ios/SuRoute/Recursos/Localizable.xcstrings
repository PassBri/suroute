     "stringUnit": {
      "state": "translated",
      "value": "हो गया: उपलब्ध होने पर हम तुम्हें बताएँगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fatto: ti avviseremo quando sarà disponibile."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "了解しました。利用可能になったらお知らせします。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "완료: 이용 가능해지면 알려 드릴게요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pronto: avisaremos quando estiver disponível."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Готово: сообщим, когда станет доступно."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "好的：可用时我们会通知你。"
     }
    }
   }
  },
