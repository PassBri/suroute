  "fa_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "طُلب فتح صعودك المالي على SuRoute Web. وافق فقط إن كنت أنت أمام كمبيوترك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es wurde angefragt, deinen Finanzaufstieg in SuRoute Web zu öffnen. Bestätige nur, wenn du es bist und vor deinem Computer sitzt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Someone asked to open your Financial Ascent on SuRoute Web. Approve it only if it is you, at your computer."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pidieron abrir tu Ascenso financiero en SuRoute Web. Apruébalo solo si eres tú, frente a tu computador."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quelqu'un a demandé à ouvrir ton Ascension financière sur SuRoute Web. Approuve seulement si c'est toi, devant ton ordinateur."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute Web पर आपका वित्तीय आरोहण खोलने का अनुरोध आया है। तभी स्वीकृति दें जब कंप्यूटर के सामने आप खुद हों।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "È stato chiesto di aprire la tua Ascesa finanziaria su SuRoute Web. Approva solo se sei tu, davanti al tuo computer."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute Web で「お金の登頂」を開くリクエストがありました。パソコンの前にいるのがあなた本人の場合だけ承認してください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute Web에서 재정 등반을 열어 달라는 요청이 있어요. 컴퓨터 앞에 있는 사람이 본인일 때만 승인하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pediram para abrir seu Ascenso financeiro no SuRoute Web. Aprove só se for você, diante do seu computador."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Поступил запрос открыть твоё «Финансовое восхождение» в SuRoute Web. Подтверждай, только если это ты за своим компьютером."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "有人请求在 SuRoute Web 上打开你的财务攀登。只有当你本人在电脑前时才批准。"
     }
    }
   }
  },
