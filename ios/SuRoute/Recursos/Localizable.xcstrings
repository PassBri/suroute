  "cu_cuotas_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتب عدد أقساط القرض وكم دفعت لترى المتبقي وكم ذهب لأصل الدين وللفوائد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gib an, wie viele Raten der Kredit hat und wie viele du bezahlt hast, um Restraten sowie Tilgung und Zinsen zu sehen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Enter how many installments the loan has and how many you have paid to see how many are left and how much went to principal and interest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escribe cuántas cuotas tiene el crédito y cuántas llevas para ver cuántas te faltan y cuánto has pagado a capital e intereses."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Indiquez le nombre d'échéances du crédit et combien vous en avez payé pour voir ce qui reste et la part capital/intérêts."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ऋण की कुल किस्तें और चुकाई किस्तें लिखें ताकि बाकी किस्तें और मूलधन-ब्याज का हिस्सा दिखे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Indica quante rate ha il prestito e quante ne hai pagate per vedere quante mancano e la quota capitale e interessi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ローンの回数と支払済み回数を入れると、残り回数と元金・利息の内訳がわかります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "대출 총 회차와 상환한 회차를 입력하면 남은 회차와 원금·이자 내역을 볼 수 있습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Informe quantas parcelas o crédito tem e quantas já pagou para ver quantas faltam e quanto foi para capital e juros."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Укажите число платежей по кредиту и сколько уже внесено, чтобы увидеть остаток и долю основного долга и процентов."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "填写贷款总期数和已还期数，即可看到剩余期数以及本金和利息各付了多少。"
     }
    }
   }
  },
