  "total_inicio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت في بداية الرحلة. وهذا رائع تمامًا: أمامك الطريق كله."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du stehst am Anfang der Reise. Das ist PERFEKT: Der ganze Weg liegt noch vor dir."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You're at the start of the journey. That's PERFECT: you have the whole road ahead of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estás al inicio del viaje. Esto es PERFECTO: tienes todo el camino por delante."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu es au début du voyage. C'est PARFAIT : tout le chemin est devant toi."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप सफ़र की शुरुआत में हैं। यह बिल्कुल ठीक है: पूरा रास्ता आपके सामने है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei all'inizio del viaggio. È PERFETTO: hai tutto il cammino davanti a te."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "旅の始まりです。それこそ最高のスタート。道のりはまるごと目の前にあります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "여정의 출발점에 있어요. 아주 좋아요! 앞에 온 길이 모두 남아 있으니까요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você está no início da jornada. Isso é PERFEITO: tem todo o caminho pela frente."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты в начале пути. Это ИДЕАЛЬНО: весь путь ещё впереди."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你正处在旅程的起点。这再好不过：整条路都在你面前。"
     }
    }
   }
  },
  "total_proceso": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت في طور الصعود. أعطِ الأولوية لمحورين أو ثلاثة واعمل عليها بكثافة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du bist mitten im Aufstieg. Setze Prioritäten bei 2 oder 3 Achsen und arbeite intensiv daran."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You're in the middle of your ascent. Prioritize 2 or 3 axes to work on intensively."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estás en proceso de ascenso. Prioriza 2 o 3 ejes para trabajar intensamente."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu es en pleine ascension. Priorise 2 ou 3 axes pour y travailler intensément."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप चढ़ाई की प्रक्रिया में हैं। 2 या 3 अक्ष चुनें और उन पर गहनता से काम करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei in piena salita. Dai priorità a 2 o 3 assi su cui lavorare intensamente."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "登頂の途中です。2〜3つの軸に絞って集中的に取り組みましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "등반 중이에요. 2~3개 축을 골라 집중적으로 가꿔 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você está em plena subida. Priorize 2 ou 3 eixos para trabalhar com intensidade."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты в процессе восхождения. Выбери 2–3 оси и поработай над ними всерьёз."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你正在攀登的路上。挑选 2 到 3 个维度重点投入。"
     }
    }
   }
  },
  "total_sin": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قيّم محاورك الستة لترى نقطة انطلاقك."
     }
    },
    "de": {
