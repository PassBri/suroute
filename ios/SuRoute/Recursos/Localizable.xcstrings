  "sal_negocio_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المبيعات هي دخلك من «مشروع» و«مبيعات». ربحية المشروع الصافية والعائد على أصوله يحتاجان تسجيل تكاليفه منفصلة عن مصاريفك الشخصية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Umsatz sind deine Einnahmen „Geschäft“ und „Verkäufe“. Nettorendite und ROA des Geschäfts brauchen seine Kosten getrennt von deinen privaten Ausgaben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sales are your “Business” and “Sales” income. The business’s net profitability and ROA need its costs recorded separately from your personal expenses."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las ventas son tus ingresos de «Negocio» y «Ventas». La rentabilidad neta y el ROA del negocio necesitan sus costos anotados aparte de tus gastos personales."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les ventes sont vos revenus « Entreprise » et « Ventes ». La rentabilité nette et le ROA de l’entreprise demandent ses coûts notés à part de vos dépenses personnelles."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बिक्री आपकी «व्यवसाय» और «बिक्री» आय है। व्यवसाय की शुद्ध लाभप्रदता और ROA के लिए उसके खर्च निजी खर्चों से अलग दर्ज करने होंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le vendite sono le entrate «Attività» e «Vendite». Redditività netta e ROA dell’attività richiedono i suoi costi annotati a parte dalle spese personali."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "売上は「事業」と「販売」の収入です。事業の純利益率と ROA には、事業の経費を個人の支出と分けて記録する必要があります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "매출은 「사업」과 「판매」 수입이에요. 사업의 순이익률과 ROA를 보려면 사업 비용을 개인 지출과 따로 기록해야 해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "As vendas são sua renda de «Negócio» e «Vendas». A rentabilidade líquida e o ROA do negócio precisam dos custos registrados à parte dos seus gastos pessoais."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Продажи — это доходы «Бизнес» и «Продажи». Для чистой рентабельности и ROA бизнеса нужно вести его расходы отдельно от личных."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "销售额是你「生意」和「销售」类收入。生意的净利润率和 ROA 需要把它的成本与个人支出分开记录。"
     }
    }
   }
  },
  "sal_negocio_nota_activo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أضف مشروعك في الأصول (نوع «مشروع») لترى دورانه. المبيعات هي دخلك من «مشروع» و«مبيعات». ربحية المشروع الصافية والعائد على أصوله يحتاجان تسجيل تكاليفه منفصلة عن مصاريفك الشخصية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Trage dein Geschäft unter Vermögen ein (Typ „Geschäft“), um den Umschlag zu sehen. Umsatz sind deine Einnahmen „Geschäft“ und „Verkäufe“. Nettorendite und ROA des Geschäfts brauchen seine Kosten getrennt von deinen privaten Ausgaben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Add your business under Assets (type “Business”) to see its turnover. Sales are your “Business” and “Sales” income. The business’s net profitability and ROA need its costs recorded separately from your personal expenses."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anota tu negocio en Activos (tipo «Negocio») para ver su rotación. Las ventas son tus ingresos de «Negocio» y «Ventas». La rentabilidad neta y el ROA del negocio necesitan sus costos anotados aparte de tus gastos personales."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajoutez votre entreprise dans Actifs (type « Entreprise ») pour voir sa rotation. Les ventes sont vos revenus « Entreprise » et « Ventes ». La rentabilité nette et le ROA de l’entreprise demandent ses coûts notés à part de vos dépenses personnelles."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "टर्नओवर देखने के लिए अपना व्यवसाय संपत्ति में («व्यवसाय» प्रकार) जोड़ें। बिक्री आपकी «व्यवसाय» और «बिक्री» आय है। व्यवसाय की शुद्ध लाभप्रदता और ROA के लिए उसके खर्च निजी खर्चों से अलग दर्ज करने होंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggiungi la tua attività in Beni (tipo «Attività») per vederne la rotazione. Le vendite sono le entrate «Attività» e «Vendite». Redditività netta e ROA dell’attività richiedono i suoi costi annotati a parte dalle spese personali."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "資産に事業（種類「事業」）を登録すると回転率が見られます。売上は「事業」と「販売」の収入です。事業の純利益率と ROA には、事業の経費を個人の支出と分けて記録する必要があります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "자산에 사업(유형 「사업」)을 등록하면 회전율을 볼 수 있어요. 매출은 「사업」과 「판매」 수입이에요. 사업의 순이익률과 ROA를 보려면 사업 비용을 개인 지출과 따로 기록해야 해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Registre seu negócio em Ativos (tipo «Negócio») para ver o giro. As vendas são sua renda de «Negócio» e «Vendas». A rentabilidade líquida e o ROA do negócio precisam dos custos registrados à parte dos seus gastos pessoais."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Добавьте бизнес в Активы (тип «Бизнес»), чтобы видеть оборачиваемость. Продажи — это доходы «Бизнес» и «Продажи». Для чистой рентабельности и ROA бизнеса нужно вести его расходы отдельно от личных."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在资产中添加你的生意（类型「生意」）即可看到周转率。销售额是你「生意」和「销售」类收入。生意的净利润率和 ROA 需要把它的成本与个人支出分开记录。"
     }
    }
   }
  },
  "sal_negocio_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "منفصل عن أموالك الشخصية · لا يُحسب في مؤشرك"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
