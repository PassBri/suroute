  "cumbre_comunidad_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "جبل واحد ارتفاعه 8,848,000 مم للجميع هذا العام. كلما زاد عدد المتسلقين صار كل مليمتر أصعب."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein einziger Berg von 8.848.000 mm für alle in diesem Jahr. Je mehr Menschen steigen, desto schwerer wird jeder Millimeter."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "One mountain of 8,848,000 mm for everyone this year. The more people climb, the harder each millimeter gets."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una sola montaña de 8.848.000 mm para todos este año. Cuantas más personas suben, más difícil es cada milímetro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une seule montagne de 8 848 000 mm pour tous cette année. Plus nous sommes nombreux, plus chaque millimètre est difficile."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस साल सबके लिए 8,848,000 मिमी का एक ही पहाड़। जितने ज़्यादा लोग चढ़ते हैं, हर मिलीमीटर उतना ही कठिन होता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un'unica montagna di 8.848.000 mm per tutti quest'anno. Più persone salgono, più difficile è ogni millimetro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今年はみんなで8,848,000 mmの山をひとつ登ります。登る人が増えるほど、1 mmが難しくなります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "올해 모두가 함께 오르는 8,848,000 mm의 산 하나. 오르는 사람이 많을수록 1 mm가 더 어려워져요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma única montanha de 8.848.000 mm para todos este ano. Quanto mais gente sobe, mais difícil é cada milímetro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Одна гора высотой 8 848 000 мм для всех в этом году. Чем больше людей поднимается, тем труднее каждый миллиметр."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "今年所有人共攀一座 8,848,000 毫米的山。攀登的人越多，每一毫米就越难。"
     }
    }
   }
  },
