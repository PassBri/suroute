  "bi_como": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كيف طقسك الداخلي؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wie ist dein inneres Wetter?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "How is your inner weather?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Cómo está tu clima interior?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quelle est ta météo intérieure ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका भीतरी मौसम कैसा है?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Com'è il tuo clima interiore?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "心の天気はどうですか？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "마음 날씨는 어떤가요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Como está seu clima interior?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Какая у тебя внутренняя погода?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的内心天气如何？"
     }
    }
   }
  },
  "bi_como_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختر حسب طاقتك وهل ما تشعر به مريح أم لا. لا يوجد طقس جيد أو سيئ: كل طقس يقول شيئًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wähle nach deiner Energie und ob sich das Gefühl angenehm anfühlt oder nicht. Es gibt kein gutes oder schlechtes Wetter: Jedes sagt etwas."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Choose by your energy and whether what you feel is pleasant or not. There's no good or bad weather: each one tells you something."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elige según tu energía y si lo que sientes es agradable o no. No hay climas buenos ni malos: todos dicen algo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisis selon ton énergie et si ce que tu ressens est agréable ou non. Il n'y a pas de bonne ou mauvaise météo : chacune dit quelque chose."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी ऊर्जा और भावना सुखद है या नहीं, इसके आधार पर चुनें। कोई मौसम अच्छा या बुरा नहीं: हर एक कुछ कहता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scegli in base alla tua energia e a se ciò che senti è piacevole o no. Non ci sono climi buoni o cattivi: ognuno dice qualcosa."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "エネルギーの高さと、心地よいかどうかで選びましょう。良い天気も悪い天気もありません。どれも何かを伝えています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "에너지가 높은지 낮은지, 느낌이 좋은지 아닌지로 고르세요. 좋은 날씨도 나쁜 날씨도 없습니다. 모두 무언가를 말해 줍니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolha pela sua energia e se o que sente é agradável ou não. Não há clima bom ou ruim: todos dizem algo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выбери по уровню энергии и по тому, приятно ли то, что чувствуешь. Нет хорошей или плохой погоды: каждая что-то говорит."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "按你的能量高低以及感受是否愉快来选择。天气没有好坏之分：每一种都在告诉你些什么。"
     }
    }
   }
  },
