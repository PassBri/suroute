     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "No meio do caminho: escolha menos e cumpra."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "На полпути: выбирайте меньше и доводите до конца."
