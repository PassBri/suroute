  "cumbre_comunidad_logro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "القمة! بلغ المجتمع 8,848,000 مم لهذا العام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gipfel! Die Community hat die 8.848.000 mm dieses Jahres bezwungen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Summit! The community conquered this year's 8,848,000 mm."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¡Cumbre! La comunidad coronó los 8.848.000 mm de este año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sommet ! La communauté a conquis les 8 848 000 mm de l'année."
