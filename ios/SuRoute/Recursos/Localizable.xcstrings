  "paso_proposito_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الشيء الكبير الذي تريد تحقيقه. ثم نقسّمه على السنة والشهر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Große, das du erreichen willst. Danach brechen wir es auf Jahr und Monat herunter."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The big thing you want to achieve. Then we break it down into the year and the month."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo grande que quieres lograr. Luego lo bajamos al año y al mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le grand objectif que tu veux atteindre. Ensuite on le décline en année et en mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जो बड़ा लक्ष्य आप पाना चाहते हैं। फिर उसे साल और महीने में बाँटेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La cosa grande che vuoi realizzare. Poi la scomponiamo in anno e mese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "達成したい大きなこと。それを年と月に落とし込みます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이루고 싶은 큰 목표. 그다음 연간·월간으로 나눠요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O grande que você quer conquistar. Depois desdobramos no ano e no mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Главное, чего ты хочешь достичь. Потом разобьём это на год и месяц."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你想实现的大目标。接着我们把它拆到年和月。"
     }
    }
   }
  },
