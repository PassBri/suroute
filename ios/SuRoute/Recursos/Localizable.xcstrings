     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "끌어서 둘러보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Arraste para olhar ao redor."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
