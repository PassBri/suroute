  "tipo_evidencia_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اعرض دليل تقدّمك: صورة واحدة تغني عن ألف نيّة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zeige den Beweis deines Fortschritts: Ein Foto sagt mehr als tausend Vorsätze."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Show proof of your progress: a photo is worth a thousand resolutions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Muestra la prueba de tu avance: una foto vale más que mil propósitos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Montre la preuve de ta progression : une photo vaut mieux que mille intentions."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी प्रगति का सबूत दिखाएँ: एक तस्वीर हज़ार उद्देश्यों से ज़्यादा कहती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mostra la prova dei tuoi progressi: una foto vale più di mille propositi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "進歩の証拠を見せましょう。1枚の写真は千の決意に勝ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "진전의 증거를 보여 주세요. 사진 한 장이 천 마디 다짐보다 나아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Mostre a prova do seu progresso: uma foto vale mais que mil propósitos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Покажи подтверждение своего прогресса: фото стоит тысячи намерений."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "展示你进展的证明：一张照片胜过千言万语。"
     }
    }
   }
  },
