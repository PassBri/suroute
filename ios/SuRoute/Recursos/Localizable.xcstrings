  "servidor_no_configurado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المجتمع عبر الإنترنت غير مُعدّ بعد في هذا الإصدار. كل ما تسجّله يُحفظ على هاتفك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Online-Community ist in dieser Version noch nicht eingerichtet. Alles, was du festhältst, wird auf deinem Handy gespeichert."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The online community isn't set up in this version yet. Everything you record is saved on your phone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La comunidad en línea aún no está configurada en esta versión. Todo lo que registras se guarda en tu teléfono."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La communauté en ligne n'est pas encore configurée dans cette version. Tout ce que tu enregistres reste sur ton téléphone."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ऑनलाइन समुदाय अभी इस वर्शन में सेट अप नहीं है। आप जो कुछ भी दर्ज करते हैं वह आपके फ़ोन में सहेजा जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La community online non è ancora configurata in questa versione. Tutto ciò che registri viene salvato sul tuo telefono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "オンラインコミュニティは、このバージョンではまだ設定されていません。記録したものはすべて、お使いのスマートフォンに保存されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 버전에서는 온라인 커뮤니티가 아직 설정되지 않았어요. 기록하는 모든 내용은 휴대폰에 저장돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A comunidade online ainda não está configurada nesta versão. Tudo o que você registra fica salvo no seu celular."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Онлайн-сообщество в этой версии ещё не настроено. Всё, что ты записываешь, хранится в твоём телефоне."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "此版本尚未配置在线社区。你记录的所有内容都保存在你的手机上。"
     }
    }
   }
  },
  "sesion_iniciada": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم تسجيل الدخول باسم %1$@"
     }
    },
    "de": {
