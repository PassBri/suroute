  "bi_h_stop_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "توقف. خذ نفسًا. لاحظ ما تشعر به وتفكر فيه. واصل بما هو في يدك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Stopp. Atme. Beobachte, was du fühlst und denkst. Mach weiter mit dem, was in deiner Hand liegt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop. Take a breath. Observe what you feel and think. Proceed with what is up to you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para. Toma aire. Observa qué sientes y piensas. Prosigue con lo que sí depende de ti."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop. Respire. Observe ce que tu ressens et penses. Poursuis avec ce qui dépend de toi."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "रुकें। साँस लें। देखें क्या महसूस और सोच रहे हैं। जो आपके हाथ में है, उसके साथ आगे बढ़ें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati. Respira. Osserva cosa senti e pensi. Prosegui con ciò che dipende da te."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "止まる。息をする。感じていること・考えていることを観察。自分にできることを続ける。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "멈추기. 숨 쉬기. 느낌과 생각 관찰하기. 내가 할 수 있는 일로 계속하기."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pare. Respire. Observe o que sente e pensa. Prossiga com o que depende de você."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Стоп. Вдохни. Понаблюдай, что чувствуешь и думаешь. Продолжай с тем, что зависит от тебя."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "停下。深呼吸。观察你的感受与想法。继续去做自己能掌控的事。"
     }
    }
   }
  },
