  "ib_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أُنشئ بواسطة SuRoute · البوصلة 1·9·81 من طريقة Ruta a la Cima، مستوحاة من Mandala Chart لـ Yasuo Matsumura (1979)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erstellt mit SuRoute · Kompass 1·9·81 der Methode Ruta a la Cima, inspiriert vom Mandala Chart von Yasuo Matsumura (1979)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Generated by SuRoute · Compass 1·9·81 of the Ruta a la Cima Method, inspired by Yasuo Matsumura's Mandala Chart (1979)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Generado por SuRoute · Brújula 1·9·81 del Método Ruta a la Cima, inspirada en la Mandala Chart de Yasuo Matsumura (1979)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Généré par SuRoute · Boussole 1·9·81 de la Méthode Ruta a la Cima, inspirée de la Mandala Chart de Yasuo Matsumura (1979)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute द्वारा बनाया गया · Ruta a la Cima पद्धति का कम्पास 1·9·81, Yasuo Matsumura के Mandala Chart (1979) से प्रेरित।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Generato da SuRoute · Bussola 1·9·81 del Metodo Ruta a la Cima, ispirata alla Mandala Chart di Yasuo Matsumura (1979)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute で作成 · Ruta a la Cima メソッドのコンパス 1·9·81。Yasuo Matsumura の Mandala Chart（1979）に着想を得ています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute에서 생성 · Ruta a la Cima 방법의 나침반 1·9·81, Yasuo Matsumura의 Mandala Chart(1979)에서 영감을 받음."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Gerado pelo SuRoute · Bússola 1·9·81 do Método Ruta a la Cima, inspirada na Mandala Chart de Yasuo Matsumura (1979)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Создано в SuRoute · Компас 1·9·81 Метода Ruta a la Cima, вдохновлён Mandala Chart Ясуо Мацумуры (Yasuo Matsumura, 1979)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "由 SuRoute 生成 · Ruta a la Cima 方法的指南针 1·9·81，灵感来自 Yasuo Matsumura 的 Mandala Chart（1979）。"
     }
    }
   }
  },
