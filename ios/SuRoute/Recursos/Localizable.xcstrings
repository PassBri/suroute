  "vida_anio_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد سجلات هنا بعد. أضف صورًا وإنجازات لتتذكر ما فعلته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hier ist noch nichts festgehalten. Füge Fotos und Erfolge hinzu, um dich zu erinnern."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Nothing recorded here yet. Add photos and achievements to remember what you did."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay registros aquí. Agrega fotos y logros para recordar lo que hiciste."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rien n’est encore noté ici. Ajoute des photos et des réussites pour t’en souvenir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यहाँ अभी कुछ दर्ज नहीं है। जो किया उसे याद रखने के लिए फ़ोटो और उपलब्धियाँ जोड़ें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Qui non c’è ancora niente. Aggiungi foto e traguardi per ricordare ciò che hai fatto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ここにはまだ記録がありません。写真や達成を追加して思い出を残しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 기록이 없어요. 사진과 성취를 추가해 한 일을 기억하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há registros aqui. Adicione fotos e conquistas para lembrar o que você fez."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Здесь пока пусто. Добавь фото и достижения, чтобы помнить, что ты сделал."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这里还没有记录。添加照片和成就，记住你做过的事。"
     }
    }
   }
  },
