  "cv_g12_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "نسخ الرابط أو كتم الصوت أو الإبلاغ أو الحظر. أمانك دائمًا على بُعد نقرة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Link kopieren, stummschalten, melden oder blockieren. Deine Sicherheit ist immer nur einen Tipp entfernt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Copy the link, mute, report or block. Your safety is always one tap away."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Copiar el enlace, silenciar, reportar o bloquear. Tu seguridad siempre está a un toque."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Copier le lien, mettre en sourdine, signaler ou bloquer. Ta sécurité est toujours à portée de doigt."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लिंक कॉपी करें, म्यूट करें, रिपोर्ट करें या ब्लॉक करें। आपकी सुरक्षा हमेशा बस एक टैप दूर है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Copia il link, silenzia, segnala o blocca. La tua sicurezza è sempre a un tocco."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "リンクのコピー、ミュート、報告、ブロック。安全はいつもワンタップで守れます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "링크 복사, 뮤트, 신고, 차단. 안전은 언제나 한 번의 탭으로 지킬 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Copiar o link, silenciar, denunciar ou bloquear. Sua segurança está sempre a um toque."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Скопировать ссылку, скрыть, пожаловаться или заблокировать. Твоя безопасность всегда в одном касании."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "复制链接、静音、举报或屏蔽。你的安全始终只需轻点一下。"
     }
    }
   }
  },
