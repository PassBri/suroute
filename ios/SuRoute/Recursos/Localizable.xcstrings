  "vida_punto_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل نقطة سنة من حياتك. المسها لتراها شهرًا بشهر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Punkt ist ein Jahr deines Lebens. Tippe auf einen, um ihn Monat für Monat zu sehen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each dot is one year of your life. Tap one to see it month by month."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada punto es un año de tu vida. Toca uno para verlo mes a mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque point est une année de ta vie. Touches-en un pour la voir mois par mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर बिंदु आपके जीवन का एक वर्ष है। उसे महीने-दर-महीने देखने के लिए टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni punto è un anno della tua vita. Toccane uno per vederlo mese per mese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1つの点が人生の1年です。タップすると月ごとに見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "점 하나가 인생의 1년이에요. 눌러서 달마다 살펴보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada ponto é um ano da sua vida. Toque em um para vê-lo mês a mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждая точка — год твоей жизни. Нажми, чтобы увидеть его по месяцам."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每个点代表你人生中的一年。点一下即可按月查看。"
     }
    }
   }
  },
