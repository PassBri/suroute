     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ainda não avaliou seus 6 eixos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты ещё не оценил(а) свои 6 осей."
     }
    },
    "zh-Hans": {
