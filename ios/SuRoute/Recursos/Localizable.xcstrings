  "bj_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "السنوات المعلّمة لديها بوصلة بالفعل. المس سنة لفتحها أو إنشائها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Markierte Jahre haben schon einen Kompass. Tippe auf ein Jahr, um ihn zu öffnen oder zu erstellen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Marked years already have a Compass. Tap a year to open or create it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los años marcados ya tienen Brújula. Toca un año para abrirla o crearla."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les années marquées ont déjà une Boussole. Touchez une année pour l’ouvrir ou la créer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चिह्नित सालों में पहले से कंपास है। खोलने या बनाने के लिए किसी साल पर टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Gli anni segnati hanno già una Bussola. Tocca un anno per aprirla o crearla."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "印のある年にはすでにコンパスがあります。年をタップして開くか作成します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "표시된 해에는 이미 나침반이 있어요. 해를 눌러 열거나 만드세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os anos marcados já têm Bússola. Toque em um ano para abri-la ou criá-la."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "У отмеченных лет уже есть Компас. Нажмите на год, чтобы открыть или создать его."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "标记的年份已有指南针。点一下年份即可打开或创建。"
     }
    }
   }
  },
