  "bi_h_mirada_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ماذا كنت ستقول لصديق في مكانك؟ ما الطريقة الأخرى لرؤية هذا؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was würdest du einem Freund an deiner Stelle sagen? Wie kann man es noch sehen?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What would you tell a friend in your place? What other way is there to see this?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Qué le dirías a un amigo en tu lugar? ¿Qué otra forma hay de ver esto?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Que dirais-tu à un ami à ta place ? De quelle autre façon voir cela ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी जगह होते दोस्त से आप क्या कहते? इसे और कैसे देखा जा सकता है?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cosa diresti a un amico al tuo posto? In che altro modo si può vedere?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "同じ立場の友だちに何と言う？ほかにどう見られる？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 자리에 있는 친구에게 뭐라고 말할까요? 다르게 볼 방법은 없을까요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que você diria a um amigo no seu lugar? De que outra forma dá para ver isso?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Что бы ты сказал другу на твоём месте? Как ещё можно на это посмотреть?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果朋友处在你的位置，你会对他说什么？还能怎么看这件事？"
     }
    }
   }
  },
