  "etapa_bancos_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أهداف ومؤشرات وإجراءات ومشاريع جاهزة لاستخدامها في أهدافك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ziele, Indikatoren, Aktionen und Projekte, die du direkt für deine Ziele nutzen kannst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ready-to-use goals, indicators, actions and projects for your goals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Metas, indicadores, acciones y proyectos listos para usar en tus metas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Objectifs, indicateurs, actions et projets prêts à l'emploi pour tes objectifs."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य, संकेतक, कार्य और प्रोजेक्ट, जो आपके लक्ष्यों में इस्तेमाल के लिए तैयार हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Obiettivi, indicatori, azioni e progetti pronti da usare nei tuoi obiettivi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標・指標・アクション・プロジェクトのテンプレートを、そのまま目標に使えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표에 바로 쓸 수 있는 목표, 지표, 행동, 프로젝트 모음이에요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Metas, indicadores, ações e projetos prontos para usar nas suas metas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Готовые цели, показатели, действия и проекты для твоих целей."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "现成的目标、指标、行动和项目，可直接用于你的目标。"
     }
    }
   }
  },
