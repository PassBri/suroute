      "value": "Konnte nicht abgeschlossen werden. Prüfe deine Verbindung und versuche es erneut."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Couldn't complete. Check your connection and try again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo completar. Revisa tu conexión e inténtalo de nuevo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossible de terminer. Vérifie ta connexion et réessaie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पूरा नहीं हो सका। कनेक्शन जाँचें और फिर कोशिश करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossibile completare. Controlla la connessione e riprova."
     }
    },
