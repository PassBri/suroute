  "cu_vs_minimos": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بدفع الحد الأدنى فقط ستحتاج %1$@ وتدفع %2$@: بطريقتك توفر %3$@ و%4$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mit nur den Mindestraten bräuchtest du %1$@ und zahltest %2$@: mit deiner Methode sparst du %3$@ und %4$@."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Paying only the minimums you would take %1$@ and pay %2$@: with your method you save %3$@ and %4$@."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando solo los mínimos tardarías %1$@ y pagarías %2$@: con tu método ahorras %3$@ y %4$@."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "En payant seulement les minimums, il te faudrait %1$@ et tu paierais %2$@ : avec ta méthode tu économises %3$@ et %4$@."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सिर्फ़ न्यूनतम भुगतान से %1$@ लगेंगे और %2$@ चुकाएँगे: आपके तरीके से %3$@ और %4$@ बचेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando solo i minimi ci metteresti %1$@ e pagheresti %2$@: con il tuo metodo risparmi %3$@ e %4$@."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最低返済だけだと %1$@ かかり %2$@ 支払います。あなたの方法なら %3$@ と %4$@ を節約できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최소 상환만 하면 %1$@ 걸리고 %2$@를 내요. 내 방법이면 %3$@와 %4$@를 아껴요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando só os mínimos você levaria %1$@ e pagaria %2$@: com seu método você economiza %3$@ e %4$@."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Платя только минимумы, ты потратишь %1$@ и заплатишь %2$@: с твоим методом экономишь %3$@ и %4$@."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "只还最低额需要 %1$@，共付 %2$@：用你的方法可省 %3$@ 和 %4$@。"
     }
    }
   }
  },
