  "respaldo_restaurado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم: استُعيد %1$ld عنصرًا (ما كان لديك يبقى)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Fertig: %1$ld Einträge wiederhergestellt (Vorhandenes bleibt erhalten)."
