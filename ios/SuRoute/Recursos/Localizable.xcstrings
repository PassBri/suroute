  "feed_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا منشورات بعد. كن أول من يشارك تقدّمه!"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Beiträge. Sei der Erste, der seinen Fortschritt teilt!"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No posts yet. Be the first to share your progress!"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay publicaciones. ¡Sé el primero en compartir tu avance!"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore de publications. Sois le premier à partager ta progression !"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी कोई पोस्ट नहीं है। अपनी प्रगति साझा करने वाले पहले व्यक्ति बनें!"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun post. Sii il primo a condividere i tuoi progressi!"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ投稿がありません。最初に進捗を共有してみませんか?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 게시물이 없어요. 가장 먼저 진행 상황을 공유해 보세요!"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há publicações. Seja o primeiro a compartilhar seu progresso!"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Публикаций пока нет. Стань первым, кто поделится прогрессом!"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有帖子。来做第一个分享进展的人吧！"
     }
    }
   }
  },
