  "vida_anhelos_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الكلمة التي تقود ذلك العام وما تتوق إليه أو كنت تتوق إليه، واحد في كل سطر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Wort, das dieses Jahr leitet, und wonach du dich sehnst oder sehntest, eins pro Zeile."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The word that guides that year and what you long or longed for, one per line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La palabra que guía ese año y lo que anhelas o anhelabas, uno por línea."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le mot qui guide cette année et ce que tu désires ou désirais, un par ligne."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "उस साल का मार्गदर्शक शब्द और जो आप चाहते हैं या चाहते थे, हर पंक्ति में एक।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La parola che guida quell’anno e ciò che desideri o desideravi, uno per riga."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "その年を導く言葉と、願うこと（願っていたこと）を 1 行に 1 つ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "그해를 이끄는 단어와 바라는(바랐던) 것, 한 줄에 하나씩."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A palavra que guia esse ano e o que você anseia ou ansiava, um por linha."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Слово, которое ведёт этот год, и то, чего ты хочешь или хотел, по одному в строке."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "引导这一年的词，以及你渴望或曾渴望的事，每行一个。"
     }
    }
   }
  },
  "vida_anhelos_ayuda_futuro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتب أمنياتك وأحلامك لذلك العام، واحدة في كل سطر. ثم حوّلها إلى أهداف."
