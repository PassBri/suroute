    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Em desenvolvimento. Você vai bem: escolha um ponto para reforçar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В развитии. Ты на верном пути: выбери один пункт для усиления."
