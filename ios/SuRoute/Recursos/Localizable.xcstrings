  "mirar_ayuda_calibrar": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المس الشاشة حيث ترى فعلًا الجرم داخل الحلقة الذهبية (%1$@). ابقَ ثابتًا أثناء اللمس. لمسة مزدوجة: إعادة الضبط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Tippe dorthin, wo du den Himmelskörper im goldenen Ring (%1$@) wirklich siehst. Halte beim Tippen still. Doppeltippen: zurücksetzen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tap where you really see the body in the gold ring (%1$@). Hold still while tapping. Double tap: reset."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca en la pantalla dónde ves de verdad el astro del aro dorado (%1$@). Quédate quieto al tocar. Doble toque: volver a cero."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touche l'écran là où tu vois vraiment l'astre de l'anneau doré (%1$@). Reste immobile en touchant. Double toucher : remettre à zéro."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "स्क्रीन पर वहाँ टैप करें जहाँ आपको सुनहरे घेरे वाला खगोलीय पिंड (%1$@) सच में दिखता है। टैप करते समय स्थिर रहें। दो बार टैप: रीसेट।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca lo schermo dove vedi davvero l'astro dell'anello dorato (%1$@). Resta fermo mentre tocchi. Doppio tocco: azzera."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "金色の輪の天体（%1$@）が実際に見える場所を画面でタップしてください。タップ中は動かさないで。ダブルタップ：リセット。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "금색 고리 속 천체(%1$@)가 실제로 보이는 곳을 화면에서 탭하세요. 탭할 때 움직이지 마세요. 두 번 탭: 초기화."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque na tela onde você realmente vê o astro do aro dourado (%1$@). Fique parado ao tocar. Toque duplo: zerar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Коснитесь экрана там, где вы на самом деле видите светило в золотом кольце (%1$@). Не двигайтесь при касании. Двойное касание: сброс."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在屏幕上点按你真实看到金色圆环中天体（%1$@）的位置。点按时保持不动。双击：归零。"
     }
    }
   }
  },
  "mirar_ayuda_camara": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "وجّه الهاتف إلى السماء: الخطوط تصل نجوم كل كوكبة والحلقات تحدد موضع كل نجم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Richte es auf den Himmel: Linien verbinden die Sterne jedes Sternbilds, Ringe zeigen, wo jeder steht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Point at the sky: lines join the stars of each constellation and rings mark where each one is."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apunta al cielo: las líneas unen las estrellas de cada constelación y los aros marcan dónde está cada una."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vise le ciel : les lignes relient les étoiles de chaque constellation et les cercles montrent où se trouve chacune."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आसमान की ओर करें: रेखाएँ हर तारामंडल के तारों को जोड़ती हैं और घेरे बताते हैं कि हर तारा कहाँ है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Punta al cielo: le linee uniscono le stelle di ogni costellazione e gli anelli segnano dove si trova ognuna."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "空に向けてください。線が星座の星を結び、輪がそれぞれの星の位置を示します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하늘을 향하세요. 선은 별자리의 별들을 잇고, 동그라미는 각 별의 위치를 표시합니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Aponte para o céu: as linhas unem as estrelas de cada constelação e os aros marcam onde cada uma está."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Наведи на небо: линии соединяют звёзды каждого созвездия, а кольца отмечают, где каждая из них."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "对准天空：线条连接每个星座的星星，圆圈标出每颗星的位置。"
     }
    }
   }
  },
  "mirar_ayuda_sensor": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "وجّه هاتفك: ما تراه هو السماء التي خلف الشاشة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Richte dein Handy aus: Du siehst den Himmel hinter dem Bildschirm."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Point your phone: what you see is the sky behind the screen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apunta con el teléfono: lo que ves es el cielo que está detrás de la pantalla."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pointe ton téléphone : ce que tu vois, c'est le ciel derrière l'écran."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "फ़ोन को आकाश की ओर करें: स्क्रीन के पीछे का आकाश दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Punta il telefono: ciò che vedi è il cielo dietro lo schermo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "スマホを向けてください。画面の向こうにある空が見えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "휴대폰을 향해 보세요. 화면 뒤에 있는 하늘이 보여요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Aponte o celular: o que você vê é o céu atrás da tela."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Наведите телефон: вы видите небо за экраном."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "举起手机对准天空：你看到的就是屏幕后方的天空。"
     }
    }
   }
  },
  "mirar_calibrado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم: أصبح %1$@ في مكانه. إن بدا منزاحًا بعد، اسحب للضبط الدقيق ثم المس تم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Fertig: %1$@ sitzt jetzt richtig. Wirkt es noch verschoben, zieh zum Feinjustieren und tippe auf Fertig."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Done: %1$@ is now in place. If it still looks off, drag to fine-tune and tap Done."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Listo: %1$@ quedó en su lugar. Si aún se ve corrido, arrastra para afinar y toca Listo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "C'est fait : %1$@ est à sa place. Si c'est encore décalé, fais glisser pour affiner puis touche Terminé."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हो गया: %1$@ अपनी जगह पर आ गया। अगर अभी भी खिसका लगे, तो बारीक समायोजन के लिए खींचें और हो गया टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fatto: %1$@ è al suo posto. Se sembra ancora spostato, trascina per rifinire e tocca Fatto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "完了：%1$@が正しい位置に合いました。まだずれていれば、ドラッグで微調整して完了をタップ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "완료: %1$@이(가) 제자리에 맞춰졌어요. 아직 어긋나 보이면 드래그로 미세 조정하고 완료를 탭하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pronto: %1$@ ficou no lugar. Se ainda parecer deslocado, arraste para ajustar e toque em Pronto."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Готово: %1$@ на своём месте. Если всё ещё сдвинуто, перетащите для точной настройки и нажмите «Готово»."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "完成：%1$@ 已对准。如果仍有偏差，拖动微调后点按完成。"
     }
    }
   }
  },
