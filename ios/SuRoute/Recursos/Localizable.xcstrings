  "bi_sueno_cuenta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "النوم مهم: في الأيام التي نمت فيها 7 ساعات أو أكثر كان طقسك مريحًا بنسبة %1$ld %%؛ ومع نوم أقل %2$ld %%."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schlaf zählt: An Tagen mit 7 Stunden oder mehr war dein Wetter zu %1$ld %% angenehm; mit weniger Schlaf zu %2$ld %%."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sleep matters: on days you slept 7 hours or more, your weather was pleasant %1$ld %%; with less sleep, %2$ld %%."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El sueño cuenta: los días que dormiste 7 horas o más, tu clima fue agradable el %1$ld %%; con menos sueño, el %2$ld %%."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le sommeil compte : les jours où tu as dormi 7 heures ou plus, ta météo était agréable à %1$ld %% ; avec moins de sommeil, à %2$ld %%."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "नींद मायने रखती है: 7 घंटे या ज़्यादा सोने वाले दिनों में मौसम %1$ld %% सुखद रहा; कम नींद में %2$ld %%।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il sonno conta: nei giorni con 7 ore o più, il tuo clima è stato piacevole il %1$ld %%; con meno sonno, il %2$ld %%."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "睡眠は大事：7時間以上眠った日は %1$ld %% が心地よい天気、睡眠が少ない日は %2$ld %%。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "수면이 중요해요: 7시간 이상 잔 날은 %1$ld %%가 기분 좋은 날씨였고, 적게 잔 날은 %2$ld %%였습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O sono conta: nos dias em que dormiu 7 horas ou mais, seu clima foi agradável em %1$ld %%; com menos sono, %2$ld %%."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сон важен: в дни, когда ты спал 7 часов и больше, погода была приятной в %1$ld %% случаев; при меньшем сне — в %2$ld %%."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "睡眠很重要：睡满 7 小时的日子里，%1$ld %% 是愉快的天气；睡得少时为 %2$ld %%。"
     }
    }
   }
  },
