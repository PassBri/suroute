  "cp_ritmo_cerca": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إيقاعان متقاربان: مع اتفاقات واضحة، يرافق أحدكما الآخر جيدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ähnliches Tempo: Mit klaren Absprachen begleitet ihr euch gut."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Close paces: with clear agreements, you keep each other good company."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ritmos cercanos: con acuerdos claros, se acompañan bien."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rythmes proches : avec des accords clairs, vous vous accompagnez bien."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मिलती-जुलती गतियाँ: साफ़ समझौतों के साथ आप अच्छा साथ निभाते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ritmi vicini: con accordi chiari, vi accompagnate bene."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "近いペース：はっきりした約束があれば、うまく寄り添える。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "비슷한 속도: 분명한 약속이 있으면 잘 함께 갈 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ritmos próximos: com acordos claros, vocês se acompanham bem."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Близкие темпы: с чёткими договорённостями вы хорошо сопровождаете друг друга."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "节奏相近：有清晰的约定，就能好好相伴。"
     }
    }
   }
  },
  "cp_ritmo_igual": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تسيران بالإيقاع نفسه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ihr geht im gleichen Tempo."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You walk at the same pace."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Caminan al mismo ritmo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous marchez au même rythme."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप एक ही गति से चल रहे हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminate allo stesso ritmo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ふたりは同じペースで歩いている。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "같은 속도로 걷고 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Vocês caminham no mesmo ritmo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы идёте в одном темпе."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你们步调一致。"
     }
    }
   }
  },
  "cp_ritmo_opuesto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إيقاعان متعاكسان: سيشعر أحدكما دائمًا أن الآخر يبطئه أو يضغط عليه. تحدّثا في ذلك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gegensätzliches Tempo: Einer wird immer das Gefühl haben, dass der andere bremst oder drängt. Sprecht darüber."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Opposite paces: one will always feel the other is holding them back or pushing them. Talk about it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ritmos opuestos: uno siempre sentirá que el otro lo frena o lo presiona. Háblenlo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rythmes opposés : l'un sentira toujours que l'autre le freine ou le presse. Parlez-en."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "उलटी गतियाँ: एक को हमेशा लगेगा कि दूसरा उसे रोक रहा है या धकेल रहा है। इस पर बात करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ritmi opposti: uno sentirà sempre che l'altro lo frena o lo pressa. Parlatene."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "正反対のペース：どちらかがいつも、相手にブレーキをかけられている、または急かされていると感じる。話し合おう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "정반대의 속도: 한 사람은 늘 상대가 자신을 붙잡거나 재촉한다고 느껴요. 함께 이야기해 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ritmos opostos: um sempre vai sentir que o outro o freia ou o pressiona. Conversem sobre isso."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Противоположные темпы: одному всегда будет казаться, что другой его тормозит или подгоняет. Обсудите это."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "节奏相反：一方总会觉得另一方在拖慢或催促自己。好好谈一谈。"
     }
    }
   }
  },
  "cp_rojas_aviso": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حدّدت %1$ld من الرايات الحمراء. وإن كانت العلاقة فوق ذلك تبعدك عن قمتك، فقد حان وقت محادثة صادقة، مع شريكك ومع نفسك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast %1$ld Red Flags markiert. Wenn dich die Beziehung außerdem von deinem Gipfel entfernt, ist ein ehrliches Gespräch fällig, mit deinem Partner und mit dir selbst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You marked %1$ld red flags. If the relationship also takes you away from your summit, it's time for an honest conversation, with your partner and with yourself."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marcaste %1$ld red flags. Si además la relación te aleja de tu cumbre, toca una conversación honesta, con tu pareja y contigo mismo/a."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as coché %1$ld red flags. Si en plus la relation t'éloigne de ton sommet, il est temps d'avoir une conversation honnête, avec ton/ta partenaire et avec toi-même."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने %1$ld red flags चुने। अगर साथ ही यह रिश्ता आपको आपके शिखर से दूर ले जाता है, तो एक ईमानदार बातचीत का समय है, अपने साथी से भी और खुद से भी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai segnato %1$ld red flag. Se in più la relazione ti allontana dalla tua vetta, è il momento di una conversazione onesta, con il tuo partner e con te stesso/a."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld個の red flags にチェックしました。さらにこの関係が頂から遠ざけているなら、正直に話すときです。パートナーとも、自分自身とも。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "red flags를 %1$ld개 표시했어요. 게다가 이 관계가 나를 정상에서 멀어지게 한다면, 연인과도 나 자신과도 솔직한 대화가 필요해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você marcou %1$ld red flags. Se além disso a relação afasta você do seu cume, é hora de uma conversa honesta, com seu par e consigo mesmo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты отметил(а) red flags: %1$ld. Если к тому же отношения отдаляют тебя от вершины, пора честно поговорить — с партнёром и с собой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你勾选了 %1$ld 个 red flags。如果这段关系还让你远离顶峰，就该进行一次诚实的对话——和伴侣，也和你自己。"
     }
    }
   }
  },
