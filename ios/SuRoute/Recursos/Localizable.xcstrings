  "cu_cif_falta_bloqueo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "فعّل أولًا القفل بالبصمة أو الوجه لتتمكن من تشفير أموالك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aktiviere zuerst die Sperre mit Fingerabdruck oder Gesicht, um deine Finanzen verschlüsseln zu können."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Turn on fingerprint or face lock first so you can encrypt your finances."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Activa primero el bloqueo con huella o rostro para poder cifrar tus finanzas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Active d'abord le verrou par empreinte ou visage pour pouvoir chiffrer tes finances."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपने वित्त को एन्क्रिप्ट करने के लिए पहले फ़िंगरप्रिंट या चेहरे से लॉक चालू करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva prima il blocco con impronta o volto per poter cifrare le tue finanze."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "お金を暗号化するには、まず指紋・顔ロックをオンにしてください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "재정을 암호화하려면 먼저 지문·얼굴 잠금을 켜세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ative primeiro o bloqueio com digital ou rosto para poder criptografar suas finanças."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сначала включи блокировку отпечатком или лицом, чтобы зашифровать свои финансы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "请先开启指纹或面部锁，才能加密你的财务。"
     }
    }
   }
  },
