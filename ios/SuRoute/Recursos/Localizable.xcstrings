    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "頂上で会いましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "정상에서 만나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nos vemos no cume."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Увидимся на вершине."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "顶峰见。"
     }
    }
   }
  },
  "carta_empezar": {
   "extractionState": "manual",
   "localizations": {
