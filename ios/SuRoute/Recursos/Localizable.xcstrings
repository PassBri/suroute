  "prioridad_b_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "غير عاجل لكنه عالي القيمة. خصّص وقتًا محددًا للتقدّم فيه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nicht dringend, aber sehr wertvoll. Plane gezielt Zeit dafür ein."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Not urgent, but high value. Schedule specific time to move forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No urgente, pero de alto valor. Planifica tiempo específico para avanzar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas urgent, mais de grande valeur. Prévois du temps précis pour avancer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "तुरंत नहीं, पर बहुत मूल्यवान। आगे बढ़ने के लिए अलग से समय तय करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non urgente, ma di alto valore. Pianifica un tempo specifico per avanzare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "緊急ではないが価値が高い。進めるための時間をしっかり確保しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "급하지 않지만 가치가 커요. 진행할 시간을 따로 계획하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não urgente, mas de alto valor. Reserve um tempo específico para avançar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не срочно, но очень ценно. Запланируй отдельное время для продвижения."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "不紧急，但价值很高。安排专门的时间推进。"
     }
    }
   }
  },
