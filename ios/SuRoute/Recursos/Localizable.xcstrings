  "ruta_semana_resumen": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم إنجاز %1$ld من %2$ld عادات هذا الأسبوع"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld von %2$ld Gewohnheiten diese Woche erfüllt"
     }
    },
    "en": {
