  "estado_en_pausa_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الهدف متوقف مؤقتًا بسبب عقبة أو قرار استراتيجي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Ziel ruht vorübergehend wegen eines Hindernisses oder einer strategischen Entscheidung."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The goal is temporarily stopped by an obstacle or a strategic decision."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La meta está detenida temporalmente por un obstáculo o una decisión estratégica."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'objectif est temporairement à l'arrêt à cause d'un obstacle ou d'un choix stratégique."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किसी बाधा या रणनीतिक फ़ैसले के कारण लक्ष्य अस्थायी रूप से रुका है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'obiettivo è fermo temporaneamente a causa di un ostacolo o di una scelta strategica."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "障害や戦略的な判断により、目標は一時的に止まっています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "장애물이나 전략적 결정으로 목표가 잠시 멈춰 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A meta está parada temporariamente por um obstáculo ou uma decisão estratégica."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цель временно остановлена из-за препятствия или стратегического решения."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目标因障碍或战略决定而暂时停下。"
     }
    }
   }
  },
