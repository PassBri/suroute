  "ex_hito_cumbre_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ربحت الخطوات الـ64 كلها في بوصلتك. اغرس العلم وأخبر مجتمعك كيف كان الصعود."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Alle 64 Schritte deines Kompasses sind geschafft. Pflanz die Fahne und erzähl deiner Gemeinschaft vom Aufstieg."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "All 64 steps of your Compass are won. Plant the flag and tell your community how the climb went."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los 64 pasos de tu Brújula están ganados. Planta la bandera y cuéntale a tu comunidad cómo fue el ascenso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les 64 pas de votre Boussole sont gagnés. Plantez le drapeau et racontez à votre communauté comment s'est passée l'ascension."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके कम्पास के सभी 64 कदम पूरे हो गए। झंडा गाड़ें और अपने समुदाय को चढ़ाई के बारे में बताएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "I 64 passi della tua Bussola sono conquistati. Pianta la bandiera e racconta alla tua comunità com'è stata la salita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コンパスの 64 歩をすべて達成しました。旗を立てて、登りの様子をコミュニティに伝えましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나침반의 64걸음을 모두 이뤘어요. 깃발을 꽂고 커뮤니티에 오르막 이야기를 들려주세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os 64 passos da sua Bússola estão ganhos. Finque a bandeira e conte à sua comunidade como foi a subida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Все 64 шага вашего Компаса пройдены. Водрузите флаг и расскажите сообществу о восхождении."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你指南针的 64 步全部完成。插上旗帜，告诉你的社区这段攀登。"
     }
    }
   }
  },
