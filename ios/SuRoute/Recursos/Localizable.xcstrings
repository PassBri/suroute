  "tarjeta_voz": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صوتك الأصيل أثمن من صوتك المقبول."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine authentische Stimme ist wertvoller als deine angepasste."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your authentic voice is worth more than your acceptable voice."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu voz auténtica es más valiosa que tu voz aceptable."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta voix authentique vaut plus que ta voix acceptable."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी सच्ची आवाज़ आपकी स्वीकार्य आवाज़ से ज़्यादा क़ीमती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua voce autentica vale più della tua voce accettabile."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "無難な声より、あなたらしい声のほうが価値があります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나다운 목소리가 무난한 목소리보다 더 값져요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sua voz autêntica vale mais que sua voz aceitável."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твой настоящий голос ценнее удобного голоса."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你真实的声音，比讨喜的声音更珍贵。"
     }
    }
   }
  },
