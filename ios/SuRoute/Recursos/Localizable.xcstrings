  "modelo_c4_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل يوم تتقدم في خطوة. الخطوة لا تُعلَّم بعلامة: بل تُكسب بأيام سير، أي أيام مختلفة تقدمت فيها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeden Tag kommst du bei einem Schritt voran. Ein Schritt wird nicht abgehakt: Er wird mit Etappentagen verdient, verschiedenen Tagen, an denen du vorangekommen bist."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every day you move forward on a step. A step is not ticked off: it is earned with workdays, different days on which you moved forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada día avanzas en un paso. Un paso no se marca: se gana con jornadas, días distintos en que avanzaste."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque jour tu avances sur un pas. Un pas ne se coche pas : il se gagne avec des journées, des jours différents où tu as avancé."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर दिन आप एक कदम पर आगे बढ़ते हैं। कदम पर निशान नहीं लगाया जाता: वह यात्रा-दिनों से कमाया जाता है, यानी अलग-अलग दिन जब आप आगे बढ़े।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni giorno avanzi in un passo. Un passo non si spunta: si conquista con giornate, giorni diversi in cui sei avanzato."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎日一つのステップを進めます。ステップはチェックするものではなく、行程日（進めた別々の日）で勝ち取るものです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "매일 한 걸음씩 나아갑니다. 걸음은 체크하는 것이 아니라 여정일, 즉 나아간 서로 다른 날들로 얻는 것입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada dia você avança em um passo. Um passo não se marca: se conquista com jornadas, dias diferentes em que você avançou."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый день ты продвигаешься в одном шаге. Шаг не отмечается галочкой: его зарабатывают переходами — разными днями, когда ты продвинулся."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每天在一个步骤上前进。步骤不是勾选的：要用行程日来赢得，也就是你前进的不同日子。"
     }
    }
   }
  },
