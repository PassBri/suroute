  "bi_h_mover_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "امشِ أو تمدد أو اصعد الدرج: الجسد يساعد على تغيير الطقس."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Geh, dehn dich oder nimm die Treppe: Der Körper hilft, das Wetter zu ändern."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk, stretch or take the stairs: your body helps change the weather."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Camina, estírate o sube escaleras: el cuerpo ayuda a cambiar el clima."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Marche, étire-toi ou monte des escaliers : le corps aide à changer la météo."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चलें, स्ट्रेच करें या सीढ़ियाँ चढ़ें: शरीर मौसम बदलने में मदद करता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina, allungati o fai le scale: il corpo aiuta a cambiare il clima."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "歩く、伸びる、階段を上る。体が天気を変える手助けをします。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "걷기, 스트레칭, 계단 오르기. 몸이 날씨를 바꾸는 걸 돕습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Caminhe, alongue-se ou suba escadas: o corpo ajuda a mudar o clima."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пройдись, потянись или поднимись по лестнице: тело помогает сменить погоду."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "走走、伸展或爬楼梯：身体能帮助改变天气。"
     }
    }
   }
  },
