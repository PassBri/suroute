  "legal_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كيف نحمي بياناتك وقواعد الخدمة، وفق القانون الكولومبي 1581 لسنة 2012. الوثائق باللغة الإسبانية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wie wir deine Daten schützen und die Regeln des Dienstes, nach dem kolumbianischen Gesetz 1581 von 2012. Die Dokumente sind auf Spanisch."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "How we look after your data and the rules of the service, under Colombia's Law 1581 of 2012. The documents are in Spanish."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cómo cuidamos tus datos y las reglas del servicio, según la Ley 1581 de 2012 de Colombia. Los documentos están en español."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Comment nous protégeons tes données et les règles du service, selon la loi colombienne 1581 de 2012. Les documents sont en espagnol."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कोलंबिया के 2012 के कानून 1581 के अनुसार हम तुम्हारे डेटा की देखभाल कैसे करते हैं और सेवा के नियम। दस्तावेज़ स्पेनिश में हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Come proteggiamo i tuoi dati e le regole del servizio, secondo la legge colombiana 1581 del 2012. I documenti sono in spagnolo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コロンビア法 1581 号（2012 年）に基づく、データの扱いとサービスのルールです。文書はスペイン語です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "콜롬비아 2012년 법률 제1581호에 따라 데이터를 보호하는 방법과 서비스 규칙이에요. 문서는 스페인어로 되어 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Como cuidamos dos seus dados e as regras do serviço, segundo a Lei 1581 de 2012 da Colômbia. Os documentos estão em espanhol."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Как мы бережём ваши данные и правила сервиса — по закону Колумбии 1581 от 2012 года. Документы на испанском."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我们如何保护你的数据以及服务规则，依据哥伦比亚 2012 年第 1581 号法律。文件为西班牙语。"
     }
    }
   }
  },
