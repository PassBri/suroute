  "ios_coach_error": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم يردّ المدرّب. تحقّق من اتصالك أو حاول لاحقًا (هناك حد يومي للرسائل)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Coach hat nicht geantwortet. Prüfe die Verbindung oder versuche es später (es gibt ein Tageslimit)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The coach didn't reply. Check your connection or try later (there's a daily message limit)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El coach no respondió. Revisa tu conexión o inténtalo más tarde (hay un límite de mensajes por día)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le coach n'a pas répondu. Vérifiez votre connexion ou réessayez plus tard (limite quotidienne de messages)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कोच ने जवाब नहीं दिया। कनेक्शन जाँचें या बाद में कोशिश करें (रोज़ की संदेश सीमा है)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il coach non ha risposto. Controlla la connessione o riprova più tardi (c'è un limite giornaliero)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コーチから返答がありません。接続を確認するか、後でお試しください（1日の上限があります）。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "코치가 답하지 않았어요. 연결을 확인하거나 나중에 다시 시도하세요(하루 메시지 한도가 있어요)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O coach não respondeu. Verifique a conexão ou tente mais tarde (há um limite diário de mensagens)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Коуч не ответил. Проверьте подключение или попробуйте позже (есть дневной лимит)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "教练没有回复。请检查网络或稍后再试（每天有消息上限）。"
     }
    }
   }
  },
