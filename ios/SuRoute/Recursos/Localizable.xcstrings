    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ज़्यादातर काम हो चुका है; बस समापन बाक़ी है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La maggior parte del lavoro è fatta; manca la chiusura."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "作業の大半は終わり、あとは仕上げです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "대부분의 작업을 마쳤고 마무리만 남았어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A maior parte do trabalho está feita; falta o fechamento."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Основная часть работы сделана; осталось завершить."
