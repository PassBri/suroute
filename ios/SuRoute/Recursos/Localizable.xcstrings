  "suspension_apelar": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إن كنت تعتقد أنه خطأ، راسلنا: سنراجعه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du glaubst, dass das ein Fehler ist, schreib uns: Wir prüfen es."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If you think this is a mistake, write to us: we'll review it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si crees que es un error, escríbenos: lo revisamos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Si tu penses que c'est une erreur, écris-nous : nous le réexaminerons."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अगर तुम्हें लगता है यह गलती है, हमें लिखो: हम दोबारा देखेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se pensi che sia un errore, scrivici: lo riesamineremo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "誤りだと思う場合はご連絡ください。確認します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오류라고 생각되면 알려 주세요. 다시 검토할게요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se acha que é um erro, escreva para nós: vamos revisar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если считаете это ошибкой, напишите нам — мы пересмотрим."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果你认为有误，请联系我们，我们会复核。"
     }
    }
   }
  },
