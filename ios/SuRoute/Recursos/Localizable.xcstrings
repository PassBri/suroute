  "nivel_5_anios_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمتك بعد 5 أو 10 أو 15 أو 20 سنة: الوجهة التي ستغيّر حياتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Gipfel in 5, 10, 15 oder 20 Jahren: das Ziel, das dein Leben verändert."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your summit in 5, 10, 15 or 20 years: the destination that will transform your life."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cumbre a 5, 10, 15 o 20 años: el destino que transformará tu vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton sommet à 5, 10, 15 ou 20 ans : la destination qui transformera ta vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "5, 10, 15 या 20 वर्षों में आपका शिखर: वह मंज़िल जो आपका जीवन बदल देगी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vetta a 5, 10, 15 o 20 anni: la meta che trasformerà la tua vita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "5年、10年、15年、20年後の頂上。人生を変える目的地。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "5년, 10년, 15년, 20년 후의 정상: 당신의 삶을 바꿀 목적지."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu cume em 5, 10, 15 ou 20 anos: o destino que vai transformar sua vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя вершина через 5, 10, 15 или 20 лет: цель, которая изменит жизнь."
