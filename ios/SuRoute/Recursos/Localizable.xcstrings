     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "雪崩法か雪だるま法で計画を立てる"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "눈사태 또는 눈덩이 방식으로 계획 세우기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Monte seu plano com avalanche ou bola de neve"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Составь план: лавина или снежный ком"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用雪崩法或雪球法制定计划"
     }
    }
   }
  },
