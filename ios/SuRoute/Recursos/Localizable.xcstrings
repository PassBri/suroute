  "bm_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل طقسك وعاداتك كل يوم وسترى المجموع هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Notiere jeden Tag dein Wetter und deine Gewohnheiten, dann siehst du hier die Summe."
