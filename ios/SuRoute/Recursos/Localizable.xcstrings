  "ng_corr_a": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في المتناول: يُحتسب في السيولة الجارية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Kurzfristig verfügbar: zählt zur Liquidität."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "At hand: counts in the current ratio."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "A la mano: cuenta en la liquidez corriente."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Disponible : compte dans la liquidité générale."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हाथ में: चालू अनुपात में गिना जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "A portata di mano: conta nell'indice di liquidità."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "すぐ使える：流動比率に含まれます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "바로 쓸 수 있음: 유동비율에 포함돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "À mão: conta na liquidez corrente."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Под рукой: учитывается в текущей ликвидности."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "随时可用：计入流动比率。"
     }
    }
   }
  },
  "ng_corr_p": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يُدفع هذا العام: يُحتسب في السيولة الجارية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieses Jahr fällig: zählt zur Liquidität."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Due this year: counts in the current ratio."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se paga este año: cuenta en la liquidez corriente."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "À payer cette année : compte dans la liquidité générale."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस साल चुकाना है: चालू अनुपात में गिना जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Da pagare quest'anno: conta nell'indice di liquidità."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今年支払う：流動比率に含まれます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "올해 갚을 돈: 유동비율에 포함돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Vence este ano: conta na liquidez corrente."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Платится в этом году: учитывается в текущей ликвидности."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "今年要还：计入流动比率。"
     }
    }
   }
