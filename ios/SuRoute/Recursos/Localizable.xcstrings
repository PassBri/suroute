     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "歩き出す"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "걸어가기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Caminhe"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Иди"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "出发前行"
     }
    }
   }
  },
  "etapa_3_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اعبر البوابات، وأقم مخيمك الأساسي، واختر رفقتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Durchquere die Tore, baue dein Basislager auf und such dir Begleitung."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cross the gateways, set up your base camp and choose your company."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cruza los portales, arma tu campamento base y elige compañía."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Franchis les portails, installe ton camp de base et choisis tes compagnons."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "द्वार पार करें, अपना बेस कैंप बनाएँ और साथी चुनें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attraversa i portali, allestisci il tuo campo base e scegli i compagni di viaggio."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ゲートを越え、ベースキャンプを築き、仲間を選びましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "관문을 지나 베이스캠프를 꾸리고 함께할 동료를 골라 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cruze os portais, monte seu acampamento base e escolha sua companhia."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пройди врата, разбей базовый лагерь и выбери спутников."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "穿越关口，搭建大本营，选择同行的伙伴。"
     }
    }
   }
  },
  "etapa_4": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تجاوز العقبات"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hindernisse überwinden"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Overcome obstacles"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Supera obstáculos"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Surmonte les obstacles"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बाधाएँ पार करें"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Supera gli ostacoli"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "壁を乗り越える"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "장애물 넘기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Supere obstáculos"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Преодолевай препятствия"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "克服障碍"
     }
    }
   }
  },
  "etapa_4_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "انهض من العثرات، واخرج من الضباب، ولا تستسلم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Steh nach Stürzen wieder auf, finde aus dem Nebel und gib nicht auf."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get back up after falls, find your way out of the fog and don't give up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Levántate de las caídas, sal de la niebla y no abandones."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Relève-toi après les chutes, sors du brouillard et ne lâche rien."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "गिरकर उठें, कोहरे से बाहर निकलें और हार न मानें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rialzati dalle cadute, esci dalla nebbia e non mollare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "転んでも立ち上がり、霧を抜け、あきらめずに進みましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "넘어져도 다시 일어서고, 안개에서 빠져나오고, 포기하지 마세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Levante-se das quedas, saia da neblina e não desista."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вставай после падений, выходи из тумана и не сдавайся."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "跌倒后重新站起，走出迷雾，绝不放弃。"
     }
    }
   }
  },
  "etapa_5": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "احتفل بالقمة"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Feiere den Gipfel"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebrate the summit"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebra la cima"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Célèbre le sommet"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "शिखर का जश्न मनाएँ"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebra la vetta"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "山頂を祝う"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "정상 축하하기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebre o cume"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отпразднуй вершину"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "庆祝登顶"
     }
    }
   }
  },
  "etapa_5_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تأمّل من القمة، واحفظ شواهدك، وأغلق دورتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Genieße die Aussicht vom Gipfel, bewahre deine Belege und schließe deinen Zyklus ab."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take in the view from the top, keep your evidence and close your cycle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mira desde la cima, guarda tus evidencias y cierra tu ciclo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Contemple depuis le sommet, garde tes preuves et boucle ton cycle."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "शिखर से नज़ारा देखें, अपने प्रमाण सहेजें और अपना चक्र पूरा करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarda dall'alto, conserva le tue prove e chiudi il tuo ciclo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "山頂からの景色を眺め、成果を記録し、サイクルを締めくくりましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "정상에서 바라보고, 증거를 간직하고, 한 사이클을 마무리해 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Olhe do alto, guarde suas evidências e feche seu ciclo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Оглядись с вершины, сохрани свои доказательства и заверши свой цикл."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "站在山顶眺望，留存你的成果证据，为这段旅程画上句号。"
     }
    }
   }
  },
