  "brujula_con_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لدي مشروع يجمع محاوري الستة في جبل واحد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich habe ein Projekt, das meine sechs Achsen zu einem Berg vereint."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I have one project that brings my six axes together into a single mountain."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tengo un proyecto que une mis seis ejes en una sola montaña."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "J'ai un projet qui réunit mes six axes en une seule montagne."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मेरे पास एक प्रोजेक्ट है जो मेरे छह अक्षों को एक पहाड़ में जोड़ता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ho un progetto che unisce i miei sei assi in un'unica montagna."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "6つの軸を1つの山にまとめるプロジェクトがあります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "여섯 축을 하나의 산으로 잇는 프로젝트가 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenho um projeto que une meus seis eixos em uma só montanha."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "У меня есть проект, который соединяет мои шесть осей в одну гору."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我有一个项目，把我的六个轴汇成一座山。"
     }
    }
   }
  },
  "brujula_con_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صورة لك وأنت تعمل على المشروع الذي يمزج ما تعرفه وما تقوله وما تقدمه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Foto von dir bei der Arbeit an dem Projekt, das Wissen, Stimme und Beitrag verbindet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A photo of you working on the project that blends what you know, what you say and what you give."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una foto tuya trabajando en el proyecto que mezcla lo que sabes, lo que dices y lo que aportas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une photo de toi en train de travailler sur le projet qui mêle ce que tu sais, dis et apportes."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी वह तस्वीर जिसमें आप उस प्रोजेक्ट पर काम कर रहे हैं जो आपका ज्ञान, आवाज़ और योगदान मिलाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una tua foto mentre lavori al progetto che unisce ciò che sai, dici e dai."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "知っていること、話すこと、与えることを合わせたプロジェクトに取り組むあなたの写真。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아는 것, 말하는 것, 주는 것을 섞은 프로젝트를 하는 당신의 사진."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma foto sua trabalhando no projeto que mistura o que você sabe, diz e oferece."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоё фото за работой над проектом, который соединяет то, что ты знаешь, говоришь и даёшь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "一张你投入那个融合所知、所言与所给的项目的照片。"
     }
    }
   }
  },
