  "cv_compromiso_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عند حلول الموعد ستقول إن كنت قد نجحت أو ستعيد النظر، وسيرى مجتمعك النتيجة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn die Frist abläuft, sagst du, ob du es geschafft hast oder neu planst, und deine Community sieht den Ausgang."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When it's due you'll say whether you made it or are rethinking it, and your community will see the outcome."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al vencer dirás si lo lograste o lo replanteas, y tu comunidad verá el desenlace."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "À l'échéance, tu diras si tu as réussi ou si tu revois ton objectif, et ta communauté verra le dénouement."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "समय पूरा होने पर आप बताएँगे कि आपने इसे हासिल किया या इस पर दोबारा विचार करना है, और आपका समुदाय नतीजा देखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alla scadenza dirai se ce l'hai fatta o se lo stai ripensando, e la tua community vedrà com'è andata."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "期限が来たら、達成できたか見直すかを伝えます。コミュニティはその結末を見ることができます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "기한이 되면 해냈는지, 다시 계획하는지 알려 주세요. 커뮤니티가 그 결말을 보게 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando vencer, você vai dizer se conseguiu ou se está repensando, e sua comunidade verá o desfecho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда срок истечёт, ты скажешь, получилось ли у тебя или ты пересматриваешь цель, а сообщество увидит развязку."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "到期时，你要说明是做到了还是需要重新调整，社区会看到结果。"
     }
    }
   }
  },
