  "mandala_compartir_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ستُنشر صورة لبوصلتك فيها قمتك وصور معسكراتك ومسارك. من يمكنه رؤيتها؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Bild deines Kompasses mit Gipfel, Lagerfotos und Route wird gepostet. Wer darf es sehen?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "An image of your Compass is posted with your summit, your camp photos and your route. Who can see it?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se publica una imagen de tu Brújula con tu cumbre, las fotos de tus campamentos y tu ruta. ¿Quién la puede ver?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une image de ta Boussole est publiée avec ton sommet, les photos de tes camps et ta route. Qui peut la voir ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके शिखर, शिविरों की तस्वीरों और मार्ग के साथ आपके कम्पास की छवि पोस्ट होगी। इसे कौन देख सकता है?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Viene pubblicata un'immagine della tua Bussola con la vetta, le foto dei campi e la rotta. Chi può vederla?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "頂、キャンプの写真、ルートが入ったコンパスの画像を投稿します。誰が見られますか？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "정상, 캠프 사진, 루트가 담긴 나침반 이미지가 게시돼요. 누가 볼 수 있나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Será publicada uma imagem da sua Bússola com seu cume, as fotos dos seus acampamentos e sua rota. Quem pode ver?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Будет опубликовано изображение твоего Компаса с вершиной, фото лагерей и маршрутом. Кто может его видеть?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "将发布一张包含你的顶峰、营地照片和路线的指南针图片。谁可以看到？"
     }
    }
   }
  },
