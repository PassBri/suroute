  "mensajes_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا محادثات بعد. راسل شخصًا من منشور في المجتمع أو اسأل مدرّب حياة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Unterhaltungen. Schreib jemandem über einen Community-Beitrag oder frag einen Life-Coach."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No conversations yet. Message someone from a community post or ask a life coach."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no tienes conversaciones. Escríbele a alguien desde una publicación de la comunidad o pregúntale a un coach de vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore de conversations. Écris à quelqu’un depuis une publication de la communauté ou demande à un coach de vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी कोई बातचीत नहीं। समुदाय की किसी पोस्ट से किसी को संदेश भेजें या लाइफ़ कोच से पूछें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessuna conversazione. Scrivi a qualcuno da un post della community o chiedi a un life coach."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ会話はありません。コミュニティの投稿から誰かにメッセージを送るか、ライフコーチに相談しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 대화가 없어요. 커뮤니티 게시물에서 메시지를 보내거나 라이프 코치에게 물어보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ainda não tem conversas. Escreva para alguém a partir de uma publicação da comunidade ou pergunte a um coach de vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Переписок пока нет. Напиши кому-нибудь из публикации в сообществе или спроси лайф-коуча."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有对话。可以从社区帖子给别人发消息，或询问人生教练。"
     }
    }
   }
  },
