  "cu_capa_cuenta_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا يمكن لأحد غيرك قراءة حركاتك: قاعدة البيانات تعطيها لجلستك فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Niemand sonst kann deine Buchungen lesen: Die Datenbank gibt sie nur deiner Sitzung."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No one else can read your entries: the database only gives them to your session."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Nadie más puede leer tus movimientos: la base de datos solo los entrega a tu sesión."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Personne d’autre ne peut lire tes mouvements : la base ne les donne qu’à ta session."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कोई और आपके लेन-देन नहीं पढ़ सकता: डेटाबेस उन्हें सिर्फ़ आपके सत्र को देता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessun altro può leggere i tuoi movimenti: il database li consegna solo alla tua sessione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "他の人は記録を読めません：データベースはあなたのセッションにだけ渡します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "다른 사람은 내역을 볼 수 없어요: 데이터베이스는 내 세션에만 제공해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ninguém mais pode ler seus lançamentos: o banco de dados só os entrega à sua sessão."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Никто другой не видит твои записи: база отдаёт их только твоей сессии."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "别人看不到你的记录：数据库只向你的会话提供。"
     }
    }
   }
  },
