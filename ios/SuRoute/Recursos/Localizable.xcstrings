  "cu_extra": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كم يمكنك أن تدفع إضافيًا كل شهر فوق الحد الأدنى؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wie viel kannst du monatlich zusätzlich zu den Mindestraten zahlen?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "How much more can you pay each month, beyond the minimums?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Cuánto más puedes pagar cada mes, además de los mínimos?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Combien de plus peux-tu payer chaque mois, en plus des minimums ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "न्यूनतम के अलावा हर महीने कितना और दे सकते हैं?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quanto puoi pagare in più ogni mese, oltre ai minimi?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最低返済額に加えて毎月いくら払えますか？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최소 상환액 외에 매달 얼마를 더 낼 수 있나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quanto mais você pode pagar por mês, além dos mínimos?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сколько ещё можешь платить в месяц сверх минимума?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "除最低还款外，你每月还能多还多少？"
     }
    }
   }
  },
  "cu_extra_a": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل ما يمكنك دفعه زيادةً يذهب إلى %1$@؛ والبقية الحد الأدنى فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Alles, was du extra zahlen kannst, geht an %1$@; die anderen bekommen nur ihre Mindestrate."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Everything extra you can pay goes to %1$@; the others get only their minimum."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todo lo que puedes pagar de más va a %1$@; a las demás, solo su mínimo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tout ce que tu peux payer en plus va à %1$@ ; les autres, seulement leur minimum."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जितना ज़्यादा भर सकें, सब %1$@ पर; बाकी पर सिर्फ़ न्यूनतम।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tutto ciò che puoi pagare in più va a %1$@; agli altri solo il minimo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "追加で払える分はすべて %1$@ へ。ほかは最低返済のみ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "더 낼 수 있는 돈은 모두 %1$@에; 나머지는 최소 상환만."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Tudo o que você puder pagar a mais vai para %1$@; as demais, só o mínimo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Всё, что можешь заплатить сверху, идёт на %1$@; остальным — только минимум."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你能多还的钱都给 %1$@；其他只还最低额。"
     }
    }
   }
  },
