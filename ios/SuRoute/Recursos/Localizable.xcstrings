  "bi_privado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "طقسك الداخلي خاص: لا يُشارك في المجتمع أبدًا. SuRoute يرافقك ولا يحل محل مختص في الصحة النفسية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein inneres Wetter ist privat: Es wird nie in der Community geteilt. SuRoute begleitet, ersetzt aber keine Fachperson für psychische Gesundheit."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your inner weather is private: it is never shared in the community. SuRoute walks with you; it does not replace a mental health professional."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu clima interior es privado: no se comparte en la comunidad. SuRoute acompaña, no reemplaza a un profesional de la salud mental."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta météo intérieure est privée : elle n'est jamais partagée dans la communauté. SuRoute accompagne, il ne remplace pas un professionnel de santé mentale."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका भीतरी मौसम निजी है: इसे समुदाय में कभी साझा नहीं किया जाता। SuRoute साथ देता है, मानसिक स्वास्थ्य विशेषज्ञ की जगह नहीं लेता।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il tuo clima interiore è privato: non viene mai condiviso nella comunità. SuRoute accompagna, non sostituisce un professionista della salute mentale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "心の天気は非公開で、コミュニティには共有されません。SuRoute は寄り添いますが、メンタルヘルスの専門家の代わりにはなりません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "마음 날씨는 비공개이며 커뮤니티에 공유되지 않습니다. SuRoute는 곁에서 돕지만 정신건강 전문가를 대신하지는 않습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu clima interior é privado: não é compartilhado na comunidade. O SuRoute acompanha, não substitui um profissional de saúde mental."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя внутренняя погода — личное: она никогда не публикуется в сообществе. SuRoute поддерживает, но не заменяет специалиста по психическому здоровью."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的内心天气是私密的：不会在社区中分享。SuRoute 陪伴你，但不能替代心理健康专业人士。"
     }
    }
   }
  },
  "bi_repite": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ما يتكرر"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was sich wiederholt"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What repeats"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que se repite"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce qui se répète"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जो दोहराता है"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cosa si ripete"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "くり返すこと"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "반복되는 것"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que se repete"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Что повторяется"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "反复出现的"
     }
    }
   }
  },
  "bi_repite_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل طقسك بضعة أيام وسترى ما يتكرر: ما يجلب العاصفة، وما يعيد الهدوء، وكيف يؤثر النوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Markiere ein paar Tage dein Wetter, dann siehst du, was sich wiederholt: was Gewitter bringt, was Ruhe zurückgibt und wie der Schlaf wirkt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Mark your weather for a few days and you'll see what repeats: what brings storms, what restores calm and how sleep influences you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marca tu clima unos días y aquí verás lo que se repite: qué te trae tormenta, qué te devuelve la calma y cómo influye tu sueño."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Note ta météo quelques jours et tu verras ce qui se répète : ce qui amène l'orage, ce qui ramène le calme et l'effet du sommeil."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कुछ दिन अपना मौसम दर्ज करें और यहाँ दिखेगा कि क्या दोहराता है: तूफ़ान क्या लाता है, शांति क्या लौटाती है और नींद का असर।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Segna il tuo clima per qualche giorno e vedrai cosa si ripete: cosa porta tempesta, cosa riporta la calma e come incide il sonno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "数日間天気をつけると、くり返すことが見えてきます。何が嵐を呼び、何が落ち着きを戻し、睡眠がどう影響するか。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "며칠간 날씨를 기록하면 반복되는 것이 보입니다. 무엇이 폭풍을 부르고, 무엇이 평온을 되찾게 하며, 수면이 어떤 영향을 주는지."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Marque seu clima alguns dias e aqui verá o que se repete: o que traz tempestade, o que devolve a calma e como o sono influencia."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отмечай погоду несколько дней, и здесь будет видно, что повторяется: что приносит грозу, что возвращает спокойствие и как влияет сон."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "记录几天你的天气，就能看到反复出现的规律：什么带来暴风雨，什么让你恢复平静，睡眠有何影响。"
     }
    }
   }
  },
  "bi_resp_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شهيق 4 ثوانٍ، احبس 4، زفير 4، واحبس 4. أربع دورات تساوي دقيقة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "4 Sekunden ein, 4 halten, 4 aus und 4 halten. Vier Runden sind eine Minute."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale 4 seconds, hold 4, exhale 4 and hold 4. Four rounds make a minute."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhala 4 segundos, sostén 4, exhala 4 y sostén 4. Cuatro vueltas son un minuto."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspire 4 secondes, retiens 4, expire 4 et retiens 4. Quatre tours font une minute."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "4 सेकंड साँस लें, 4 रोकें, 4 छोड़ें और 4 रोकें। चार चक्कर एक मिनट हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira 4 secondi, trattieni 4, espira 4 e trattieni 4. Quattro giri fanno un minuto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "4秒吸って、4秒止め、4秒吐いて、4秒止める。4周で1分です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "4초 들이쉬고, 4초 멈추고, 4초 내쉬고, 4초 멈춥니다. 네 바퀴가 1분입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspire 4 segundos, segure 4, expire 4 e segure 4. Quatro voltas são um minuto."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вдох 4 секунды, задержка 4, выдох 4 и задержка 4. Четыре круга — минута."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气 4 秒，屏住 4 秒，呼气 4 秒，再屏住 4 秒。四轮就是一分钟。"
     }
    }
   }
  },
