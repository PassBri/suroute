     "stringUnit": {
      "state": "translated",
      "value": "لم تختر بعد أهداف هذا الشهر. اخترها في الشهر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast noch keine Ziele für diesen Monat gewählt. Wähle sie im Monat."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You haven't chosen which goals to work on this month. Choose them in the month."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no eliges qué metas trabajar este mes. Elígelas en el mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous n'avez pas encore choisi vos objectifs du mois. Choisissez-les dans le mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने अभी इस महीने के लक्ष्य नहीं चुने। उन्हें महीने में चुनें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non hai ancora scelto gli obiettivi del mese. Sceglili nel mese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今月取り組む目標をまだ選んでいません。月の画面で選びましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 달에 할 목표를 아직 고르지 않았어요. 월 화면에서 고르세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ainda não escolheu quais metas trabalhar este mês. Escolha-as no mês."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы ещё не выбрали цели на этот месяц. Выберите их в месяце."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你还没选择本月要做的目标。请在月份中选择。"
     }
    }
   }
  },
