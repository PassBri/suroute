    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दीर्घकालिक: चालू अनुपात में नहीं गिना जाता।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "A lungo termine: non conta nell'indice di liquidità."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "長期：流動比率には含まれません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
