    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anota tu clima y tus hábitos cada día y aquí verás el acumulado."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Note ta météo et tes habitudes chaque jour pour voir le cumul ici."
