  "resumen_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا يوجد ما يكفي لملخصك بعد: سجّل عاداتك بضعة أيام ثم عد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Für deinen Rückblick reicht es noch nicht: hake ein paar Tage deine Gewohnheiten ab und komm wieder."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "There isn’t enough for your summary yet: check your habits for a few days and come back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todavía no hay suficiente para tu resumen: marca tus hábitos unos días y vuelve."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore assez pour ton bilan : coche tes habitudes quelques jours et reviens."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सारांश के लिए अभी पर्याप्त नहीं है: कुछ दिन अपनी आदतें दर्ज करें और लौटें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non c’è ancora abbastanza per il tuo riepilogo: segna le abitudini per qualche giorno e torna."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ振り返るには足りません。数日習慣を記録してから戻ってきてください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 요약할 내용이 부족해요. 며칠 습관을 기록하고 다시 오세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há o suficiente para o seu resumo: marque seus hábitos por alguns dias e volte."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока данных мало: отмечай привычки несколько дней и возвращайся."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "总结的数据还不够：先打卡几天习惯再回来吧。"
     }
    }
   }
  },
