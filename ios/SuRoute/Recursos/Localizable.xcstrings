       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "고정 항목(%2$@)이 %3$@에 나타나지 않습니다. 이번 달에도 해당되었나요?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "고정 항목 %1$ld개(%2$@)가 %3$@에 나타나지 않습니다. 이번 달에도 해당되었나요?"
        }
