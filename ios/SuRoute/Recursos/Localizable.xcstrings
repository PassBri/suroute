  "cp_listo_si": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت تسير من الامتلاء. يمكنك أن تختار رفيق صعود عن اختيار، لا عن حاجة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du gehst aus der Fülle. Du kannst einen Aufstiegspartner aus freier Wahl wählen, nicht aus Bedürftigkeit."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You're walking from wholeness. You can choose a climbing partner out of choice, not out of need."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estás caminando desde la plenitud. Puedes elegir un compañero de ascenso desde la elección, no desde la necesidad."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu marches depuis la plénitude. Tu peux choisir un compagnon de cordée par choix, et non par besoin."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप पूर्णता से चल रहे हैं। आप चढ़ाई का साथी ज़रूरत से नहीं, अपनी पसंद से चुन सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai camminando dalla pienezza. Puoi scegliere un compagno di salita per scelta, non per bisogno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたは満たされた状態から歩いています。必要からではなく、選択として登攀パートナーを選べます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "충만함에서 걷고 있어요. 필요가 아니라 선택으로 등반 동반자를 고를 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você está caminhando a partir da plenitude. Pode escolher um companheiro de subida por escolha, não por necessidade."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты идёшь из полноты. Ты можешь выбрать спутника восхождения по выбору, а не из нужды."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你正从圆满出发。你可以出于选择，而不是出于需要，去选择攀登伙伴。"
     }
    }
   }
  },
