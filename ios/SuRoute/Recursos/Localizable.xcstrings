  "mod_eliminar_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيُحذف نهائيًا ولا يمكن استعادته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wird endgültig gelöscht und kann nicht wiederhergestellt werden."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It will be deleted forever and can't be recovered."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se borra para siempre y no se puede recuperar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce sera supprimé définitivement, sans retour possible."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह हमेशा के लिए हट जाएगा और वापस नहीं आएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Verrà eliminato per sempre e non potrà essere recuperato."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "完全に削除され、元に戻せません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "영구 삭제되며 복구할 수 없어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Será apagado para sempre e não poderá ser recuperado."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Будет удалено навсегда без возможности восстановления."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "将被永久删除，无法恢复。"
     }
    }
   }
  },
