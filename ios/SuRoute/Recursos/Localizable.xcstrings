  "coach_vida_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شخص حقيقي يرافقك في صعودك: يتحدث معك، ويراجع تقدّمك إن سمحت له، ويساعدك على عدم الاستسلام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein echter Mensch, der dich beim Aufstieg begleitet: spricht mit dir, sieht deinen Fortschritt, wenn du es erlaubst, und hilft dir dranzubleiben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A real person who walks your climb with you: talks with you, reviews your progress if you allow it, and helps you keep going."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una persona real que te acompaña en tu ascenso: conversa contigo, revisa tu avance si se lo permites y te ayuda a no rendirte."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une vraie personne qui t’accompagne dans ton ascension : elle échange avec toi, suit ta progression si tu le permets et t’aide à ne pas abandonner."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "एक असली इंसान जो आपकी चढ़ाई में साथ देता है: आपसे बात करता है, अनुमति देने पर आपकी प्रगति देखता है और हार न मानने में मदद करता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una persona reale che ti accompagna nella salita: parla con te, segue i tuoi progressi se lo permetti e ti aiuta a non mollare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "登頂に寄り添う実在の人。あなたと話し、許可すれば進み具合を確認し、あきらめないよう支えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 등반을 함께하는 실제 사람: 대화하고, 허락하면 진행 상황을 살피며, 포기하지 않도록 돕습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma pessoa real que acompanha sua subida: conversa com você, revisa seu avanço se você permitir e ajuda você a não desistir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Живой человек, который сопровождает твой подъём: общается с тобой, смотрит прогресс, если ты разрешишь, и помогает не сдаваться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "一位真实的人陪你攀登：与你交谈，在你允许时查看你的进展，帮助你坚持下去。"
     }
    }
   }
  },
