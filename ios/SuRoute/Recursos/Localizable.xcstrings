     "stringUnit": {
      "state": "translated",
      "value": "Ein Tag mehr ist kein Tag weniger: Es ist eine neue Chance aufzusteigen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "One more day isn't one less day: it's a new chance to climb."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un día más no es un día menos: es una oportunidad nueva para subir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un jour de plus n'est pas un jour de moins : c'est une nouvelle occasion de grimper."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "एक और दिन, एक दिन कम होना नहीं है: यह चढ़ने का एक नया मौका है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un giorno in più non è un giorno in meno: è una nuova occasione per salire."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "もう1日は、1日減ることではありません。新しく登るチャンスです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루가 더 생긴 건 하루가 줄어든 게 아니라, 새로 오를 기회예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Um dia a mais não é um dia a menos: é uma nova oportunidade de subir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ещё один день — это не на один день меньше, а новая возможность подняться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "多一天不是少一天，而是又一次向上攀登的机会。"
     }
    }
   }
  },
  "frase_120_10": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا تعدّ الأيام، بل اجعل الأيام تُحسب."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zähle nicht die Tage: Lass die Tage zählen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Don't count the days: make the days count."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No cuentes los días: haz que los días cuenten."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ne compte pas les jours : fais que les jours comptent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दिन मत गिनिए: दिनों को मायने दीजिए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non contare i giorni: fai in modo che i giorni contino."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "日数を数えるのではなく、日々を意味のあるものにしよう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "날짜를 세지 말고, 하루하루가 의미 있게 하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não conte os dias: faça os dias contarem."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не считай дни: сделай так, чтобы дни имели значение."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "不要数着日子过，要让每一天都有意义。"
     }
    }
   }
  },
  "frase_120_11": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل عادة تلتزم بها اليوم هي لبنة في سنواتك المئة القادمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jede Gewohnheit, die du heute einhältst, ist ein Baustein deiner nächsten 100 Jahre."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every habit you keep today is a brick in your next 100 years."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada hábito que cumples hoy es un ladrillo de tus próximos 100 años."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque habitude tenue aujourd'hui est une brique de tes 100 prochaines années."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज जो भी आदत आप निभाते हैं, वह आपके अगले 100 वर्षों की एक ईंट है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni abitudine che rispetti oggi è un mattone dei tuoi prossimi 100 anni."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日守る習慣のひとつひとつが、これからの100年のレンガになる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 지킨 습관 하나하나가 앞으로 100년의 벽돌이 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada hábito que você cumpre hoje é um tijolo dos seus próximos 100 anos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждая привычка, которую ты соблюдаешь сегодня, — кирпичик твоих следующих 100 лет."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你今天坚持的每个习惯，都是未来 100 年的一块砖。"
     }
    }
   }
  },
  "frase_120_12": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اشكر على ثلاثة أشياء قبل النوم. الامتنان وقود الصعود."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei vor dem Schlafen für drei Dinge dankbar. Dankbarkeit ist der Treibstoff des Aufstiegs."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Be grateful for three things before sleep. Gratitude is the fuel of the climb."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agradece tres cosas antes de dormir. La gratitud es el combustible del ascenso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Remercie pour trois choses avant de dormir. La gratitude est le carburant de l'ascension."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सोने से पहले तीन बातों के लिए आभारी हों। कृतज्ञता चढ़ाई का ईंधन है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ringrazia per tre cose prima di dormire. La gratitudine è il carburante della salita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "眠る前に3つのことに感謝しよう。感謝は登り続けるための燃料。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "자기 전에 감사한 일 세 가지를 떠올려 보세요. 감사는 오르막의 연료예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Agradeça por três coisas antes de dormir. A gratidão é o combustível da subida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Поблагодари за три вещи перед сном. Благодарность — топливо восхождения."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "睡前感恩三件事。感恩是攀登的燃料。"
     }
    }
   }
  },
  "frase_120_13": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إن سقطت اليوم فانهض اليوم. الطريق طويل وفيه وقت لتصعد من جديد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du heute fällst, steh heute wieder auf. Der Weg ist lang, und es bleibt Zeit, wieder aufzusteigen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If you fall today, get up today. The road is long and there's time to climb again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si hoy caes, levántate hoy. El camino es largo y hay tiempo para volver a subir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Si tu tombes aujourd'hui, relève-toi aujourd'hui. Le chemin est long et il y a le temps de regrimper."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अगर आज गिरें, तो आज ही उठ खड़े हों। रास्ता लंबा है और फिर से चढ़ने का समय है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se oggi cadi, rialzati oggi. Il cammino è lungo e c'è tempo per tornare a salire."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日転んだら、今日立ち上がろう。道は長く、また登る時間はある。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 넘어졌다면 오늘 다시 일어나세요. 길은 길고, 다시 오를 시간은 충분해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se hoje você cair, levante hoje. O caminho é longo e há tempo para voltar a subir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если сегодня упал, поднимись сегодня. Путь долгий, и есть время подняться снова."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果今天跌倒了，就在今天站起来。路很长，还有时间再次攀登。"
     }
    }
   }
  },
  "frase_120_14": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمتك تنتظرك. هذا اليوم جزء من الطريق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Gipfel wartet auf dich. Dieser Tag ist Teil des Weges."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your summit is waiting. This day is part of the road."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cumbre te espera. Este día es parte del camino."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton sommet t'attend. Cette journée fait partie du chemin."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका शिखर आपका इंतज़ार कर रहा है। यह दिन भी सफ़र का हिस्सा है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vetta ti aspetta. Questo giorno fa parte del cammino."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの頂が待っている。今日という日もその道の一部。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 정상이 기다리고 있어요. 오늘도 그 길의 일부예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu cume está te esperando. Este dia faz parte do caminho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя вершина ждёт тебя. Этот день — часть пути."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的山峰在等你。今天也是这条路的一部分。"
     }
    }
   }
  },
  "frase_120_2": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لست مضطرًا اليوم إلى بلوغ القمة. يكفي أن تخطو الخطوة التالية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Heute musst du nicht den Gipfel erreichen. Mach einfach den nächsten Schritt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Today you don't have to reach the summit. Just take the next step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hoy no tienes que llegar a la cima. Solo dar el siguiente paso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aujourd'hui, tu n'as pas à atteindre le sommet. Fais simplement le pas suivant."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज आपको शिखर तक नहीं पहुँचना है। बस अगला कदम बढ़ाना है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Oggi non devi arrivare in vetta. Basta fare il passo successivo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日は頂上に着かなくても大丈夫。次の一歩を踏み出すだけでいい。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘은 정상에 오를 필요 없어요. 다음 한 걸음만 내디디면 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Hoje você não precisa chegar ao cume. Basta dar o próximo passo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сегодня не нужно добираться до вершины. Просто сделай следующий шаг."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "今天你不必登上山顶，只要迈出下一步。"
     }
    }
   }
  },
  "frase_120_3": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عِش هذا اليوم كأنه سيُكتب في قصتك. لأنه سيُكتب فعلًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lebe diesen Tag so, als würde er in deine Geschichte eingeschrieben. Denn das wird er."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Live this day as if it will be written into your story. Because it will."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vive este día como si fuera a quedar escrito en tu historia. Porque así será."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vis cette journée comme si elle allait s'inscrire dans ton histoire. Parce que ce sera le cas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस दिन को ऐसे जिएँ जैसे यह आपकी कहानी में दर्ज होने वाला है। क्योंकि यह होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Vivi questo giorno come se dovesse restare scritto nella tua storia. Perché sarà così."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この日があなたの物語に刻まれるつもりで生きよう。実際にそうなるのだから。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 하루가 당신의 이야기에 새겨질 것처럼 살아 보세요. 실제로 그렇게 될 테니까요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Viva este dia como se ele fosse ficar escrito na sua história. Porque vai ficar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Проживи этот день так, будто он останется в твоей истории. Так и будет."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "把今天当作会被写进你人生故事的一天来度过，因为它确实会。"
     }
    }
   }
  },
  "frase_120_4": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيحملك جسدك حتى سن 120 إن اعتنيت به اليوم: تحرّك، واشرب الماء، وارتح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Körper trägt dich bis 120, wenn du heute gut auf ihn achtest: bewege dich, trinke genug, ruhe dich aus."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your body will carry you to 120 if you take care of it today: move, hydrate, rest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cuerpo te llevará hasta los 120 si lo cuidas hoy: muévete, hidrátate, descansa."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton corps te portera jusqu'à 120 ans si tu en prends soin aujourd'hui : bouge, hydrate-toi, repose-toi."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अगर आज आप अपने शरीर का ध्यान रखेंगे, तो वह आपको 120 तक ले जाएगा: चलें-फिरें, पानी पिएँ, आराम करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il tuo corpo ti porterà fino a 120 anni se oggi ne hai cura: muoviti, idratati, riposa."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日体を大切にすれば、体はあなたを120歳まで運んでくれる。動いて、水を飲んで、休もう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 몸을 잘 돌보면 몸이 120세까지 데려다줄 거예요. 움직이고, 물을 마시고, 쉬세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu corpo vai te levar até os 120 se você cuidar dele hoje: mexa-se, hidrate-se, descanse."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоё тело донесёт тебя до 120, если ты позаботишься о нём сегодня: двигайся, пей воду, отдыхай."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "只要今天好好照顾身体，它就会陪你走到 120 岁：动一动，喝足水，好好休息。"
     }
    }
   }
  },
  "frase_120_5": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُبنى الحياة الطويلة بأيام عِيشت جيدًا، لا بسنوات تُعَدّ."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein langes Leben entsteht aus gut gelebten Tagen, nicht aus gezählten Jahren."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A long life is built from well-lived days, not counted years."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una larga vida se construye con días bien vividos, no con años contados."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une longue vie se construit avec des jours bien vécus, pas avec des années comptées."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लंबा जीवन अच्छे से जिए गए दिनों से बनता है, गिने हुए सालों से नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una lunga vita si costruisce con giorni ben vissuti, non con anni contati."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "長い人生は、数えた年月ではなく、よく生きた日々でつくられる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "긴 삶은 세어 온 나이가 아니라 잘 살아낸 하루하루로 만들어져요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma vida longa se constrói com dias bem vividos, não com anos contados."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Долгая жизнь строится из хорошо прожитых дней, а не из сосчитанных лет."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "漫长的人生由过得充实的日子堆成，而不是靠数着年头。"
     }
    }
   }
  },
  "frase_120_6": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أي ذكرى تريد أن يتركها هذا اليوم بعد 50 عامًا؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Welche Erinnerung soll dieser Tag in 50 Jahren sein?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What memory do you want this day to hold 50 years from now?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Qué recuerdo quieres que tenga este día dentro de 50 años?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quel souvenir veux-tu que cette journée laisse dans 50 ans ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "50 साल बाद आप इस दिन को कैसी याद के रूप में देखना चाहते हैं?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Che ricordo vuoi che sia questo giorno tra 50 anni?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "50年後、この日をどんな思い出にしたい？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "50년 뒤 이 하루가 어떤 추억이 되길 바라나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Que lembrança você quer que este dia tenha daqui a 50 anos?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каким воспоминанием ты хочешь видеть этот день через 50 лет?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "50 年后，你希望这一天成为怎样的回忆？"
     }
    }
   }
  },
  "frase_120_7": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "انضباط اليوم هو حرية نفسك غدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Disziplin von heute ist die Freiheit deines Ichs von morgen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Today's discipline is tomorrow's freedom for your future self."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La disciplina de hoy es la libertad de tu yo de mañana."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La discipline d'aujourd'hui est la liberté de ton toi de demain."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज का अनुशासन आपके आने वाले कल की आज़ादी है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La disciplina di oggi è la libertà del te di domani."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日の自制は、明日のあなたの自由になる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘의 절제는 내일의 내가 누릴 자유예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A disciplina de hoje é a liberdade do seu eu de amanhã."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Дисциплина сегодня — это свобода твоего завтрашнего «я»."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "今天的自律，是明天的你的自由。"
     }
    }
   }
  },
  "frase_120_8": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اتصل بمن تحب أو اكتب له أو عانقه. العلاقات تُطيل العمر أيضًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruf jemanden an, schreib ihm oder umarme ihn, den du liebst. Beziehungen verlängern auch das Leben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Call, write or hug someone you love. Relationships lengthen life too."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Llama, escribe o abraza a alguien que amas. Las relaciones también alargan la vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Appelle, écris ou serre dans tes bras quelqu'un que tu aimes. Les relations allongent aussi la vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किसी अपने को फ़ोन करें, लिखें या गले लगाएँ। रिश्ते भी उम्र बढ़ाते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Chiama, scrivi o abbraccia qualcuno che ami. Anche le relazioni allungano la vita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "大切な人に電話して、メッセージして、抱きしめよう。人とのつながりも寿命をのばす。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "사랑하는 사람에게 전화하고, 메시지를 보내고, 안아 주세요. 관계도 삶을 길게 해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ligue, escreva ou abrace alguém que você ama. Os relacionamentos também prolongam a vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Позвони, напиши или обними того, кого любишь. Отношения тоже продлевают жизнь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "给你爱的人打个电话、写条消息，或者抱一抱他。良好的人际关系也能延长寿命。"
     }
    }
   }
  },
  "frase_120_9": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعلّم شيئًا جديدًا اليوم: العقل الفضولي لا يشيخ أبدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lerne heute etwas Neues: Ein neugieriger Geist altert nie."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Learn something new today: a curious mind never grows old."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprende algo nuevo hoy: una mente curiosa nunca envejece."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Apprends quelque chose de nouveau aujourd'hui : un esprit curieux ne vieillit jamais."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज कुछ नया सीखें: जिज्ञासु मन कभी बूढ़ा नहीं होता।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impara qualcosa di nuovo oggi: una mente curiosa non invecchia mai."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日は何か新しいことを学ぼう。好奇心のある心は老いない。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 새로운 것을 배워 보세요. 호기심 많은 마음은 늙지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprenda algo novo hoje: uma mente curiosa nunca envelhece."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Узнай сегодня что-нибудь новое: любопытный ум не стареет."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "今天学点新东西：好奇的心永远不会老。"
     }
    }
   }
  },
  "frase_contador": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "فتحتَ %1$ld من 365 عبارة هذا العام"
     }
    },
    "de": {
