  "ios_recuperar_enviado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إذا كان لهذا البريد حساب، فسيصلك رابط لإنشاء كلمة مرور جديدة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn zu dieser E-Mail ein Konto existiert, bekommst du einen Link für ein neues Passwort."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If that email has an account, you'll get a link to create a new password."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si ese correo tiene cuenta, te llegará un enlace para crear una contraseña nueva."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Si cet e-mail a un compte, vous recevrez un lien pour créer un nouveau mot de passe."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अगर उस ईमेल का खाता है, तो आपको नया पासवर्ड बनाने का लिंक मिलेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se quell'email ha un account, riceverai un link per creare una nuova password."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "そのメールにアカウントがあれば、新しいパスワードを作るリンクが届きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "해당 이메일에 계정이 있으면 새 비밀번호를 만드는 링크가 도착해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se esse e-mail tiver conta, você receberá um link para criar uma nova senha."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если у этой почты есть аккаунт, придёт ссылка для нового пароля."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果该邮箱有账号，你会收到设置新密码的链接。"
     }
    }
   }
  },
