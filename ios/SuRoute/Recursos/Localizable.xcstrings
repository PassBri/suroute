  "ios_revisa_correo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أرسلنا إليك بريدًا لتأكيد حسابك. افتحه ثم سجّل الدخول هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wir haben dir eine E-Mail zur Bestätigung geschickt. Öffne sie und melde dich dann hier an."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "We sent you an email to confirm your account. Open it, then sign in here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Te enviamos un correo para confirmar tu cuenta. Ábrelo y luego entra aquí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Nous vous avons envoyé un e-mail pour confirmer votre compte. Ouvrez-le, puis connectez-vous ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हमने आपके खाते की पुष्टि के लिए ईमेल भेजा है। उसे खोलें, फिर यहाँ साइन इन करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ti abbiamo inviato un'email per confermare l'account. Aprila e poi accedi qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "確認メールを送りました。開いてからここでログインしてください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계정 확인 메일을 보냈어요. 메일을 연 뒤 여기서 로그인하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Enviamos um e-mail para confirmar sua conta. Abra-o e depois entre aqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Мы отправили письмо для подтверждения. Откройте его и затем войдите здесь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我们已向你发送确认邮件。打开后再在这里登录。"
     }
    }
   }
  },
  "ios_ruta_vacia": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ليس لديك أهداف بعد. ابنِ بوصلتك أو اكتبها في SuRoute Web وستظهر هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast noch keine Ziele. Baue deinen Kompass oder schreibe sie in SuRoute Web – sie erscheinen dann hier."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You don't have purposes or goals yet. Build your Compass or write them in SuRoute Web and they'll show up here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no tienes propósitos ni metas. Arma tu Brújula o escríbelos en SuRoute Web y aparecerán aquí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous n'avez pas encore d'objectifs. Construisez votre Boussole ou écrivez-les dans SuRoute Web : ils apparaîtront ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी आपके कोई उद्देश्य या लक्ष्य नहीं हैं। अपना कम्पास बनाएँ या SuRoute Web में लिखें, वे यहाँ दिखेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non hai ancora propositi né obiettivi. Crea la tua Bussola o scrivili in SuRoute Web e appariranno qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ目的や目標がありません。コンパスを作るか SuRoute Web で書くと、ここに表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 목적이나 목표가 없어요. 나침반을 만들거나 SuRoute 웹에서 적으면 여기에 나타나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ainda não tem propósitos nem metas. Monte sua Bússola ou escreva-os no SuRoute Web e eles aparecerão aqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "У вас пока нет целей. Соберите Компас или запишите их в SuRoute Web — они появятся здесь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你还没有目标。创建你的指南针或在 SuRoute 网页版中写下，它们会出现在这里。"
     }
    }
   }
  },
