  "brujula_sin_pasos": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شارك هذا الشخص قمته ومعسكراته دون نص خطواته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Diese Person hat Gipfel und Lager geteilt, ohne den Text der Schritte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This person shared their summit and camps, without the text of their steps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esta persona compartió su cumbre y sus campamentos, sin el texto de sus pasos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Cette personne a partagé son sommet et ses camps, sans le texte de ses pas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस व्यक्ति ने अपना शिखर और पड़ाव साझा किए, कदमों का पाठ नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questa persona ha condiviso vetta e campi, senza il testo dei passi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この人は頂とキャンプを共有しましたが、ステップの内容は非公開です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 사람은 정상과 캠프를 공유했지만 단계 내용은 공개하지 않았어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Esta pessoa compartilhou seu cume e acampamentos, sem o texto dos passos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Человек поделился вершиной и лагерями, без текста шагов."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "此人分享了顶峰和营地，但没有分享步骤内容。"
     }
    }
   }
  },
