  "perfil_invitacion": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أصعد إلى قمتي على SuRoute (@%1$@). تابعني ولنصعد معًا: https://suroute.com/descargar.html"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich erklimme meinen Gipfel auf SuRoute (@%1$@). Folge mir und lass uns gemeinsam aufsteigen: https://suroute.com/descargar.html"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I’m climbing to my summit on SuRoute (@%1$@). Follow me and let’s climb together: https://suroute.com/descargar.html"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estoy subiendo a mi cumbre en SuRoute (@%1$@). Sígueme y subamos juntos: https://suroute.com/descargar.html"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je gravis mon sommet sur SuRoute (@%1$@). Suivez-moi et montons ensemble : https://suroute.com/descargar.html"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं SuRoute पर अपने शिखर की ओर बढ़ रहा हूँ (@%1$@)। मुझे फ़ॉलो करें और साथ चढ़ें: https://suroute.com/descargar.html"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sto salendo verso la mia vetta su SuRoute (@%1$@). Seguimi e saliamo insieme: https://suroute.com/descargar.html"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute で自分の頂上を目指しています（@%1$@）。フォローして、一緒に登りましょう：https://suroute.com/descargar.html"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute에서 나만의 정상을 향해 오르고 있어요 (@%1$@). 팔로우하고 함께 올라가요: https://suroute.com/descargar.html"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Estou subindo ao meu cume no SuRoute (@%1$@). Siga-me e vamos subir juntos: https://suroute.com/descargar.html"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я поднимаюсь к своей вершине в SuRoute (@%1$@). Подпишись, и будем подниматься вместе: https://suroute.com/descargar.html"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我正在 SuRoute 攀登自己的顶峰（@%1$@）。关注我，一起攀登：https://suroute.com/descargar.html"
     }
    }
   }
  },
