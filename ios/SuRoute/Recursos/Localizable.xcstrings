    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 님을 차단했어요. 더 이상 게시물이 보이지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
