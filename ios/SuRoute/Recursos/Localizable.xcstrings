  "registro_acepto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أوافق على الشروط والأحكام وسياسة الخصوصية، وأأذن بمعالجة بياناتي، بما فيها البيانات الحساسة التي أختار تقديمها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich akzeptiere die AGB und die Datenschutzerklärung und willige in die Verarbeitung meiner Daten ein, einschließlich sensibler Daten, die ich angeben möchte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I accept the Terms and conditions and the Privacy policy, and I authorize the processing of my data, including any sensitive data I choose to provide."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acepto los Términos y condiciones y la Política de privacidad, y autorizo el tratamiento de mis datos, incluidos los sensibles que decida dar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "J'accepte les Conditions générales et la Politique de confidentialité, et j'autorise le traitement de mes données, y compris les données sensibles que je choisis de fournir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं नियम और शर्तें तथा गोपनीयता नीति स्वीकार करता/करती हूँ, और अपने डेटा के प्रसंस्करण की अनुमति देता/देती हूँ, जिसमें वह संवेदनशील डेटा भी शामिल है जो मैं देना चुनूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Accetto i Termini e condizioni e l'Informativa sulla privacy e autorizzo il trattamento dei miei dati, compresi quelli sensibili che deciderò di fornire."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "利用規約とプライバシーポリシーに同意し、私が提供を選んだ機微なデータを含め、私のデータの処理を許可します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이용 약관과 개인정보 처리방침에 동의하며, 제공하기로 선택한 민감 정보를 포함해 내 데이터 처리를 허락합니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Aceito os Termos e condições e a Política de privacidade, e autorizo o tratamento dos meus dados, incluindo os sensíveis que eu decidir fornecer."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я принимаю Условия использования и Политику конфиденциальности и даю согласие на обработку моих данных, включая чувствительные, которые решу указать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我接受条款与条件和隐私政策，并授权处理我的数据，包括我选择提供的敏感数据。"
     }
    }
   }
  },
  "registro_edad": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عمري 18 عامًا أو أكثر، أو بين 14 و17 عامًا ولدي إذن من وليّ أمري."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich bin 18 oder älter, oder ich bin zwischen 14 und 17 und habe die Erlaubnis meines gesetzlichen Vertreters."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I am 18 or older, or I am between 14 and 17 and have my legal guardian's permission."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tengo 18 años o más, o tengo entre 14 y 17 y cuento con la autorización de mi representante legal."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "J'ai 18 ans ou plus, ou j'ai entre 14 et 17 ans et j'ai l'autorisation de mon représentant légal."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मेरी उम्र 18 वर्ष या उससे अधिक है, या 14 से 17 के बीच है और मेरे पास अपने कानूनी अभिभावक की अनुमति है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ho 18 anni o più, oppure ho tra 14 e 17 anni e ho l'autorizzazione del mio rappresentante legale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "18 歳以上です。または 14〜17 歳で、法定代理人の許可を得ています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "만 18세 이상이거나, 14~17세이며 법정 대리인의 허락을 받았습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenho 18 anos ou mais, ou tenho entre 14 e 17 e conto com a autorização do meu responsável legal."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Мне 18 лет или больше, либо мне от 14 до 17 лет и у меня есть разрешение законного представителя."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我已年满 18 岁，或年龄在 14 至 17 岁之间并已获得法定监护人的同意。"
     }
    }
   }
  },
