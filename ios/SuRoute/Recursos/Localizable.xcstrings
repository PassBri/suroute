  "paso_nacimiento_boton": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أضف تاريخ ميلادي"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Geburtsdatum eintragen"
