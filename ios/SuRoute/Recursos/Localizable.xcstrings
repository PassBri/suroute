     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Puoi terminare l’accompagnamento in qualsiasi momento."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "伴走はいつでも終了できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "언제든 동행을 끝낼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você pode encerrar o acompanhamento a qualquer momento."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы можете завершить сопровождение в любое время."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你可以随时结束陪伴。"
     }
    }
   }
  },
  "coach_dir_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مدرب الحياة في SuRoute شخص حقيقي يرافقك في صعودك: يتحدث معك، ويراجع تقدمك فقط إذا سمحت، ويساعدك على عدم الاستسلام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein SuRoute-Lebenscoach ist ein echter Mensch, der dich bei deinem Aufstieg begleitet: spricht mit dir, sieht deinen Fortschritt nur, wenn du es erlaubst, und hilft dir, nicht aufzugeben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A SuRoute life coach is a real person who walks with you on your climb: talks with you, reviews your progress only if you allow it, and helps you not give up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un coach de vida de SuRoute es una persona real que te acompaña en tu ascenso: conversa contigo, revisa tu avance solo si tú lo permites y te ayuda a no rendirte."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un coach de vie SuRoute est une vraie personne qui vous accompagne dans votre ascension : il échange avec vous, suit votre progression seulement si vous l’autorisez et vous aide à ne pas abandonner."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute लाइफ़ कोच एक असली व्यक्ति है जो आपकी चढ़ाई में साथ देता है: आपसे बात करता है, आपकी अनुमति से ही प्रगति देखता है और हार न मानने में मदद करता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un coach di vita SuRoute è una persona reale che ti accompagna nella tua salita: parla con te, vede i tuoi progressi solo se lo permetti e ti aiuta a non mollare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute のライフコーチは、あなたの登山に寄り添う実在の人です。対話し、許可したときだけ進捗を見て、あきらめないよう支えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute 라이프 코치는 당신의 등반을 함께하는 실제 사람이에요. 대화하고, 허락할 때만 진행 상황을 보고, 포기하지 않도록 도와요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Um coach de vida do SuRoute é uma pessoa real que acompanha sua subida: conversa com você, revisa seu avanço só se você permitir e ajuda você a não desistir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Лайф-коуч SuRoute — живой человек, который сопровождает вас на пути: общается с вами, видит прогресс только с вашего разрешения и помогает не сдаться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute 人生教练是陪你攀登的真人：与你交流，只有在你允许时才查看你的进度，帮你坚持下去。"
     }
    }
   }
  },
