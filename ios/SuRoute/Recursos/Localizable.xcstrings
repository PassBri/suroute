  "cu_ind_libertad_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الدخل السلبي ÷ المصروفات. عند 1 تدفع دخولك حياتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Passives Einkommen ÷ Ausgaben. Bei 1 bezahlen deine Einkünfte dein Leben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Passive income ÷ expenses. At 1, your passive income pays for your life."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ingresos pasivos ÷ gastos. En 1, tus rentas pagan tu vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Revenus passifs ÷ dépenses. À 1, tes rentes paient ta vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "निष्क्रिय आय ÷ खर्च। 1 पर आपकी आय जीवन चलाती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Reddito passivo ÷ spese. A 1, le rendite pagano la tua vita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "不労所得 ÷ 支出。1 で不労所得が生活費をまかないます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "수동 소득 ÷ 지출. 1이면 수동 소득이 생활비를 감당해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Renda passiva ÷ despesas. Em 1, suas rendas pagam sua vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пассивный доход ÷ расходы. При 1 пассивный доход оплачивает жизнь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "被动收入 ÷ 支出。达到 1 时，被动收入足以支付生活。"
     }
    }
   }
  },
