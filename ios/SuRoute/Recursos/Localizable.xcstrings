  "cascada_vacia_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنشئ هدفًا لعدد السنوات الذي تريده وقسّمه إلى أهداف سنوية وشهرية وأفعال اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg ein Ziel für so viele Jahre an, wie du willst, und brich es in Jahres- und Monatsziele und heutige Schritte herunter."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Create a purpose for as many years as you want and break it down into yearly goals, monthly goals and today’s actions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Crea un propósito a los años que quieras y bájalo a metas anuales, mensuales y acciones de hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Crée un objectif sur le nombre d’années que tu veux et décline-le en objectifs annuels, mensuels et actions du jour."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जितने साल चाहें उतने का उद्देश्य बनाएँ और उसे वार्षिक, मासिक लक्ष्यों व आज के कार्यों में बाँटें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crea un proposito per gli anni che vuoi e scomponilo in obiettivi annuali, mensili e azioni di oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "好きな年数の目的を作り、年間・月間目標と今日の行動に分けましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "원하는 기간의 목표를 만들고 연간·월간 목표와 오늘의 행동으로 나눠 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Crie um propósito para os anos que quiser e divida-o em metas anuais, mensais e ações de hoje."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Создай цель на любое число лет и разбей её на годовые и месячные цели и дела на сегодня."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "创建一个你想要年数的目标，并拆解为年度、月度目标和今天的行动。"
     }
    }
   }
  },
