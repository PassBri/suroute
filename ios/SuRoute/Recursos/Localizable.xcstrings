  "nube_error": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعذّر إحضار مسارك. تحقق من الاتصال وحاول مرة أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Route konnte nicht geholt werden. Prüfe die Verbindung und versuche es erneut."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your route could not be brought. Check your connection and try again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo traer tu ruta. Revisa la conexión e inténtalo otra vez."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossible de ramener votre itinéraire. Vérifiez la connexion et réessayez."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका रास्ता नहीं लाया जा सका। कनेक्शन जाँचें और फिर कोशिश करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossibile portare la tua rotta. Controlla la connessione e riprova."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ルートを取り込めませんでした。接続を確認してもう一度お試しください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "길을 가져오지 못했어요. 연결을 확인하고 다시 시도하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não foi possível trazer sua rota. Verifique a conexão e tente de novo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не удалось перенести маршрут. Проверьте соединение и попробуйте снова."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "无法带回你的路线。请检查网络后重试。"
     }
    }
   }
  },
  "nube_listo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "وصل مسارك إلى هذا الهاتف."
     }
    },
    "de": {
