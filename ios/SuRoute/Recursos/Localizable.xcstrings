  "cu_cats_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عندما تسجل المصروفات سترى هنا أين تذهب. أنشئ فئاتك: حيوانات، رياضة، هدايا…"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sobald du Ausgaben erfasst, siehst du hier, wohin sie gehen. Lege eigene Kategorien an: Haustiere, Fitness, Geschenke…"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Once you record expenses you’ll see here where they go. Create your own categories: Pets, Gym, Gifts…"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando anotes gastos verás aquí en qué se van. Crea tus propias categorías: Mascotas, Gimnasio, Regalos…"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quand tu noteras des dépenses, tu verras ici où elles vont. Crée tes catégories : Animaux, Sport, Cadeaux…"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "खर्च दर्ज करने पर यहाँ दिखेगा कि पैसा कहाँ जाता है। अपनी श्रेणियाँ बनाएँ: पालतू, जिम, उपहार…"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando annoterai le spese vedrai qui dove vanno. Crea le tue categorie: Animali, Palestra, Regali…"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "支出を記録すると、ここで行き先が見られます。ペット、ジム、プレゼントなど自分のカテゴリを作れます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지출을 기록하면 어디로 가는지 여기서 보여요. 반려동물, 헬스, 선물 등 나만의 분류를 만드세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando anotar despesas verá aqui para onde vão. Crie suas categorias: Pets, Academia, Presentes…"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда запишешь расходы, здесь будет видно, куда они уходят. Создай свои категории: питомцы, спортзал, подарки…"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "记录支出后，这里会显示钱花在哪里。创建你的类别：宠物、健身、礼物…"
     }
    }
   }
  },
