  "lb_mes_silencio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بقي هذا الشهر صامتًا. وهذا جزء من الطريق أيضًا: الجبل ما زال هناك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieser Monat blieb still. Auch das gehört zum Weg: Der Berg ist noch da."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This month stayed quiet. That is part of the path too: the mountain is still there."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Este mes quedó en silencio. También eso es parte del camino: la montaña sigue ahí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce mois est resté silencieux. Cela fait aussi partie du chemin : la montagne est toujours là."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह महीना शांत रहा। यह भी राह का हिस्सा है: पहाड़ अब भी वहीं है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo mese è rimasto in silenzio. Anche questo fa parte del cammino: la montagna è ancora lì."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今月は静かでした。それも道の一部です。山はまだそこにあります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 달은 조용했어요. 그것도 길의 일부예요. 산은 여전히 그 자리에 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Este mês ficou em silêncio. Isso também faz parte do caminho: a montanha continua aí."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Этот месяц прошёл тихо. Это тоже часть пути: гора всё ещё на месте."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这个月很安静。这也是路的一部分：山还在那里。"
     }
    }
   }
  },
