  "om_borrar_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيُحذف «%1$@» مع تقدّمه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "„%1$@“ wird samt Fortschritt gelöscht."
