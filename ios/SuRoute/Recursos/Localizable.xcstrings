  },
  "ev_evaluar_mes_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "درجة الشهر والأهداف والعادات والعافية والحصيلة والمالية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Punktzahl, Ziele, Gewohnheiten, Wohlbefinden, Bilanz und Finanzen des Monats."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Score, goals, habits, wellbeing, review and finances of the month."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puntaje, metas, hábitos, bienestar, balance y finanzas del mes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Score, objectifs, habitudes, bien-être, bilan et finances du mois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "महीने का स्कोर, लक्ष्य, आदतें, कल्याण, लेखा-जोखा और वित्त।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Punteggio, obiettivi, abitudini, benessere, bilancio e finanze del mese."
