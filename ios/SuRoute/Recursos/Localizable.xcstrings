    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tie (%1$ld-%2$ld). Go back to your summit in one sentence and decide from there."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empate (%1$ld-%2$ld). Vuelve a tu cumbre en una frase y decide desde ahí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Égalité (%1$ld-%2$ld). Reviens à ton sommet en une phrase et décide à partir de là."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बराबरी (%1$ld-%2$ld)। अपनी चोटी को एक वाक्य में याद करें और वहीं से फ़ैसला लें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pareggio (%1$ld-%2$ld). Torna alla tua vetta in una frase e decidi da lì."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "同点です(%1$ld-%2$ld)。山頂を一言で思い出して、そこから決めましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "동점이에요 (%1$ld-%2$ld). 한 문장으로 정상을 다시 떠올리고 거기서부터 결정하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Empate (%1$ld-%2$ld). Volte ao seu cume em uma frase e decida a partir dele."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ничья (%1$ld-%2$ld). Вернись к своей вершине в одной фразе и решай, исходя из неё."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "平局（%1$ld-%2$ld）。用一句话回到你的山巅，从那里做决定。"
     }
    }
   }
  },
  "matriz_gana": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» يحصد نقاطًا أكثر (%2$ld مقابل %3$ld). وهو عادةً الخيار الأفضل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "„%1$@“ bekommt mehr Punkte (%2$ld zu %3$ld). Meistens ist das die bessere Option."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "“%1$@” scores more points (%2$ld vs %3$ld). It's usually the better option."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» suma más puntos (%2$ld vs %3$ld). Generalmente es la mejor opción."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "« %1$@ » marque plus de points (%2$ld contre %3$ld). C'est généralement la meilleure option."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "“%1$@” के ज़्यादा अंक हैं (%2$ld बनाम %3$ld)। आम तौर पर यही बेहतर विकल्प है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» totalizza più punti (%2$ld contro %3$ld). Di solito è l'opzione migliore."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」のほうが得点が高いです(%2$ld対%3$ld)。たいていは、こちらがベストな選択です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」이(가) 더 많은 점수를 얻었어요 (%2$ld 대 %3$ld). 보통 더 나은 선택이에요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "“%1$@” soma mais pontos (%2$ld vs %3$ld). Geralmente é a melhor opção."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» набирает больше очков (%2$ld против %3$ld). Обычно это лучший вариант."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」得分更高（%2$ld 比 %3$ld）。通常是更好的选择。"
     }
    }
   }
  },
  "matriz_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "نقطة لكل «نعم» أو «طاقة»."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Punkt für jedes JA oder jede ENERGIE."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "One point for each YES or ENERGIZES."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un punto por cada SÍ o ENERGÍA."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un point pour chaque OUI ou ÉNERGIE."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर हाँ या ऊर्जा पर एक अंक।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un punto per ogni SÌ o ENERGIA."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「はい」または「元気が出る」ごとに1点。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "예 또는 에너지 하나당 1점."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Um ponto para cada SIM ou ENERGIA."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "По одному баллу за каждое ДА или ЭНЕРГИЮ."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每个「是」或「能量」得 1 分。"
     }
    }
   }
  },
  "matriz_p1": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هل يقرّبني من قمّتي؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bringt es mich meinem Gipfel näher?"
