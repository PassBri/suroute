  "respaldo_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "احفظ مسارك كاملًا في ملف (الأهداف والعادات والإجابات والمحاور والمعسكرات والعبارات). يعمل دون حساب، لتغيير الهاتف أو للاحتياط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Speichere deine ganze Route in einer Datei (Ziele, Gewohnheiten, Antworten, Achsen, Lager und Zitate). Auch ohne Konto – zum Handywechsel oder zur Sicherheit."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Save your whole route to a file (goals, habits, answers, axes, camps and quotes). Works without an account, to switch phones or just in case."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarda toda tu ruta en un archivo (metas, hábitos, respuestas, ejes, campamentos y frases). Sirve aunque no tengas cuenta, para cambiar de teléfono o por si acaso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Enregistre toute ta route dans un fichier (objectifs, habitudes, réponses, axes, camps et citations). Sans compte, pour changer de téléphone ou au cas où."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपना पूरा मार्ग एक फ़ाइल में सहेजें (लक्ष्य, आदतें, उत्तर, आयाम, शिविर और उद्धरण)। बिना खाते के भी—फ़ोन बदलने या एहतियात के लिए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salva tutta la tua rotta in un file (obiettivi, abitudini, risposte, assi, campi e frasi). Funziona senza account, per cambiare telefono o per sicurezza."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ルート全体（目標、習慣、回答、軸、キャンプ、言葉）をファイルに保存。アカウント不要で、機種変更や万一に備えて。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "전체 경로(목표, 습관, 답변, 축, 캠프, 문구)를 파일로 저장해요. 계정 없이도 휴대폰 교체나 만일을 위해 쓸 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Salve toda a sua rota em um arquivo (metas, hábitos, respostas, eixos, acampamentos e frases). Funciona sem conta, para trocar de telefone ou por precaução."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сохрани весь маршрут в файл (цели, привычки, ответы, оси, лагеря и цитаты). Без аккаунта — для смены телефона или на всякий случай."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "将你的整条路线保存为文件（目标、习惯、回答、维度、营地和语录）。无需账号，换手机或以防万一都适用。"
     }
    }
   }
  },
