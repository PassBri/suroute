  "coach_vida_compartir_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمّتك وغاياتك وأهدافك وعادات الأسبوع والمحاور والمعسكرات. لا إجاباتك في الكتب ولا ملاحظاتك أبدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Gipfel, Lebensziele, Ziele, Gewohnheiten der Woche, Achsen und Lager. Nie deine Antworten in den Büchern oder Notizen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your summit, purposes, goals, this week’s habits, axes and camps. Never your workbook answers or notes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cumbre, propósitos, metas, hábitos de la semana, ejes y campamentos. Nunca tus respuestas de los libros ni tus notas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton sommet, tes raisons d’être, objectifs, habitudes de la semaine, axes et camps. Jamais tes réponses aux cahiers ni tes notes."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका शिखर, उद्देश्य, लक्ष्य, सप्ताह की आदतें, आयाम और शिविर। किताबों के उत्तर या नोट्स कभी नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vetta, scopi, obiettivi, abitudini della settimana, assi e campi. Mai le tue risposte ai libri né le note."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "頂、目的、目標、今週の習慣、軸、キャンプ。本への回答やメモは共有しません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 정상, 목적, 목표, 이번 주 습관, 축과 캠프. 책에 쓴 답이나 메모는 절대 공유되지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu cume, propósitos, metas, hábitos da semana, eixos e acampamentos. Nunca suas respostas dos livros nem suas notas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя вершина, цели жизни, задачи, привычки недели, оси и лагеря. Никогда — ответы в книгах и заметки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的巅峰、使命、目标、本周习惯、维度和营地。绝不包括你在书中的回答或笔记。"
     }
    }
   }
  },
