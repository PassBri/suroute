  "gr_vacia": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عندما تسجل أولى حركاتك سترى هنا كيف يرتفع رصيدك يومًا بعد يوم وشهرًا بعد شهر وعامًا بعد عام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sobald du deine ersten Buchungen einträgst, siehst du hier deinen Saldo Tag für Tag, Monat für Monat und Jahr für Jahr steigen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Once you log your first entries, you’ll see your balance climb day by day, month by month and year by year."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando anotes tus primeros movimientos, aquí verás cómo sube tu saldo día a día, mes a mes y año a año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Dès tes premiers mouvements, tu verras ici ton solde monter jour après jour, mois après mois, année après année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पहली एंट्री लिखते ही यहाँ दिखेगा कि आपका शेष दिन-ब-दिन, महीने-दर-महीने और साल-दर-साल कैसे बढ़ता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando annoti i primi movimenti, qui vedrai salire il tuo saldo giorno per giorno, mese per mese e anno per anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最初の記録をすると、ここで残高が日ごと、月ごと、年ごとに上がっていく様子が見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "첫 기록을 남기면 여기서 잔액이 날마다, 달마다, 해마다 오르는 모습을 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando anotar seus primeiros movimentos, verá aqui seu saldo subir dia a dia, mês a mês e ano a ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда запишешь первые операции, здесь будет видно, как растёт остаток день за днём, месяц за месяцем и год за годом."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "记下第一笔收支后，这里会显示你的余额如何逐日、逐月、逐年上升。"
     }
    }
   }
  },
