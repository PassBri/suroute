    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "“%1$@” and its progress will be deleted."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se borrará «%1$@» con su avance."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "« %1$@ » et sa progression seront supprimés."
