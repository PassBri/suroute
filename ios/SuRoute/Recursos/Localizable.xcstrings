  "lb_sin_paginas": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عندما تُكمل مخيّمًا من بوصلتك أو هدفًا أو التزامًا، ستظهر صفحته هنا لتوقّعها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du ein Lager deines Kompasses, ein Ziel oder eine Verpflichtung abschließt, erscheint hier seine Seite zum Unterschreiben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When you complete a camp of your Compass, a goal or a commitment, its page will appear here for you to sign."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando completes un campamento de tu Brújula, una meta o un compromiso, aquí aparecerá su página para firmarla."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quand vous terminerez un camp de votre Boussole, un objectif ou un engagement, sa page apparaîtra ici pour la signer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जब आप कम्पास का कोई शिविर, लक्ष्य या वादा पूरा करेंगे, उसका पन्ना यहाँ हस्ताक्षर के लिए आएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando completerai un campo della tua Bussola, un obiettivo o un impegno, qui apparirà la sua pagina da firmare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コンパスのキャンプ、目標、約束を達成すると、ここに署名するページが現れます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나침반의 캠프, 목표, 약속을 이루면 여기에 서명할 페이지가 나타납니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando você completar um acampamento da sua Bússola, uma meta ou um compromisso, a página aparecerá aqui para assinar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда вы пройдёте лагерь Компаса, достигнете цели или выполните обязательство, здесь появится страница для подписи."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "当你完成指南针的一个营地、一个目标或一项承诺时，它的页面会出现在这里等你签名。"
     }
    }
   }
  },
