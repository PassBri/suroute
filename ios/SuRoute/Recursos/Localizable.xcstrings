  "cv_cuerda_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أُلقي إليك حبلًا يا %1$@: اليوم يوم جيد للعودة إلى التسجيل! "
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich werfe dir ein Seil zu, %1$@: Heute ist ein guter Tag, um wieder abzuhaken! "
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I'm throwing you a rope, %1$@: today is a good day to check in again! "
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Te lanzo una cuerda, %1$@: ¡hoy es un buen día para volver a marcar! "
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je te lance une corde, %1$@ : aujourd'hui est un bon jour pour cocher à nouveau ! "
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@, यह रही आपके लिए एक रस्सी: आज फिर से निशान लगाने का अच्छा दिन है! "
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ti lancio una corda, %1$@: oggi è un buon giorno per tornare a segnare! "
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ さん、ロープを投げます。今日はまたチェックするのにいい日です！ "
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@님, 로프를 던질게요. 오늘은 다시 체크하기 좋은 날이에요! "
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Estou te jogando uma corda, %1$@: hoje é um bom dia para voltar a marcar! "
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Бросаю тебе верёвку, %1$@: сегодня хороший день, чтобы снова отметиться! "
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@，我给你抛根绳子：今天是重新打卡的好日子！ "
     }
    }
   }
  },
