  "bloqueo_sin_biometria": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم يتم إعداد فتح القفل بالوجه أو بصمة الإصبع أو قفل الشاشة على هذا الهاتف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Auf diesem Telefon sind weder Gesichtsentsperrung noch Fingerabdruck oder Displaysperre eingerichtet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This phone has no face unlock, fingerprint, or screen lock set up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Este teléfono no tiene rostro, huella ni bloqueo de pantalla configurados."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce téléphone n'a ni déverrouillage facial, ni empreinte, ni verrouillage d'écran configuré."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस फ़ोन में फ़ेस अनलॉक, फ़िंगरप्रिंट या स्क्रीन लॉक सेट नहीं है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo telefono non ha lo sblocco con il volto, l'impronta o il blocco schermo configurati."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この端末には顔認証、指紋認証、画面ロックが設定されていません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 휴대전화에는 얼굴 인식, 지문 또는 화면 잠금이 설정되어 있지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Este celular não tem desbloqueio facial, digital nem bloqueio de tela configurados."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "На этом телефоне не настроены разблокировка по лицу, отпечаток пальца или блокировка экрана."
