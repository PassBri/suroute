  "cu_pasivo_agregado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أُضيف الالتزام: أكمل الفائدة والقسط في الخروج من الديون"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Verbindlichkeit hinzugefügt: Zins und Rate unter Raus aus den Schulden ergänzen"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Liability added: complete its rate and payment in Get out of debt"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasivo agregado: completa su tasa y cuota en Salir de deudas"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Passif ajouté : complétez son taux et sa mensualité dans Sortir des dettes"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "देनदारी जोड़ी गई: ब्याज दर और किस्त कर्ज़ से बाहर निकलें में भरें"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Passività aggiunta: completa tasso e rata in Uscire dai debiti"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "負債を追加しました：金利と返済額は「借金から抜け出す」で入力してください"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "부채를 추가했습니다: 이자율과 상환액은 빚에서 벗어나기에서 입력하세요"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Passivo adicionado: complete a taxa e a parcela em Sair das dívidas"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Обязательство добавлено: укажите ставку и платёж в разделе «Выйти из долгов»"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "负债已添加：请在“摆脱债务”中补充利率和月供"
     }
    }
   }
  },
  "cu_pasivo_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الدين الجيد ينتج (عمل، دراسة، سكن)؛ والسيئ يكلّف فقط. تُكمَل الفائدة والقسط في الخروج من الديون."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gute Schulden bringen etwas (Geschäft, Studium, Wohnung); schlechte kosten nur. Zins und Rate ergänzt du unter Raus aus den Schulden."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A good debt produces (business, education, home); a bad one only costs. Rate and payment are completed in Get out of debt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una deuda buena produce (negocio, estudio, vivienda); una mala solo cuesta. La tasa y la cuota se completan en Salir de deudas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une bonne dette produit (entreprise, études, logement) ; une mauvaise ne fait que coûter. Taux et mensualité se complètent dans Sortir des dettes."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अच्छा कर्ज़ कमाता है (व्यवसाय, पढ़ाई, घर); बुरा कर्ज़ सिर्फ़ खर्च कराता है। ब्याज दर और किस्त कर्ज़ से बाहर निकलें में भरें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un debito buono produce (attività, studio, casa); uno cattivo costa soltanto. Tasso e rata si completano in Uscire dai debiti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "良い借金は生み出します（事業、学び、住まい）。悪い借金はただコストです。金利と返済額は「借金から抜け出す」で入力します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "좋은 빚은 수익을 냅니다(사업, 공부, 집). 나쁜 빚은 비용만 듭니다. 이자율과 상환액은 빚에서 벗어나기에서 입력합니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma dívida boa produz (negócio, estudo, moradia); uma ruim só custa. A taxa e a parcela se completam em Sair das dívidas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Хороший долг приносит доход (бизнес, учёба, жильё); плохой только стоит денег. Ставку и платёж укажите в разделе «Выйти из долгов»."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "好的债务能带来收益（生意、学习、住房）；坏的债务只会花钱。利率和月供在“摆脱债务”中补充。"
     }
    }
   }
  },
