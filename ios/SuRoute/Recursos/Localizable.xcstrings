  "red_menor_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تصل منشوراتك إلى متابعيك فقط ولا يراسلك إلا من تتابعهم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Beiträge sehen nur deine Follower, und nur Personen, denen du folgst, können dir schreiben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your posts reach only your followers and only people you follow can message you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que publiques llega solo a tus seguidores y solo te escriben las personas que sigues."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vos publications n’atteignent que vos abonnés et seules les personnes que vous suivez peuvent vous écrire."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी पोस्ट सिर्फ़ फ़ॉलोअर्स तक पहुँचेगी और सिर्फ़ वे लोग संदेश भेज सकेंगे जिन्हें आप फ़ॉलो करते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "I tuoi post arrivano solo ai tuoi follower e solo le persone che segui possono scriverti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿はフォロワーだけに届き、メッセージはフォローしている人からだけ届きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "게시물은 팔로워에게만 보이고, 내가 팔로우하는 사람만 메시지를 보낼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que você publicar chega só aos seus seguidores e só as pessoas que você segue podem escrever."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
