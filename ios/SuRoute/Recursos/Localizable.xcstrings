  "dona_falto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "نقصك %1$@: خرج أكثر مما دخل"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es fehlten %1$@: Es ging mehr hinaus als herein"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You were short %1$@: more went out than came in"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Te faltaron %1$@: salió más de lo que entró"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il vous a manqué %1$@ : plus de sorties que d’entrées"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ कम पड़े: आने से ज़्यादा गया"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ti sono mancati %1$@: è uscito più di quanto è entrato"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 不足：入金より出金が多い"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 부족: 들어온 것보다 더 나갔습니다"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Faltaram %1$@: saiu mais do que entrou"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не хватило %1$@: расходы больше поступлений"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "缺少 %1$@：支出多于收入"
     }
    }
   }
  },
  "dona_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المُبنى = الادخار + الاستثمار. هدف Cima financiera هو 20 % على الأقل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aufgebaut = Sparen + Investieren. Das Ziel von Cima financiera sind mindestens 20 %."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Built = savings + investment. The Cima financiera goal is at least 20 %."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Construido = ahorro + inversión. La meta del libro Cima financiera es al menos el 20 %."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Construit = épargne + investissement. L’objectif de Cima financiera est d’au moins 20 %."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बनाया = बचत + निवेश। Cima financiera का लक्ष्य कम से कम 20 % है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Costruito = risparmio + investimento. L’obiettivo di Cima financiera è almeno il 20 %."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "積み上げ = 貯蓄 + 投資。Cima financiera の目標は 20 % 以上です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "쌓은 돈 = 저축 + 투자. Cima financiera의 목표는 최소 20 %입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Construído = poupança + investimento. A meta do livro Cima financiera é pelo menos 20 %."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Накоплено = сбережения + инвестиции. Цель Cima financiera — не меньше 20 %."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "积累 = 储蓄 + 投资。Cima financiera 的目标是至少 20 %。"
     }
    }
   }
  },
