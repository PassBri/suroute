  "ev_evaluar_anio_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "درجة السنة والبوصلة والعافية والحصيلة السنوية."
     }
    },
