  "manana_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتبها قبل النوم: غدًا تبدأ دون أن تقرر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib sie vor dem Schlafen auf: Morgen fängst du an, ohne zu entscheiden."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write them before you sleep: tomorrow you start without deciding."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escríbelas antes de dormir: mañana empiezas sin decidir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écris-les avant de dormir : demain tu commences sans décider."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सोने से पहले लिख लें: कल बिना सोचे शुरू करेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrivile prima di dormire: domani inizi senza dover decidere."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "寝る前に書きましょう。明日は迷わず始められます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "자기 전에 적어 두세요. 내일은 고민 없이 시작해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escreva antes de dormir: amanhã você começa sem decidir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши перед сном: завтра начнёшь, не раздумывая."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "睡前写好：明天直接开始，不用再决定。"
     }
    }
   }
  },
