  "tr_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "معاملة أو إجراء أو قسط: من يوم البداية إلى يوم النهاية، مع تنبيهات قبل الاستحقاق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Antrag, ein Verfahren oder eine Rate: vom ersten bis zum letzten Tag, mit Erinnerungen vor Ablauf."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A procedure, a process or an installment: from start day to end day, with reminders before it’s due."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un trámite, un proceso o una cuota: del día de inicio al final, con avisos antes de vencer."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une démarche, une procédure ou une échéance : du premier au dernier jour, avec des rappels avant l’échéance."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कोई प्रक्रिया, मामला या किस्त: शुरुआत के दिन से आख़िरी दिन तक, समय-सीमा से पहले याद दिलाना।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una pratica, un procedimento o una rata: dal giorno di inizio a quello finale, con promemoria prima della scadenza."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "手続き、プロセス、分割払い：開始日から終了日まで、期限前にお知らせします。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "절차, 진행 건 또는 할부: 시작일부터 마감일까지, 마감 전에 알려 드려요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Um trâmite, um processo ou uma parcela: do dia de início ao final, com avisos antes de vencer."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Процедура, процесс или платёж: от первого до последнего дня, с напоминаниями до срока."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "一项手续、一个流程或一笔分期：从开始日到截止日，到期前提醒。"
     }
    }
   }
  },
