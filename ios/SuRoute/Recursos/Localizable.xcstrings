      "value": "Tap the symbol to open today's quote."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca el símbolo para abrir la frase de hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touche le symbole pour ouvrir la citation du jour."
     }
    },
    "hi": {
