  "estado_cumplida_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تحقق الهدف كما خُطط له أو بنتائج مكافئة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Ziel wurde wie geplant oder mit gleichwertigen Ergebnissen erreicht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The goal was achieved as planned or with equivalent results."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La meta se logró según lo planeado o con resultados equivalentes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'objectif a été atteint comme prévu ou avec des résultats équivalents."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य योजना के अनुसार या उसके बराबर नतीजों के साथ हासिल हुआ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'obiettivo è stato raggiunto come previsto o con risultati equivalenti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "計画どおり、または同等の成果で目標を達成しました。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계획대로, 또는 그에 준하는 결과로 목표를 이뤘어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A meta foi alcançada como planejado ou com resultados equivalentes."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цель достигнута, как планировалось, или с равноценными результатами."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目标已按计划达成，或取得了同等的成果。"
     }
    }
   }
  },
