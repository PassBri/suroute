  "notas_coach_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تراها أنت فقط: ما اتفقتما عليه والتقدم وما تراجعه في الجلسة القادمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nur du siehst sie: Vereinbarungen, Fortschritte und was du in der nächsten Sitzung ansprechen willst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Only you can see them: agreements, progress and what to review next session."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Solo tú las ves: lo que acuerdan, avances y qué revisar en la próxima sesión."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Toi seul les vois : vos accords, les progrès et ce qu’il faut revoir à la prochaine séance."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "केवल आप देख सकते हैं: तय बातें, प्रगति और अगले सत्र में क्या देखना है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le vedi solo tu: accordi, progressi e cosa rivedere alla prossima sessione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなただけが見られます。約束、進捗、次回確認すること。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나만 볼 수 있어요: 약속, 진행 상황, 다음 세션에서 다룰 것."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Só você as vê: o que combinaram, avanços e o que revisar na próxima sessão."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Видишь только ты: договорённости, прогресс и что обсудить на следующей сессии."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "只有你能看到：约定、进展以及下次要回顾的事项。"
     }
    }
   }
  },
