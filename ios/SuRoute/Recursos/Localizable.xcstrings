  "estado_iniciada_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "خطوت خطواتك الأولى، لكن التقدّم ما زال بسيطًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast die ersten Schritte gemacht, aber der Fortschritt ist noch gering."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You've taken the first steps, but progress is still basic."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ya diste los primeros pasos, pero el avance aún es básico."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as fait les premiers pas, mais l'avancement reste modeste."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने पहले कदम उठा लिए हैं, पर प्रगति अभी शुरुआती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai già fatto i primi passi, ma l'avanzamento è ancora minimo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最初の一歩は踏み出しましたが、進捗はまだ初歩的です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "첫걸음을 뗐지만 진전은 아직 기초 단계예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você já deu os primeiros passos, mas o progresso ainda é básico."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты сделал(а) первые шаги, но прогресс пока небольшой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你已经迈出了第一步，但进展还很初步。"
     }
    }
   }
  },
