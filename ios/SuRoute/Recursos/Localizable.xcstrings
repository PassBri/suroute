  "vision_foto_privada": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُحفظ صورك كمنشورات رؤية خاصة: لا يراها غيرك حتى تقرر مشاركتها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Fotos werden als private Visions-Beiträge gespeichert: Nur du siehst sie, bis du sie teilst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your photos are saved as private vision posts: only you see them until you choose to share."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus fotos se guardan como publicaciones de visión privadas: solo tú las ves hasta que decidas compartirlas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tes photos sont enregistrées comme publications de vision privées : toi seul les vois jusqu’à ce que tu décides de les partager."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी फ़ोटो निजी विज़न पोस्ट के रूप में सहेजी जाती हैं: साझा करने तक केवल आप देख सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le tue foto sono salvate come post di visione privati: le vedi solo tu finché non decidi di condividerle."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "写真は非公開のビジョン投稿として保存され、共有するまであなたしか見られません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "사진은 비공개 비전 게시물로 저장돼요. 공유하기 전까지는 나만 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suas fotos ficam salvas como publicações de visão privadas: só você as vê até decidir compartilhar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Фото сохраняются как личные публикации-визии: видишь их только ты, пока не решишь поделиться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "照片会保存为私密愿景动态：在你决定分享之前只有你能看到。"
     }
    }
   }
  },
