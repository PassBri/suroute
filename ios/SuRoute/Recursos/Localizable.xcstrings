  "ev_lect_1": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شهر ضبابي: عد إلى الأساسيات دون لوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nebelmonat: zurück zum Wesentlichen, ohne Schuld."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A foggy month: go back to the essentials, no guilt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mes de niebla: vuelve a lo esencial, sin culpa."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mois de brouillard : reviens à l'essentiel, sans culpabilité."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "धुंध भरा महीना: बिना दोष के मूल बातों पर लौटें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mese di nebbia: torna all'essenziale, senza sensi di colpa."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "霧の月：自分を責めず、基本に戻りましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "안개 낀 달: 자책하지 말고 본질로 돌아가세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Mês de neblina: volte ao essencial, sem culpa."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Туманный месяц: вернитесь к главному, без вины."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "雾月：回到本质，不必自责。"
     }
    }
   }
  },
  "ev_lect_2": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في منتصف الطريق: اختر أقل وأنجزه."
