  "ex_llevo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "من قمة %1$@ هذه، ماذا تأخذ؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was nimmst du von diesem Gipfel von %1$@ mit?"
