  "vision_eje_evo_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل شهر أصبح أفضل من الشهر السابق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeden Monat bin ich besser als im vorherigen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every month I'm better than the one before."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada mes soy mejor que el anterior."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque mois, je suis meilleur que le précédent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर महीने मैं पिछले से बेहतर होता हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni mese sono migliore del precedente."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎月、前の月より良くなっている。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "매달 지난달보다 나아진다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada mês sou melhor que o anterior."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый месяц я лучше, чем в предыдущий."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每个月的我都比上个月更好。"
     }
    }
   }
  },
  "vision_eje_evo_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شيء تتعلمه أو مكان تريد الوصول إليه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Etwas, das du lernst, oder ein Ort, den du erreichen willst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Something you're learning or a place you want to reach."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Algo que estás aprendiendo o un lugar al que quieres llegar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quelque chose que tu apprends ou un lieu que tu veux atteindre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कुछ जो आप सीख रहे हैं या कोई जगह जहाँ पहुँचना चाहते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Qualcosa che stai imparando o un luogo che vuoi raggiungere."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "学んでいること、たどり着きたい場所。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "배우고 있는 것이나 가고 싶은 곳."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Algo que você está aprendendo ou um lugar aonde quer chegar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "То, чему ты учишься, или место, куда хочешь прийти."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你正在学习的东西，或你想抵达的地方。"
     }
    }
   }
  },
  "vision_eje_mae_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أتدرب كل يوم حتى أتقن حرفتي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich übe jeden Tag, bis ich mein Handwerk meistere."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I practice every day until I master my craft."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Practico cada día hasta dominar mi oficio."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je pratique chaque jour jusqu’à maîtriser mon métier."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं अपने काम में महारत तक हर दिन अभ्यास करता हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mi esercito ogni giorno finché non padroneggio il mio mestiere."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "技を極めるまで毎日練習する。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 일을 숙달할 때까지 매일 연습한다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pratico todo dia até dominar meu ofício."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я практикуюсь каждый день, пока не овладею своим делом."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我每天练习，直到精通自己的技艺。"
     }
    }
   }
  },
  "vision_eje_mae_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت أثناء التدرب: أدواتك أو مكان عملك أو دراستك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du bei deiner Praxis: deine Werkzeuge, dein Arbeits- oder Lernplatz."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You at your practice: your tools, your workspace or study space."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tú en tu práctica: tus herramientas, tu espacio de trabajo o de estudio."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Toi en pleine pratique : tes outils, ton espace de travail ou d’étude."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभ्यास करते हुए आप: आपके औज़ार, काम या पढ़ाई की जगह।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu mentre ti eserciti: i tuoi strumenti, il tuo spazio di lavoro o di studio."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "練習中のあなた：道具、仕事や勉強の場所。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연습하는 당신: 도구, 작업 또는 공부 공간."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você na sua prática: suas ferramentas, seu espaço de trabalho ou estudo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты в практике: твои инструменты, рабочее или учебное место."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "练习中的你：你的工具、工作或学习空间。"
     }
    }
   }
  },
  "vision_eje_tra_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمتي تساعد الآخرين على الصعود."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mein Gipfel hilft anderen beim Aufstieg."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "My summit helps others climb."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mi cumbre ayuda a otros a subir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mon sommet aide les autres à monter."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मेरा शिखर दूसरों को चढ़ने में मदद करता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La mia vetta aiuta gli altri a salire."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "私の頂上は他の人の登りを助ける。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나의 정상은 다른 이들이 오르도록 돕는다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Meu cume ajuda outros a subir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Моя вершина помогает подниматься другим."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我的巅峰帮助他人攀登。"
     }
    }
   }
  },
  "vision_eje_tra_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الأشخاص الذين تؤثر فيهم: عائلتك وطلابك ومجتمعك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Menschen, die du bewegst: deine Familie, deine Schüler, deine Gemeinschaft."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The people you impact: your family, your students, your community."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las personas que impactas: tu familia, tus alumnos, tu comunidad."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les personnes que tu touches : ta famille, tes élèves, ta communauté."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जिन लोगों पर आप असर डालते हैं: परिवार, विद्यार्थी, समुदाय।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le persone su cui hai impatto: la tua famiglia, i tuoi studenti, la tua comunità."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたが影響を与える人：家族、生徒、地域。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신이 영향을 주는 사람들: 가족, 학생, 공동체."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "As pessoas que você impacta: sua família, seus alunos, sua comunidade."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Люди, на которых ты влияешь: семья, ученики, сообщество."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你影响的人：你的家人、学生、社群。"
     }
    }
   }
  },
  "vision_eje_val_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أعيش بانسجام مما أجيد فعله."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich lebe stimmig von dem, was ich kann."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I make a coherent living from what I know how to do."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vivo con coherencia de lo que sé hacer."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je vis avec cohérence de ce que je sais faire."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं जो करना जानता हूँ उससे सुसंगत जीवन जीता हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Vivo con coerenza di ciò che so fare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "できることで、一貫した暮らしを立てる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내가 잘하는 일로 일관되게 살아간다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Vivo com coerência do que sei fazer."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я живу в согласии с собой тем, что умею делать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我以自己擅长的事，过一致而踏实的生活。"
     }
    }
   }
  },
  "vision_eje_val_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ما يجعله عملك ممكنًا: بيتك ومشروعك وحريتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was deine Arbeit möglich macht: dein Zuhause, dein Geschäft, deine Freiheit."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What your work makes possible: your home, your business, your freedom."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que tu trabajo hace posible: tu casa, tu negocio, tu libertad."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce que ton travail rend possible : ta maison, ton entreprise, ta liberté."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका काम जो संभव बनाता है: घर, व्यवसाय, आज़ादी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ciò che il tuo lavoro rende possibile: la tua casa, la tua attività, la tua libertà."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "仕事がもたらすもの：家、事業、自由。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 일이 가능하게 하는 것: 집, 사업, 자유."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que seu trabalho torna possível: sua casa, seu negócio, sua liberdade."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "То, что даёт твоя работа: дом, своё дело, свобода."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的工作带来的：你的家、你的事业、你的自由。"
     }
    }
   }
  },
  "vision_eje_vol_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أعرف ما يحركني وأسعى إليه كل يوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich weiß, was mich antreibt, und gehe jeden Tag dafür."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I know what drives me and I go for it every day."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sé lo que me mueve y voy por ello cada día."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je sais ce qui me motive et j’y vais chaque jour."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं जानता हूँ मुझे क्या प्रेरित करता है और हर दिन उसकी ओर बढ़ता हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "So cosa mi muove e ci vado ogni giorno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自分を動かすものを知り、毎日それに向かう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나를 움직이는 것을 알고 매일 그것을 향해 간다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei o que me move e vou atrás disso todo dia."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я знаю, что меня движет, и иду к этому каждый день."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我知道是什么在驱动我，每天都向它前进。"
     }
    }
   }
  },
  "vision_eje_vol_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شيء يشعلك: مكان أو شخص أو رمز لهدفك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Etwas, das dich entfacht: ein Ort, ein Mensch oder ein Symbol deines Ziels."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Something that fires you up: a place, a person or a symbol of your purpose."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Algo que te encienda: un lugar, una persona o un símbolo de tu propósito."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quelque chose qui t’enflamme : un lieu, une personne ou un symbole de ton objectif."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कुछ जो आपको जगा दे: कोई जगह, व्यक्ति या आपके उद्देश्य का प्रतीक।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Qualcosa che ti accenda: un luogo, una persona o un simbolo del tuo proposito."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "心に火をつけるもの：場所、人、目的の象徴。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신을 불타오르게 하는 것: 장소, 사람, 목표의 상징."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Algo que te acenda: um lugar, uma pessoa ou um símbolo do seu propósito."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "То, что тебя зажигает: место, человек или символ твоей цели."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "能点燃你的东西：一个地方、一个人或你目标的象征。"
     }
    }
   }
  },
  "vision_eje_voz_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أشارك رسالتي بصوتي الحقيقي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich teile meine Botschaft mit meiner echten Stimme."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I share my message in my authentic voice."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Comparto mi mensaje con mi voz auténtica."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je partage mon message avec ma voix authentique."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं अपनी सच्ची आवाज़ में अपना संदेश साझा करता हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Condivido il mio messaggio con la mia voce autentica."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "本当の声で自分のメッセージを伝える。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나의 진정한 목소리로 메시지를 전한다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Compartilho minha mensagem com minha voz autêntica."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я делюсь своим посланием своим настоящим голосом."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我用真实的声音分享我的信息。"
     }
    }
   }
  },
  "vision_eje_voz_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت تتحدث أو تعلّم أو تعرض عملك على الآخرين."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du beim Sprechen, Lehren oder Zeigen deines Werks."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You speaking, teaching or showing your work to others."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tú hablando, enseñando o mostrando tu obra a otros."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Toi en train de parler, d’enseigner ou de montrer ton œuvre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बोलते, सिखाते या अपना काम दिखाते हुए आप।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu che parli, insegni o mostri la tua opera agli altri."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "話す、教える、作品を見せるあなた。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "말하고, 가르치고, 작품을 보여 주는 당신."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você falando, ensinando ou mostrando sua obra aos outros."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты выступаешь, учишь или показываешь свою работу другим."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "正在讲话、教学或向他人展示作品的你。"
     }
    }
