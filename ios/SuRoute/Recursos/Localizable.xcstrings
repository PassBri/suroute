  "diario_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد ذكريات بعد. سجّل أولها في أي عام من حياتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Erinnerungen. Halte die erste in einem beliebigen Jahr deines Lebens fest."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No memories yet. Add the first one to any year of your life."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todavía no hay recuerdos. Registra el primero en cualquier año de tu vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore de souvenirs. Ajoute le premier à n’importe quelle année de ta vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी कोई याद नहीं है। अपने जीवन के किसी भी साल में पहली याद दर्ज करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun ricordo. Registra il primo in qualsiasi anno della tua vita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ思い出がありません。人生のどの年にでも最初の思い出を記録しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 추억이 없어요. 인생의 어느 해에든 첫 추억을 남겨 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há lembranças. Registre a primeira em qualquer ano da sua vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока нет воспоминаний. Добавь первое в любой год своей жизни."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有回忆。在人生的任意一年记录第一条吧。"
     }
    }
   }
  },
