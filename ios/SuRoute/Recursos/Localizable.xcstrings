     "stringUnit": {
      "state": "translated",
      "value": "연간 점수, 나침반, 웰빙, 연간 결산."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pontuação do ano, a Bússola, bem-estar e balanço anual."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Оценка года, Компас, самочувствие и годовые итоги."
     }
    },
