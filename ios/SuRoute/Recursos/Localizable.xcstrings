  "cu_documentos_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد مستندات بعد. أضف سند الملكية أو كشف الحساب أو العقد ليكون في متناولك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Dokumente. Füge Urkunde, Auszug oder Vertrag hinzu, um sie griffbereit zu haben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No documents yet. Add the deed, statement or contract to keep it at hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay documentos. Agrega la escritura, el extracto o el contrato para tenerlo a mano."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucun document. Ajoutez l'acte, le relevé ou le contrat pour l'avoir sous la main."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी कोई दस्तावेज़ नहीं। विलेख, स्टेटमेंट या अनुबंध जोड़ें ताकि वह हाथ में रहे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun documento. Aggiungi l'atto, l'estratto o il contratto per averlo a portata di mano."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ書類はありません。登記、明細、契約書を追加していつでも見られるようにしましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 문서가 없습니다. 등기, 명세서, 계약서를 추가해 두세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há documentos. Adicione a escritura, o extrato ou o contrato para tê-lo à mão."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Документов пока нет. Добавьте свидетельство, выписку или договор, чтобы они были под рукой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有文件。添加房产证、对账单或合同，方便随时查看。"
     }
    }
   }
  },
