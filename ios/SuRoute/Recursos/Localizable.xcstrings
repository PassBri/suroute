    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$@ में मैं %1$ld के कौन-से लक्ष्यों पर काम करूँ?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Su quali obiettivi del %1$ld lavoro a %2$@?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$@は%1$ld年のどの目標に取り組む？"
