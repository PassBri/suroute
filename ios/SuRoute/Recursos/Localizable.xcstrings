  "vision_sug_cumbre": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صورة لك في مكان أو لحظة تمثل قمتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Foto von dir an einem Ort oder in einem Moment, der für deinen Gipfel steht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A photo of you in a place or moment that stands for your summit."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una foto tuya en un lugar o momento que represente tu cumbre."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une photo de toi dans un lieu ou un moment qui représente ton sommet."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किसी ऐसी जगह या पल में आपकी फ़ोटो जो आपके शिखर को दर्शाए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una tua foto in un luogo o momento che rappresenti la tua vetta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの頂上を表す場所や瞬間の、あなた自身の写真。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 정상을 나타내는 장소나 순간 속 당신의 사진."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma foto sua num lugar ou momento que represente seu cume."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоё фото в месте или моменте, которые олицетворяют твою вершину."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "一张你在代表你巅峰的地方或时刻的照片。"
     }
    }
   }
  },
