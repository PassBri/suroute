  "diag_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إذا أُغلق التطبيق بسبب خطأ، يرسل ما الذي فشل (الإصدار وطراز الهاتف وسطر الشيفرة) دون حسابك أو محتواك. يساعدنا ذلك على الإصلاح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn die App wegen eines Fehlers schließt, sendet sie, was fehlschlug (Version, Handymodell und Codezeile), ohne dein Konto oder deine Inhalte. Das hilft uns beim Beheben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If the app closes because of an error, it sends what failed (version, phone model and the line of code), without your account or your content. It helps us fix it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si la app se cierra por un error, envía qué falló (versión, modelo del teléfono y la línea del código), sin tu cuenta ni tu contenido. Nos ayuda a arreglarlo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Si l'app se ferme à cause d'une erreur, elle envoie ce qui a échoué (version, modèle du téléphone et ligne de code), sans ton compte ni ton contenu. Cela nous aide à corriger."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अगर ऐप किसी त्रुटि से बंद हो जाए, तो यह भेजता है कि क्या गड़बड़ हुई (संस्करण, फ़ोन मॉडल और कोड की पंक्ति), तुम्हारे खाते या सामग्री के बिना। इससे हमें ठीक करने में मदद मिलती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se l'app si chiude per un errore, invia cosa non ha funzionato (versione, modello del telefono e riga di codice), senza il tuo account né i tuoi contenuti. Ci aiuta a correggerlo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アプリがエラーで閉じた場合、何が起きたか（バージョン、端末の機種、コードの行）を送信します。アカウントや内容は含みません。修正に役立ちます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "앱이 오류로 닫히면 무엇이 실패했는지(버전, 휴대폰 모델, 코드 줄)를 보내요. 계정이나 내용은 포함되지 않아요. 문제 해결에 도움이 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se o app fechar por um erro, envia o que falhou (versão, modelo do celular e a linha do código), sem sua conta nem seu conteúdo. Isso nos ajuda a corrigir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если приложение закроется из‑за ошибки, оно отправит, что сломалось (версию, модель телефона и строку кода), без вашего аккаунта и содержимого. Это помогает нам исправлять ошибки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "如果应用因错误关闭，会发送出错信息（版本、手机型号和代码行），不含你的账户和内容。这能帮助我们修复问题。"
     }
    }
   }
  },
