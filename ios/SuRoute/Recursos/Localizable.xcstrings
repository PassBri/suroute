  },
  "cv_camino_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيُظهر منشورك الطريق الذي قطعته: اليوم %1$ld من المثابرة · %2$ld من 64 خطوة مكتسبة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Beitrag zeigt den Weg, der dahintersteckt: Tag %1$ld der Beständigkeit · %2$ld von 64 Schritten geschafft."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your post will show the path behind it: day %1$ld of consistency · %2$ld of 64 steps earned."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu publicación mostrará el camino que hay detrás: día %1$ld de constancia · %2$ld de 64 pasos ganados."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta publication montrera le chemin parcouru : jour %1$ld de régularité · %2$ld pas gagnés sur 64."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी पोस्ट उसके पीछे का रास्ता दिखाएगी: निरंतरता का दिन %1$ld · 64 में से %2$ld कदम हासिल।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il tuo post mostrerà il cammino che c'è dietro: giorno %1$ld di costanza · %2$ld passi su 64 guadagnati."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿には、その裏にある道のりが表示されます：継続 %1$ld 日目 · 64 歩中 %2$ld 歩を獲得。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "게시물에 그 뒤에 있는 여정이 표시돼요: 꾸준함 %1$ld일째 · 64걸음 중 %2$ld걸음 달성."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sua publicação vai mostrar o caminho por trás dela: dia %1$ld de constância · %2$ld de 64 passos conquistados."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя публикация покажет путь, который за ней стоит: день %1$ld постоянства · %2$ld из 64 шагов пройдено."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的动态会展示背后走过的路：坚持第 %1$ld 天 · 已赢得 64 步中的 %2$ld 步。"
     }
    }
   }
  },
  "cv_camino_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل عاداتك واكسب خطوات في البوصلة: ستُظهر منشوراتك الطريق الذي قطعته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hake deine Gewohnheiten ab und sammle Schritte auf deinem Kompass: Deine Beiträge zeigen den Weg, der dahintersteckt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Check off your habits and earn steps on your Compass: your posts will show the path behind them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marca tus hábitos y gana pasos en tu Brújula: tus publicaciones mostrarán el camino que hay detrás."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Coche tes habitudes et gagne des pas sur ta Boussole : tes publications montreront le chemin parcouru."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी आदतों पर निशान लगाएँ और अपने कंपास पर कदम कमाएँ: आपकी पोस्ट उनके पीछे का रास्ता दिखाएँगी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Segna le tue abitudini e guadagna passi sulla tua Bussola: i tuoi post mostreranno il cammino che c'è dietro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "習慣にチェックを入れて、コンパスで歩数を獲得しましょう。あなたの投稿に、その裏にある道のりが表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "습관을 체크하고 나침반에서 걸음을 얻으세요. 내 게시물에 그 뒤에 있는 여정이 표시돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Marque seus hábitos e ganhe passos na sua Bússola: suas publicações vão mostrar o caminho por trás delas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отмечай привычки и получай шаги в Компасе: твои публикации покажут путь, который за ними стоит."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "打卡你的习惯，在指南针上赢得步数：你的动态会展示背后走过的路。"
     }
    }
   }
  },
  "cv_carta_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "احفظها في حقيبتك لتقرأها عندما تُفتح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg ihn in deinen Rucksack, um ihn zu lesen, wenn er sich öffnet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Save it in your backpack to read it when it opens."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Guárdala en tu mochila para leerla cuando se abra."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Range-la dans ton sac à dos pour la lire quand elle s'ouvrira."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इसे अपने बैकपैक में सहेजें ताकि खुलने पर पढ़ सकें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettila nello zaino per leggerla quando si aprirà."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "リュックに保存して、開封されたら読みましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "배낭에 저장해 두었다가 열리면 읽어 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarde-a na sua mochila para ler quando ela abrir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сохрани его в рюкзаке, чтобы прочитать, когда оно откроется."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "把它放进背包，等开启时再读。"
     }
    }
   }
  },
