  "plan_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تبقى الطريقة كلها مجانية. خطة القمة لمن يريد أن يذهب أبعد، وتساعد أيضًا على استمرار SuRoute."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die ganze Methode bleibt kostenlos. Der Gipfel-Plan ist für alle, die weiter gehen wollen – und er hilft, SuRoute zu tragen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The whole method stays free. The Summit Plan is for those who want to go further, and it helps keep SuRoute going."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todo el método sigue gratis. El Plan Cumbre es para quien quiere ir más lejos y, de paso, ayuda a sostener SuRoute."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Toute la méthode reste gratuite. Le Plan Sommet est pour qui veut aller plus loin, et il aide à faire vivre SuRoute."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पूरी पद्धति मुफ़्त रहेगी। शिखर प्लान उनके लिए है जो और आगे जाना चाहते हैं, और यह SuRoute को चलाए रखने में मदद करता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tutto il metodo resta gratuito. Il Piano Vetta è per chi vuole andare oltre e aiuta a sostenere SuRoute."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "メソッドはすべて無料のままです。サミットプランはさらに先へ進みたい人のためのもので、SuRoute の運営も支えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모든 방법은 계속 무료예요. 정상 플랜은 더 멀리 가고 싶은 분을 위한 것이며, SuRoute를 지속하는 데도 도움이 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Todo o método continua grátis. O Plano Cume é para quem quer ir mais longe e, de quebra, ajuda a manter o SuRoute."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Весь метод остаётся бесплатным. План «Вершина» — для тех, кто хочет пойти дальше, и он помогает SuRoute жить."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "整个方法依然免费。顶峰计划适合想走得更远的人，同时也帮助维持 SuRoute。"
     }
    }
   }
  },
