  "vida_resumen": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عشت %1$ld شهرًا. يتبقى أمامك نحو %2$ld شهرًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast %1$ld Monate gelebt. Etwa %2$ld liegen noch vor dir."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You’ve lived %1$ld months. About %2$ld are still ahead of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Has vivido %1$ld meses. Te quedan cerca de %2$ld por vivir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as vécu %1$ld mois. Il t’en reste environ %2$ld à vivre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने %1$ld महीने जिए हैं। लगभग %2$ld महीने अभी बाकी हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai vissuto %1$ld mesi. Te ne restano circa %2$ld da vivere."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "これまで%1$ldか月を生きてきました。残りはおよそ%2$ldか月です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld개월을 살아왔어요. 앞으로 약 %2$ld개월이 남아 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você viveu %1$ld meses. Restam cerca de %2$ld pela frente."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты прожил %1$ld месяцев. Впереди примерно %2$ld."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你已经走过 %1$ld 个月，前方还有大约 %2$ld 个月。"
     }
    }
   }
  },
  "vida_sin_nacimiento_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أضف تاريخ ميلادك لترى حياتك شهرًا بشهر: ما عشته وما سجلته وكل ما تبقى لتصعده."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gib dein Geburtsdatum ein und sieh dein Leben Monat für Monat: was du gelebt und festgehalten hast und was noch vor dir liegt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Add your date of birth to see your life month by month: what you’ve lived, what you’ve recorded and everything left to climb."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agrega tu fecha de nacimiento y verás tu vida mes a mes: lo que has vivido, lo que registraste y todo lo que te queda por escalar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajoute ta date de naissance pour voir ta vie mois par mois : ce que tu as vécu, ce que tu as noté et tout ce qu’il te reste à gravir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी जन्मतिथि जोड़ें और अपना जीवन महीने-दर-महीने देखें: जो जिया, जो दर्ज किया और जो अभी चढ़ना बाकी है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggiungi la tua data di nascita e vedrai la tua vita mese per mese: ciò che hai vissuto, ciò che hai registrato e tutto ciò che ti resta da scalare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "生年月日を入れると、人生を月ごとに見られます。生きてきた月、記録した月、これから登るすべて。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "생년월일을 입력하면 인생을 달마다 볼 수 있어요. 살아온 날, 기록한 순간, 앞으로 오를 모든 것."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicione sua data de nascimento e veja sua vida mês a mês: o que viveu, o que registrou e tudo o que ainda falta escalar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Добавь дату рождения и увидишь жизнь по месяцам: прожитое, записанное и всё, что ещё предстоит покорить."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "添加你的出生日期，按月查看你的人生：已经走过的、记录下的，以及还要攀登的一切。"
     }
    }
   }
  },
