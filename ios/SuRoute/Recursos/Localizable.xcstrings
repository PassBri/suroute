    }
   }
  },
  "brujula_cierre_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "احتفل وادمج وانزل بوعي: اكتب دروس عامك السبعة، واحفظ بوصلتك في يوميات حياتك، وابدأ جبلًا جديدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Feiere, integriere und steige bewusst ab: Schreib die 7 Lektionen deines Jahres, speichere deinen Kompass im Lebenstagebuch und beginne einen neuen Berg."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebrate, integrate and descend mindfully: write the 7 lessons of your year, save your Compass to your life diary and start a new mountain."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebra, integra y desciende con conciencia: escribe las 7 lecciones de tu año, guarda tu Brújula en el diario de vida y empieza una nueva montaña."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Célèbre, intègre et redescends en conscience : écris les 7 leçons de ton année, garde ta Boussole dans ton journal de vie et commence une nouvelle montagne."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जश्न मनाएँ, सीख समेटें और सजग होकर उतरें: अपने साल के 7 सबक लिखें, कम्पास को जीवन-डायरी में सहेजें और नया पहाड़ शुरू करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebra, integra e scendi con consapevolezza: scrivi le 7 lezioni del tuo anno, salva la Bussola nel diario di vita e inizia una nuova montagna."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "祝い、統合し、意識して下山しましょう。1年の7つの教訓を書き、コンパスを人生日記に保存して、新しい山を始めます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "축하하고, 통합하고, 의식적으로 하산하세요. 한 해의 7가지 교훈을 쓰고 나침반을 인생 일기에 저장한 뒤 새 산을 시작해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Celebre, integre e desça com consciência: escreva as 7 lições do seu ano, guarde sua Bússola no diário de vida e comece uma nova montanha."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отпразднуй, осмысли и спустись осознанно: запиши 7 уроков года, сохрани компас в дневник жизни и начни новую гору."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "庆祝、整合并有意识地下山：写下你这一年的 7 个教训，把罗盘存进人生日记，开始一座新的山。"
     }
    }
   }
  },
