  "bj_ninguna": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ليست لديك بوصلات سنوية بعد. المس سنة لإنشاء الأولى."
     }
    },
