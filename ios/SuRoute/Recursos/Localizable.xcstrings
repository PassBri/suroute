  "onb_ejemplos": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا أفكار؟ المس واحدة للبدء ثم اجعلها خاصة بك:"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Keine Idee? Tippe eine an und mach sie dann zu deiner:"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No ideas yet? Tap one to start, then make it yours:"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Sin ideas? Toca una para empezar y luego hazla tuya:"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas d'idée ? Touche-en une pour commencer, puis fais-la tienne :"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कोई विचार नहीं? शुरू करने के लिए एक चुनें, फिर उसे अपना बनाएँ:"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessuna idea? Toccane una per iniziare e poi falla tua:"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "思いつかない？ひとつタップして、自分の言葉に変えましょう："
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아이디어가 없나요? 하나를 눌러 시작하고 내 것으로 바꿔 보세요:"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sem ideias? Toque uma para começar e depois torne-a sua:"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нет идей? Коснитесь одной, чтобы начать, и сделайте её своей:"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "没有头绪？点一个开始，再改成你自己的："
     }
    }
   }
  },
  "onb_fase": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في أي مرحلة أنت اليوم؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "In welcher Phase bist du HEUTE?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Which phase are you in TODAY?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿En qué fase estás HOY?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Dans quelle phase es-tu AUJOURD'HUI ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप आज किस चरण में हैं?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "In che fase sei OGGI?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今、どのフェーズにいますか?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 나는 어느 단계에 있나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Em que fase você está HOJE?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "На какой ты фазе СЕГОДНЯ?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你今天处在哪个阶段？"
     }
    }
   }
  },
  "onb_fase_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اقرأ كل مرحلة وعلّم على التي تصف وضعك الحالي بأفضل شكل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lies jede Phase und wähle die, die deine aktuelle Situation am besten beschreibt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Read each phase and mark the one that best describes your current situation."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lee cada fase y marca la que mejor describe tu situación actual."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Lis chaque phase et coche celle qui décrit le mieux ta situation actuelle."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर चरण पढ़ें और वह चुनें जो आपकी मौजूदा स्थिति को सबसे अच्छे से बताता हो।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Leggi ogni fase e scegli quella che descrive meglio la tua situazione attuale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "各フェーズを読んで、今の状況にいちばん近いものを選んでください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "각 단계를 읽고 지금 내 상황과 가장 가까운 것을 골라 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Leia cada fase e marque a que melhor descreve sua situação atual."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Прочитай каждую фазу и отметь ту, что лучше всего описывает твою текущую ситуацию."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "读一读每个阶段，选出最贴近你当前状况的那个。"
     }
    }
   }
  },
