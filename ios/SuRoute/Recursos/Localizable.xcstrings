  "brujula_zoom_1": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمتك الشخصية. اضغط أو اضغط مرتين لفتح معسكراتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein persönlicher Gipfel. Tippe oder doppeltippe, um deine Lager zu öffnen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your personal summit. Tap or double-tap to open your camps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cumbre personal. Toca o haz doble toque para abrir tus campamentos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton sommet personnel. Touche ou touche deux fois pour ouvrir tes camps."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका निजी शिखर। अपने शिविर खोलने के लिए टैप या डबल-टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vetta personale. Tocca o tocca due volte per aprire i tuoi campi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの頂上。タップまたはダブルタップでキャンプを開きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 개인 정상. 탭하거나 두 번 탭하여 캠프를 여세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu cume pessoal. Toque ou toque duas vezes para abrir seus acampamentos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя личная вершина. Нажми или дважды нажми, чтобы открыть свои лагеря."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的个人山顶。轻点或双击打开你的营地。"
     }
    }
   }
  },
  "brujula_zoom_81": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بوصلتك كاملة: 81 خانة. المس كتلة لفتحها بالأسفل. للعودة استخدم السهم أو مسار التنقل أو زر الرجوع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein ganzer Kompass: 81 Felder. Tippe auf einen Block, um ihn unten zu öffnen. Zurück geht's mit dem Pfeil, der Pfadleiste oder der Zurück-Taste."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your full Compass: 81 tiles. Tap a block to open it below. To go back, use the arrow, the breadcrumbs or the back button."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu Brújula completa: 81 casillas. Toca un bloque para abrirlo abajo. Para volver, usa la flecha, las migas o el botón atrás."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta Boussole complète : 81 cases. Touche un bloc pour l'ouvrir en dessous. Pour revenir, utilise la flèche, le fil d'Ariane ou le bouton retour."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका पूरा कम्पास: 81 खाने। किसी ब्लॉक को नीचे खोलने के लिए टैप करें। लौटने के लिए तीर, पथ या बैक बटन इस्तेमाल करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua Bussola completa: 81 caselle. Tocca un blocco per aprirlo sotto. Per tornare usa la freccia, il percorso o il tasto indietro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コンパス全体：81マス。ブロックをタップすると下に開きます。戻るには矢印、パンくず、戻るボタンを使います。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "전체 나침반: 81칸. 블록을 누르면 아래에 열려요. 돌아가려면 화살표, 경로 표시, 뒤로 버튼을 쓰세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sua Bússola completa: 81 casas. Toque um bloco para abri-lo abaixo. Para voltar, use a seta, a trilha ou o botão voltar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Весь компас: 81 клетка. Нажми на блок, чтобы открыть его ниже. Назад — стрелка, «хлебные крошки» или кнопка «назад»."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "完整的罗盘：81 格。点一个区块在下方打开。返回可用箭头、路径导航或返回键。"
     }
    }
   }
  },
  "brujula_zoom_9": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المعسكرات: القمة ومعسكراتها الثمانية. اضغط على القمة لرؤية 9×9 أو على معسكر لفتح خطواته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Lager: der Gipfel und seine 8 Lager. Tippe auf den Gipfel für das 9×9 oder auf ein Lager für seine Schritte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Camps: the summit and its 8 camps. Tap the summit to see the 9×9 or a camp to open its steps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Campamentos: la cumbre y sus 8 campamentos. Toca la cumbre para ver el 9×9 o un campamento para abrir sus pasos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Camps : le sommet et ses 8 camps. Touche le sommet pour voir le 9×9 ou un camp pour ouvrir ses pas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "शिविर: शिखर और उसके 8 शिविर। 9×9 देखने के लिए शिखर पर, या किसी शिविर के कदम खोलने के लिए उस पर टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Campi: la vetta e i suoi 8 campi. Tocca la vetta per vedere il 9×9 o un campo per aprire i suoi passi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "キャンプ：頂上と8つのキャンプ。頂上をタップすると9×9、キャンプをタップするとそのステップが開きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "캠프: 정상과 8개의 캠프. 정상을 탭하면 9×9, 캠프를 탭하면 그 걸음이 열립니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Acampamentos: o cume e seus 8 acampamentos. Toque o cume para ver o 9×9 ou um acampamento para abrir seus passos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Лагеря: вершина и её 8 лагерей. Нажми на вершину, чтобы увидеть 9×9, или на лагерь, чтобы открыть его шаги."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "营地：山顶和它的 8 个营地。轻点山顶查看 9×9，或轻点营地打开它的步骤。"
     }
    }
   }
  },
