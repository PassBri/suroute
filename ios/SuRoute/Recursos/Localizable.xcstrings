  "foco_elegir_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حدّد أهداف %1$ld، وإن شئت بعض أهدافها الفرعية فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Markiere deine Ziele für %1$ld und, wenn du willst, nur einige Teilziele."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Check your %1$ld goals and, if you like, only some of their sub-goals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marca las metas de %1$ld y, si quieres, solo algunas de sus sub-metas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Cochez vos objectifs de %1$ld et, si vous voulez, seulement certains sous-objectifs."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld के लक्ष्य चुनें और चाहें तो उनके कुछ उप-लक्ष्य ही।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spunta gli obiettivi del %1$ld e, se vuoi, solo alcuni sotto-obiettivi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld年の目標にチェックし、必要ならサブ目標を一部だけ選びます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld년 목표를 체크하고, 원하면 하위 목표 일부만 고르세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Marque as metas de %1$ld e, se quiser, só algumas das submetas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отметьте цели на %1$ld и, если хотите, только некоторые подцели."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "勾选 %1$ld 年的目标，也可以只选部分子目标。"
     }
    }
   }
  },
