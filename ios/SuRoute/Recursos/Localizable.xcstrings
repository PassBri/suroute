  "modelo_solo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شارك 9×9 الخاص بك مع المجتمع، واصعد ضمن فريق، ودع الآخرين يحفّزونك بطقسهم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Teile dein 9×9 mit der Community, steig in einer Seilschaft und lass dich von anderen mit ihrem Wetter anspornen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Share your 9×9 with the community, climb as a rope team and let others boost you with their weather."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Comparte tu 9×9 en la comunidad, sube en cordada y deja que otros te impulsen con su clima."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Partage ton 9×9 avec la communauté, monte en cordée et laisse les autres te pousser avec leur météo."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "समुदाय में अपना 9×9 साझा करें, रस्सी-दल में चढ़ें और दूसरों को अपने मौसम से आपका हौसला बढ़ाने दें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Condividi il tuo 9×9 con la comunità, sali in cordata e lascia che gli altri ti spingano con il loro meteo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コミュニティで9×9を共有し、ザイルパーティーで登り、仲間の天気で背中を押してもらいましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "커뮤니티에 9×9를 공유하고, 로프 팀으로 오르며, 다른 사람들이 날씨로 응원하게 하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Compartilhe seu 9×9 na comunidade, suba em cordada e deixe que outros te impulsionem com o seu clima."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Делись своим 9×9 с сообществом, иди в связке и позволь другим поддерживать тебя своей погодой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在社区分享你的 9×9，和同伴结组攀登，让别人用他们的天气为你加油。"
     }
    }
   }
  },
  "modelo_solo_t": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا تصعد وحدك"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du steigst nicht allein"
     }
    },
    "en": {
