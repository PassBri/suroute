  "cu_fijos_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المبلغ الجديد يسري من هذا الشهر. لتغيير شهر واحد فقط عدّله في يومه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein neuer Betrag gilt ab diesem Monat. Für nur einen Monat bearbeite ihn an seinem Tag."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A new amount applies from this month on. To change just one month, edit it on its day."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si cambias el monto, rige desde este mes. Para cambiar solo un mes, edítalo en su día."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un nouveau montant s’applique dès ce mois-ci. Pour un seul mois, modifie-le à sa date."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "रकम बदलें तो इस महीने से लागू होगी। सिर्फ़ एक महीना बदलना हो तो उस दिन पर बदलें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un nuovo importo vale da questo mese. Per un solo mese, modificalo nel suo giorno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "金額を変えると今月から反映されます。1か月分だけなら、その日で編集してください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "금액을 바꾸면 이번 달부터 적용돼요. 한 달만 바꾸려면 그날에서 수정하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se mudar o valor, vale a partir deste mês. Para mudar só um mês, edite no dia."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Новая сумма действует с этого месяца. Чтобы изменить один месяц, правь запись в её день."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "修改金额从本月起生效。只改某一个月，请在当天修改。"
     }
    }
   }
  },
