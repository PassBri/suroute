  "cu_moneda_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُختار حسب بلدك ولغتك. غيّرها إن كنت تدير حساباتك بعملة أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nach Land und Sprache gewählt. Ändere sie, wenn du in einer anderen rechnest."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Chosen from your country and language. Change it if you keep your accounts in another."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se elige según tu país e idioma. Cámbiala si llevas tus cuentas en otra."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisie selon ton pays et ta langue. Change-la si tu tiens tes comptes dans une autre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके देश और भाषा से चुनी गई है। किसी और मुद्रा में हिसाब रखते हों तो बदलें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scelta in base a paese e lingua. Cambiala se tieni i conti in un’altra."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "国と言語から選ばれます。別の通貨で管理するなら変更してください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "국가와 언어에 따라 정해져요. 다른 통화로 관리하면 바꾸세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolhida pelo seu país e idioma. Mude se você controla suas contas em outra."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выбрана по стране и языку. Смени, если ведёшь учёт в другой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "根据你的国家和语言选择。如用其他货币记账，可以更改。"
     }
    }
   }
  },
