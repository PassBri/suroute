  "cv_g7_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يُظهر كل منشور الطريق الذي يقف خلفه: أيام المثابرة المتتالية والخطوات المكتسبة في البوصلة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Beitrag zeigt den Weg dahinter: die Tage Beständigkeit am Stück und die auf dem Kompass gesammelten Schritte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each post shows the path behind it: days in a row of consistency and steps earned on the Compass."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada publicación muestra el camino que hay detrás: los días seguidos de constancia y los pasos ganados de la Brújula."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque publication montre le chemin parcouru : les jours de régularité d'affilée et les pas gagnés sur la Boussole."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर पोस्ट उसके पीछे का रास्ता दिखाती है: लगातार निरंतरता के दिन और कंपास पर कमाए गए कदम।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni post mostra il cammino che c'è dietro: i giorni consecutivi di costanza e i passi guadagnati sulla Bussola."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿には、その裏にある道のりが表示されます：連続した継続日数と、コンパスで獲得した歩数です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모든 게시물에 그 뒤에 있는 여정이 표시돼요: 연속 꾸준함 일수와 나침반에서 얻은 걸음 수예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada publicação mostra o caminho por trás dela: os dias seguidos de constância e os passos conquistados na Bússola."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждая публикация показывает путь за ней: дни постоянства подряд и шаги, полученные в Компасе."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每条动态都会展示背后走过的路：连续坚持的天数和在指南针上赢得的步数。"
     }
    }
   }
  },
  "cv_g7_t": {
