  },
  "ruta_sin_propositos": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا شيء طويل المدى بعد. ينشأ من بوصلتك العامة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch nichts Langfristiges. Es entsteht aus deinem allgemeinen Kompass."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Nothing long-term yet. It comes from your general Compass."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todavía no hay propósitos. Nacen de tu Brújula general."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rien à long terme pour l’instant. Cela naît de ta Boussole générale."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी कुछ लंबी अवधि का नहीं। यह आपके सामान्य कम्पास से बनता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora niente a lungo termine. Nasce dalla tua Bussola generale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ長期の目標がありません。全体のコンパスから生まれます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 장기 목표가 없어요. 전체 나침반에서 생겨나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda nada de longo prazo. Nasce da sua Bússola geral."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока ничего долгосрочного. Это рождается из твоего общего компаса."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有长期目标。它来自你的总罗盘。"
     }
    }
   }
  },
  "ruta_vida_puntos": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
