  "brujula_edicion_81_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتب مباشرة في الخانات. استخدم + أو − أو مسار التنقل لتغيير المستوى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreibe direkt in die Felder. Wechsle die Ebene mit +, − oder dem Navigationspfad."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write directly in the cells. Use +, − or the breadcrumbs to change levels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escribe directamente en las casillas. Usa +, − o las migas para cambiar de nivel."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écrivez directement dans les cases. Utilisez +, − ou le fil de navigation pour changer de niveau."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "खानों में सीधे लिखें। स्तर बदलने के लिए +, − या नेविगेशन पथ का उपयोग करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrivi direttamente nelle caselle. Usa +, − o il percorso di navigazione per cambiare livello."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "マスに直接入力できます。+、−、パンくずリストで階層を切り替えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "칸에 직접 입력하세요. +, − 또는 탐색 경로로 보기를 바꿀 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escreva diretamente nas células. Use +, − ou o caminho de navegação para mudar de nível."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пишите прямо в ячейках. Меняйте уровень с помощью +, − или навигационной цепочки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "直接在格子中填写。使用+、−或导航路径切换层级。"
     }
    }
   }
  },
