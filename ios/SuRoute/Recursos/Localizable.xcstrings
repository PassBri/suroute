    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Am I willing to sacrifice my summit to keep a relationship?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Estoy dispuesto/a a sacrificar mi cumbre por mantener una relación?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Suis-je prêt·e à sacrifier mon sommet pour garder une relation ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "क्या मैं किसी रिश्ते को बचाने के लिए अपना शिखर त्यागने को तैयार हूँ?"
     }
    },
    "it": {
