  "ng_vacio_dia": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد حركات في هذا اليوم بعد. سجّل الأولى بالأعلى: النوع والمبلغ وانتهيت."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Buchungen an diesem Tag. Trage oben die erste ein: Art, Betrag, fertig."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No entries this day yet. Add the first one above: the type, the amount, done."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay movimientos este día. Anota el primero arriba: el tipo, el monto y listo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucun mouvement ce jour-là. Notez le premier ci-dessus : le type, le montant, c'est tout."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस दिन अभी कोई प्रविष्टि नहीं। ऊपर पहली लिखें: प्रकार, राशि, बस।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun movimento in questo giorno. Annota il primo qui sopra: tipo, importo e via."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この日の記録はまだありません。上で最初の一件を：種類と金額だけでOK。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 날은 아직 기록이 없어요. 위에서 첫 기록을 남기세요: 종류와 금액이면 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há movimentos neste dia. Anote o primeiro acima: o tipo, o valor e pronto."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В этот день записей пока нет. Добавьте первую выше: тип и сумма — и готово."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这一天还没有记录。在上方记下第一笔：类型、金额，就好了。"
     }
    }
   }
  },
  "ng_vacio_mes": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا شيء مسجل في %1$@. ابدأ بمبيعاتك: اضغط «بيع»."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nichts eingetragen im %1$@. Beginne mit deinen Verkäufen: tippe auf „Verkauf“."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Nothing recorded in %1$@. Start with your sales: tap “Sale”."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Nada anotado en %1$@. Empieza por tus ventas: toca «Venta»."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rien de noté en %1$@. Commencez par vos ventes : touchez « Vente »."
