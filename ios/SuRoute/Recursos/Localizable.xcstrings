  "cordadas_muro_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم يكتب أحد بعد. «هيا بنا!» في وقتها تساعد أكثر مما تظن."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch hat niemand geschrieben. Ein „Los geht’s!“ zur rechten Zeit hilft mehr, als du denkst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No one has written yet. A timely “let’s go!” helps more than you think."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Nadie ha escrito todavía. Un «¡vamos!» a tiempo ayuda más de lo que crees."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Personne n’a encore écrit. Un « on y va ! » au bon moment aide plus qu’on ne croit."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी किसी ने नहीं लिखा। सही समय पर “चलो!” सोच से ज़्यादा मदद करता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessuno ha ancora scritto. Un «forza!» al momento giusto aiuta più di quanto pensi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ誰も書いていません。タイミングのいい「行こう！」は思った以上に効きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 아무도 쓰지 않았어요. 제때의 “가자!” 한마디가 생각보다 큰 힘이 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ninguém escreveu ainda. Um “vamos!” na hora certa ajuda mais do que você imagina."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока никто не писал. Вовремя сказанное «вперёд!» помогает больше, чем кажется."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有人留言。一句及时的“加油！”比你想的更有用。"
     }
    }
   }
  },
