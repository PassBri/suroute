  "ios_acepto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أوافق على [الشروط والأحكام](%1$@) و[سياسة الخصوصية](%2$@)، و[أأذن بمعالجة بياناتي](%3$@)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich akzeptiere die [AGB](%1$@) und die [Datenschutzerklärung](%2$@) und [willige in die Verarbeitung meiner Daten ein](%3$@)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I accept the [Terms and conditions](%1$@) and the [Privacy policy](%2$@), and [I authorize the processing of my data](%3$@)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acepto los [Términos y condiciones](%1$@) y la [Política de privacidad](%2$@), y [autorizo el tratamiento de mis datos](%3$@)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "J'accepte les [Conditions générales](%1$@) et la [Politique de confidentialité](%2$@), et [j'autorise le traitement de mes données](%3$@)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं [नियम और शर्तें](%1$@) और [गोपनीयता नीति](%2$@) स्वीकार करता/करती हूँ, और [अपने डेटा के प्रसंस्करण की अनुमति देता/देती हूँ](%3$@)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Accetto i [Termini e condizioni](%1$@) e l'[Informativa sulla privacy](%2$@), e [autorizzo il trattamento dei miei dati](%3$@)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "[利用規約](%1$@)と[プライバシーポリシー](%2$@)に同意し、[データの取り扱いを許可します](%3$@)。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "[이용약관](%1$@)과 [개인정보 처리방침](%2$@)에 동의하며 [내 데이터 처리를 허락합니다](%3$@)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Aceito os [Termos e condições](%1$@) e a [Política de privacidade](%2$@), e [autorizo o tratamento dos meus dados](%3$@)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я принимаю [Условия использования](%1$@) и [Политику конфиденциальности](%2$@) и [разрешаю обработку моих данных](%3$@)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我接受[条款和条件](%1$@)和[隐私政策](%2$@)，并[授权处理我的数据](%3$@)。"
     }
    }
   }
  },
