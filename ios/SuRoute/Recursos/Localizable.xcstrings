  "cu_capa_ocultar_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في اليوم والمخطِّط ومساري سترى ••••• بدل الأرقام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "In Heute, im Planer und in Meine Route siehst du ••••• statt Zahlen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "In Today, the planner and My route you’ll see ••••• instead of figures."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "En Hoy, el planificador y Mi ruta verás ••••• en vez de cifras."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Dans Aujourd’hui, le planificateur et Ma route, tu verras ••••• au lieu des chiffres."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज, प्लानर और मेरी राह में संख्याओं की जगह ••••• दिखेगा।"
