      }
     }
    },
    "pt": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Seu fixo (%2$@) não aparece em %3$@. Também valia neste mês?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "Seus %1$ld fixos (%2$@) não aparecem em %3$@. Também valiam neste mês?"
