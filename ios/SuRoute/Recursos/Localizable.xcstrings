  "tipo_meta_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أعلن هدفك: الالتزام المشترك يُنجَز أكثر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mach dein Ziel öffentlich: Geteilte Verpflichtung wird eher erfüllt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Make your goal public: a shared commitment is more likely to be kept."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz pública tu meta: el compromiso compartido se cumple más."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rends ton objectif public : un engagement partagé se tient mieux."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपना लक्ष्य सार्वजनिक करें: साझा किया गया वादा ज़्यादा निभता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rendi pubblico il tuo obiettivo: l'impegno condiviso si rispetta di più."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標を公開しましょう。みんなで共有した約束は、果たされやすくなります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표를 공개하세요. 함께 나눈 약속은 더 잘 지켜져요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Torne sua meta pública: compromisso compartilhado é mais cumprido."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сделай цель публичной: общее обязательство выполняется чаще."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "公开你的目标：被分享的承诺更容易兑现。"
     }
    }
   }
  },
