  "ev_prop_atras": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت متأخر عن الوقت: راجع أي هدف سنوي يقرّبك أكثر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du liegst hinter der Zeit: prüfe, welches Jahresziel es näherbringt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You're behind time: check which goal of the year brings it closer."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vas detrás del tiempo: revisa qué meta del año lo acerca más."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu es en retard sur le temps : vois quel objectif de l'année le rapproche le plus."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप समय से पीछे हैं: देखें इस साल का कौन-सा लक्ष्य सबसे पास लाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei indietro sul tempo: guarda quale obiettivo dell'anno lo avvicina di più."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "時間より遅れています：今年どの目標が最も近づけるか見直しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "시간보다 뒤처졌어요: 올해 어떤 목표가 가장 가깝게 하는지 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você está atrás do tempo: veja qual meta do ano o aproxima mais."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы отстаёте от времени: посмотрите, какая цель года больше приближает."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你落后于时间：看看今年哪个目标最能推进它。"
     }
    }
   }
  },
