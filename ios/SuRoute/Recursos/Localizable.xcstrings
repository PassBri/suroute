  "meta_creada_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أصبح في شلّالك. علّم عليه كل يوم في «اليوم» وسترى قمّتك تكبر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es ist jetzt in deiner Kaskade. Hak es jeden Tag unter Heute ab und sieh deinen Gipfel wachsen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It's already in your cascade. Check it off every day in Today and watch your summit grow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ya está en tu cascada. Márcala cada día en Hoy y verás crecer tu cumbre."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il est déjà dans ta cascade. Coche-le chaque jour dans Aujourd'hui et regarde ton sommet grandir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह अब आपके झरने में है। इसे रोज़ आज में टिक करें और अपनी चोटी को बढ़ते देखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "È già nella tua cascata. Segnalo ogni giorno in Oggi e vedrai crescere la tua vetta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "カスケードに追加されました。「今日」で毎日チェックすれば、山頂が育っていくのが見えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이제 폭포에 들어갔어요. 오늘 탭에서 매일 체크하면 나의 정상이 자라는 걸 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ela já está na sua cascata. Marque-a todo dia em Hoje e veja seu cume crescer."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Она уже в твоём каскаде. Отмечай её каждый день в «Сегодня», и ты увидишь, как растёт твоя вершина."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "它已经在你的瀑布里了。每天在「今天」里打卡，你就会看到你的山巅在长高。"
     }
    }
   }
  },
