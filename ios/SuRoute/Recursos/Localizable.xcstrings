  "usuario_explica": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اسمك الفريد في SuRoute: به يجدك أصدقاؤك ويراسلونك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein eindeutiger Name bei SuRoute: So finden dich Freunde und schreiben dir."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It's your unique name on SuRoute: it's how friends find you and message you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Es tu nombre único en SuRoute: así te encuentran tus amigos y te escriben."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "C'est votre nom unique sur SuRoute : c'est ainsi que vos amis vous trouvent et vous écrivent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह SuRoute पर आपका अनोखा नाम है: इसी से दोस्त आपको ढूँढते और संदेश भेजते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "È il tuo nome unico su SuRoute: così i tuoi amici ti trovano e ti scrivono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute でのあなただけの名前です。友だちはこれであなたを見つけ、メッセージを送ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute에서의 고유한 이름입니다. 친구들이 이것으로 당신을 찾고 메시지를 보냅니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "É seu nome único no SuRoute: é assim que seus amigos encontram você e escrevem."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ваше уникальное имя в SuRoute: по нему друзья находят вас и пишут вам."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这是你在 SuRoute 的唯一名称：朋友靠它找到你并给你发消息。"
     }
    }
   }
  },
  "usuario_formato": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "من 3 إلى 30 حرفًا صغيرًا أو أرقامًا أو نقطة أو شرطة سفلية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "3 bis 30 Kleinbuchstaben, Ziffern, Punkt oder Unterstrich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "3 to 30 lowercase letters, numbers, dot or underscore."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De 3 a 30 letras minúsculas, números, punto o guion bajo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "De 3 à 30 lettres minuscules, chiffres, point ou tiret bas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "3 से 30 छोटे अक्षर, अंक, बिंदु या अंडरस्कोर।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Da 3 a 30 lettere minuscole, numeri, punto o trattino basso."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "3〜30 文字の小文字、数字、ドット、アンダースコア。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "3~30자의 소문자, 숫자, 마침표 또는 밑줄."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "De 3 a 30 letras minúsculas, números, ponto ou sublinhado."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "От 3 до 30 строчных букв, цифр, точки или подчёркивания."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "3 到 30 个小写字母、数字、点或下划线。"
     }
    }
   }
  },
