      "state": "translated",
      "value": "Du hast dieses Jahr %1$ld von 365 Zitaten geöffnet"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You've opened %1$ld of 365 quotes this year"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Has abierto %1$ld de 365 frases este año"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as ouvert %1$ld citations sur 365 cette année"
