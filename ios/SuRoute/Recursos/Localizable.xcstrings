  "cord_hoy_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مجموعتك تصعد معك: علّم يومك وسيرونه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Gruppe steigt mit dir: Hak deinen Tag ab und sie sehen es."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your group climbs with you: check in and they’ll see it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu grupo sube contigo: marca tu día y ellos lo ven."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton groupe grimpe avec toi : coche ton jour et ils le voient."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका समूह आपके साथ चढ़ता है: दिन चिह्नित करें, वे देखेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il tuo gruppo sale con te: segna il tuo giorno e lo vedono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "仲間が一緒に登っています。日をチェックすると皆に見えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "팀이 함께 올라요. 하루를 체크하면 모두가 봐요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu grupo sobe com você: marque seu dia e eles veem."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Группа поднимается с тобой: отметь день — они увидят."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的小组和你一起攀登：打卡后他们都能看到。"
     }
    }
   }
  },
