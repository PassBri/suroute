  "tarjeta_tra": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمّتي لا تهمّ إلا إذا ساعدت غيري على الصعود."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mein Gipfel zählt nur, wenn er anderen beim Aufstieg hilft."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "My summit only matters if it helps others climb."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mi cumbre solo importa si ayuda a otros a subir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mon sommet n'a d'importance que s'il aide les autres à monter."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मेरी चोटी तभी मायने रखती है जब वह दूसरों को चढ़ने में मदद करे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La mia vetta conta solo se aiuta gli altri a salire."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの山頂は、誰かが登る助けになってこそ意味がある。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나의 정상은 다른 사람이 오르도록 도울 때 의미가 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Meu cume só importa se ajudar outros a subir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Моя вершина важна, только если помогает другим подниматься."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "只有当我的山巅能帮助他人攀登，它才有意义。"
     }
    }
   }
  },
  "tarjeta_val": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أتقاضى مقابل القيمة التي أصنعها، لا مقابل ساعات عملي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich verlange Geld für den Wert, den ich schaffe, nicht für die Stunden, die ich arbeite."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I charge for the value I create, not for the hours I work."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cobro por el valor que genero, no por las horas que trabajo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je me fais payer pour la valeur que je crée, pas pour les heures que je travaille."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं उस मूल्य के पैसे लेता हूँ जो मैं पैदा करता हूँ, काम के घंटों के नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mi faccio pagare per il valore che genero, non per le ore che lavoro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "働いた時間ではなく、生み出す価値に対して対価をもらう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "일한 시간이 아니라 내가 만든 가치만큼 받아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cobro pelo valor que gero, não pelas horas que trabalho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я беру плату за создаваемую ценность, а не за отработанные часы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我按创造的价值收费，而不是按工作的小时数。"
     }
    }
   }
  },
  "tarjeta_vol": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هل يقرّبني هذا من قمّتي أم يبعدني عنها؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bringt mich das meinem Gipfel näher oder entfernt es mich davon?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Does this bring me closer to my summit or pull me away?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Esto me acerca o me aleja de mi cumbre?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Cela me rapproche-t-il ou m'éloigne-t-il de mon sommet ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "क्या यह मुझे मेरी चोटी के क़रीब ले जाता है या दूर?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo mi avvicina o mi allontana dalla mia vetta?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "これは山頂に近づく?それとも遠ざかる?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이것이 나를 정상에 가깝게 할까, 멀어지게 할까?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Isto me aproxima ou me afasta do meu cume?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Это приближает меня к вершине или уводит от неё?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这件事是让我靠近还是远离我的山巅？"
     }
    }
   }
  },
