  "ios_misma_cuenta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إنه المسار نفسه في تطبيق Android وSuRoute Web: ما تحدده هنا يظهر هناك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es ist dieselbe Route wie in der Android-App und in SuRoute Web: Was du hier abhakst, erscheint dort."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It's the same route as your Android app and SuRoute Web: what you check here shows up there."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Es la misma ruta de tu app Android y de SuRoute Web: lo que marques aquí aparece allá."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "C'est le même parcours que sur Android et SuRoute Web : ce que vous cochez ici apparaît là-bas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह वही मार्ग है जो आपके Android ऐप और SuRoute Web में है: यहाँ जो चिह्नित करेंगे वह वहाँ दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "È lo stesso percorso della tua app Android e di SuRoute Web: ciò che segni qui appare lì."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "Android アプリや SuRoute Web と同じルートです。ここでチェックしたものはあちらにも表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "Android 앱, SuRoute 웹과 같은 루트예요. 여기서 체크한 것이 그곳에도 나타나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "É a mesma rota do seu app Android e do SuRoute Web: o que você marcar aqui aparece lá."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Это тот же маршрут, что в приложении Android и SuRoute Web: отмеченное здесь появится там."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "与你的 Android 应用和 SuRoute 网页版是同一条路线：在这里勾选的内容会同步到那里。"
     }
    }
   }
  },
