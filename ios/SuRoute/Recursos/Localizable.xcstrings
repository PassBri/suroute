    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The sky right now: the sun at %1$ld°, the moon %2$ld%% lit."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El cielo de ahora: el sol a %1$ld°, la luna iluminada al %2$ld %%."
