  "decision_pausar_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هناك عقبات مؤقتة. توقّف قليلًا وأعد النظر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es gibt vorübergehende Hindernisse. Halte kurz inne und denk neu."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "There are temporary obstacles. Stop briefly and rethink."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hay obstáculos temporales. Detente brevemente y replantea."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il y a des obstacles temporaires. Arrête-toi un instant et repense la suite."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कुछ अस्थायी बाधाएँ हैं। थोड़ा रुकें और दोबारा सोचें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ci sono ostacoli temporanei. Fermati un attimo e ripensa."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "一時的な障害があります。少し立ち止まって考え直しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "일시적인 장애물이 있어요. 잠시 멈추고 다시 생각해 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Há obstáculos temporários. Pare por um momento e repense."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Есть временные препятствия. Ненадолго остановись и переосмысли."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "出现了暂时的障碍。先停一停，重新思考。"
     }
    }
   }
  },
