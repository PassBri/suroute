  "foco_sin_metas": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد أهداف لعام %1$ld بعد. تنشأ من بوصلتك لتلك السنة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Ziele für %1$ld. Sie entstehen aus deinem Kompass dieses Jahres."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No goals for %1$ld yet. They come from that year’s Compass."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay metas de %1$ld. Nacen de tu Brújula de ese año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore d’objectifs pour %1$ld. Ils naissent de ta Boussole de cette année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld के लिए अभी कोई लक्ष्य नहीं। वे उस साल के कम्पास से बनते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun obiettivo per il %1$ld. Nascono dalla tua Bussola di quell’anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld年の目標はまだありません。その年のコンパスから生まれます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld년 목표가 아직 없어요. 그해 나침반에서 생겨나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há metas de %1$ld. Elas nascem da sua Bússola desse ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Целей на %1$ld пока нет. Они рождаются из твоего компаса на этот год."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld 年还没有目标。它们来自那一年的罗盘。"
     }
    }
   }
  },
  "foco_sin_pasos": {
