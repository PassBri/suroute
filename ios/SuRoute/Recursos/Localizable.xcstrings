  "ios_fin_codigo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أموالك مشفّرة. على هذا الـ iPhone أدخل رمز الاسترداد المكوّن من 12 كلمة مرة واحدة، ثم ستدخل بالرمز السري أو Face ID."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Finanzen sind verschlüsselt. Gib auf diesem iPhone einmal deinen 12-Wörter-Wiederherstellungscode ein; danach PIN oder Face ID."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your finances are encrypted. On this iPhone, enter your 12-word recovery code once; after that you'll use your PIN or Face ID."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus finanzas están cifradas. En este iPhone, escribe una sola vez tu código de recuperación de 12 palabras; luego entrarás con tu PIN o con Face ID."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vos finances sont chiffrées. Sur cet iPhone, saisissez une seule fois votre code de récupération de 12 mots ; ensuite, PIN ou Face ID."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका वित्त एन्क्रिप्टेड है। इस iPhone पर एक बार 12 शब्दों का रिकवरी कोड लिखें; फिर PIN या Face ID से खोलें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le tue finanze sono cifrate. Su questo iPhone inserisci una sola volta il codice di recupero di 12 parole; poi entrerai con PIN o Face ID."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "お金の記録は暗号化されています。この iPhone で 12 語の復元コードを一度だけ入力すると、以後は PIN か Face ID で開けます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "재무가 암호화되어 있어요. 이 iPhone에서 12단어 복구 코드를 한 번만 입력하면 이후에는 PIN이나 Face ID로 열 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suas finanças estão criptografadas. Neste iPhone, digite uma única vez seu código de recuperação de 12 palavras; depois entrará com seu PIN ou Face ID."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ваши финансы зашифрованы. На этом iPhone один раз введите 12-словный код восстановления; дальше — PIN или Face ID."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的财务已加密。在这台 iPhone 上输入一次 12 个词的恢复码，之后用 PIN 或面容 ID 进入。"
     }
    }
   }
  },
