  "cu_ind_liquidez_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الدخل ÷ المصروفات. فوق 1 تغطي كل ما يخرج."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Einnahmen ÷ Ausgänge. Über 1 deckst du alles, was rausgeht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Income ÷ outflows. Above 1 you cover everything that goes out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ingresos ÷ egresos. Por encima de 1 cubres todo lo que sale."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Revenus ÷ sorties. Au-dessus de 1, tu couvres tout ce qui sort."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आय ÷ निकासी। 1 से ऊपर होने पर सब खर्च पूरे होते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Entrate ÷ uscite. Sopra 1 copri tutto ciò che esce."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "収入 ÷ 支出。1 を超えれば出ていくお金をすべて賄えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "수입 ÷ 지출. 1을 넘으면 나가는 돈을 모두 감당해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Receitas ÷ saídas. Acima de 1 você cobre tudo o que sai."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Доходы ÷ списания. Выше 1 — ты покрываешь все расходы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "收入 ÷ 支出。大于 1 即可覆盖所有支出。"
     }
    }
   }
  },
