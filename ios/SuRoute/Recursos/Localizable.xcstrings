  "cp_l3": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هل لديّ وضوح تام بشأن قمتي الشخصية؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bin ich mir über meinen eigenen persönlichen Gipfel völlig im Klaren?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Am I completely clear about my own personal summit?"
     }
    },
    "es": {
