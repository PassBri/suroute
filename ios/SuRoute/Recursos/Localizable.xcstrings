  "cu_control_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل ما دخل وما خرج اليوم. في الصعود المالي يُضاف إلى الشهر والسنة وميزانك العام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Notiere, was heute rein- und rausging. Im Finanziellen Aufstieg zählt es zum Monat, zum Jahr und zu deiner Gesamtbilanz."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write down what came in and went out today. In Financial ascent it adds up to the month, the year and your overall balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anota lo que entró y salió hoy. En Ascenso financiero se suma al mes, al año y a tu balance general."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Note ce qui est entré et sorti aujourd’hui. Dans Ascension financière, cela s’ajoute au mois, à l’année et à ton bilan général."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज जो आया और गया, लिखें। वित्तीय चढ़ाई में यह महीने, साल और कुल हिसाब में जुड़ता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Annota cosa è entrato e uscito oggi. In Ascesa finanziaria si somma al mese, all’anno e al bilancio generale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日入った額と出た額を記録しましょう。お金の登山で月・年・全体の収支に加算されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 들어오고 나간 돈을 적으세요. 재정 등반에서 월, 연도, 전체 결산에 더해져요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Anote o que entrou e saiu hoje. Na Ascensão financeira isso soma ao mês, ao ano e ao seu balanço geral."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши, что пришло и ушло сегодня. В «Финансовом восхождении» это сложится в месяц, год и общий баланс."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "记下今天进出的钱。在财务攀登中，它会汇入月、年和你的总余额。"
     }
    }
   }
  },
