  "cv_guia_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "في SuRoute لا نكافئ الانتباه بل التقدم الحقيقي. إليك طريقة استخدام كل خيار:"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bei SuRoute wird nicht Aufmerksamkeit belohnt, sondern echter Fortschritt. So nutzt du jede Option:"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute doesn't reward attention, it rewards real progress. Here's how each option works:"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "En SuRoute no se premia la atención sino el avance real. Así se usa cada opción:"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sur SuRoute, ce n'est pas l'attention qui est récompensée, mais les vrais progrès. Voici comment utiliser chaque option :"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute ध्यान खींचने को नहीं, असली प्रगति को पुरस्कृत करता है। हर विकल्प ऐसे इस्तेमाल करें:"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Su SuRoute non si premia l'attenzione, ma i progressi reali. Ecco come usare ogni opzione:"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute では、注目ではなく本当の前進が評価されます。各機能の使い方はこちら："
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute는 관심이 아니라 실제 전진을 응원해요. 각 기능은 이렇게 사용해요:"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "No SuRoute, o que se premia não é a atenção, e sim o avanço real. Veja como usar cada opção:"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В SuRoute вознаграждается не внимание, а реальный прогресс. Вот как пользоваться каждой функцией:"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute 奖励的不是关注度，而是真正的进步。各项功能的用法如下："
     }
    }
   }
  },
