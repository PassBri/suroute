  "cu_fijos_ausentes": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "بندك الثابت (%2$@) لا يظهر في %3$@. هل كان ينطبق هذا الشهر أيضًا؟"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "بنودك الثابتة الـ %1$ld (%2$@) لا تظهر في %3$@. هل كانت تنطبق هذا الشهر أيضًا؟"
        }
       }
      }
     }
    },
    "de": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Ihr Fixposten (%2$@) erscheint nicht im %3$@. Galt er auch in diesem Monat?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "Ihre %1$ld Fixposten (%2$@) erscheinen nicht im %3$@. Galten sie auch in diesem Monat?"
        }
       }
      }
     }
    },
    "en": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Your fixed item (%2$@) doesn't appear in %3$@. Did it also apply this month?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "Your %1$ld fixed items (%2$@) don't appear in %3$@. Did they also apply this month?"
        }
       }
      }
     }
    },
    "es": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Tu fijo (%2$@) no aparece en %3$@. ¿También aplicaba este mes?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "Tus %1$ld fijos (%2$@) no aparecen en %3$@. ¿También aplicaban este mes?"
        }
       }
      }
     }
    },
    "fr": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Votre élément fixe (%2$@) n’apparaît pas en %3$@. S’appliquait-il aussi ce mois-ci ?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "Vos %1$ld éléments fixes (%2$@) n’apparaissent pas en %3$@. S’appliquaient-ils aussi ce mois-ci ?"
        }
       }
      }
     }
    },
    "hi": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "आपकी तय मद (%2$@) %3$@ में नहीं दिख रही। क्या यह इस महीने भी लागू थी?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "आपकी %1$ld तय मदें (%2$@) %3$@ में नहीं दिख रहीं। क्या ये इस महीने भी लागू थीं?"
        }
       }
      }
     }
    },
    "it": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "La tua voce fissa (%2$@) non compare a %3$@. Valeva anche questo mese?"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "Le tue %1$ld voci fisse (%2$@) non compaiono a %3$@. Valevano anche questo mese?"
        }
       }
      }
     }
    },
    "ja": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "固定項目（%2$@）が%3$@に表示されていません。この月も該当しましたか？"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld 件の固定項目（%2$@）が%3$@に表示されていません。この月も該当しましたか？"
