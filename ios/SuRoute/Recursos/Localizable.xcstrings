  "gr_acceso_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كبّر وتصفح حساباتك بالأيام أو الأسابيع أو الأشهر أو السنوات · شموع وأعمدة وخطوط"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zoome durch deine Konten nach Tagen, Wochen, Monaten oder Jahren · Kerzen, Balken und Linien"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Zoom through your accounts by day, week, month or year · candles, bars and lines"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Amplía y recorre tus cuentas por días, semanas, meses o años · velas, barras y líneas"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Zoome et parcours tes comptes par jours, semaines, mois ou années · bougies, barres et lignes"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दिन, हफ़्ते, महीने या साल के हिसाब से ज़ूम करके देखें · कैंडल, बार और रेखाएँ"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ingrandisci e scorri i tuoi conti per giorni, settimane, mesi o anni · candele, barre e linee"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "日・週・月・年で拡大して見られます・ローソク足、棒、折れ線"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "일·주·월·연 단위로 확대해 살펴보세요 · 캔들, 막대, 선"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Amplie e percorra suas contas por dias, semanas, meses ou anos · velas, barras e linhas"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Масштабируй и листай счета по дням, неделям, месяцам и годам · свечи, столбцы, линии"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "按日、周、月或年缩放浏览账目 · K线、柱状和折线"
     }
    }
   }
  },
