  "contactos_sin_cuenta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بحساب يمكنك العثور على جهات اتصالك ويمكنهم العثور عليك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mit einem Konto findest du deine Kontakte und sie dich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "With an account you can find your contacts and let them find you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con tu cuenta podrás encontrar a tus contactos y que ellos te encuentren."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Avec un compte, vous pourrez trouver vos contacts et ils pourront vous trouver."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "खाते के साथ आप अपने संपर्क ढूँढ सकेंगे और वे आपको।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con un account potrai trovare i tuoi contatti e farti trovare da loro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アカウントがあれば、連絡先を見つけたり、見つけてもらったりできます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계정이 있으면 연락처를 찾고, 그들도 당신을 찾을 수 있습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Com sua conta você poderá encontrar seus contatos e eles poderão encontrar você."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "С аккаунтом вы сможете находить контакты, а они — вас."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "登录账户后，你可以找到联系人，他们也能找到你。"
     }
    }
   }
  },
