  "horizonte_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قمتك في عام %1$ld. ستمتد أهدافك السنوية حتى ذلك العام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Gipfel liegt im Jahr %1$ld. Die Jahresziele des Plans reichen bis dahin."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your summit will be in %1$ld. Your yearly goals will run until then."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu cumbre estará en %1$ld. Las metas anuales del plan llegarán hasta ese año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton sommet sera en %1$ld. Les objectifs annuels du plan iront jusqu’à cette année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका शिखर %1$ld में होगा। वार्षिक लक्ष्य उसी वर्ष तक चलेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua vetta sarà nel %1$ld. Gli obiettivi annuali arriveranno fino a quell’anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたの頂上は%1$ld年です。年間目標はその年まで続きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "당신의 정상은 %1$ld년입니다. 연간 목표가 그해까지 이어집니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu cume será em %1$ld. As metas anuais do plano irão até esse ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя вершина — в %1$ld году. Годовые цели плана продлятся до этого года."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的巅峰在 %1$ld 年。年度目标将一直规划到那一年。"
     }
    }
   }
  },
