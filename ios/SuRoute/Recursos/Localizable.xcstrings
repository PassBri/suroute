  "ng_i_margen_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "(المبيعات − تكلفة المبيعات) ÷ المبيعات. ما يتبقى من كل بيع لتغطية التشغيل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "(Umsatz − Wareneinsatz) ÷ Umsatz. Was jeder Verkauf für den Betrieb übrig lässt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "(Sales − cost of goods sold) ÷ sales. What each sale leaves to pay for running the business."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "(Ventas − costo de lo vendido) ÷ ventas. Lo que te queda de cada venta para pagar la operación."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "(Ventes − coût des ventes) ÷ ventes. Ce que chaque vente laisse pour payer le fonctionnement."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "(बिक्री − बेचे माल की लागत) ÷ बिक्री। हर बिक्री से संचालन के लिए कितना बचता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "(Vendite − costo del venduto) ÷ vendite. Ciò che ogni vendita lascia per pagare l'operatività."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "（売上 − 売上原価）÷ 売上。各売上から運営費に回せる分。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "(매출 − 매출원가) ÷ 매출. 판매마다 운영비로 남는 몫."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "(Vendas − custo do vendido) ÷ vendas. O que sobra de cada venda para pagar a operação."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "(Продажи − себестоимость) ÷ продажи. Сколько каждая продажа оставляет на работу бизнеса."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "（销售额 − 销售成本）÷ 销售额。每笔销售留下多少来支付经营。"
     }
    }
   }
  },
