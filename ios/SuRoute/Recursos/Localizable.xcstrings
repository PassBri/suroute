  "album_borrar_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيُحذف المنشور من حائطك ومن ألبومك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Beitrag wird von deiner Pinnwand und aus deinem Album gelöscht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The post will be removed from your wall and your album."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se borra la publicación de tu muro y de tu álbum."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La publication sera supprimée de votre mur et de votre album."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पोस्ट आपकी वॉल और एल्बम से हटा दी जाएगी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il post verrà eliminato dalla tua bacheca e dal tuo album."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿はウォールとアルバムから削除されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "게시물이 담벼락과 앨범에서 삭제됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A publicação será apagada do seu mural e do seu álbum."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Публикация будет удалена со стены и из альбома."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "该帖子将从你的主页和相册中删除。"
     }
    }
   }
  },
