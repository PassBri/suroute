  "ex_paso_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ما ألهمك يصبح شيئًا تفعله."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was dich inspiriert hat, wird zu etwas, das du tust."
