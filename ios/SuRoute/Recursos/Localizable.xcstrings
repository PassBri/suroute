  "niebla_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الضياع ليس فشلًا: إنه جزء من الرحلة. اختر البروتوكول الذي تحتاجه الآن."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sich zu verlaufen ist kein Scheitern, sondern Teil der Reise. Wähle das Protokoll, das du jetzt brauchst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Getting lost isn't failing: it's part of the journey. Choose the protocol you need right now."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Perderse no es fracasar: es parte del viaje. Elige el protocolo que necesitas ahora."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Se perdre n'est pas échouer : cela fait partie du voyage. Choisis le protocole dont tu as besoin maintenant."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "खो जाना असफलता नहीं है: यह सफ़र का हिस्सा है। अभी जिस प्रोटोकॉल की ज़रूरत है, उसे चुनें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Perdersi non è fallire: fa parte del viaggio. Scegli il protocollo che ti serve ora."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "迷うことは失敗ではなく、旅の一部です。今の自分に必要なプロトコルを選びましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "길을 잃는 건 실패가 아니에요. 여정의 일부예요. 지금 필요한 프로토콜을 골라 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se perder não é fracassar: faz parte da jornada. Escolha o protocolo de que você precisa agora."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Потеряться — не значит провалиться: это часть пути. Выбери протокол, который нужен сейчас."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "迷路不是失败，而是旅程的一部分。选择你现在需要的方案。"
     }
    }
   }
  },
