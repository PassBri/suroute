  "fase_2_diag": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أعرف إلى أين أتجه، لكني أحتاج إلى تطوير مهاراتي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich weiß schon, wohin ich will, aber ich muss Fähigkeiten aufbauen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I know where I'm headed, but I need to develop skills."
     }
    },
    "es": {
