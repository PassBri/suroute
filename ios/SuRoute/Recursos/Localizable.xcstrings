  "mirar_sugerir_calibrar": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل بوصلة تنحرف قليلًا: المس معايرة ثم %1$@ الحقيقي ليتطابق كل شيء."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Kompass weicht etwas ab: Tippe auf Kalibrieren und dann auf den echten %1$@, damit alles passt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every compass drifts a bit: tap Calibrate, then the real %1$@, so everything lines up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada brújula se desvía un poco: toca Calibrar y luego %1$@ de verdad para que todo calce."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque boussole dévie un peu : touche Calibrer, puis le vrai %1$@, pour que tout s'aligne."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर कंपास थोड़ा भटकता है: कैलिब्रेट करें टैप करें, फिर असली %1$@ पर टैप करें ताकि सब मेल खाए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni bussola devia un po': tocca Calibra e poi il vero %1$@, così tutto combacia."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コンパスは少しずれます：補正をタップし、本物の%1$@をタップするとすべてが合います。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나침반은 조금씩 어긋나요: 보정을 탭한 뒤 실제 %1$@을(를) 탭하면 모두 맞춰져요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toda bússola desvia um pouco: toque em Calibrar e depois em %1$@ de verdade para tudo se alinhar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Любой компас немного ошибается: нажмите «Калибровать», а затем на настоящую цель (%1$@), чтобы всё совпало."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每个指南针都会有些偏差：点按校准，再点按真实的%1$@，让一切对齐。"
     }
    }
   }
  },
