  "total_cerca": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت قريب من قمّتك. ركّز على صقل المحاور الأضعف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du bist nah an deinem Gipfel. Konzentriere dich darauf, die schwächsten Achsen zu verfeinern."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You're close to your summit. Focus on polishing your weakest axes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estás cerca de tu cumbre. Enfócate en perfeccionar los ejes más débiles."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu es proche de ton sommet. Concentre-toi sur le perfectionnement de tes axes les plus faibles."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप अपनी चोटी के क़रीब हैं। सबसे कमज़ोर अक्षों को निखारने पर ध्यान दें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei vicino alla tua vetta. Concentrati sul perfezionare gli assi più deboli."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "山頂はもうすぐです。いちばん弱い軸を磨き上げましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "정상이 가까워요. 가장 약한 축을 다듬는 데 집중하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você está perto do seu cume. Foque em aprimorar os eixos mais fracos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты близко к своей вершине. Сосредоточься на подтягивании самых слабых осей."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你离山巅已经很近了。专注打磨最薄弱的维度吧。"
     }
    }
   }
  },
