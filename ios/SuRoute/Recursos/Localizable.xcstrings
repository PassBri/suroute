      "value": "¿Tengo claridad total sobre mi propia cumbre personal?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ai-je une clarté totale sur mon propre sommet personnel ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "क्या मुझे अपने निजी शिखर के बारे में पूरी स्पष्टता है?"
     }
    },
    "it": {
