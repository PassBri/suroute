  "vision_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يبني الذكاء الاصطناعي لوحتك من قمتك وأهدافك وغاياتك، وتملؤها أنت بصورك: فكل صورة من حياتك لا من كتالوج."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die KI baut dein Board aus deinem Gipfel, deinen Zielen und Vorhaben. Du füllst es mit deinen Fotos – jedes Bild stammt aus deinem Leben, nicht aus einem Katalog."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "AI builds your board from your summit, purposes and goals. You fill it with your own photos, so every image comes from your life, not a catalog."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La IA arma tu tablero con tu cumbre, tus propósitos y tus metas. Tú lo llenas con tus fotos: así cada imagen es de tu vida, no de un catálogo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L’IA construit ton tableau avec ton sommet, tes objectifs et tes buts. Tu le remplis de tes photos : chaque image vient de ta vie, pas d’un catalogue."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "AI आपके शिखर, उद्देश्यों और लक्ष्यों से बोर्ड बनाता है। आप उसे अपनी तस्वीरों से भरें: हर छवि आपकी ज़िंदगी से हो, किसी कैटलॉग से नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L’IA crea la tua bacheca con la tua vetta, i tuoi propositi e obiettivi. Tu la riempi con le tue foto: ogni immagine viene dalla tua vita, non da un catalogo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "AI があなたの頂上・目的・目標からボードを組み立てます。写真はあなた自身のものを。どの画像もカタログではなく、あなたの人生から。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "AI가 당신의 정상, 목표, 계획으로 보드를 구성해요. 사진은 직접 채우세요. 모든 이미지가 카탈로그가 아닌 당신의 삶에서 나오도록."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A IA monta seu quadro com seu cume, seus propósitos e suas metas. Você o preenche com suas fotos: assim cada imagem é da sua vida, não de um catálogo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "ИИ собирает доску из твоей вершины, целей и задач. Ты наполняешь её своими фото — каждое изображение из твоей жизни, а не из каталога."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "AI 根据你的巅峰、目标和计划搭建愿景板，再由你放上自己的照片：每张图都来自你的生活，而不是图库。"
     }
    }
   }
  },
