     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя Личная Вершина в одной фразе (можно написать позже):"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用一句话写下你的个人山巅（也可以稍后再写）："
     }
    }
   }
  },
  "onb_ejemplo_1": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أن أعيش مما أحب وأجد وقتًا لعائلتي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Von dem leben, was ich liebe, und Zeit für meine Familie haben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Make a living from what I love and have time for my family."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vivir de lo que amo y tener tiempo para mi familia."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vivre de ce que j'aime et avoir du temps pour ma famille."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जो मुझे पसंद है उसी से जीविका चलाना और परिवार के लिए समय रखना।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Vivere di ciò che amo e avere tempo per la mia famiglia."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "好きなことで生計を立て、家族との時間を持つ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "좋아하는 일로 생계를 꾸리고 가족과 시간을 보내기."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Viver do que amo e ter tempo para minha família."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Жить любимым делом и иметь время для семьи."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "以我热爱的事为生，并有时间陪伴家人。"
     }
    }
   }
  },
  "onb_ejemplo_2": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
