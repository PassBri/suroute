  "regreso_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "غبت %1$ld أيام ومسارك ما زال هنا كاملًا. لا داعي للتعويض: ابدأ اليوم بعادة واحدة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du warst %1$ld Tage weg und deine Route ist noch komplett da. Nichts aufholen: Starte heute mit einer einzigen Gewohnheit neu."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You were away %1$ld days and your route is still here, complete. No need to catch up: restart with a single habit today."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estuviste %1$ld días fuera y tu ruta sigue aquí, completa. No hace falta ponerse al día: retoma con un solo hábito hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as été absent %1$ld jours et ta route est toujours là, complète. Pas besoin de rattraper : reprends avec une seule habitude aujourd’hui."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप %1$ld दिन दूर रहे और आपका मार्ग पूरा यहीं है। कुछ भरपाई नहीं करनी: आज एक आदत से फिर शुरू करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei stato via %1$ld giorni e la tua rotta è ancora qui, completa. Non serve recuperare: riparti oggi con una sola abitudine."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld日ぶりですね。ルートはそのまま残っています。取り戻す必要はありません。今日は習慣をひとつだけ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld일 동안 떠나 있었지만 경로는 그대로예요. 따라잡을 필요 없어요. 오늘 습관 하나로 다시 시작해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ficou %1$ld dias fora e sua rota continua aqui, completa. Não precisa recuperar o atraso: retome com um único hábito hoje."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Тебя не было %1$ld дн., а маршрут на месте. Ничего не нужно навёрстывать: начни сегодня с одной привычки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你离开了 %1$ld 天，你的路线依然完整。不必补课：今天从一个习惯重新开始。"
     }
    }
   }
  },
  "regreso_titulo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سعيد برؤيتك مجددًا"
     }
    },
    "de": {
