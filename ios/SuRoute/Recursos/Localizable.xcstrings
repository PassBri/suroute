  "aprende_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مكتبتك تتبع مراحل الصعود. تقدّم بالترتيب أو ادخل حيث تحتاج اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Bibliothek folgt den Etappen des Aufstiegs. Geh der Reihe nach vor oder steig dort ein, wo du heute etwas brauchst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your library follows the stages of the ascent. Go in order or jump in wherever you need it today."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu biblioteca sigue las etapas del ascenso. Avanza en orden o entra donde lo necesites hoy."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta bibliothèque suit les étapes de l'ascension. Avance dans l'ordre ou entre là où tu en as besoin aujourd'hui."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी लाइब्रेरी चढ़ाई के चरणों के साथ चलती है। क्रम से आगे बढ़ें या आज जहाँ ज़रूरत हो वहाँ से शुरू करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua biblioteca segue le tappe della salita. Procedi in ordine o entra dove ti serve oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ライブラリは登頂のステージに沿って並んでいます。順番に進んでも、今日必要なところから入ってもOKです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "배움 라이브러리는 등반의 단계를 따라가요. 순서대로 진행하거나 오늘 필요한 곳으로 바로 들어가 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sua biblioteca segue as etapas da subida. Avance em ordem ou entre onde precisar hoje."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя библиотека следует этапам восхождения. Иди по порядку или заходи туда, где нужно сегодня."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的知识库遵循攀登的各个阶段。可以按顺序前进，也可以直接进入今天需要的部分。"
     }
    }
   }
  },
