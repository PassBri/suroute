  "fg_llevo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مما سمعته في نار %1$@، ماذا تأخذ لخطوتك غدًا؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was nimmst du aus dem Lagerfeuer von %1$@ für deinen Schritt von morgen mit?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "From what you heard at %1$@'s campfire, what do you take away for tomorrow's step?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De lo que escuchaste en la fogata de %1$@, ¿qué te llevas para tu paso de mañana?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "De ce que vous avez entendu au feu de %1$@, qu'emportez-vous pour votre pas de demain ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ के अलाव में जो सुना, उसमें से कल के कदम के लिए आप क्या ले जा रहे हैं?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Da ciò che hai ascoltato al falò di %1$@, cosa porti via per il tuo passo di domani?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ さんのたき火で聞いたことから、明日の一歩のために何を持ち帰りますか？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 님의 모닥불에서 들은 것 중 내일의 한 걸음을 위해 무엇을 가져가나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Do que você ouviu na fogueira de %1$@, o que leva para o seu passo de amanhã?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Что из услышанного у костра %1$@ вы уносите для своего завтрашнего шага?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "从 %1$@ 的篝火中，你为明天的一步带走了什么？"
     }
    }
   }
  },
  "fg_llevo_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيرى %1$@ ما تأخذه، فيعرف ما تركه في أهله."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ sieht, was du mitnimmst. So weiß die Person, was sie bei ihren Leuten hinterlassen hat."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ will see what you take away. That way they know what they left in their people."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ verá lo que te llevas. Así sabe qué dejó en su gente."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ verra ce que vous emportez. Ainsi, il sait ce qu'il a laissé aux siens."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ देखेंगे कि आप क्या ले जा रहे हैं। इससे उन्हें पता चलता है कि उन्होंने अपने लोगों में क्या छोड़ा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ vedrà cosa porti via. Così sa cosa ha lasciato alla sua gente."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ さんはあなたが持ち帰ることを見られます。仲間に何を残せたかがわかります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 님이 당신이 가져가는 것을 봅니다. 그래서 사람들에게 무엇을 남겼는지 알 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ verá o que você leva. Assim sabe o que deixou na sua gente."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ увидит, что вы уносите. Так он поймёт, что оставил своим людям."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 会看到你带走了什么，这样就知道自己给大家留下了什么。"
     }
    }
   }
  },
  "fg_llevo_ok": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إنه لك. غدًا خطوتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du nimmst es mit. Morgen ist dein Schritt."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It's yours. Tomorrow is your step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Te lo llevas. Mañana es tu paso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "C'est à vous. Demain, c'est votre pas."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह आपका है। कल आपका कदम है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "È tuo. Domani è il tuo passo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "持ち帰りました。明日はあなたの一歩です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "가져갔어요. 내일은 당신의 한 걸음입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "É seu. Amanhã é o seu passo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Это ваше. Завтра — ваш шаг."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你带走了。明天是你的一步。"
     }
    }
   }
  },
  "fg_llevo_ph": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مثال: تجهيز الملابس في الليلة السابقة"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Z. B.: abends die Kleidung bereitlegen"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "E.g.: lay out my clothes the night before"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ej.: dejar la ropa lista la noche anterior"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ex. : préparer mes vêtements la veille"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जैसे: रात में ही कपड़े तैयार रखना"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Es.: preparare i vestiti la sera prima"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "例：前の晩に服を用意しておく"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "예: 전날 밤 옷을 미리 준비하기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ex.: deixar a roupa pronta na noite anterior"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Напр.: готовить одежду с вечера"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
