  "vv_cam_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مخيم القاعدة هم من يصعدون معك: فريقك ومرشدك ومدرب حياتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Basislager sind die Menschen, die mit dir steigen: deine Seilschaft, dein Mentor und dein Life-Coach."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your base camp is the people who climb with you: your rope team, your mentor and your life coach."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu campamento base son las personas que suben contigo: tu cordada, tu mentor y tu coach de vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton camp de base, ce sont les personnes qui montent avec toi : ta cordée, ton mentor et ton coach de vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका बेस कैंप वे लोग हैं जो आपके साथ चढ़ते हैं: आपकी टोली, मेंटर और लाइफ़ कोच।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il tuo campo base sono le persone che salgono con te: la tua cordata, il tuo mentore e il tuo life coach."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ベースキャンプは一緒に登る人たち。ザイルパーティ、メンター、ライフコーチです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "베이스캠프는 함께 오르는 사람들입니다. 자일 파티, 멘토, 라이프 코치."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu acampamento base são as pessoas que sobem com você: sua cordada, seu mentor e seu coach de vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твой базовый лагерь — люди, которые идут с тобой: связка, наставник и лайф-коуч."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的大本营是和你一起攀登的人：你的绳队、导师和人生教练。"
     }
    }
   }
  },
