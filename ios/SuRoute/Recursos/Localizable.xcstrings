  "cu_has_pagado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "دفعت %1$@: %2$@ لأصل الدين و%3$@ فوائد. عليك %4$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bezahlt: %1$@ – %2$@ Tilgung und %3$@ Zinsen. Du schuldest %4$@."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You have paid %1$@: %2$@ to principal and %3$@ to interest. You owe %4$@."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Has pagado %1$@: %2$@ a capital y %3$@ a intereses. Debes %4$@."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous avez payé %1$@ : %2$@ de capital et %3$@ d'intérêts. Vous devez %4$@."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने %1$@ चुकाए: %2$@ मूलधन और %3$@ ब्याज। बकाया %4$@।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai pagato %1$@: %2$@ di capitale e %3$@ di interessi. Devi %4$@."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "支払済み %1$@：元金 %2$@、利息 %3$@。残高 %4$@。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지금까지 %1$@ 상환: 원금 %2$@, 이자 %3$@. 남은 빚 %4$@."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você pagou %1$@: %2$@ de capital e %3$@ de juros. Deve %4$@."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выплачено %1$@: %2$@ основного долга и %3$@ процентов. Остаток %4$@."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你已支付 %1$@：本金 %2$@，利息 %3$@。仍欠 %4$@。"
     }
    }
   }
  },
