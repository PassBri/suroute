  "eje_voz_pregunta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هل أعبّر عن أصالتي ورسالتي للعالم دون خوف؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Drücke ich meine Authentizität und meine Botschaft ohne Angst in die Welt aus?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Do I express my authenticity and my message to the world without fear?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Expreso mi autenticidad y mi mensaje al mundo sin miedo?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Est-ce que j'exprime mon authenticité et mon message au monde sans peur ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "क्या मैं बिना डर के अपनी असलियत और अपना संदेश दुनिया के सामने रखता हूँ?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Esprimo la mia autenticità e il mio messaggio al mondo senza paura?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "恐れずに、自分らしさとメッセージを世界に伝えていますか?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "두려움 없이 나다운 모습과 메시지를 세상에 표현하고 있나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Expresso minha autenticidade e minha mensagem ao mundo sem medo?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выражаю ли я свою подлинность и своё послание миру без страха?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我是否能毫无畏惧地向世界表达真实的自己和我的信息？"
     }
    }
   }
  },
