  "onb_cita": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تأتي لحظة في الحياة تشعر فيها بنداء هادئ."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es gibt einen Moment im Leben, in dem du einen stillen Ruf spürst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "There comes a moment in life when you feel a quiet calling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hay un momento en la vida en que sientes un llamado silencioso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il arrive un moment dans la vie où l'on ressent un appel silencieux."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ज़िंदगी में एक ऐसा पल आता है जब आप एक ख़ामोश पुकार महसूस करते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Arriva un momento nella vita in cui senti un richiamo silenzioso."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "人生には、静かな呼び声を感じる瞬間があります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "삶에는 조용한 부름을 느끼는 순간이 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Há um momento na vida em que você sente um chamado silencioso."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В жизни бывает момент, когда ты слышишь тихий зов."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "人生中会有这样一个时刻，你感到一种无声的召唤。"
     }
    }
   }
  },
