  "cu_rec_ahorro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ادفع لنفسك أولًا: ادّخر 10 % على الأقل يوم الراتب."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zahl dich zuerst: lege am Zahltag mindestens 10 % zurück."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pay yourself first: set aside at least 10 % on payday, before spending."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Págate primero: separa al menos el 10 % el día que te pagan, antes de gastar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Payez-vous d'abord : mettez au moins 10 % de côté le jour de paie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पहले खुद को भुगतान करें: वेतन वाले दिन कम से कम 10 % अलग रखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Paga prima te stesso: metti da parte almeno il 10 % il giorno di paga."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "先に自分に払う：給料日に少なくとも 10 % を取り分けましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "먼저 자신에게 지불하세요: 월급날 최소 10 %를 떼어 두세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pague-se primeiro: separe pelo menos 10 % no dia do pagamento, antes de gastar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сначала заплатите себе: откладывайте не меньше 10 % в день зарплаты."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "先支付自己：发薪当天至少存下 10 %。"
     }
    }
   }
  },
  "cu_rec_buenas": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "معظم ديونك تكلّف فقط. سدّدها أولًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die meisten deiner Schulden kosten nur. Tilge sie zuerst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Most of your debts only cost. Close them first."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La mayoría de tus deudas solo cuestan. Ciérralas primero."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La plupart de vos dettes ne font que coûter. Fermez-les d'abord."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके ज़्यादातर कर्ज़ सिर्फ़ खर्च कराते हैं। पहले उन्हें चुकाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La maggior parte dei tuoi debiti costa soltanto. Chiudili per primi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "借金の多くはコストだけです。まずそれを返しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "대부분의 빚은 비용만 듭니다. 먼저 갚으세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A maioria das suas dívidas só custa. Feche-as primeiro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Большинство ваших долгов только стоят денег. Закройте их первыми."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的大多数债务只会花钱。先还清它们。"
     }
    }
   }
  },
  "cu_rec_construye": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اهدف لقاعدة 80/20: 20 % من كل دخل لمستقبلك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ziel 80/20: 20 % jedes Einkommens für deine Zukunft."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Aim for the 80/20 rule: 20 % of each income for your future."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apunta a la regla 80/20: el 20 % de cada ingreso para tu futuro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Visez la règle 80/20 : 20 % de chaque revenu pour votre avenir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "80/20 नियम: हर आय का 20 % अपने भविष्य के लिए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Punta alla regola 80/20: il 20 % di ogni entrata per il tuo futuro."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "80/20 ルール：収入の 20 % を未来のために。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "80/20 규칙: 수입의 20 %를 미래를 위해."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Mire a regra 80/20: 20 % de cada renda para o seu futuro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цель — правило 80/20: 20 % каждого дохода на будущее."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "以 80/20 规则为目标：每笔收入的 20 % 留给未来。"
     }
    }
   }
  },
  "cu_rec_dti": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أقساطك تثقل دخلك. لا تأخذ ديونًا جديدة وسدّد الأغلى أولًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Raten belasten dein Einkommen stark. Keine neuen Schulden und zuerst die teuersten tilgen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your installments weigh heavily on your income. Take no new debt and follow your plan to close the most expensive first."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus cuotas pesan mucho sobre tu ingreso. No tomes deudas nuevas y sigue tu plan para cerrar primero las más caras."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vos mensualités pèsent lourd. Pas de nouvelle dette, et suivez le plan en fermant d'abord les plus chères."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "किस्तें आय पर भारी हैं। नया कर्ज़ न लें और महँगे कर्ज़ पहले चुकाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le rate pesano molto sul reddito. Niente nuovi debiti; chiudi prima i più cari."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "返済が収入を圧迫しています。新たな借入はせず、高い借金から返しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "상환액이 수입에 큰 부담입니다. 새 빚을 지지 말고 비싼 빚부터 갚으세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suas parcelas pesam muito sobre sua renda. Não faça novas dívidas e siga o plano, fechando as mais caras primeiro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Платежи сильно давят на доход. Не берите новых долгов и гасите сначала самые дорогие."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "月供占收入比例很高。不要再借新债，按计划先还最贵的。"
     }
    }
   }
  },
  "cu_rec_endeuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تدين بجزء كبير مما تملك. خفّض الديون السيئة قبل الشراء بالتقسيط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du schuldest einen großen Teil deines Besitzes. Tilge schlechte Schulden, bevor du auf Kredit kaufst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You owe a large share of what you own. Pay down bad debt before buying on credit."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Debes una parte grande de lo que tienes. Baja las deudas malas antes de comprar a crédito."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous devez une grande part de ce que vous possédez. Réduisez les mauvaises dettes avant d'acheter à crédit."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी संपत्ति के मुकाबले कर्ज़ बड़ा है। उधार पर खरीदने से पहले बुरे कर्ज़ घटाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Devi una parte grande di ciò che hai. Riduci i debiti cattivi prima di comprare a credito."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "資産に対して借金の割合が大きいです。ローンで買う前に悪い借金を減らしましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "가진 것에 비해 빚이 큽니다. 할부 구매 전에 나쁜 빚을 줄이세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você deve grande parte do que tem. Reduza as dívidas ruins antes de comprar a crédito."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы должны большую часть того, что имеете. Сократите плохие долги, прежде чем покупать в кредит."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你欠的钱占资产很大比例。先还坏债，再考虑贷款消费。"
     }
    }
   }
  },
  "cu_rec_flujo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يبقى القليل مما يدخل. راجع الحقيبة الصفراء وضع حدًا لكل فئة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Von deinen Einnahmen bleibt wenig übrig. Prüfe den gelben Rucksack und setze Limits pro Kategorie."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Little is left of what comes in. Review the yellow backpack and set a cap per category."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Te queda poco libre de lo que entra. Revisa la mochila amarilla y fija un tope por categoría."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il reste peu de ce qui entre. Revoyez le sac jaune et fixez un plafond par catégorie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आय में से बहुत कम बचता है। पीला बैग देखें और हर श्रेणी की सीमा तय करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Resta poco di ciò che entra. Rivedi lo zaino giallo e fissa un tetto per categoria."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "入ってくるお金の残りがわずかです。黄色のリュックを見直し、カテゴリごとに上限を決めましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "들어오는 돈 중 남는 것이 적습니다. 노란 배낭을 점검하고 카테고리별 한도를 정하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sobra pouco do que entra. Revise a mochila amarela e defina um limite por categoria."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "От доходов остаётся мало. Проверьте жёлтый рюкзак и задайте лимит для каждой категории."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "收入剩余很少。检查黄色背包，为每个类别设定上限。"
     }
    }
   }
  },
  "cu_rec_fondo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كوّن صندوق طوارئ يغطي 3 إلى 6 أشهر من المصاريف الثابتة في حساب منفصل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Baue einen Notgroschen von 3 bis 6 Monatsfixkosten auf einem eigenen Konto auf."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Build a fund of 3 to 6 months of fixed expenses in a separate account."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Arma un fondo de 3 a 6 meses de gastos fijos en una cuenta aparte."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Constituez un fonds de 3 à 6 mois de dépenses fixes sur un compte à part."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अलग खाते में 3 से 6 महीने के तय खर्च का आपात कोष बनाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crea un fondo di 3-6 mesi di spese fisse su un conto separato."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "固定費 3〜6 か月分の緊急資金を別口座に用意しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "별도 계좌에 고정비 3~6개월분 비상금을 마련하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Monte um fundo de 3 a 6 meses de gastos fixos em uma conta separada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Создайте резерв на 3–6 месяцев постоянных расходов на отдельном счёте."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在单独账户中建立 3 到 6 个月固定支出的应急金。"
     }
    }
   }
  },
  "cu_rec_gasto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "المصاريف تستهلك معظم دخلك. أعد التفاوض على الثابت منها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ausgaben fressen fast das ganze Einkommen. Verhandle Fixkosten neu, wo möglich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Expenses take almost all your income. Renegotiate the fixed ones you can (plans, insurance, services)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus gastos se llevan casi todo el ingreso. Renegocia los fijos que se puedan (planes, seguros, servicios)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les dépenses prennent presque tout le revenu. Renégociez les dépenses fixes possibles."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "खर्च लगभग पूरी आय ले लेते हैं। तय खर्चों पर फिर से बातचीत करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le spese si prendono quasi tutto il reddito. Rinegozia le spese fisse possibili."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "支出が収入のほとんどを占めています。固定費を見直しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지출이 수입 대부분을 차지합니다. 가능한 고정비를 재협상하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os gastos levam quase toda a renda. Renegocie os fixos que puder (planos, seguros, serviços)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Расходы съедают почти весь доход. Пересмотрите постоянные расходы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "支出几乎吃掉全部收入。尽量重新谈判固定支出（套餐、保险、服务）。"
     }
    }
   }
  },
  "cu_rec_libertad": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل دخل سلبي جديد يقربك من أن تدفع عوائدك تكاليف حياتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jedes neue passive Einkommen bringt dich dem Ziel näher, dass Erträge dein Leben zahlen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each new passive income brings you closer to your rents paying for your life."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada ingreso pasivo nuevo te acerca a que tus rentas paguen tu vida."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque revenu passif vous rapproche du jour où vos rentes paient votre vie."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर नई निष्क्रिय आय आपको उस दिन के करीब लाती है जब आय आपका जीवन चलाएगी।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni nuova entrata passiva ti avvicina a una vita pagata dalle rendite."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "新しい不労所得が増えるほど、収益で暮らせる日に近づきます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "새 수동 소득은 수익으로 생활하는 날을 앞당깁니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada nova renda passiva aproxima o dia em que suas rendas pagam sua vida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый новый пассивный доход приближает жизнь на доход от капитала."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每一笔新的被动收入，都让你更接近靠收益生活。"
     }
    }
   }
  },
  "cu_rec_liquidez": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يخرج أكثر مما يدخل. خفّض المصاريف المتغيرة قبل زيادة الادخار."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es geht mehr raus als rein. Kürze variable Ausgaben, bevor du mehr sparst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "More goes out than comes in. Before saving more, cut variable expenses until income covers everything."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sale más de lo que entra. Antes de ahorrar más, corta gastos variables hasta que los ingresos cubran todo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il sort plus qu'il n'entre. Avant d'épargner plus, réduisez les dépenses variables."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आमदनी से ज़्यादा खर्च है। पहले परिवर्तनशील खर्च घटाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Esce più di quanto entra. Prima di risparmiare di più, taglia le spese variabili."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "出ていくお金が入るお金より多いです。まず変動費を減らしましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나가는 돈이 들어오는 돈보다 많습니다. 먼저 변동 지출을 줄이세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sai mais do que entra. Antes de poupar mais, corte gastos variáveis até a renda cobrir tudo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Расходы больше доходов. Сначала сократите переменные расходы."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "支出多于收入。先削减可变支出，再考虑多存钱。"
     }
    }
   }
  },
  "cu_rec_netoing": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل مبلغ يذهب للادخار أو الاستثمار أو سداد الدين ينمّي ثروتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Euro für Sparen, Investieren oder Tilgen lässt dein Vermögen wachsen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every peso that goes to savings, investing or paying debt grows your net worth."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada peso que pasa a ahorro, inversión o a bajar deudas hace crecer tu patrimonio."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque euro mis en épargne, en investissement ou en remboursement fait grandir votre patrimoine."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बचत, निवेश या कर्ज़ चुकाने में गया हर रुपया आपकी संपत्ति बढ़ाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni euro destinato a risparmio, investimenti o debiti fa crescere il tuo patrimonio."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "貯蓄・投資・返済に回すお金が純資産を増やします。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "저축·투자·상환으로 가는 돈이 순자산을 키웁니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada real que vai para poupança, investimento ou para pagar dívidas aumenta seu patrimônio."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый рубль на сбережения, инвестиции или погашение долгов увеличивает капитал."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每一笔存款、投资或还债都会让你的净资产增长。"
     }
    }
   }
  },
  "cu_rec_pasivos": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ابدأ ببناء دخل لا يعتمد على وقتك: إيجارات، أرباح أسهم، مشروع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Baue Einkommen auf, das nicht von deiner Zeit abhängt: Mieten, Dividenden, ein Geschäft."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start building income that does not depend on your time: rents, dividends, a business."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza a construir ingresos que no dependan de tu tiempo: rentas, dividendos, un negocio."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Commencez à créer des revenus qui ne dépendent pas de votre temps : loyers, dividendes, une entreprise."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ऐसी आय बनाना शुरू करें जो आपके समय पर निर्भर न हो: किराया, लाभांश, व्यवसाय।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia a costruire entrate che non dipendano dal tuo tempo: affitti, dividendi, un'attività."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "時間に依存しない収入を作り始めましょう：家賃、配当、事業。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "시간에 의존하지 않는 수입을 만들기 시작하세요: 임대료, 배당, 사업."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Comece a construir rendas que não dependam do seu tempo: aluguéis, dividendos, um negócio."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Начните строить доход, не зависящий от вашего времени: аренда, дивиденды, бизнес."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "开始建立不依赖时间的收入：租金、股息、生意。"
     }
    }
   }
  },
