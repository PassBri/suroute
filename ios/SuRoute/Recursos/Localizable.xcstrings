  "vida_fila_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل صف عقد: على اليسار السنة التي يبدأ فيها. النقطة الذهبية هي هذا العام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jede Zeile ist ein Jahrzehnt: links das Jahr, in dem es beginnt. Der goldene Punkt ist dieses Jahr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each row is a decade: on the left, the year it starts. The gold dot is this year."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada fila es una década: a la izquierda, el año en que empieza. El punto dorado es este año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque ligne est une décennie : à gauche, l’année où elle commence. Le point doré est cette année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर पंक्ति एक दशक है: बाईं ओर वह साल जिससे वह शुरू होता है। सुनहरा बिंदु यह साल है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni riga è un decennio: a sinistra, l’anno in cui inizia. Il punto dorato è quest’anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1行が10年。左はその始まりの年。金色の点が今年です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "한 줄은 10년이에요. 왼쪽은 시작하는 해, 금색 점은 올해예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada linha é uma década: à esquerda, o ano em que começa. O ponto dourado é este ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждая строка — десятилетие: слева год его начала. Золотая точка — этот год."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每一行代表十年：左边是开始的年份。金色圆点是今年。"
     }
    }
   }
  },
