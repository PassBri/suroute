  "coach_vida_en_revision": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "طلبك قيد المراجعة. ستظهر في الدليل بعد الموافقة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Bewerbung wird geprüft. Nach der Freigabe erscheinst du im Verzeichnis."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your application is under review. You’ll appear in the directory once approved."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu postulación está en revisión. Te avisaremos cuando aparezcas en el directorio."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta candidature est en cours d’examen. Tu apparaîtras dans l’annuaire une fois approuvée."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका आवेदन समीक्षा में है। स्वीकृत होने पर आप सूची में दिखेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua candidatura è in revisione. Apparirai nell’elenco una volta approvata."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "応募は審査中です。承認されると名簿に表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지원서를 검토 중입니다. 승인되면 목록에 표시됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sua candidatura está em análise. Você aparecerá no diretório quando for aprovada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Заявка на рассмотрении. После одобрения ты появишься в каталоге."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的申请正在审核中，通过后会出现在名录中。"
     }
    }
   }
  },
  "coach_vida_eres_coach": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنت مدرّب موثَّق. يمكن للناس أن يطلبوا مرافقتك من الدليل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du bist verifizierter Coach. Menschen können dich über das Verzeichnis anfragen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You’re a verified coach. People can ask you to coach them from the directory."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Eres coach verificado. Las personas pueden pedirte que las acompañes desde el directorio."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu es coach vérifié. Les personnes peuvent te demander de les accompagner depuis l’annuaire."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप सत्यापित कोच हैं। लोग सूची से आपसे साथ देने का अनुरोध कर सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sei un coach verificato. Le persone possono chiederti di accompagnarle dall’elenco."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたは認証済みコーチです。名簿から伴走を依頼されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "인증된 코치입니다. 사람들이 목록에서 코칭을 요청할 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você é um coach verificado. As pessoas podem pedir seu acompanhamento pelo diretório."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты проверенный коуч. Люди могут обратиться к тебе через каталог."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你是认证教练。其他人可以在名录中请你辅导。"
     }
    }
   }
  },
