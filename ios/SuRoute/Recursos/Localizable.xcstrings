  "bi_guarda_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الأيام الجيدة أيضًا نتعلم منها: ما الذي جعلها كذلك؟ اكتبه في ملاحظتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Auch gute Tage kann man lernen: Was hat sie so gemacht? Schreib es in deine Notiz."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Good days can be learned too: what made it so? Write it in your note."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los días buenos también se aprenden: ¿qué los hizo así? Escríbelo en tu nota."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les bons jours s'apprennent aussi : qu'est-ce qui les a rendus ainsi ? Écris-le dans ta note."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अच्छे दिनों से भी सीखा जाता है: उन्हें ऐसा क्या बनाया? अपने नोट में लिखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Anche i giorni buoni si imparano: cosa li ha resi così? Scrivilo nella nota."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "良い日からも学べます。何がそうさせたのか、メモに書きましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "좋은 날에서도 배울 수 있어요. 무엇이 그렇게 만들었는지 메모에 적어 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os dias bons também se aprendem: o que os fez assim? Escreva na sua nota."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Хорошие дни тоже учат: что сделало их такими? Запиши в заметку."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "好日子也值得学习：是什么让它这样？写进你的笔记。"
     }
    }
   }
  },
