  "ng_empieza": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ابدأ من اليوم: اضغط «بيع» وسجّل ما بعته. كل يوم يُضاف إلى الشهر وكل شهر إلى السنة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Beginne mit heute: tippe auf „Verkauf“ und trage ein, was du verkauft hast. Jeder Tag zählt zum Monat, jeder Monat zum Jahr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with today: tap “Sale” and record what you sold. Each day adds to the month and each month to the year."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza por hoy: toca «Venta» y anota lo que vendiste. Cada día suma al mes y cada mes al año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Commencez par aujourd'hui : touchez « Vente » et notez ce que vous avez vendu. Chaque jour s'ajoute au mois, chaque mois à l'année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज से शुरू करें: “बिक्री” दबाएँ और जो बेचा वह लिखें। हर दिन महीने में और हर महीना साल में जुड़ता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia da oggi: tocca «Vendita» e annota ciò che hai venduto. Ogni giorno si somma al mese e ogni mese all'anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日から始めましょう：「売上」をタップして売ったものを記録。毎日が月に、毎月が年に積み上がります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘부터 시작하세요: 「판매」를 눌러 판 것을 기록하세요. 하루하루가 한 달이 되고, 달이 모여 한 해가 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Comece por hoje: toque em “Venda” e anote o que vendeu. Cada dia soma ao mês e cada mês ao ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Начните с сегодняшнего дня: нажмите «Продажа» и запишите, что продали. Каждый день складывается в месяц, месяц — в год."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "从今天开始：点「销售」，记下卖了什么。每天累计到月，每月累计到年。"
     }
    }
   }
  },
