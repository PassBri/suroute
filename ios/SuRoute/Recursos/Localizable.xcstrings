  "demo_post_1": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنهيت دورتي الأولى في التصميم! 30 يومًا متتاليًا من التدرّب ساعة يوميًا."
