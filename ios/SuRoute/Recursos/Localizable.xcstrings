  "resultado_atencion": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يحتاج إلى انتباه. هنا أكبر فرصة لك للنمو."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Braucht Aufmerksamkeit. Hier liegt deine größte Wachstumschance."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Needs attention. This is your biggest chance to grow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Necesita atención. Aquí está tu mayor oportunidad de crecer."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Demande de l'attention. C'est ici que tu as le plus de marge de progression."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ध्यान चाहिए। यहीं आपके बढ़ने का सबसे बड़ा मौक़ा है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Richiede attenzione. Qui c'è la tua più grande occasione di crescita."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "注意が必要です。ここが、いちばん成長できるチャンスです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "관심이 필요해요. 여기가 가장 크게 성장할 기회예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Precisa de atenção. Aqui está sua maior oportunidade de crescer."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нужно внимание. Здесь твоя самая большая возможность для роста."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "需要关注。这里是你成长空间最大的地方。"
     }
    }
   }
  },
  "resultado_desarrollo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "قيد التطوير. أنت تسير جيدًا: اختر نقطة لتعزيزها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
