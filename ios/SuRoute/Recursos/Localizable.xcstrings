      "value": "सोने से पहले स्क्रीन नहीं"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Niente schermi prima di dormire"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "寝る前の画面オフ"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "잠들기 전 화면 끄기"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sem telas ao dormir"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Без экранов перед сном"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "睡前不看屏幕"
     }
    }
   }
  },
