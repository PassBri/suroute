  "cv_g4_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شارك ما شعرت به: شمس، عاصفة، ضباب، وادٍ أو قمة. تُظهر الحلقة الملونة الطقس الذي تركه المجتمع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zeig, wie es sich angefühlt hat: Sonne, Sturm, Nebel, Tal oder Gipfel. Der Farbring zeigt das Wetter, das die Community hinterlassen hat."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Share how it made you feel: sun, storm, fog, valley or summit. The colored ring shows the weather the community left."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja cómo te hizo sentir: sol, tormenta, niebla, valle o cumbre. El anillo de colores muestra el clima que dejó la comunidad."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Partage ce que tu as ressenti : soleil, orage, brouillard, vallée ou sommet. L'anneau de couleurs montre la météo laissée par la communauté."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बताएँ कि आपको कैसा लगा: धूप, तूफ़ान, कोहरा, घाटी या शिखर। रंगीन घेरा दिखाता है कि समुदाय ने कैसा मौसम छोड़ा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia come ti ha fatto sentire: sole, tempesta, nebbia, valle o vetta. L'anello colorato mostra il tempo lasciato dalla community."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "どう感じたかを残しましょう：晴れ、嵐、霧、谷、山頂。カラーリングには、コミュニティが残した天気が表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "어떤 기분이 들었는지 남겨 주세요: 맑음, 폭풍, 안개, 계곡, 정상. 색깔 링은 커뮤니티가 남긴 날씨를 보여 줘요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Diga como isso te fez sentir: sol, tempestade, neblina, vale ou cume. O anel colorido mostra o clima que a comunidade deixou."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Поделись своим ощущением: солнце, гроза, туман, долина или вершина. Цветное кольцо показывает погоду, которую оставило сообщество."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "留下你的感受：晴天、风暴、迷雾、山谷或山顶。彩色圆环显示社区留下的天气。"
     }
    }
   }
  },
  "cv_g4_t": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أي طقس تركه فيك؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Welches Wetter hinterlässt es bei dir?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What weather does it leave you?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Qué clima te deja?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quelle météo te laisse-t-elle ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह आपके लिए कैसा मौसम छोड़ गई?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Che tempo ti lascia?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "どんな天気が残りましたか？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "어떤 날씨를 남겼나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Que clima isso te deixa?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Какую погоду она тебе оставила?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
