      "state": "translated",
      "value": "Hasta 10 fotos, o un video de hasta 60 segundos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Jusqu’à 10 photos, ou une vidéo de 60 secondes maximum."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "10 फ़ोटो तक, या 60 सेकंड तक का एक वीडियो।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fino a 10 foto, o un video fino a 60 secondi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "写真は最大10枚、動画は60秒まで。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "사진은 최대 10장, 동영상은 60초까지."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Até 10 fotos, ou um vídeo de até 60 segundos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "До 10 фото или видео до 60 секунд."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "最多 10 张照片，或一段不超过 60 秒的视频。"
     }
    }
   }
  },
  "pub_video_largo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
