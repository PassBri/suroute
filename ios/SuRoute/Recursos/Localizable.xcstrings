  "paso_ejes_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "دقيقتان لتعرف أين أنت قوي وأي محور يحتاج إلى اهتمام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zwei Minuten, um zu sehen, wo du stark bist und welche Achse Aufmerksamkeit braucht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Two minutes to see where you’re strong and which axis needs attention."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dos minutos para saber dónde estás fuerte y qué eje necesita atención."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Deux minutes pour savoir où tu es fort et quel axe demande de l’attention."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दो मिनट में जानें आप कहाँ मज़बूत हैं और किस आयाम पर ध्यान चाहिए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Due minuti per capire dove sei forte e quale asse ha bisogno di attenzione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "2分間で強みと、手を入れるべき軸がわかります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "2분이면 강점과 신경 써야 할 축을 알 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Dois minutos para saber onde você está forte e qual eixo precisa de atenção."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Две минуты, чтобы понять, где ты силён и какой оси нужно внимание."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "两分钟了解你的优势，以及哪个维度需要关注。"
     }
    }
   }
  },
