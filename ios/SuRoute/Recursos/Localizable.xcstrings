  "fase_6_diag": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أستوعب ما أنجزته وأدمجه وأقدّره."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich verarbeite, integriere und würdige das Erreichte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I'm absorbing, integrating and appreciating what I've achieved."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estoy asimilando, integrando y valorando lo logrado."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "J'assimile, j'intègre et je mesure ce que j'ai accompli."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं जो हासिल हुआ उसे समझ रहा हूँ, अपना रहा हूँ और उसकी क़द्र कर रहा हूँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sto assimilando, integrando e dando valore a ciò che ho ottenuto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "達成したことを味わい、取り入れ、見つめ直している。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이룬 것을 받아들이고, 통합하고, 음미하는 중이에요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Estou assimilando, integrando e valorizando o que conquistei."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я осмысляю, усваиваю и ценю достигнутое."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我正在消化、整合并珍视所取得的成就。"
     }
    }
   }
  },
