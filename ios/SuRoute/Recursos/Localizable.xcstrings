  "cu_cif_quitar_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ستُحفظ أموالك مجددًا بدون تشفير (وتبقى خاصة بحسابك). ولن يعود رمز الاسترداد صالحًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Finanzen werden wieder unverschlüsselt gespeichert (sie bleiben privat in deinem Konto). Dein Wiederherstellungscode funktioniert dann nicht mehr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your finances will be saved unencrypted again (they stay private to your account). Your recovery code will stop working."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus finanzas se guardarán otra vez sin cifrar (siguen siendo privadas de tu cuenta). Tu código de recuperación dejará de servir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tes finances seront de nouveau enregistrées sans chiffrement (elles restent privées dans ton compte). Ton code de récupération ne servira plus."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका वित्त फिर से बिना एन्क्रिप्शन के सहेजा जाएगा (यह आपके खाते में निजी रहेगा)। आपका रिकवरी कोड काम करना बंद कर देगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le tue finanze verranno di nuovo salvate senza cifratura (restano private nel tuo account). Il tuo codice di recupero non funzionerà più."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "お金は再び暗号化なしで保存されます（アカウント内では引き続き非公開です）。リカバリーフレーズは使えなくなります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "재정이 다시 암호화 없이 저장돼요(계정 안에서는 계속 비공개예요). 복구 코드는 더 이상 쓸 수 없어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suas finanças voltarão a ser salvas sem criptografia (continuam privadas na sua conta). Seu código de recuperação deixará de funcionar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твои финансы снова будут сохраняться без шифрования (они по-прежнему приватны в твоём аккаунте). Код восстановления перестанет работать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的财务将重新以未加密方式保存（仍仅限你的账户私有）。你的恢复码将失效。"
     }
    }
   }
  },
