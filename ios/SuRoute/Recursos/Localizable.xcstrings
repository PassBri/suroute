  "modelo_e1_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "غايتك في جملة وصورة. هي الشمال لكل ما عداها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Ziel in einem Satz und einem Foto. Es ist der Norden für alles andere."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your purpose in one sentence and one photo. It is the north of everything else."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu propósito en una frase y una foto. Es el norte de todo lo demás."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton but en une phrase et une photo. C'est le nord de tout le reste."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "एक वाक्य और एक फ़ोटो में आपका उद्देश्य। यह बाकी सब का उत्तर है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il tuo scopo in una frase e una foto. È il nord di tutto il resto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目的を一文と一枚の写真で。ほかのすべての北になります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "한 문장과 한 장의 사진으로 담은 당신의 목적. 다른 모든 것의 북쪽입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu propósito em uma frase e uma foto. É o norte de todo o resto."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твоя цель в одной фразе и одном фото. Это север для всего остального."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用一句话和一张照片写下你的目标。它是其他一切的北方。"
     }
    }
   }
  },
