    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ में कुछ दर्ज नहीं। अपनी बिक्री से शुरू करें: “बिक्री” दबाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Niente annotato a %1$@. Inizia dalle vendite: tocca «Vendita»."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ の記録はありません。まず売上から：「売上」をタップ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@에 기록이 없어요. 판매부터 시작하세요: 「판매」를 누르세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nada anotado em %1$@. Comece pelas vendas: toque em “Venda”."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
