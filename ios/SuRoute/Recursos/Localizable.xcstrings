     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "观察"
     }
    }
   }
  },
  "prioridad_d_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا عاجل ولا مهم. قيّم هل يستحق الاستمرار فعلًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Weder dringend noch wichtig. Prüfe, ob es sich wirklich lohnt weiterzumachen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Neither urgent nor important. Consider whether it's really worth continuing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ni urgente ni importante. Evalúa si realmente vale la pena continuar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ni urgent ni important. Demande-toi s'il vaut vraiment la peine de continuer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "न तुरंत, न ज़रूरी। परखें कि इसे जारी रखना सच में सही है या नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Né urgente né importante. Valuta se vale davvero la pena continuare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "緊急でも重要でもない。本当に続ける価値があるか見直しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "급하지도 중요하지도 않아요. 계속할 가치가 있는지 따져 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nem urgente nem importante. Avalie se realmente vale a pena continuar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ни срочно, ни важно. Оцени, стоит ли вообще продолжать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "既不紧急也不重要。评估是否真的值得继续。"
     }
    }
   }
  },
