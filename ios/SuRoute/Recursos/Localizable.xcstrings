  "suspension_hasta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حتى %1$@. يمكنك في الأثناء مواصلة استخدام مسارك، لكن لا يمكنك النشر أو التعليق أو إرسال الرسائل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bis %1$@. Bis dahin kannst du deine Route weiter nutzen, aber nicht posten, kommentieren oder Nachrichten schreiben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Until %1$@. Meanwhile you can keep using your path, but you can't post, comment or send messages."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hasta el %1$@. Mientras tanto puedes seguir usando tu ruta, pero no publicar, comentar ni escribir mensajes."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Jusqu'au %1$@. En attendant, tu peux continuer à utiliser ta route, mais pas publier, commenter ni écrire de messages."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ तक। तब तक तुम अपना रास्ता इस्तेमाल कर सकते हो, पर पोस्ट, टिप्पणी या संदेश नहीं भेज सकते।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fino al %1$@. Nel frattempo puoi continuare a usare il tuo percorso, ma non pubblicare, commentare né scrivere messaggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ まで。その間も自分のルートは使えますが、投稿・コメント・メッセージはできません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@까지. 그동안 루트는 계속 쓸 수 있지만 게시, 댓글, 메시지는 할 수 없어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Até %1$@. Enquanto isso, você pode continuar usando sua rota, mas não pode publicar, comentar nem enviar mensagens."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "До %1$@. Пока можно пользоваться своим маршрутом, но нельзя публиковать, комментировать и писать сообщения."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "至 %1$@。在此期间你仍可使用自己的路线，但不能发帖、评论或发送消息。"
     }
    }
   }
  },
