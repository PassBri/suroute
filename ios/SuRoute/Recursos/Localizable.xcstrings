  "decision_continuar_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الهدف يتقدّم بوتيرة جيدة. حافظ على الخطة الحالية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Ziel kommt gut voran. Behalte den aktuellen Plan bei."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The goal is moving at a good pace. Keep the current plan."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La meta avanza a buen ritmo. Mantén el plan actual."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'objectif avance à bon rythme. Garde le plan actuel."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य अच्छी रफ़्तार से बढ़ रहा है। मौजूदा योजना बनाए रखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'obiettivo procede a buon ritmo. Mantieni il piano attuale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標は順調に進んでいます。今のプランを続けましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표가 좋은 속도로 나아가고 있어요. 현재 계획을 유지하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A meta avança em bom ritmo. Mantenha o plano atual."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цель движется в хорошем темпе. Придерживайся текущего плана."
     }
    },
    "zh-Hans": {
     "stringUnit": {
