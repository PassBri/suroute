  "mirar_ayuda_ajustar": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اسحب الرسم حتى يطابق القمر أو نجم ساطع موضعه الحقيقي. نقرتان: إعادة الضبط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ziehe die Zeichnung, bis der Mond oder ein heller Stern auf dem echten liegt. Doppeltippen: zurücksetzen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drag the drawing until the Moon or a bright star sits on the real one. Double tap: reset."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Arrastra el dibujo hasta que la Luna o una estrella brillante caiga sobre la real. Doble toque: volver a cero."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Faites glisser le dessin jusqu'à ce que la Lune ou une étoile brillante coïncide avec la vraie. Double appui : réinitialiser."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चित्र को तब तक खींचें जब तक चाँद या कोई चमकीला तारा असली पर न आ जाए। दो बार टैप: रीसेट।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trascina il disegno finché la Luna o una stella luminosa coincide con quella vera. Doppio tocco: azzera."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "月や明るい星が本物と重なるまで図をドラッグします。ダブルタップでリセット。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "달이나 밝은 별이 실제와 겹칠 때까지 그림을 끄세요. 두 번 탭: 초기화."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Arraste o desenho até a Lua ou uma estrela brilhante coincidir com a real. Toque duplo: zerar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Перетащите рисунок, пока Луна или яркая звезда не совпадёт с настоящей. Двойное касание: сброс."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "拖动星图，直到月亮或一颗亮星与真实的重合。双击：重置。"
     }
    }
   }
  },
  "mirar_ayuda_arrastre": {
   "extractionState": "manual",
   "localizations": {
