  "cordadas_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لست في أي فريق بعد. أنشئ فريقًا وادعُ 2 إلى 5 أشخاص، أو انضم برمز شاركوه معك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du bist noch in keiner Seilschaft. Gründe eine und lade 2 bis 5 Menschen ein, oder tritt mit einem Code bei."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You’re not in a rope team yet. Create one and invite 2 to 5 people, or join with a code someone shared."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no estás en ninguna cordada. Crea una e invita a 2 a 5 personas, o únete con el código que te compartieron."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu n’es dans aucune cordée. Crées-en une et invite 2 à 5 personnes, ou rejoins-en une avec un code."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप अभी किसी रोप टीम में नहीं हैं। एक बनाएँ और 2 से 5 लोगों को बुलाएँ, या साझा कोड से जुड़ें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non sei ancora in una cordata. Creane una e invita da 2 a 5 persone, oppure unisciti con un codice."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだどのパーティにも入っていません。作って2〜5人を招待するか、共有されたコードで参加しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 로프 팀이 없어요. 만들어서 2~5명을 초대하거나 공유받은 코드로 참여하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ainda não está em nenhuma cordada. Crie uma e convide de 2 a 5 pessoas, ou entre com o código que compartilharam."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты пока не в связке. Создай её и пригласи 2–5 человек или вступи по коду."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你还没有加入结组。创建一个并邀请 2 到 5 人，或用别人分享的代码加入。"
     }
    }
   }
  },
