  "cu_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ابدأ باليوم: سجّل ما دخل وما خرج. كل يوم يُضاف إلى الشهر، وكل شهر إلى السنة، وكل سنة إلى هذا الميزان."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Fang mit heute an: Notiere, was rein- und rausging. Jeder Tag zählt zum Monat, jeder Monat zum Jahr und jedes Jahr zu dieser Bilanz."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with today: write down what came in and went out. Each day adds to the month, each month to the year, and each year to this balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza por hoy: anota lo que entró y salió. Cada día suma al mes, cada mes al año y cada año a este balance."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Commence par aujourd’hui : note ce qui est entré et sorti. Chaque jour s’ajoute au mois, chaque mois à l’année et chaque année à ce bilan."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आज से शुरू करें: जो आया और गया, लिखें। हर दिन महीने में, हर महीना साल में और हर साल इस हिसाब में जुड़ता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia da oggi: annota cosa è entrato e uscito. Ogni giorno si somma al mese, ogni mese all’anno e ogni anno a questo bilancio."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日から始めましょう。入った額と出た額を記録すると、日が月に、月が年に、年がこの収支に積み上がります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘부터 시작하세요: 들어오고 나간 돈을 적으면 하루는 한 달로, 한 달은 한 해로, 한 해는 이 결산으로 쌓여요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Comece por hoje: anote o que entrou e saiu. Cada dia soma ao mês, cada mês ao ano e cada ano a este balanço."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Начни с сегодняшнего дня: запиши, что пришло и ушло. День складывается в месяц, месяц в год, год в этот баланс."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "从今天开始：记下进出的钱。每天汇入月，每月汇入年，每年汇入这份总余额。"
     }
    }
   }
  },
