  "brujula_compartir_ayuda2": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُنشر بوصلتك ليستكشفها المجتمع (1 · 9 · 81) مع صورة للتنزيل. اختر ما يظهر:"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dein Kompass wird veröffentlicht, damit die Community ihn erkunden kann (1 · 9 · 81), mit einem Bild zum Herunterladen. Wähle, was dabei ist:"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your Compass is posted so the community can explore it (1 · 9 · 81), with an image to download. Choose what's included:"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se publica tu Brújula para que la comunidad la explore (1 · 9 · 81), con una imagen para descargar. Elige qué sale:"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta Boussole est publiée pour que la communauté l'explore (1 · 9 · 81), avec une image à télécharger. Choisis ce qui apparaît :"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "तुम्हारा कम्पास पोस्ट होगा ताकि समुदाय उसे देख सके (1 · 9 · 81), साथ में डाउनलोड के लिए छवि। चुनो क्या दिखेगा:"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La tua Bussola viene pubblicata perché la comunità la esplori (1 · 9 · 81), con un'immagine da scaricare. Scegli cosa mostrare:"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コンパスを公開し、コミュニティが探索できるようにします（1 · 9 · 81）。ダウンロード用の画像付き。含める内容を選んでください："
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나침반이 게시되어 커뮤니티가 탐색할 수 있어요(1 · 9 · 81). 내려받을 이미지도 함께요. 보여 줄 내용을 고르세요:"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sua Bússola é publicada para que a comunidade a explore (1 · 9 · 81), com uma imagem para baixar. Escolha o que sai:"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Компас публикуется, чтобы сообщество могло его изучить (1 · 9 · 81), с картинкой для скачивания. Выбери, что показать:"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的罗盘会被发布，让社区可以探索（1 · 9 · 81），并附一张可下载的图片。选择要显示的内容："
     }
    }
   }
  },
