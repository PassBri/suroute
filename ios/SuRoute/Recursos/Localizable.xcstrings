  "cu_cif_nuevo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أموالك مشفّرة. اكتب رمز الاسترداد المكوّن من 12 كلمة مرة واحدة فقط؛ بعدها تكفي بصمتك أو وجهك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Finanzen sind verschlüsselt. Gib einmalig deinen Wiederherstellungscode aus 12 Wörtern ein; danach genügt dein Fingerabdruck oder dein Gesicht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your finances are encrypted. Enter your 12-word recovery code just once; after that, your fingerprint or face is enough."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus finanzas están cifradas. Escribe una sola vez tu código de recuperación de 12 palabras; después bastará tu huella o tu rostro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tes finances sont chiffrées. Écris une seule fois ton code de récupération de 12 mots ; ensuite, ton empreinte ou ton visage suffira."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका वित्त एन्क्रिप्टेड है। अपना 12 शब्दों का रिकवरी कोड सिर्फ़ एक बार लिखें; उसके बाद आपका फ़िंगरप्रिंट या चेहरा काफ़ी होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le tue finanze sono cifrate. Scrivi una sola volta il tuo codice di recupero di 12 parole; poi basteranno la tua impronta o il tuo volto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "お金は暗号化されています。12 単語のリカバリーフレーズを一度だけ入力してください。以後は指紋か顔で開けます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "재정이 암호화되어 있어요. 12단어 복구 코드를 한 번만 입력하세요. 그다음부터는 지문이나 얼굴이면 충분해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suas finanças estão criptografadas. Digite uma única vez seu código de recuperação de 12 palavras; depois bastará sua digital ou seu rosto."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твои финансы зашифрованы. Введи код восстановления из 12 слов всего один раз; дальше хватит отпечатка или лица."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的财务已加密。只需输入一次 12 个单词的恢复码，之后用指纹或面部即可。"
     }
    }
   }
  },
  "cu_cif_nuevo_t": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هذا الهاتف لا يملك مفتاحك بعد"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieses Handy hat deinen Schlüssel noch nicht"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This phone doesn't have your key yet"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Este teléfono aún no tiene tu llave"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce téléphone n'a pas encore ta clé"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस फ़ोन में अभी आपकी कुंजी नहीं है"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo telefono non ha ancora la tua chiave"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "このスマホにはまだ鍵がありません"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 휴대폰에는 아직 키가 없어요"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Este telefone ainda não tem sua chave"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "На этом телефоне ещё нет твоего ключа"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这部手机还没有你的密钥"
     }
    }
   }
  },
  "cu_cif_off_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شفّر مبالغك على هاتفك بمفتاح لا يملكه سواك، مع رمز استرداد من 12 كلمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Verschlüssle deine Beträge auf deinem Handy mit einem Schlüssel, den nur du hast, und einem Wiederherstellungscode aus 12 Wörtern."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Encrypt your amounts on your phone with a key only you have, plus a 12-word recovery code."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cifra tus montos en tu teléfono con una llave que solo tú tienes, con un código de recuperación de 12 palabras."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chiffre tes montants sur ton téléphone avec une clé que toi seul possèdes, avec un code de récupération de 12 mots."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी राशियों को अपने फ़ोन पर ऐसी कुंजी से एन्क्रिप्ट करें जो सिर्फ़ आपके पास है, साथ में 12 शब्दों का रिकवरी कोड।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cifra i tuoi importi sul telefono con una chiave che hai solo tu, con un codice di recupero di 12 parole."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなただけが持つ鍵で、スマホ上で金額を暗号化します。12 単語のリカバリーフレーズ付きです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나만 가진 키로 휴대폰에서 금액을 암호화해요. 12단어 복구 코드가 함께 제공돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Criptografe seus valores no seu telefone com uma chave que só você tem, com um código de recuperação de 12 palavras."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Шифруй свои суммы на телефоне ключом, который есть только у тебя, с кодом восстановления из 12 слов."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用只有你拥有的密钥在手机上加密你的金额，并配有 12 个单词的恢复码。"
     }
    }
   }
  },
  "cu_cif_on_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مفعّل: تُشفَّر مبالغك على هاتفك قبل حفظها. لا يمكن لأحد غيرك قراءتها، ولا حتى SuRoute."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aktiv: Deine Beträge werden auf deinem Handy verschlüsselt, bevor sie gespeichert werden. Niemand sonst kann sie lesen, nicht einmal SuRoute."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "On: your amounts are encrypted on your phone before they're saved. No one else can read them, not even SuRoute."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Activo: tus montos se cifran en tu teléfono antes de guardarse. Nadie más puede leerlos, ni siquiera SuRoute."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Activé : tes montants sont chiffrés sur ton téléphone avant d'être enregistrés. Personne d'autre ne peut les lire, pas même SuRoute."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "चालू: आपकी राशियाँ सहेजे जाने से पहले आपके फ़ोन पर एन्क्रिप्ट होती हैं। कोई और उन्हें नहीं पढ़ सकता, SuRoute भी नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva: i tuoi importi vengono cifrati sul telefono prima di essere salvati. Nessun altro può leggerli, nemmeno SuRoute."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "オン：金額は保存前にスマホ上で暗号化されます。SuRoute を含め、ほかの誰も読めません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "켜짐: 금액이 저장되기 전에 휴대폰에서 암호화돼요. SuRoute를 포함해 누구도 읽을 수 없어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ativa: seus valores são criptografados no seu telefone antes de serem salvos. Ninguém mais pode lê-los, nem mesmo o SuRoute."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Включено: твои суммы шифруются на телефоне перед сохранением. Никто другой не может их прочитать, даже SuRoute."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
