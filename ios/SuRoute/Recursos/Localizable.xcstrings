  "mandala_3d_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اسحب لتدوير الجبل. كل خطوة تكتبها وتنجزها تجعله ينمو."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ziehen, um den Berg zu drehen. Jeder notierte und erledigte Schritt lässt ihn wachsen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drag to turn the mountain. Every step you write and complete makes it grow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Arrastra para girar la montaña. Cada paso que escribes y cumples la hace crecer."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Fais glisser pour tourner la montagne. Chaque pas écrit et accompli la fait grandir."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पहाड़ घुमाने के लिए खींचें। हर लिखा और पूरा किया कदम उसे बड़ा करता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trascina per ruotare la montagna. Ogni passo che scrivi e compi la fa crescere."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ドラッグで山を回せます。書いて達成したステップごとに山が育ちます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "드래그해서 산을 돌려 보세요. 단계를 쓰고 완료할 때마다 산이 자라요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Arraste para girar a montanha. Cada passo que você escreve e cumpre a faz crescer."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Потяни, чтобы повернуть гору. Каждый записанный и выполненный шаг делает её выше."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "拖动可旋转山峰。你写下并完成的每一步都会让它长高。"
     }
    }
   }
  },
