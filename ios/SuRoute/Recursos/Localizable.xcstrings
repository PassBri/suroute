  "mf_nota": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل إيداع يُسجَّل اليوم في دفترك كادخار لهذا الهدف؛ والسحب يعود إلى رصيدك المتاح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jede Einzahlung wird heute als Ersparnis für dieses Ziel notiert; eine Entnahme geht zurück in dein Verfügbares."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each contribution is recorded today in your book as savings for that goal; a withdrawal returns it to your available money."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada aporte se anota hoy en tu libro como ahorro de esa meta; un retiro lo devuelve a tu disponible."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque versement est noté aujourd'hui comme épargne pour cet objectif ; un retrait revient à votre disponible."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर जमा आज बही में उस लक्ष्य की बचत के रूप में दर्ज होती है; निकासी उपलब्ध राशि में लौटती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni versamento si annota oggi come risparmio per quell'obiettivo; un prelievo torna al tuo disponibile."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "積立は今日の帳簿にその目標の貯金として記録され、引き出しは使えるお金に戻ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "적립은 오늘 장부에 그 목표의 저축으로 기록되고, 인출은 사용 가능 금액으로 돌아갑니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada aporte é anotado hoje no seu livro como poupança dessa meta; um resgate volta ao seu disponível."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый взнос сегодня записывается в книгу как накопление на эту цель; снятие возвращается в доступные деньги."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每笔存入今天记入账本，作为该目标的储蓄；取出则回到可用余额。"
     }
    }
   }
  },
