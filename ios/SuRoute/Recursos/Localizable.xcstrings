  "tarjeta_mae": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الأمر ليس موهبة، بل ممارسة منتظمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es geht nicht um Talent. Es geht um beständiges Üben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It's not about talent. It's about consistent practice."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se trata de talento. Se trata de práctica consistente."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce n'est pas une question de talent. C'est une question de pratique régulière."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "बात प्रतिभा की नहीं है। बात नियमित अभ्यास की है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non è questione di talento. È questione di pratica costante."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "大切なのは才能ではなく、続ける練習です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "재능의 문제가 아니에요. 꾸준한 연습의 문제예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não é questão de talento. É questão de prática consistente."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Дело не в таланте. Дело в постоянной практике."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这无关天赋，而在于持续的练习。"
     }
    }
   }
  },
