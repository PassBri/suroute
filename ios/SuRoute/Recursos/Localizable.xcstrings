     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके दीर्घकालिक उद्देश्य जो इस साल से गुज़रते हैं, और %1$ld में आप उनमें क्या जोड़ते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "I tuoi propositi a lungo termine che attraversano quest’anno e ciò che dai loro nel %1$ld."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今年を通る長期の目的と、%1$ld 年にそれへ注ぐこと。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "올해를 지나는 장기 목적과 %1$ld년에 그것에 보태는 것."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seus propósitos de longo prazo que passam por este ano e o que você contribui em %1$ld."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твои долгосрочные цели, проходящие через этот год, и твой вклад в них в %1$ld."
     }
    },
