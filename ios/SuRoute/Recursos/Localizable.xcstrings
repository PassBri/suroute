  "eje_val_pregunta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هل حوّلت موهبتي إلى قيمة مادية مستدامة؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Habe ich mein Talent in nachhaltigen wirtschaftlichen Wert verwandelt?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Have I turned my talent into sustainable economic value?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿He transformado mi talento en valor económico sostenible?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ai-je transformé mon talent en valeur économique durable ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "क्या मैंने अपनी प्रतिभा को टिकाऊ आर्थिक मूल्य में बदला है?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ho trasformato il mio talento in valore economico sostenibile?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自分の才能を、持続可能な経済的価値に変えられていますか?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 재능을 지속 가능한 경제적 가치로 바꿔 왔나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Transformei meu talento em valor econômico sustentável?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Превратил(а) ли я свой талант в устойчивую экономическую ценность?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我是否把自己的才华转化成了可持续的经济价值？"
