     "stringUnit": {
      "state": "translated",
      "value": "لم يشارك %1$@ أي سنة من يومياته بعد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ teilt noch keine Jahre des Tagebuchs."
