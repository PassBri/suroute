  "cu_privacidad_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حساباتك لك. اختر أن تبقى لك وحدك أو أن تشارك تقدمك (نسب فقط، لا مبالغ أبدًا)."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Finanzen gehören dir. Wähle, ob sie privat bleiben oder du deinen Fortschritt teilst (nur Prozente, nie Beträge)."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your accounts are yours. Choose whether they’re only for you or you want to share your progress (percentages only, never amounts)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus cuentas son tuyas. Elige si son solo para ti o si quieres compartir tu avance (solo porcentajes, nunca montos)."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tes comptes t’appartiennent. Choisis s’ils restent pour toi ou si tu partages ton avancée (pourcentages seulement, jamais de montants)."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपका हिसाब आपका है। चुनें कि यह सिर्फ़ आपके लिए हो या प्रगति साझा करें (सिर्फ़ प्रतिशत, राशि कभी नहीं)।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "I tuoi conti sono tuoi. Scegli se restano solo per te o se condividi i progressi (solo percentuali, mai importi)."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "お金の記録はあなたのもの。自分だけにするか、進捗を共有するか選べます（割合のみ、金額は出ません）。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 장부는 나의 것. 나만 볼지, 진행을 공유할지 고르세요(비율만, 금액은 절대 아님)."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Suas contas são suas. Escolha se são só para você ou se quer compartilhar seu avanço (só porcentagens, nunca valores)."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Твои финансы — твои. Выбери: только для тебя или делиться прогрессом (только проценты, никаких сумм)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的账目属于你。选择仅自己可见，或分享进展（只显示百分比，从不显示金额）。"
     }
    }
   }
  },
