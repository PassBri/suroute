      "value": "Выполнено привычек на этой неделе: %1$ld из %2$ld"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "本周已完成 %1$ld/%2$ld 个习惯"
     }
    }
