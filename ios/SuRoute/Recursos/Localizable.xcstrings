  "mensajes_solicitud_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يريد %1$@ مراسلتك. إن قبلت يمكنكما التحدث، وإن رفضت فلن يعرف عنك شيئًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ möchte dir schreiben. Wenn du annimmst, könnt ihr chatten; lehnst du ab, hört die Person nichts mehr von dir."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ wants to message you. If you accept, you can talk; if you decline, they won’t hear from you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ quiere escribirte. Si aceptas, podrán conversar; si rechazas, no sabrá nada más de ti."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ souhaite t’écrire. Si tu acceptes, vous pourrez discuter ; si tu refuses, cette personne n’aura plus de nouvelles."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ आपको संदेश भेजना चाहते हैं। स्वीकार करने पर आप बात कर सकेंगे; अस्वीकार करने पर उन्हें आपसे कुछ नहीं मिलेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ vuole scriverti. Se accetti potrete parlare; se rifiuti non saprà più nulla di te."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ さんがメッセージを送りたいそうです。承認すると会話でき、拒否すると相手には何も届きません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 님이 메시지를 보내고 싶어 해요. 수락하면 대화할 수 있고, 거절하면 더 이상 연락이 닿지 않아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ quer falar com você. Se aceitar, poderão conversar; se recusar, não saberá mais de você."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ хочет тебе написать. Если примешь — сможете общаться; если отклонишь — больше ничего не узнает."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 想给你发消息。接受后你们可以聊天；拒绝后对方不会再收到你的消息。"
     }
    }
   }
  },
