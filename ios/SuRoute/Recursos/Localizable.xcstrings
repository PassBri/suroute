  "fb_res_ritmo_cerrado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أنفقت %1$@ يوميًا في المتوسط وأنهيت %2$@ بنفقات قدرها %3$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sie haben im Schnitt %1$@ pro Tag ausgegeben und %2$@ mit %3$@ Ausgaben abgeschlossen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You spent %1$@ a day on average and closed %2$@ with %3$@ in expenses."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gastaste %1$@ al día en promedio y cerraste %2$@ con %3$@ en gastos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous avez dépensé %1$@ par jour en moyenne et clôturé %2$@ avec %3$@ de dépenses."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने औसतन रोज़ %1$@ खर्च किए और %2$@ का खर्च %3$@ रहा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai speso in media %1$@ al giorno e chiuso %2$@ con %3$@ di spese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1日平均 %1$@ 使い、%2$@ は支出 %3$@ で締めくくりました。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루 평균 %1$@를 썼고 %2$@ 지출은 %3$@였어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você gastou %1$@ por dia em média e fechou %2$@ com %3$@ em gastos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В среднем вы тратили %1$@ в день и закрыли %2$@ с расходами %3$@."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你平均每天花 %1$@，%2$@ 共支出 %3$@。"
     }
    }
   }
  },
  "fb_res_ritmo_txt": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تنفق %1$@ يوميًا في المتوسط. بهذه الوتيرة ستُنهي %2$@ بنفقات قدرها %3$@."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sie geben im Schnitt %1$@ pro Tag aus. In diesem Tempo schließen Sie %2$@ mit %3$@ Ausgaben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You spend %1$@ a day on average. At this pace you’d close %2$@ with %3$@ in expenses."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gastas %1$@ al día en promedio. A este paso cerrarías %2$@ con %3$@ en gastos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous dépensez %1$@ par jour en moyenne. À ce rythme, vous finiriez %2$@ avec %3$@ de dépenses."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप औसतन रोज़ %1$@ खर्च करते हैं। इसी रफ़्तार से %2$@ का खर्च %3$@ होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spendi in media %1$@ al giorno. A questo ritmo chiuderesti %2$@ con %3$@ di spese."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1日平均 %1$@ 使っています。このペースだと %2$@ は支出 %3$@ で締めくくります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루 평균 %1$@를 써요. 이 속도라면 %2$@ 지출은 %3$@가 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você gasta %1$@ por dia em média. Nesse ritmo fecharia %2$@ com %3$@ em gastos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В среднем вы тратите %1$@ в день. В таком темпе %2$@ закроется с расходами %3$@."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你平均每天花 %1$@。按这个速度，%2$@ 结束时支出将达 %3$@。"
     }
    }
   }
  },
  "fb_res_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عندما تسجّل حركات %1$@ سترى هنا أرقامك ووتيرة إنفاقك وأين تذهب أموالك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sobald Sie Bewegungen für %1$@ eintragen, sehen Sie hier Ihre Zahlen, Ihr Ausgabentempo und wohin Ihr Geld geht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Once you log movements for %1$@ you’ll see your figures, spending pace and where your money goes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando anotes movimientos de %1$@ verás aquí tus cifras, tu ritmo de gasto y a dónde se va tu dinero."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quand vous noterez des mouvements de %1$@, vous verrez ici vos chiffres, votre rythme de dépense et où va votre argent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ के लेन-देन दर्ज करने पर यहाँ आपके आँकड़े, खर्च की रफ़्तार और पैसा कहाँ गया, दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando annoterai movimenti di %1$@ vedrai qui le tue cifre, il ritmo di spesa e dove vanno i tuoi soldi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ の記録をつけると、数字・支出ペース・お金の行き先がここに表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 내역을 기록하면 여기에서 수치, 지출 속도, 돈의 행방을 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando anotar movimentos de %1$@, verá aqui seus números, seu ritmo de gasto e para onde vai seu dinheiro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда вы запишете движения за %1$@, здесь появятся цифры, темп трат и то, куда уходят деньги."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "记录 %1$@ 的收支后，这里会显示你的数字、支出节奏和钱的去向。"
     }
    }
   }
  },
