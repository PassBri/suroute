      "state": "translated",
      "value": "Utilidad ÷ ventas, después de costos y gastos de operación."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bénéfice ÷ ventes, après coûts et charges d'exploitation."
