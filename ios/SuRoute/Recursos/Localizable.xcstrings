  "fase_4_diag": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أرى نتائج، لكني أحتاج إلى التعديل والتقوية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich sehe Ergebnisse, muss aber nachjustieren und mich festigen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I'm seeing results, but I need to adjust and strengthen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Veo resultados, pero necesito ajustar y fortalecer."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je vois des résultats, mais je dois ajuster et consolider."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मुझे नतीजे दिख रहे हैं, पर मुझे सुधार और मज़बूती की ज़रूरत है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Vedo dei risultati, ma devo aggiustare e rafforzare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "成果は出ているけれど、調整と強化が必要。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "성과가 보이지만 조정하고 보완해야 해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Vejo resultados, mas preciso ajustar e fortalecer."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я вижу результаты, но нужно скорректировать и укрепить курс."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我看到了成果，但还需要调整和加强。"
     }
    }
   }
  },
