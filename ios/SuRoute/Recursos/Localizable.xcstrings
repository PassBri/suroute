  "cv_sellar_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيرى الآخرون الظرف بختمه الشمعي حتى يوم فتحه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die anderen sehen den Umschlag mit seinem Wachssiegel bis zu dem Tag, an dem er sich öffnet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Others will see the envelope and its wax seal until the day it opens."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los demás verán el sobre con su lacre hasta el día en que se abra."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les autres verront l'enveloppe et son sceau de cire jusqu'au jour de son ouverture."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "खुलने के दिन तक दूसरों को लाख की मुहर वाला लिफ़ाफ़ा दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Gli altri vedranno la busta con il sigillo di ceralacca fino al giorno in cui si aprirà."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "開封日までは、ほかの人には封蠟つきの封筒だけが表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "열리는 날까지 다른 사람들에게는 밀랍 봉인이 찍힌 봉투만 보여요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os outros verão o envelope com o lacre até o dia em que ele abrir."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Остальные будут видеть конверт с сургучной печатью до того дня, когда он откроется."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在开启之日前，其他人只能看到盖着火漆印的信封。"
     }
    }
   }
  },
