  "paso_meta_mes_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "شيء محدد لهذه الأسابيع، مع الأيام التي ستخصصها له."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Etwas Konkretes für diese Wochen, mit den Tagen, die du dafür einplanst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Something concrete for these weeks, with the days you’ll give it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Algo concreto para estas semanas, con los días que le vas a dedicar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quelque chose de concret pour ces semaines, avec les jours que tu y consacreras."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इन हफ़्तों के लिए कुछ ठोस, साथ में उसे दिए जाने वाले दिन।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Qualcosa di concreto per queste settimane, con i giorni che ci dedicherai."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この数週間の具体的な目標と、取り組む日数を決めます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 몇 주 동안의 구체적인 목표와 투자할 날 수를 정해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Algo concreto para estas semanas, com os dias que vai dedicar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Что-то конкретное на эти недели и сколько дней ты этому посвятишь."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "为这几周定一个具体目标，并写下要投入的天数。"
     }
    }
   }
  },
  "paso_nacimiento": {
   "extractionState": "manual",
