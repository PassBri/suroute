  "cu_recibo_error": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تعذّر حفظ الإيصال. استخدم صورة أو PDF أقل من 15 ميغابايت."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Beleg konnte nicht gespeichert werden. Nutze ein Foto oder PDF unter 15 MB."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Couldn’t save the receipt. Use a photo or PDF under 15 MB."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo guardar el recibo. Usa una foto o un PDF de menos de 15 MB."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossible d’enregistrer le reçu. Utilise une photo ou un PDF de moins de 15 Mo."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "रसीद सहेजी नहीं जा सकी। 15 MB से छोटी फ़ोटो या PDF लें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossibile salvare la ricevuta. Usa una foto o un PDF sotto i 15 MB."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "領収書を保存できませんでした。15 MB 未満の写真か PDF を使ってください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "영수증을 저장하지 못했어요. 15MB 미만의 사진이나 PDF를 사용하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não foi possível salvar o recibo. Use uma foto ou PDF de até 15 MB."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Не удалось сохранить чек. Используй фото или PDF до 15 МБ."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "无法保存收据。请使用小于 15 MB 的照片或 PDF。"
     }
    }
   }
  },
