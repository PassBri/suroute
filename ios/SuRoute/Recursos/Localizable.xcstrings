  "cu_publica_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يمكنك مشاركة صحتك المالية وتقدمك ضد الديون مع المجتمع. تبقى المبالغ والإيصالات والحركات خاصة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du kannst deine finanzielle Gesundheit und deinen Schuldenabbau in der Community teilen. Beträge, Belege und Buchungen bleiben privat."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You can share your financial health and debt progress with the community. Amounts, receipts and entries stay private."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puedes compartir tu salud financiera y tu avance contra las deudas en la comunidad. Los montos, los recibos y los movimientos siguen siendo privados."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu peux partager ta santé financière et ton avancée contre les dettes avec la communauté. Les montants, reçus et mouvements restent privés."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप अपनी वित्तीय सेहत और कर्ज़ से मुक्ति की प्रगति समुदाय में साझा कर सकते हैं। राशि, रसीदें और लेन-देन निजी रहते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Puoi condividere la tua salute finanziaria e i progressi sui debiti nella comunità. Importi, ricevute e movimenti restano privati."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "お金の健康と借金返済の進捗をコミュニティで共有できます。金額・領収書・記録は非公開のままです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "재정 건강과 빚 상환 진행을 커뮤니티에 공유할 수 있어요. 금액, 영수증, 내역은 비공개로 유지돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você pode compartilhar sua saúde financeira e o avanço contra as dívidas na comunidade. Valores, recibos e lançamentos continuam privados."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты можешь делиться финансовым здоровьем и прогрессом по долгам в сообществе. Суммы, чеки и записи остаются личными."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你可以在社区分享财务健康和还债进展。金额、收据和记录仍然保密。"
     }
    }
   }
  },
