  "foco_quitar_q": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» لديه بالفعل %2$ld أيام مُعلّمة هذا الشهر. هل تزيله من الشهر؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "„%1$@“ hat diesen Monat schon %2$ld markierte Tage. Aus dem Monat entfernen?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "“%1$@” already has %2$ld days marked this month. Remove it from the month?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» ya tiene %2$ld días marcados este mes. ¿Quitarla del mes?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "« %1$@ » a déjà %2$ld jours marqués ce mois-ci. Le retirer du mois ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» के इस महीने पहले से %2$ld दिन दर्ज हैं। इसे महीने से हटाएँ?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» ha già %2$ld giorni segnati questo mese. Toglierlo dal mese?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」は今月すでに%2$ld日記録されています。今月から外しますか？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」는 이번 달 이미 %2$ld일이 표시됐어요. 이번 달에서 뺄까요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "“%1$@” já tem %2$ld dias marcados este mês. Tirar do mês?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» уже имеет %2$ld отмеченных дней в этом месяце. Убрать из месяца?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」本月已标记 %2$ld 天。要从本月移除吗？"
     }
    }
   }
  },
  "foco_resumen": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هذا الشهر: %1$ld أهداف و%2$ld أهداف فرعية من %3$ld."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Diesen Monat: %1$ld Ziele und %2$ld Teilziele aus %3$ld."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This month: %1$ld goals and %2$ld sub-goals from %3$ld."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Este mes: %1$ld metas y %2$ld sub-metas de %3$ld."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce mois-ci : %1$ld objectifs et %2$ld sous-objectifs de %3$ld."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस महीने: %3$ld के %1$ld लक्ष्य और %2$ld उप-लक्ष्य।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo mese: %1$ld obiettivi e %2$ld sotto-obiettivi del %3$ld."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今月：%3$ld年の目標%1$ld件、サブ目標%2$ld件。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이번 달: %3$ld년 목표 %1$ld개, 하위 목표 %2$ld개."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Este mês: %1$ld metas e %2$ld submetas de %3$ld."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В этом месяце: целей — %1$ld, подцелей — %2$ld (из %3$ld)."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
