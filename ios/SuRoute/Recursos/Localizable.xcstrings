     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seus marcos"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ваши вехи"
     }
    },
    "zh-Hans": {
     "stringUnit": {
