     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Verrou par empreinte ou visage"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "फ़िंगरप्रिंट या चेहरे से लॉक"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Blocco con impronta o volto"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "指紋・顔でロック"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지문·얼굴 잠금"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Bloqueio com digital ou rosto"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Блокировка отпечатком или лицом"
     }
