  "cu_ind_fondo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أشهر المصاريف الثابتة التي يغطيها ادخار الطوارئ ونقدك وحساباتك. المثالي: من 3 إلى 6."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Monate fester Ausgaben, die dein Notgroschen und dein Bargeld und deine Konten decken. Ideal: 3 bis 6."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Months of fixed expenses covered by your emergency savings plus your cash and accounts. Ideal: 3 to 6."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Meses de gastos fijos que cubren tu ahorro de emergencia y tu efectivo y cuentas. Ideal: de 3 a 6."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mois de dépenses fixes couverts par votre épargne de secours et vos liquidités et comptes. Idéal : de 3 à 6."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपात बचत और नकद व खातों से कितने महीनों के तय खर्च पूरे होते हैं। आदर्श: 3 से 6।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mesi di spese fisse coperti dal tuo fondo di emergenza e da contanti e conti. Ideale: da 3 a 6."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "緊急用の貯蓄と現金・口座でまかなえる固定費の月数。理想は3〜6か月。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "비상 저축과 현금·계좌로 감당할 수 있는 고정 지출 개월 수. 이상적: 3~6개월."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Meses de gastos fixos cobertos pela sua poupança de emergência e pelo seu dinheiro e contas. Ideal: de 3 a 6."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сколько месяцев постоянных расходов покрывают резервный фонд, наличные и счета. Идеально: от 3 до 6."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "应急储蓄加上现金和账户能覆盖的固定支出月数。理想：3 到 6 个月。"
     }
    }
   }
  },
