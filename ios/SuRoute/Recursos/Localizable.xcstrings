     }
    }
   }
  },
  "cv_g5_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عند التعليق، اختر سؤال أو نصيحة أو أنا أحاول أيضًا. الحبل يساعد أكثر من التصفيق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wähle beim Kommentieren Frage, Tipp oder Ich versuche es auch. Ein Seil hilft mehr als Applaus."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When commenting, choose Question, Tip or I'm trying too. A rope helps more than applause."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al comentar, elige Pregunta, Consejo o Yo también lo intento. Una cuerda ayuda más que un aplauso."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "En commentant, choisis Question, Conseil ou Moi aussi, j'essaie. Une corde aide plus qu'un applaudissement."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "टिप्पणी करते समय सवाल, सलाह या मेरी भी कोशिश जारी है चुनें। एक रस्सी तालियों से ज़्यादा मदद करती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando commenti, scegli Domanda, Consiglio o Ci provo anch'io. Una corda aiuta più di un applauso."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コメントするときは、質問、アドバイス、私も挑戦中から選びます。ロープは拍手よりも力になります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "댓글을 달 때 질문, 조언, 저도 도전 중이에요 중에서 고르세요. 로프 한 줄이 박수보다 더 큰 도움이 돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ao comentar, escolha Pergunta, Dica ou Eu também estou tentando. Uma corda ajuda mais que um aplauso."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Комментируя, выбери «Вопрос», «Совет» или «Я тоже пытаюсь». Верёвка помогает больше, чем аплодисменты."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "评论时，选择提问、建议或我也在努力。一根绳子比掌声更有帮助。"
     }
    }
   }
  },
  "cv_g5_t": {
   "extractionState": "manual",
