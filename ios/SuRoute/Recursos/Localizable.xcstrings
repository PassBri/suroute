  "cu_minimos_nunca": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بدفع الحد الأدنى فقط لن ينتهي الدين: بطريقتك ستخرج منه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mit nur den Mindestraten würde die Schuld nie enden: mit deiner Methode kommst du raus."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Paying only the minimums the debt would never end: with your method you get out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando solo los mínimos la deuda no se acabaría: con tu método sí sales."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "En payant seulement les minimums, la dette ne finirait jamais : avec ta méthode, tu t’en sors."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सिर्फ़ न्यूनतम भुगतान से कर्ज़ कभी खत्म नहीं होगा: आपके तरीके से आप बाहर निकलेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando solo i minimi il debito non finirebbe mai: con il tuo metodo ne esci."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "最低返済だけでは借金は終わりません。あなたの方法なら抜け出せます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "최소 상환만 하면 빚이 끝나지 않아요. 내 방법이면 벗어날 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pagando só os mínimos a dívida nunca acabaria: com seu método você sai."
