     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके लिए, विज़न और फ़ॉलोइंग"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Per te, Visione e Seguiti"
     }
    },
    "ja": {
