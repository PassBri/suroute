      "state": "translated",
      "value": "%1$@ días por delante en tu camino hacia los %2$ld años"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ jours devant toi sur ton chemin vers les %2$ld ans"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$ld वर्ष के सफ़र में आगे %1$@ दिन बाकी हैं"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ giorni davanti a te sul tuo cammino verso i %2$ld anni"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$ld歳への道のりで、あと%1$@日"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$ld세로 가는 길에 %1$@일이 남았어요"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ dias pela frente no seu caminho até os %2$ld anos"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Впереди %1$@ дней на пути к %2$ld годам"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "在通往 %2$ld 岁的路上，前方还有 %1$@ 天"
     }
    }
   }
  },
  "recordatorio_sin_fecha": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أضف تاريخ ميلادك وستعرف كل صباح أي يوم من حياتك يبدأ وكم يومًا بقي لك في طريقك نحو 120 عامًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Trage dein Geburtsdatum ein, und jeden Morgen weißt du, welcher Tag deines Lebens beginnt und wie viele dir auf deinem Weg zu 120 Jahren noch bleiben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Add your date of birth and every morning you'll know which day of your life is starting and how many are left on your road to 120 years."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agrega tu fecha de nacimiento y cada mañana sabrás qué día de tu vida comienza y cuántos te quedan en tu camino hacia los 120 años."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajoute ta date de naissance et chaque matin tu sauras quel jour de ta vie commence et combien il t'en reste sur ton chemin vers les 120 ans."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपनी जन्मतिथि जोड़ें, और हर सुबह आप जानेंगे कि आपके जीवन का कौन-सा दिन शुरू हो रहा है और 120 वर्ष के सफ़र में कितने दिन बाकी हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggiungi la tua data di nascita e ogni mattina saprai quale giorno della tua vita inizia e quanti te ne restano sul tuo cammino verso i 120 anni."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "生年月日を追加すると、毎朝、人生の何日目が始まるのか、120歳への道のりであと何日残っているのかがわかります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "생년월일을 추가하면 매일 아침 내 인생의 며칠째가 시작되는지, 120세로 가는 길에 며칠이 남았는지 알 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Adicione sua data de nascimento e, toda manhã, você saberá qual dia da sua vida está começando e quantos ainda restam no seu caminho até os 120 anos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Добавь дату рождения, и каждое утро ты будешь знать, какой день твоей жизни начинается и сколько их осталось на пути к 120 годам."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "添加你的出生日期，每天早晨你都会知道人生的第几天开始了，以及在通往 120 岁的路上还剩多少天。"
     }
    }
   }
  },
