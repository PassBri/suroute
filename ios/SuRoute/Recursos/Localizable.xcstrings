    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» अपनी प्रगति के साथ हटा दिया जाएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» verrà eliminato con i suoi progressi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」とその進捗が削除されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "「%1$@」와 진행 상황이 삭제됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "«%1$@» será apagada com o seu progresso."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
