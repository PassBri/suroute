  "constancia_leyenda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل مربع يوم؛ كلما زاد الذهبي زادت العادات."
     }
    },
    "de": {
