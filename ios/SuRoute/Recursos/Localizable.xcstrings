  "mf_fondo_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مصاريفك الثابتة نحو %1$@ شهريًا. المثالي ادخار 3 إلى 6 أشهر: بين %2$@ و%3$@. معه لا يتحول الطارئ إلى دين."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Deine Fixkosten liegen bei etwa %1$@ im Monat. Ideal sind 3 bis 6 Monate Rücklage: zwischen %2$@ und %3$@. So wird aus Unvorhergesehenem keine Schuld."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your fixed expenses are about %1$@ a month. Ideally keep 3 to 6 months saved: between %2$@ and %3$@. With it, a surprise doesn't become debt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tus gastos fijos son cerca de %1$@ al mes. Lo ideal es tener de 3 a 6 meses guardados: entre %2$@ y %3$@. Con él, un imprevisto no se vuelve deuda."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vos dépenses fixes sont d'environ %1$@ par mois. L'idéal est d'avoir 3 à 6 mois de côté : entre %2$@ et %3$@. Ainsi, un imprévu ne devient pas une dette."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके तय खर्च लगभग %1$@ महीना हैं। 3 से 6 महीने की बचत आदर्श है: %2$@ से %3$@। इससे अचानक खर्च कर्ज़ नहीं बनता।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le tue spese fisse sono circa %1$@ al mese. L'ideale è avere da 3 a 6 mesi da parte: tra %2$@ e %3$@. Così un imprevisto non diventa un debito."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "固定費は月およそ %1$@ です。3〜6か月分（%2$@〜%3$@）あるのが理想。あれば、急な出費が借金になりません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "고정 지출이 매달 약 %1$@입니다. 3~6개월치(%2$@~%3$@)를 모아 두는 것이 이상적입니다. 그러면 뜻밖의 일이 빚이 되지 않습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seus gastos fixos são cerca de %1$@ por mês. O ideal é ter de 3 a 6 meses guardados: entre %2$@ e %3$@. Com ela, um imprevisto não vira dívida."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ваши постоянные расходы около %1$@ в месяц. Идеально иметь запас на 3–6 месяцев: от %2$@ до %3$@. Тогда непредвиденное не станет долгом."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的固定支出每月约 %1$@。理想是存够 3 到 6 个月：%2$@ 到 %3$@。有了它，意外就不会变成债务。"
     }
    }
   }
  },
