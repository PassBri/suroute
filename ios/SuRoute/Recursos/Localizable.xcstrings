  "cu_ind_rendact_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الدخل السلبي للسنة ÷ كل ما تملكه. يبين إن كانت ثروتك تعمل أم ساكنة. المثالي: 4 % أو أكثر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Passive Einnahmen des Jahres ÷ alles, was du besitzt. Zeigt, ob dein Vermögen arbeitet oder ruht. Ideal: 4 % oder mehr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Passive income for the year ÷ everything you own. Shows whether your wealth is working or idle. Ideal: 4 % or more."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ingresos pasivos del año ÷ todo lo que tienes. Muestra si tu patrimonio trabaja o está quieto. Ideal: 4 % o más."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Revenus passifs de l’année ÷ tout ce que vous possédez. Montre si votre patrimoine travaille ou dort. Idéal : 4 % ou plus."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "साल की निष्क्रिय आय ÷ आपकी पूरी संपत्ति। दिखाता है कि आपकी संपत्ति काम कर रही है या रुकी है। आदर्श: 4 % या ज़्यादा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Entrate passive dell’anno ÷ tutto ciò che possiedi. Mostra se il tuo patrimonio lavora o è fermo. Ideale: 4 % o più."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1 年の不労所得 ÷ 保有資産のすべて。資産が働いているか眠っているかがわかります。理想：4 % 以上。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "1년 불로소득 ÷ 가진 모든 자산. 자산이 일하고 있는지 쉬고 있는지 보여 줘요. 이상적: 4 % 이상."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Renda passiva do ano ÷ tudo o que você tem. Mostra se seu patrimônio trabalha ou está parado. Ideal: 4 % ou mais."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пассивный доход за год ÷ всё, что у вас есть. Показывает, работает ли капитал или простаивает. Идеал: 4 % и больше."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "一年的被动收入 ÷ 你拥有的全部资产。显示你的资产是在工作还是闲置。理想：4 % 或以上。"
     }
    }
   }
  },
