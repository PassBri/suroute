  "ex_hito_camp_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ربحت الخطوات الثماني في %1$@. يمكن لمجتمعك رؤية ذلك في بوصلتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast alle 8 Schritte von %1$@ geschafft. Deine Gemeinschaft sieht es in deinem Kompass."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You won all 8 steps of %1$@. Your community can see it in your Compass."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ganaste los 8 pasos de %1$@. Tu comunidad puede verlo en tu Brújula."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vous avez gagné les 8 pas de %1$@. Votre communauté peut le voir dans votre Boussole."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने %1$@ के सभी 8 कदम पूरे किए। आपका समुदाय इसे आपके कम्पास में देख सकता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai conquistato gli 8 passi di %1$@. La tua comunità può vederlo nella tua Bussola."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ の 8 歩をすべて達成しました。コミュニティはあなたのコンパスで見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@의 8걸음을 모두 이뤘어요. 커뮤니티가 당신의 나침반에서 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você ganhou os 8 passos de %1$@. Sua comunidade pode ver isso na sua Bússola."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Вы прошли все 8 шагов %1$@. Сообщество увидит это в вашем Компасе."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你完成了 %1$@ 的全部 8 步。你的社区可以在你的指南针里看到。"
     }
    }
   }
  },
