  "web_borrado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم. حُذف مسارك من السحابة وما زال كاملًا على هاتفك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erledigt. Dein Weg wurde aus der Cloud gelöscht und ist auf dem Handy vollständig."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Done. Your path was deleted from the cloud and is still complete on your phone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Listo. Tu ruta se borró de la nube y sigue completa en tu teléfono."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "C’est fait. Ton parcours a été supprimé du cloud et reste complet sur ton téléphone."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हो गया। आपका मार्ग क्लाउड से हट गया और फ़ोन पर पूरा है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fatto. Il percorso è stato eliminato dal cloud ed è ancora completo sul telefono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "完了しました。ルートはクラウドから削除され、スマホにはすべて残っています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "완료됐어요. 경로가 클라우드에서 삭제됐고 휴대폰에는 그대로 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pronto. Sua rota foi apagada da nuvem e continua completa no celular."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Готово. Путь удалён из облака и полностью сохранён на телефоне."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "完成。你的路线已从云端删除，手机上仍完整保留。"
     }
    }
   }
  },
