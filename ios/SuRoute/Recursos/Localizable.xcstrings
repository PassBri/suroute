  "meses_del_anio_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أشهر السنة (اللون = تمت حصيلة الشهر). اضغط على شهر لفتحه."
     }
    },
    "de": {
     "stringUnit": {
