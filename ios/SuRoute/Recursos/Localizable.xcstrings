  "paso_vision_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يبنيها الذكاء الاصطناعي مما كتبته، وتملؤها أنت بصورك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die KI baut es aus dem, was du geschrieben hast; du füllst es mit deinen Fotos."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "AI builds it from what you’ve written; you fill it with your photos."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La IA lo arma con lo que ya escribiste; tú lo llenas con tus fotos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L’IA le compose avec ce que tu as écrit ; tu le remplis avec tes photos."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "AI आपके लिखे से बनाता है; आप उसे अपनी तस्वीरों से भरते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L’IA la compone con ciò che hai scritto; tu la riempi con le tue foto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "書いた内容からAIが作り、あなたが写真で埋めます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "AI가 작성한 내용으로 만들고, 사진으로 채우는 건 당신이에요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A IA monta com o que você já escreveu; você preenche com suas fotos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "ИИ соберёт её из написанного тобой, а ты заполнишь своими фото."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "AI 根据你写下的内容生成，你用自己的照片填满。"
     }
    }
   }
  },
