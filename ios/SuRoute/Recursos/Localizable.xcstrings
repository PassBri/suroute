  "ios_muro_vacio_siguiendo": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عندما تتابع أشخاصًا، سترى خطواتهم هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du anderen folgst, siehst du hier ihre Schritte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When you follow people, you'll see their steps here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando sigas a otras personas, aquí verás sus pasos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quand vous suivrez des personnes, vous verrez leurs pas ici."
