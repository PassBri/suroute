  "resumen_cierre": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل يوم أضاف شيئًا. قمّتك أقرب مما كانت قبل عام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Tag hat gezählt. Dein Gipfel ist näher als vor einem Jahr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every day counted. Your summit is closer than a year ago."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada día sumó. Tu cumbre está más cerca que hace un año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque jour a compté. Ton sommet est plus proche qu’il y a un an."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर दिन जुड़ा। आपका शिखर एक साल पहले से ज़्यादा करीब है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni giorno ha contato. La tua vetta è più vicina di un anno fa."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎日が積み重なりました。頂は1年前より近づいています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루하루가 쌓였어요. 정상은 1년 전보다 가까워졌어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada dia somou. Seu cume está mais perto do que há um ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый день был важен. Твоя вершина ближе, чем год назад."
