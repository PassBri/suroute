  "contactos_encontrable_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عبر بريد حسابك، وعبر هاتفك إن كتبته. تُحفظ بصمة مشفرة فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Über die E-Mail deines Kontos und, wenn du sie einträgst, über deine Nummer. Gespeichert wird nur ein verschlüsselter Fingerabdruck."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "By your account email and, if you add it, your phone. Only an encrypted fingerprint is stored."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Por el correo de tu cuenta y, si lo escribes, por tu teléfono. Se guarda solo una huella cifrada."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Par l'e-mail de votre compte et, si vous l'ajoutez, par votre téléphone. Seule une empreinte chiffrée est conservée."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके खाते के ईमेल से और, अगर आप लिखें, तो फ़ोन नंबर से। केवल एक एन्क्रिप्टेड फ़िंगरप्रिंट सहेजा जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tramite l'e-mail del tuo account e, se lo scrivi, il tuo telefono. Si salva solo un'impronta cifrata."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アカウントのメールと、入力すれば電話番号で。保存するのは暗号化された指紋だけです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계정 이메일과, 입력하면 전화번호로 찾을 수 있습니다. 암호화된 지문만 저장됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pelo e-mail da sua conta e, se você escrever, pelo seu telefone. Só é guardada uma impressão cifrada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "По почте вашего аккаунта и, если укажете, по телефону. Хранится только зашифрованный отпечаток."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "通过你账户的邮箱，以及你填写的手机号。只保存加密指纹。"
     }
    }
   }
  },
