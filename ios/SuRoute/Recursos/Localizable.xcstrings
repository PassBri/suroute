  "dias_objetivo_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل يوم تعلّمه يضيف تقدّمًا لهذا الهدف ولكل الشلّال."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Tag, den du abhakst, bringt dieses Ziel und die ganze Kaskade voran."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Every day you check adds progress to this goal and to the whole cascade."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada día que marques suma avance a esta meta y a toda la cascada."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque jour que tu coches fait avancer cet objectif et toute la cascade."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आप जो भी दिन टिक करेंगे वह इस लक्ष्य और पूरे झरने में प्रगति जोड़ेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni giorno che spunti fa avanzare questo obiettivo e tutta la cascata."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "チェックした日ごとに、この目標とカスケード全体の進捗が増えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "체크하는 하루하루가 이 목표와 폭포 전체의 진행률을 올려 줘요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada dia que você marcar soma progresso a esta meta e a toda a cascata."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый отмеченный день добавляет прогресс этой цели и всему каскаду."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你打卡的每一天，都会为这个目标乃至整个瀑布增加进展。"
     }
    }
   }
  },
