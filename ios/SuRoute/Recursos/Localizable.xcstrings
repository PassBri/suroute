  "contactos_invitacion": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أصعد نحو قمتي في SuRoute. انضم إليّ ولنصعد معًا: %1$@"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich steige bei SuRoute zu meinem Gipfel auf. Komm mit, wir steigen zusammen: %1$@"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I'm climbing toward my summit on SuRoute. Join me and let's climb together: %1$@"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estoy subiendo a mi cumbre en SuRoute. Únete y subamos juntos: %1$@"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je grimpe vers mon sommet sur SuRoute. Rejoins-moi et montons ensemble : %1$@"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं SuRoute पर अपने शिखर की ओर चढ़ रहा हूँ। जुड़िए, साथ चढ़ें: %1$@"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sto salendo verso la mia vetta su SuRoute. Unisciti e saliamo insieme: %1$@"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute で自分の頂上を目指しています。一緒に登ろう：%1$@"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute에서 나의 정상을 향해 오르고 있어요. 함께 올라요: %1$@"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Estou subindo rumo ao meu cume no SuRoute. Venha e vamos subir juntos: %1$@"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я поднимаюсь к своей вершине в SuRoute. Присоединяйся, поднимемся вместе: %1$@"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我正在 SuRoute 上攀登我的顶峰。加入我，一起攀登：%1$@"
     }
    }
   }
  },
