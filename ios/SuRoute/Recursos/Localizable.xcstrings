  "red_bienvenida": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختر المحاور التي تحرّكك أكثر وتابع بعض الأشخاص لملء صفحتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wähle die Achsen, die dich am meisten bewegen, und folge ein paar Personen, um deinen Feed zu füllen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pick the axes that move you most and follow a few people to fill your feed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elige los ejes que más te mueven y sigue a algunas personas para llenar tu muro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisissez les axes qui vous animent et suivez quelques personnes pour remplir votre fil."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जो धुरियाँ आपको सबसे ज़्यादा प्रेरित करती हैं उन्हें चुनें और अपनी फ़ीड भरने के लिए कुछ लोगों को फ़ॉलो करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scegli gli assi che ti muovono di più e segui alcune persone per riempire la tua bacheca."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "心を動かす軸を選び、何人かをフォローしてフィードを充実させましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "가장 마음이 가는 축을 고르고 몇 사람을 팔로우해 피드를 채워 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolha os eixos que mais movem você e siga algumas pessoas para encher seu mural."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выберите оси, которые вас больше всего вдохновляют, и подпишитесь на нескольких людей, чтобы наполнить ленту."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "选择最能激励你的维度，并关注几个人来充实你的动态。"
     }
    }
   }
  },
