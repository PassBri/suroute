  "vida_carta_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ما تريد قوله لنفسك في %1$ld."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was du dir %1$ld sagen willst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "What you want to tell yourself in %1$ld."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que quieres decirte en %1$ld."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce que tu veux te dire en %1$ld."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld में आप खुद से क्या कहना चाहते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ciò che vuoi dirti nel %1$ld."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld 年に自分へ伝えたいこと。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld년에 나에게 하고 싶은 말."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O que você quer se dizer em %1$ld."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Что ты хочешь сказать себе в %1$ld."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld 年你想对自己说的话。"
     }
    }
   }
  },
  "vida_carta_ayuda_futuro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتب للشخص الذي ستكونه في %1$ld. تُحفظ الرسالة وتُفتح في 1 يناير من ذلك العام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib der Person, die du %1$ld sein wirst. Er wird aufbewahrt und öffnet sich am 1. Januar dieses Jahres."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write to the person you will be in %1$ld. It is kept safe and opens on January 1 of that year."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escríbele a la persona que serás en %1$ld. Se guarda y se abre el 1 de enero de ese año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écris à la personne que tu seras en %1$ld. Elle est gardée et s’ouvre le 1er janvier de cette année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld में जो आप होंगे, उसे लिखें। यह सहेजा जाएगा और उस साल 1 जनवरी को खुलेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrivi alla persona che sarai nel %1$ld. Resta custodita e si apre il 1° gennaio di quell’anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld 年の自分に書きましょう。手紙は保管され、その年の 1 月 1 日に開きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$ld년의 나에게 쓰세요. 편지는 보관되고 그해 1월 1일에 열립니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escreva para a pessoa que você será em %1$ld. Ela fica guardada e abre em 1º de janeiro desse ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Напиши человеку, которым ты станешь в %1$ld. Письмо сохранится и откроется 1 января того года."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "写给 %1$ld 年的自己。信会被保存，在那一年的 1 月 1 日开启。"
     }
    }
   }
  },
