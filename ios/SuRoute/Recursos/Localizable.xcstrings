  "habitos_editar_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اكتبها بطريقتك. لكل محور من 1 إلى 6 عادات. الأيام التي سجّلتها تبقى كما هي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schreib sie auf deine Art. Jede Achse hat 1 bis 6 Gewohnheiten. Bereits abgehakte Tage bleiben erhalten."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Write them your way. Each axis has 1 to 6 habits. Days you already checked are kept."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escríbelos a tu manera. Cada eje lleva de 1 a 6 hábitos. Los días que ya marcaste se conservan."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Écris-les à ta façon. Chaque axe a de 1 à 6 habitudes. Les jours déjà cochés sont conservés."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इन्हें अपने तरीके से लिखें। हर धुरी में 1 से 6 आदतें। पहले से चिह्नित दिन बने रहते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrivile a modo tuo. Ogni asse ha da 1 a 6 abitudini. I giorni già segnati restano."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "自分の言葉で書きましょう。各軸に 1〜6 個の習慣。チェック済みの日はそのまま残ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "나만의 방식으로 적어 보세요. 축마다 습관은 1~6개입니다. 이미 체크한 날은 그대로 남아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escreva do seu jeito. Cada eixo tem de 1 a 6 hábitos. Os dias já marcados são mantidos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пиши их по-своему. На каждой оси от 1 до 6 привычек. Отмеченные дни сохраняются."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用你的方式写下它们。每个维度有 1 到 6 个习惯。已经打勾的日子会保留。"
     }
    }
   }
  },
