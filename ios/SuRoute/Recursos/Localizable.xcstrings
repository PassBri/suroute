  "cv_g8_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عند النشر يمكنك الالتزام لفترة. عند حلول الموعد تقول إن كنت قد نجحت أو ستعيد النظر، ويرى مجتمعك النتيجة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Beim Posten kannst du dich für eine Zeit verpflichten. Ist es fällig, sagst du, ob du es geschafft hast oder neu planst, und deine Community sieht den Ausgang."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When posting you can commit for a while. When it's due you say whether you made it or are rethinking it, and your community sees the outcome."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al publicar puedes comprometerte por un tiempo. Cuando vence, dices si lo lograste o lo replanteas, y tu comunidad ve el desenlace."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "En publiant, tu peux t'engager pour une durée. À l'échéance, tu dis si tu as réussi ou si tu revois ton objectif, et ta communauté voit le dénouement."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पोस्ट करते समय आप कुछ समय के लिए संकल्प ले सकते हैं। समय पूरा होने पर आप बताते हैं कि आपने इसे हासिल किया या इस पर दोबारा विचार करना है, और आपका समुदाय नतीजा देखता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando pubblichi puoi impegnarti per un certo periodo. Alla scadenza dici se ce l'hai fatta o se lo stai ripensando, e la tua community vede com'è andata."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "投稿するときに、一定期間の約束ができます。期限が来たら達成できたか見直すかを伝え、コミュニティがその結末を見ます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "게시할 때 일정 기간 약속할 수 있어요. 기한이 되면 해냈는지, 다시 계획하는지 알리고, 커뮤니티가 그 결말을 봐요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ao publicar, você pode se comprometer por um tempo. Quando vence, você diz se conseguiu ou se está repensando, e sua comunidade vê o desfecho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Публикуя, ты можешь взять обещание на какое-то время. Когда срок истекает, ты говоришь, получилось ли или ты пересматриваешь цель, а сообщество видит развязку."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "发布时可以做出一段时间的承诺。到期时，你说明是做到了还是需要重新调整，社区会看到结果。"
     }
    }
   }
  },
  "cv_g8_t": {
   "extractionState": "manual",
   "localizations": {
