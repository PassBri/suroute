  "ios_edad": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عمري 18 عامًا أو أكثر، أو بين 14 و17 عامًا ولدي إذن من ولي أمري القانوني."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich bin 18 Jahre oder älter, oder zwischen 14 und 17 und habe die Erlaubnis meines gesetzlichen Vertreters."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I am 18 or older, or I am between 14 and 17 and have my legal guardian's permission."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tengo 18 años o más, o tengo entre 14 y 17 y cuento con la autorización de mi representante legal."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "J'ai 18 ans ou plus, ou j'ai entre 14 et 17 ans avec l'autorisation de mon représentant légal."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मेरी उम्र 18 वर्ष या उससे अधिक है, या 14 से 17 के बीच है और मेरे कानूनी अभिभावक की अनुमति है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ho 18 anni o più, oppure tra 14 e 17 anni con l'autorizzazione del mio rappresentante legale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "18歳以上です。または14〜17歳で、法定代理人の許可を得ています。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "만 18세 이상이거나, 14~17세로 법정대리인의 허락을 받았습니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenho 18 anos ou mais, ou tenho entre 14 e 17 e conto com a autorização do meu responsável legal."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Мне 18 лет или больше, либо от 14 до 17 лет и у меня есть разрешение законного представителя."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我已年满 18 岁，或年龄在 14 至 17 岁之间并已获得法定监护人的许可。"
     }
    }
   }
  },
  "ios_eliminar_aviso": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيؤدي هذا إلى حذف حسابك وكل ما على الخادم نهائيًا: مسارك ومنشوراتك ورسائلك. لا يمكن التراجع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dies löscht dein Konto und alles auf dem Server endgültig: deine Route, Beiträge und Nachrichten. Das kann nicht rückgängig gemacht werden."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This permanently deletes your account and everything on the server: your route, posts and messages. It can't be undone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esto borra para siempre tu cuenta y todo lo que está en el servidor: tu ruta, tus publicaciones y tus mensajes. No se puede deshacer."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Cela supprime définitivement votre compte et tout ce qui est sur le serveur : votre parcours, vos publications et vos messages. C'est irréversible."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इससे आपका खाता और सर्वर पर सब कुछ हमेशा के लिए हट जाएगा: आपका मार्ग, पोस्ट और संदेश। इसे पूर्ववत नहीं किया जा सकता।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo elimina per sempre il tuo account e tutto ciò che è sul server: percorso, pubblicazioni e messaggi. Non si può annullare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アカウントとサーバー上のすべて（ルート、投稿、メッセージ）が完全に削除されます。元に戻せません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계정과 서버의 모든 것(루트, 게시물, 메시지)이 영구 삭제돼요. 되돌릴 수 없어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Isso apaga para sempre sua conta e tudo o que está no servidor: sua rota, publicações e mensagens. Não pode ser desfeito."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Это навсегда удалит аккаунт и всё на сервере: маршрут, публикации и сообщения. Отменить нельзя."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这将永久删除你的账号及服务器上的所有内容：路线、发布和消息。无法撤销。"
     }
    }
   }
  },
