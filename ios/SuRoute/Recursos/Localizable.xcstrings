  "plan_dia_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أشياء قليلة وبالترتيب: ابدأ بالأولى ولا تنتقل إلى التالية حتى تنهيها. اربطها بهدف الشهر لتُحتسب هناك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenige Dinge, der Reihe nach: Beginne mit Nr. 1 und geh erst weiter, wenn sie erledigt ist. Verknüpfe sie mit einem Monatsziel, damit sie dort zählen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A few things, in order: start with number 1 and don't move on until it's done. Link them to a monthly goal so they count there."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pocas cosas, en orden: empieza por la 1 y no pases a la siguiente hasta terminarla. Únelas a una meta del mes para que cuenten allá."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Peu de choses, dans l’ordre : commence par la 1 et ne passe à la suivante qu’une fois finie. Relie-les à un objectif du mois pour qu’elles comptent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कम चीज़ें, क्रम से: 1 से शुरू करें और उसे पूरा किए बिना आगे न बढ़ें। इन्हें महीने के लक्ष्य से जोड़ें ताकि वहाँ गिनी जाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Poche cose, in ordine: inizia dalla 1 e passa alla successiva solo quando l’hai finita. Collegale a un obiettivo del mese perché contino lì."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "少なく、順番に。1 から始め、終わるまで次に進まない。月の目標につなげればそこに記録されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "적게, 순서대로: 1번부터 시작해 끝낼 때까지 다음으로 넘어가지 마세요. 이달의 목표에 연결하면 거기에 반영됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Poucas coisas, em ordem: comece pela 1 e só passe para a próxima quando terminar. Ligue-as a uma meta do mês para que contem lá."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Немного дел и по порядку: начни с первого и не переходи к следующему, пока не закончишь. Свяжи их с целью месяца, чтобы они там засчитывались."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "少而有序：从第 1 件开始，做完再做下一件。把它们关联到本月目标，就会计入那里。"
     }
    }
   }
  },
