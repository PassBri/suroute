  "fg_cortar_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ينتهي البث للجميع ويُسجَّل على أنه أوقفته الإشراف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Übertragung endet für alle und wird als durch die Moderation beendet erfasst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The stream ends for everyone and is recorded as ended by moderation."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La transmisión termina para todos y queda registrada como cortada por moderación."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La diffusion s'arrête pour tous et est enregistrée comme coupée par la modération."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "प्रसारण सभी के लिए खत्म होगा और मॉडरेशन द्वारा रोका गया दर्ज होगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La trasmissione termina per tutti e viene registrata come interrotta dalla moderazione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "配信は全員に対して終了し、モデレーションによる中断として記録されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "방송이 모두에게 종료되고 운영진에 의한 중단으로 기록됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A transmissão termina para todos e fica registrada como interrompida pela moderação."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Трансляция завершится для всех и будет отмечена как прерванная модерацией."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "直播将对所有人结束，并记录为被审核中断。"
     }
    }
   }
  },
