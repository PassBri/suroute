  "cu_metodo_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "من كتاب Cargas financieras: ادفع الحد الأدنى للجميع وضع كل الإضافي في دين واحد. عندما تنهيه، ينتقل قسطه إلى التالي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aus dem Buch Cargas financieras: Zahle überall das Minimum und alles Zusätzliche auf eine. Ist sie getilgt, geht ihre Rate an die nächste."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "From the book Cargas financieras: pay the minimum on all and put every extra on just one. When it’s done, its payment rolls to the next."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Del libro Cargas financieras: paga el mínimo en todas y pon todo lo extra en una sola. Cuando la terminas, su cuota pasa a la siguiente."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "D’après Cargas financieras : paie le minimum partout et mets tout l’extra sur une seule. Une fois finie, sa mensualité passe à la suivante."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "Cargas financieras पुस्तक से: सब पर न्यूनतम दें और सारा अतिरिक्त एक पर लगाएँ। उसे चुकाने के बाद उसकी किस्त अगले पर जाए।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dal libro Cargas financieras: paga il minimo su tutti e metti tutto l’extra su uno solo. Finito, la sua rata passa al successivo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "『Cargas financieras』より：全部に最低額を払い、余分はひとつに集中。完済したらその返済額を次へ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "『Cargas financieras』에서: 모든 빚에 최소액을 내고 추가금은 하나에 집중하세요. 다 갚으면 그 상환액을 다음으로 넘겨요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Do livro Cargas financieras: pague o mínimo em todas e coloque todo o extra em uma só. Quando terminar, a parcela passa para a próxima."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Из книги Cargas financieras: плати минимум по всем и весь излишек — в один долг. Погасив его, переводи его платёж на следующий."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "出自《Cargas financieras》：所有债务只还最低额，额外的钱集中还一笔。还清后，它的还款额转到下一笔。"
     }
    }
   }
  },
