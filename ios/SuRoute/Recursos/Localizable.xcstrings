  "cu_sin_movs_dia": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا حركات في هذا اليوم بعد. سجّل الأولى: المبلغ وفئته يكفيان."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "An diesem Tag noch keine Buchung. Erfasse die erste: Betrag und Kategorie genügen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No entries for this day yet. Add the first one: the amount and its category are enough."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay movimientos este día. Anota el primero: el monto y su categoría bastan."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore de mouvement ce jour. Note le premier : le montant et sa catégorie suffisent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "इस दिन अभी कोई लेन-देन नहीं। पहला दर्ज करें: राशि और श्रेणी काफ़ी हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun movimento oggi. Annota il primo: bastano importo e categoria."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この日の記録はまだありません。最初の1件を：金額とカテゴリだけで十分です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이날은 아직 내역이 없어요. 첫 내역을 적어 보세요: 금액과 분류면 충분해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há lançamentos neste dia. Anote o primeiro: o valor e a categoria bastam."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В этот день записей пока нет. Добавь первую: хватит суммы и категории."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这一天还没有记录。添加第一条：金额和类别就够了。"
     }
    }
   }
  },
