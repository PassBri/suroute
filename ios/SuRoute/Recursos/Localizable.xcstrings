  "cu_fijos_repetidos": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "بند ثابت مكرر في %2$@ ويُحتسب مرتين. احذف الزائد بسلة المهملات: يتوقف احتسابه من %2$@ ولا تتغير الأشهر السابقة."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld بنود ثابتة مكررة في %2$@ وتُحتسب مرتين. احذف الزائدة بسلة المهملات: يتوقف احتسابها من %2$@ ولا تتغير الأشهر السابقة."
        }
       }
      }
     }
    },
    "de": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Ein Fixposten ist im %2$@ doppelt und wird zweimal gezählt. Entfernen Sie den überzähligen mit dem Papierkorb: Er zählt ab %2$@ nicht mehr, frühere Monate bleiben gleich."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld Fixposten sind im %2$@ doppelt und werden zweimal gezählt. Entfernen Sie die überzähligen mit dem Papierkorb: Sie zählen ab %2$@ nicht mehr, frühere Monate bleiben gleich."
        }
       }
      }
     }
    },
    "en": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "One fixed item is repeated in %2$@ and counted twice. Remove the extra one with the bin: it stops counting from %2$@; earlier months don't change."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld fixed items are repeated in %2$@ and counted twice. Remove the extra ones with the bin: they stop counting from %2$@; earlier months don't change."
        }
       }
      }
     }
    },
    "es": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Un fijo está repetido en %2$@ y se cuenta dos veces. Quita el que sobra con el bote: deja de contar desde %2$@, los meses anteriores no cambian."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld fijos están repetidos en %2$@ y se cuentan dos veces. Quita los que sobran con el bote: dejan de contar desde %2$@, los meses anteriores no cambian."
        }
       }
      }
     }
    },
    "fr": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Un élément fixe est en double en %2$@ et compté deux fois. Retirez celui en trop avec la corbeille : il ne compte plus à partir de %2$@ ; les mois précédents ne changent pas."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld éléments fixes sont en double en %2$@ et comptés deux fois. Retirez ceux en trop avec la corbeille : ils ne comptent plus à partir de %2$@ ; les mois précédents ne changent pas."
        }
       }
      }
     }
    },
    "hi": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "एक तय मद %2$@ में दोहराई गई है और दो बार गिनी जा रही है। अतिरिक्त को कूड़ेदान से हटाएँ: %2$@ से गिनती बंद होगी, पिछले महीने नहीं बदलेंगे।"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld तय मदें %2$@ में दोहराई गई हैं और दो बार गिनी जा रही हैं। अतिरिक्त को कूड़ेदान से हटाएँ: %2$@ से गिनती बंद होगी, पिछले महीने नहीं बदलेंगे।"
        }
       }
      }
     }
    },
    "it": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Una voce fissa è ripetuta a %2$@ e conta due volte. Rimuovi quella in più con il cestino: smette di contare da %2$@, i mesi precedenti non cambiano."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld voci fisse sono ripetute a %2$@ e contano due volte. Rimuovi quelle in più con il cestino: smettono di contare da %2$@, i mesi precedenti non cambiano."
        }
       }
      }
     }
    },
    "ja": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "固定項目が%2$@で重複し、2回数えられています。余分なものをゴミ箱で削除してください。%2$@から数えなくなり、それ以前の月は変わりません。"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld 件の固定項目が%2$@で重複し、2回数えられています。余分なものをゴミ箱で削除してください。%2$@から数えなくなり、それ以前の月は変わりません。"
        }
       }
      }
     }
    },
    "ko": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "고정 항목 하나가 %2$@에 중복되어 두 번 계산됩니다. 남는 항목을 휴지통으로 삭제하세요. %2$@부터 계산되지 않으며 이전 달은 바뀌지 않습니다."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "고정 항목 %1$ld개가 %2$@에 중복되어 두 번 계산됩니다. 남는 항목을 휴지통으로 삭제하세요. %2$@부터 계산되지 않으며 이전 달은 바뀌지 않습니다."
        }
       }
      }
     }
    },
    "pt": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Um fixo está repetido em %2$@ e conta duas vezes. Remova o que sobra com a lixeira: deixa de contar a partir de %2$@; os meses anteriores não mudam."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "%1$ld fixos estão repetidos em %2$@ e contam duas vezes. Remova os que sobram com a lixeira: deixam de contar a partir de %2$@; os meses anteriores não mudam."
        }
       }
      }
     }
    },
    "ru": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "Постоянный платёж повторяется в %2$@ и считается дважды. Удалите лишний корзиной: он перестанет учитываться с %2$@, прошлые месяцы не изменятся."
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "Постоянные платежи (%1$ld) повторяются в %2$@ и считаются дважды. Удалите лишние корзиной: они перестанут учитываться с %2$@, прошлые месяцы не изменятся."
        }
       }
      }
     }
    },
    "zh-Hans": {
     "variations": {
      "plural": {
       "one": {
        "stringUnit": {
         "state": "translated",
         "value": "有一个固定项在%2$@重复，被计算了两次。用垃圾桶删除多余的：从%2$@起不再计入，之前的月份不变。"
        }
       },
       "other": {
        "stringUnit": {
         "state": "translated",
         "value": "有 %1$ld 个固定项在%2$@重复，被计算了两次。用垃圾桶删除多余的：从%2$@起不再计入，之前的月份不变。"
        }
       }
      }
