  "ng_i_roa_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ربح السنة ÷ كل ما يملكه المشروع. كم ينتج ما وضعته فيه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jahresgewinn ÷ alles, was das Geschäft besitzt. Was dein Einsatz erwirtschaftet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Yearly profit ÷ everything the business owns. How much what you put in produces."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Utilidad del año ÷ todo lo que tiene el negocio. Cuánto produce lo que pusiste en él."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bénéfice annuel ÷ tout ce que possède l'entreprise. Ce que rapporte ce que vous y avez mis."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "साल का लाभ ÷ व्यवसाय की सारी संपत्ति। आपने जो लगाया वह कितना कमाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Utile annuo ÷ tutto ciò che l'attività possiede. Quanto rende ciò che ci hai messo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "年間利益 ÷ ビジネスの全資産。投じたものがどれだけ生むか。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연간 이익 ÷ 사업의 전체 자산. 넣은 것이 얼마나 벌어들이는지."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Lucro do ano ÷ tudo o que o negócio tem. Quanto rende o que você colocou nele."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Годовая прибыль ÷ всё, что есть у бизнеса. Сколько приносит вложенное."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "全年利润 ÷ 生意拥有的全部资产。你投入的东西能产出多少。"
     }
    }
   }
  },
