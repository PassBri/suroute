  "cu_cierre_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بعد هذه الدقائق دون استخدام، أو عند الخروج من التطبيق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nach diesen Minuten ohne Nutzung oder beim Verlassen der App."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "After these minutes without use, or when you leave the app."
     }
    },
    "es": {
