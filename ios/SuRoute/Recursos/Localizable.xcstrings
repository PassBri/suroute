  "balance_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ليس حكمًا عليك: إنه أداة تعلّم لتعديل طريقك والاحتفاء بانتصاراتك واستخلاص الدروس."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das ist kein Urteil, sondern ein Lernwerkzeug, um deine Route anzupassen, Siege zu feiern und Lektionen zu ziehen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It's not a judgment: it's a learning tool to adjust your route, celebrate wins and draw lessons."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No es un juicio: es una herramienta de aprendizaje para ajustar tu ruta, celebrar victorias y extraer lecciones."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce n'est pas un jugement : c'est un outil d'apprentissage pour ajuster ta route, célébrer tes victoires et tirer des leçons."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "यह कोई फ़ैसला सुनाना नहीं है: यह सीखने का साधन है ताकि आप अपना रास्ता सुधारें, जीत का जश्न मनाएँ और सबक़ निकालें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non è un giudizio: è uno strumento di apprendimento per aggiustare il tuo percorso, celebrare le vittorie e trarre insegnamenti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "これは評価ではなく、ルートを調整し、勝利を祝い、教訓を引き出すための学びのツールです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "평가가 아니에요. 길을 조정하고, 승리를 축하하고, 교훈을 얻기 위한 배움의 도구예요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não é um julgamento: é uma ferramenta de aprendizado para ajustar sua rota, celebrar vitórias e tirar lições."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Это не оценка и не приговор, а инструмент обучения: скорректировать маршрут, отпраздновать победы и извлечь уроки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这不是评判，而是帮你调整路线、庆祝胜利、总结教训的学习工具。"
     }
    }
   }
  },
