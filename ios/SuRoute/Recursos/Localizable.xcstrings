  "ng_i_liq_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "النقد وما يُستحق لك والمخزون ÷ ما عليك دفعه قريبًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Kasse, Forderungen und Lager ÷ was du bald zahlen musst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cash, what you're owed and stock ÷ what you must pay soon."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Caja, lo que te deben e inventario ÷ lo que debes pagar pronto."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Trésorerie, créances et stock ÷ ce que vous devez payer bientôt."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "नकद, आपको मिलने वाला और स्टॉक ÷ जल्द चुकाना है वह।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cassa, crediti e magazzino ÷ ciò che devi pagare a breve."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "現金・売掛金・在庫 ÷ 近く支払うもの。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "현금, 받을 돈, 재고 ÷ 곧 갚아야 할 돈."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Caixa, o que te devem e estoque ÷ o que você precisa pagar em breve."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Деньги, дебиторка и запасы ÷ то, что нужно скоро заплатить."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "现金、应收和存货 ÷ 近期要付的钱。"
     }
    }
