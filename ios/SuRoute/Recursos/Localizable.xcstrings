  "ios_libro_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مثل الكتاب في أعلى الجبال: هنا تُوقَّع وصولاتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wie das Buch auf dem Gipfel: Hier werden deine Ankünfte eingetragen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Like the book at the top of a mountain: your arrivals are signed here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Como el libro que hay arriba en las montañas: aquí quedan firmadas tus llegadas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Comme le livre au sommet des montagnes : vos arrivées y sont signées."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "पहाड़ की चोटी पर रखी किताब की तरह: यहाँ आपके पहुँचने पर हस्ताक्षर होते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Come il libro in cima alle montagne: qui restano firmati i tuoi arrivi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "山頂に置かれたノートのように、あなたの到達がここに記されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "산 정상의 방명록처럼, 당신의 도착이 여기에 기록돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Como o livro no alto das montanhas: aqui ficam assinadas suas chegadas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Как книга на вершине горы: здесь отмечены ваши восхождения."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "就像山顶的留名册：你每次登顶都在这里签名。"
     }
    }
   }
  },
  "ios_libro_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عندما تُكمل الخطوات الثماني لمخيم أو هدف الشهر، ستظهر صفحته هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du die 8 Schritte eines Lagers oder ein Monatsziel erfüllst, erscheint hier seine Seite."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "When you complete a camp's 8 steps or a monthly goal, its page will appear here."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando cumplas los 8 pasos de un campamento o una meta del mes, su página aparecerá aquí."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quand vous accomplirez les 8 étapes d'un camp ou un objectif du mois, sa page apparaîtra ici."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जब आप किसी कैंप के 8 कदम या महीने का लक्ष्य पूरा करेंगे, उसका पेज यहाँ दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando completerai gli 8 passi di un campo o un obiettivo del mese, la sua pagina apparirà qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "キャンプの8ステップや月の目標を達成すると、ここにページが現れます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "캠프의 8단계나 이번 달 목표를 이루면 그 페이지가 여기에 나타나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando cumprir os 8 passos de um acampamento ou uma meta do mês, a página aparecerá aqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда выполните 8 шагов лагеря или цель месяца, здесь появится её страница."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "完成一个营地的 8 步或一个月度目标后，它的页面会出现在这里。"
     }
    }
   }
  },
