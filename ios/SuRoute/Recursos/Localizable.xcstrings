  "brujula_ayuda_81": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اضغط على مجموعة لفتح خطواتها. استخدم + أو − أو مسار التنقل لتغيير المستوى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Tippe auf einen Block, um seine Schritte zu öffnen. Wechsle die Ebene mit +, − oder dem Navigationspfad."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tap a block to open its steps. Use +, − or the breadcrumbs to change levels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca un bloque para abrir sus pasos. Usa +, − o las migas para cambiar de nivel."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touchez un bloc pour ouvrir ses étapes. Utilisez +, − ou le fil de navigation pour changer de niveau."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कदम खोलने के लिए खंड पर टैप करें। स्तर बदलने के लिए +, − या नेविगेशन पथ का उपयोग करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca un blocco per aprire i suoi passi. Usa +, − o il percorso di navigazione per cambiare livello."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ブロックをタップしてステップを開きます。+、−、パンくずリストで階層を切り替えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "블록을 눌러 단계를 여세요. +, − 또는 탐색 경로로 보기를 바꿀 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque em um bloco para abrir seus passos. Use +, − ou o caminho de navegação para mudar de nível."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нажмите на блок, чтобы открыть его шаги. Меняйте уровень с помощью +, − или навигационной цепочки."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "点按区块查看步骤。使用+、−或导航路径切换层级。"
     }
    }
   }
  },
  "brujula_caida_registrada": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اعترفت بسقوط %1$@. لا تخسر أيامك: هذه الخطوة تطلب الآن %2$ld لتعود."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast einen Sturz (%1$@) erkannt. Deine Tage bleiben: Dieser Schritt verlangt jetzt %2$ld, damit du zurückkommst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You recognized a %1$@ fall. You keep your work days: this step now asks for %2$ld so you can come back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Reconociste una caída %1$@. No pierdes tus jornadas: este paso ahora pide %2$ld para que vuelvas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu as reconnu une chute %1$@. Tu gardes tes journées : ce pas en demande maintenant %2$ld pour que tu reviennes."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपने %1$@ गिरावट मानी। आपके दिन नहीं जाते: लौटने के लिए यह कदम अब %2$ld माँगता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hai riconosciuto una caduta %1$@. Non perdi le giornate: ora questo passo ne chiede %2$ld per farti tornare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@の転倒を認めました。日数は失いません。戻りやすいよう、このステップは今%2$ld日です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%1$@ 넘어짐을 인정했어요. 실행한 날은 그대로예요. 다시 돌아오도록 이 단계는 이제 %2$ld일만 필요해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você reconheceu uma queda %1$@. Não perde suas jornadas: este passo agora pede %2$ld para você voltar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты признал падение: %1$@. Дни не теряются: теперь шаг требует %2$ld, чтобы ты вернулся."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你承认了一次%1$@跌倒。你的行动日不会丢失：这一步现在只需 %2$ld 天，好让你重新出发。"
     }
    }
   }
  },
