  "cu_informe_todo_bien": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل مؤشراتك ضمن الهدف. استمر وزد استثمارك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Alle Kennzahlen sind im Ziel. Weiter so und investiere mehr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "All your indicators are on target. Keep it up and raise your investing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todos tus indicadores están en su meta. Sigue igual y sube tu inversión."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tous vos indicateurs sont dans l'objectif. Continuez et augmentez vos investissements."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके सभी संकेतक लक्ष्य पर हैं। ऐसे ही चलें और निवेश बढ़ाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tutti gli indicatori sono in obiettivo. Continua così e aumenta gli investimenti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "すべての指標が目標どおりです。この調子で投資を増やしましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모든 지표가 목표에 도달했습니다. 계속 유지하고 투자를 늘리세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Todos os seus indicadores estão na meta. Continue assim e aumente seu investimento."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Все показатели в норме. Продолжайте и увеличьте инвестиции."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的各项指标都已达标。继续保持，并加大投资。"
     }
    }
