     "stringUnit": {
      "state": "translated",
      "value": "हर दिन मौसम और आदतें दर्ज करें, यहाँ कुल दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Segna clima e abitudini ogni giorno e qui vedrai il totale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎日天気と習慣を記録すると、ここに累計が表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "매일 날씨와 습관을 기록하면 여기에서 누적을 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Anote seu clima e seus hábitos todo dia e aqui verá o acumulado."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отмечай погоду и привычки каждый день — здесь появится итог."
