  "cu_bloqueado_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "افتحها بالبصمة أو الوجه أو الرمز. تُغلق مجددًا بعد 5 دقائق أو عند الخروج."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Öffne sie mit Fingerabdruck, Gesicht oder PIN. Nach 5 Minuten oder beim Verlassen sperren sie sich wieder."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open them with your fingerprint, face or PIN. They lock again after 5 minutes or when you leave."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ábrelas con tu huella, rostro o PIN. Se vuelven a cerrar a los 5 minutos o al salir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ouvre-les avec ton empreinte, ton visage ou ton code. Elles se reverrouillent après 5 minutes ou quand tu sors."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "फ़िंगरप्रिंट, चेहरे या पिन से खोलें। 5 मिनट बाद या बाहर जाने पर फिर लॉक हो जाएगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprile con impronta, volto o PIN. Si richiudono dopo 5 minuti o uscendo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "指紋・顔・PIN で開きます。5分後か退出時に再びロックされます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지문·얼굴·PIN으로 여세요. 5분 후나 나갈 때 다시 잠겨요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Abra com digital, rosto ou PIN. Fecham de novo após 5 minutos ou ao sair."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Открой отпечатком, лицом или PIN. Снова закроется через 5 минут или при выходе."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "用指纹、面部或密码打开。5 分钟后或离开时会再次锁定。"
     }
    }
   }
  },
