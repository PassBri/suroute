    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "올해의 달 (색 = 월간 결산 완료). 눌러서 열어 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Meses do ano (cor = balanço mensal feito). Toque em um para abri-lo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Месяцы года (цвет = итоги месяца подведены). Нажми на месяц, чтобы открыть."
