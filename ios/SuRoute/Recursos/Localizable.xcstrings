  "modelo_c6_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عافية كل يوم (الطاقة، النشاط البدني، التنفس) تتراكم في الشهر والعام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Wohlbefinden jedes Tages (Energie, Bewegung, Atmung) summiert sich über Monat und Jahr."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each day's wellbeing (energy, physical activity, breathing) adds up over the month and the year."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El bienestar de cada día (energía, actividad física, respiración) se suma en el mes y en el año."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le bien-être de chaque jour (énergie, activité physique, respiration) s'additionne sur le mois et l'année."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर दिन की सेहत (ऊर्जा, शारीरिक गतिविधि, साँस) महीने और साल में जुड़ती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il benessere di ogni giorno (energia, attività fisica, respirazione) si somma nel mese e nell'anno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎日のウェルビーイング（エネルギー、身体活動、呼吸）が月と年に積み重なります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "매일의 웰빙(에너지, 신체 활동, 호흡)이 월과 연에 쌓입니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O bem-estar de cada dia (energia, atividade física, respiração) se soma no mês e no ano."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Самочувствие каждого дня (энергия, физическая активность, дыхание) складывается за месяц и год."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每天的身心状态（精力、身体活动、呼吸）会累计到月和年。"
     }
    }
   }
  },
  "modelo_c6_t": {
