  "plan_avisado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تم: سنخبرك عندما تتوفر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erledigt: Wir sagen dir Bescheid, wenn es verfügbar ist."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Done: we'll let you know when it's available."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Listo: te avisaremos cuando esté disponible."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "C'est noté : nous te préviendrons quand ce sera disponible."
