  "cierre_5_anios_sub": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تقييم الغايات والتأملات و«من أنا الآن؟»."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Bewertung der Vorsätze, Reflexionen und „Wer bin ich jetzt?“."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Review of purposes, reflections and “Who am I now?”."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Evaluación de propósitos, reflexiones y «¿Quién soy ahora?»."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Évaluation des buts, réflexions et « Qui suis-je maintenant ? »."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "उद्देश्यों का आकलन, चिंतन और “अब मैं कौन हूँ?”।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Valutazione degli scopi, riflessioni e «Chi sono ora?»."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目的の評価、振り返り、そして「今の私は誰?」。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목적 평가, 돌아보기, 그리고 「지금의 나는 누구인가?」"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Avaliação de propósitos, reflexões e “Quem sou eu agora?”."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Оценка целей, размышления и «Кто я теперь?»."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "回顾初心、反思，以及「我现在是谁？」。"
     }
    }
   }
  },
