  "modelo_c7_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صورة لكل خطوة: ما عشته يحلّ تدريجيًا محل ما حلمت به."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Foto pro Schritt: Das Erlebte ersetzt nach und nach das Erträumte."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "One photo per step: what you lived gradually replaces what you dreamed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una foto por paso: lo vivido va reemplazando a lo soñado."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une photo par pas : le vécu remplace peu à peu le rêvé."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर कदम की एक फ़ोटो: जिया हुआ धीरे-धीरे देखे हुए सपने की जगह ले लेता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una foto per passo: il vissuto sostituisce a poco a poco il sognato."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ステップごとに一枚の写真：生きたことが夢見たことに少しずつ置き換わります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "걸음마다 사진 한 장: 살아낸 것이 꿈꾼 것을 조금씩 대신합니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma foto por passo: o vivido vai substituindo o sonhado."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Одно фото на шаг: прожитое постепенно заменяет задуманное."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每个步骤一张照片：亲身经历逐渐取代梦想。"
     }
    }
   }
  },
