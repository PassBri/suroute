  "cascada_sin_anuales": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا أهداف سنوية بعد. اضغط + لإنشاء هدف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Jahresziele. Tippe auf +, um eines anzulegen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No yearly goals yet. Tap + to create one."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sin metas anuales todavía. Toca + para crear una."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore d'objectifs annuels. Touche + pour en créer un."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी कोई सालाना लक्ष्य नहीं है। बनाने के लिए + पर टैप करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun obiettivo annuale. Tocca + per crearne uno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "年間目標はまだありません。+をタップして作成しましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 연간 목표가 없어요. +를 눌러 만들어 보세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda sem metas anuais. Toque em + para criar uma."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Годовых целей пока нет. Нажми +, чтобы создать."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有年度目标。点按 + 创建一个。"
     }
    }
   }
  },
  "cascada_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل يوم يضيف إلى الشهر، وكل شهر إلى العام، وكل عام إلى قمتك طويلة المدى. يُحسب التقدم تلقائيًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeder Tag zählt für den Monat, jeder Monat für das Jahr und jedes Jahr für deinen langfristigen Gipfel. Der Fortschritt wird automatisch berechnet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Each day adds to the month, each month to the year and each year to your long-term summit. Progress is calculated for you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada día suma al mes, cada mes al año y cada año a tu cumbre de largo plazo. El avance se calcula solo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chaque jour compte pour le mois, chaque mois pour l’année et chaque année pour ton sommet à long terme. La progression se calcule seule."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "हर दिन महीने में, हर महीना साल में और हर साल आपके दीर्घकालिक शिखर में जुड़ता है। प्रगति अपने आप गिनी जाती है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ogni giorno conta per il mese, ogni mese per l’anno e ogni anno per la tua vetta a lungo termine. L’avanzamento si calcola da solo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "毎日が月に、毎月が年に、毎年が長期の頂上につながります。進捗は自動で計算されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루하루가 한 달을, 한 달이 한 해를, 한 해가 장기 정상을 채웁니다. 진행률은 자동으로 계산돼요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cada dia soma ao mês, cada mês ao ano e cada ano ao seu cume de longo prazo. O avanço é calculado sozinho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Каждый день складывается в месяц, месяц — в год, год — в долгосрочную вершину. Прогресс считается сам."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每一天累积成月，每月累积成年，每年累积成你的长期巅峰。进度自动计算。"
     }
    }
   }
  },
  "cascada_titulo": {
   "extractionState": "manual",
