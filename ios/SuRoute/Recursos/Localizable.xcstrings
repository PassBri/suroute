    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mein %1$ld auf SuRoute: %2$ld Tage mit Gewohnheiten, %3$ld erledigte Gewohnheiten, beste Serie %4$ld Tage und %5$ld erreichte Ziele."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "My %1$ld on SuRoute: %2$ld days with habits, %3$ld habits completed, a best streak of %4$ld days and %5$ld goals completed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mi %1$ld en SuRoute: %2$ld días con hábitos, %3$ld hábitos cumplidos, mejor racha de %4$ld días y %5$ld metas cumplidas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mon %1$ld sur SuRoute : %2$ld jours avec des habitudes, %3$ld habitudes accomplies, une meilleure série de %4$ld jours et %5$ld objectifs atteints."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute पर मेरा %1$ld: आदतों वाले %2$ld दिन, %3$ld पूरी आदतें, %4$ld दिनों की सबसे लंबी गिनती और %5$ld पूरे लक्ष्य।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il mio %1$ld su SuRoute: %2$ld giorni con abitudini, %3$ld abitudini compiute, serie migliore di %4$ld giorni e %5$ld obiettivi raggiunti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRouteでの%1$ld年：習慣を記録した日%2$ld日、達成した習慣%3$ld、最長ストリーク%4$ld日、達成した目標%5$ld。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "SuRoute에서의 %1$ld년: 습관 기록 %2$ld일, 완료한 습관 %3$ld개, 최장 연속 %4$ld일, 달성한 목표 %5$ld개."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Meu %1$ld na SuRoute: %2$ld dias com hábitos, %3$ld hábitos cumpridos, melhor sequência de %4$ld dias e %5$ld metas cumpridas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Мой %1$ld в SuRoute: %2$ld дней с привычками, %3$ld выполненных привычек, лучшая серия %4$ld дней и %5$ld достигнутых целей."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我在 SuRoute 的 %1$ld：%2$ld 天打卡，完成 %3$ld 个习惯，最长连续 %4$ld 天，达成 %5$ld 个目标。"
     }
    }
   }
  },
