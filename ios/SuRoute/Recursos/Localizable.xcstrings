  "cp_convergente_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تلتقي قمتاكما في غاية أكبر. قوي، لكنه يتطلب تواصلًا كثيرًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Eure Gipfel vereinen sich in einem größeren Ziel. Kraftvoll, aber es braucht viel Kommunikation."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Your summits join in a greater purpose. Powerful, but it takes a lot of communication."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sus cumbres se unen en un propósito mayor. Poderoso, pero pide mucha comunicación."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vos sommets se rejoignent dans un but plus grand. Puissant, mais cela demande beaucoup de communication."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके शिखर एक बड़े उद्देश्य में मिलते हैं। शक्तिशाली, पर बहुत बातचीत माँगता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le vostre vette si uniscono in uno scopo più grande. Potente, ma richiede molta comunicazione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ふたりの頂がより大きな目的でひとつになる。力強いけれど、たくさんの対話が必要。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "두 정상이 더 큰 목적으로 하나가 돼요. 강력하지만 많은 대화가 필요해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seus cumes se unem em um propósito maior. Poderoso, mas pede muita comunicação."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ваши вершины сливаются в большую цель. Мощно, но требует много общения."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你们的顶峰汇聚成更大的使命。很有力量，但需要大量沟通。"
     }
    }
   }
  },
  "cp_crucial": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سؤال حاسم: هل تقرّبني هذه العلاقة من قمتي أم تبعدني عنها؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Entscheidende Frage: Bringt mich diese Beziehung meinem Gipfel näher oder entfernt sie mich davon?"
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Crucial question: does this relationship bring me closer to my summit or take me away from it?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pregunta crucial: ¿esta relación me acerca o me aleja de mi cumbre?"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Question cruciale : cette relation me rapproche-t-elle ou m'éloigne-t-elle de mon sommet ?"
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अहम सवाल: क्या यह रिश्ता मुझे मेरे शिखर के करीब ले जाता है या दूर?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Domanda cruciale: questa relazione mi avvicina o mi allontana dalla mia vetta?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "大切な問い：この関係は自分を頂に近づけている？それとも遠ざけている？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "핵심 질문: 이 관계는 나를 정상에 더 가깝게 하나요, 아니면 멀어지게 하나요?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pergunta crucial: esta relação me aproxima ou me afasta do meu cume?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ключевой вопрос: эти отношения приближают меня к моей вершине или отдаляют от неё?"
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "关键问题：这段关系让我离顶峰更近，还是更远？"
     }
    }
   }
  },
