  "cielo_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "السماء الآن: الشمس على ارتفاع %1$ld°، والقمر مضاء بنسبة %2$ld%%."
     }
    },
    "de": {
