  "recordatorio_frase_sellada": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عبارة يومك بانتظارك مختومة. افتحها بوجهك أو رمز PIN."
