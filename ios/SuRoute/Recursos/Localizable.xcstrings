  "web_borrar_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يُلغى ربط جميع الحواسيب ويُحذف مسارك من السحابة. يبقى كاملًا على هاتفك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Alle Computer werden getrennt und dein Weg wird aus der Cloud gelöscht. Auf deinem Handy bleibt er vollständig."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "All computers are unlinked and your path is deleted from the cloud. It stays complete on your phone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se desvinculan todos los computadores y tu ruta se borra de la nube. En tu teléfono sigue completa."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tous les ordinateurs sont dissociés et ton parcours est supprimé du cloud. Il reste complet sur ton téléphone."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "सभी कंप्यूटरों का लिंक हट जाएगा और आपका मार्ग क्लाउड से हट जाएगा। फ़ोन पर यह पूरा रहेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tutti i computer vengono scollegati e il tuo percorso viene eliminato dal cloud. Sul telefono resta completo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "すべてのパソコンのリンクが解除され、ルートはクラウドから削除されます。スマホにはすべて残ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모든 컴퓨터의 연결이 해제되고 경로가 클라우드에서 삭제돼요. 휴대폰에는 그대로 남아요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Todos os computadores são desvinculados e sua rota é apagada da nuvem. No seu celular ela continua completa."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Все компьютеры будут отвязаны, а путь удалён из облака. На телефоне он останется полностью."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "所有电脑将取消关联，你的路线将从云端删除。手机上的数据完整保留。"
     }
    }
   }
  },
