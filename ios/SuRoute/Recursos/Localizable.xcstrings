    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Couldn't save. Check your connection and try again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No se pudo guardar. Revisa tu conexión e inténtalo de nuevo."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Impossible d'enregistrer. Vérifie ta connexion et réessaie."
