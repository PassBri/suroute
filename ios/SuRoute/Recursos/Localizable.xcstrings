  "fg_llevaron_vacio": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الناس يكتبونه الآن. ستراه في ملخص هذه النار خلال دقائق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Leute schreiben es gerade. Du siehst es in wenigen Minuten in der Zusammenfassung dieses Lagerfeuers."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "People are writing it now. You'll see it in this campfire's summary in a few minutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las personas lo están escribiendo ahora. Lo verás en el resumen de esta fogata en unos minutos."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les personnes l'écrivent maintenant. Vous le verrez dans le résumé de ce feu dans quelques minutes."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लोग अभी लिख रहे हैं। कुछ मिनटों में इस अलाव के सारांश में दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le persone lo stanno scrivendo ora. Lo vedrai nel riepilogo di questo falò tra pochi minuti."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "いまみんなが書いています。数分後にこのたき火のまとめで見られます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "사람들이 지금 쓰고 있어요. 몇 분 뒤 이 모닥불 요약에서 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "As pessoas estão escrevendo agora. Você verá no resumo desta fogueira em alguns minutos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Люди сейчас пишут. Через несколько минут вы увидите это в итогах костра."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "大家正在写。几分钟后你会在这堆篝火的总结里看到。"
     }
    }
   }
  },
