  "estado_no_iniciada_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الهدف لم يبدأ بعد أو ما زال مجرد نيّة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Ziel hat noch nicht begonnen oder besteht nur als Absicht."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The goal hasn't begun yet or is only an intention."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La meta todavía no ha comenzado o solo está en intención."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L'objectif n'a pas encore démarré ou n'est qu'une intention."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "लक्ष्य अभी शुरू नहीं हुआ है या सिर्फ़ इरादे में है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'obiettivo non è ancora partito o è solo un'intenzione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標はまだ始まっていないか、気持ちだけの段階です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목표가 아직 시작되지 않았거나 마음속 의도에 머물러 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "A meta ainda não começou ou existe só como intenção."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Цель ещё не начата или пока остаётся лишь намерением."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目标尚未开始，或只停留在想法阶段。"
     }
    }
   }
  },
