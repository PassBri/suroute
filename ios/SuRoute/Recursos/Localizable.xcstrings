  "web_ninguno": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد حواسيب مرتبطة بعد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine verknüpften Computer."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No linked computers yet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todavía no hay computadores vinculados."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucun ordinateur associé pour l’instant."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी कोई कंप्यूटर लिंक नहीं है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessun computer collegato per ora."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "リンク済みのパソコンはまだありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 연결된 컴퓨터가 없어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há computadores vinculados."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока нет привязанных компьютеров."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有关联的电脑。"
     }
    }
   }
  },
  "web_privacidad": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "طالما أن النسخة الويب مرتبطة، يُحفظ مسارك في حسابك ليراه الحاسوب. تُرفع المنشورات الخاصة أيضًا، لكن لا يراها أحد غيرك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Solange die Web-Version verknüpft ist, wird dein Weg in deinem Konto gespeichert, damit der Computer ihn sieht. Private Beiträge werden auch hochgeladen, aber nur du siehst sie."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "While the web app is linked, your path is saved to your account so the computer can see it. Private posts are uploaded too, but only you can see them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mientras tengas la web vinculada, tu ruta se guarda en tu cuenta para que el computador la vea. Las publicaciones privadas también suben, pero solo tú las ves."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tant que la version web est associée, ton parcours est enregistré dans ton compte pour que l’ordinateur le voie. Les publications privées sont aussi envoyées, mais toi seul les vois."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "जब तक वेब लिंक है, आपका मार्ग आपके खाते में सहेजा जाता है ताकि कंप्यूटर उसे देख सके। निजी पोस्ट भी अपलोड होती हैं, पर उन्हें केवल आप देख सकते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Finché la versione web è collegata, il tuo percorso viene salvato nel tuo account perché il computer lo veda. Anche i post privati vengono caricati, ma li vedi solo tu."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "Web 版をリンクしている間、ルートはパソコンから見られるようアカウントに保存されます。非公開の投稿もアップロードされますが、見られるのはあなただけです。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "웹이 연결되어 있는 동안 경로가 계정에 저장되어 컴퓨터에서 볼 수 있어요. 비공개 게시물도 올라가지만 나만 볼 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Enquanto a web estiver vinculada, sua rota fica salva na sua conta para o computador vê-la. As publicações privadas também sobem, mas só você as vê."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока веб-версия привязана, твой путь хранится в аккаунте, чтобы компьютер его видел. Личные публикации тоже загружаются, но видишь их только ты."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "关联网页版期间，你的路线会保存在账户中，以便电脑查看。私密动态也会上传，但只有你能看到。"
     }
    }
   }
  },
  "web_sin_cuenta": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لربط حاسوب، سجّل الدخول إلى حسابك في SuRoute."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Um einen Computer zu verknüpfen, melde dich bei deinem SuRoute-Konto an."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "To link a computer, sign in to your SuRoute account."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para vincular un computador, inicia sesión en tu cuenta de SuRoute."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pour associer un ordinateur, connecte-toi à ton compte SuRoute."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कंप्यूटर लिंक करने के लिए अपने SuRoute खाते में साइन इन करें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Per collegare un computer, accedi al tuo account SuRoute."
     }
    },
    "ja": {
