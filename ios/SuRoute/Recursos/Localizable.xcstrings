  "bi_g_0_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اسأل نفسك ثلاث مرات يوميًا: بماذا أشعر وأين في جسدي؟ سمِّه بدقة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Frag dich dreimal am Tag: Was fühle ich und wo im Körper? Benenne es genau."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Three times a day ask: what do I feel and where in my body? Name it exactly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tres veces al día pregúntate: ¿qué siento y dónde lo siento en el cuerpo? Ponle nombre exacto."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Trois fois par jour demande-toi : que ressens-je et où dans mon corps ? Nomme-le exactement."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "दिन में तीन बार पूछें: मैं क्या महसूस कर रहा हूँ और शरीर में कहाँ? सटीक नाम दें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tre volte al giorno chiediti: cosa sento e dove lo sento nel corpo? Dagli il nome esatto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1日3回、問いかけましょう。何を感じている？体のどこで？正確に名前をつけて。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "하루 세 번 물어보세요: 무엇을 느끼고 몸 어디에서 느끼나요? 정확히 이름 붙이세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Três vezes ao dia pergunte: o que sinto e onde sinto no corpo? Dê o nome exato."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Трижды в день спроси себя: что я чувствую и где это в теле? Назови точно."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "每天问自己三次：我感受到什么？在身体哪里感受到？准确说出它的名字。"
     }
    }
   }
  },
