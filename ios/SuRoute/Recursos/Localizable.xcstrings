  "web_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "التطبيق نفسه على حاسوبك وبالحساب نفسه: ما تفعله في أحدهما يظهر في الآخر."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieselbe App auf deinem Computer, mit demselben Konto: Was du auf einem Gerät machst, erscheint auf dem anderen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The same app on your computer, with the same account: whatever you do on one shows up on the other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La misma app en tu computador, con tu misma cuenta: lo que hagas en un lado aparece en el otro."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La même app sur ton ordinateur, avec le même compte : ce que tu fais d’un côté apparaît de l’autre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपके कंप्यूटर पर वही ऐप, उसी खाते के साथ: एक जगह जो करेंगे, वह दूसरी जगह भी दिखेगा।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La stessa app sul tuo computer, con lo stesso account: quello che fai da una parte appare anche dall’altra."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "パソコンでも同じアプリを同じアカウントで。片方でしたことはもう片方にも表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "컴퓨터에서도 같은 계정으로 같은 앱을 쓰세요. 한쪽에서 한 일이 다른 쪽에도 나타나요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O mesmo app no seu computador, com a mesma conta: o que você fizer em um aparece no outro."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "То же приложение на компьютере, с тем же аккаунтом: что делаешь в одном месте, появляется в другом."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "电脑上的同一个应用，使用同一个账户：你在一边做的事，另一边也会出现。"
     }
    }
   }
  },
