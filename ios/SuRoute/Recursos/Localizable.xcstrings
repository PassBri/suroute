  "cv_llevado": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أخذته معك: صار في حقيبتك وأرسلت إليه ضوءك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Mitgenommen: im Rucksack, und du hast dein Licht gegeben."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It's yours: saved in your backpack and you gave it your light."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Te lo llevas: quedó en tu mochila y le diste tu luz."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
