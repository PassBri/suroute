  "kit_intro": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "هذه الأدوات تنفع عندما تستخدمها، لا عندما تحتفظ بها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Diese Werkzeuge wirken, wenn du sie benutzt, nicht wenn du sie aufbewahrst."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "These tools work when you use them, not when you save them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estas herramientas funcionan cuando las usas, no cuando las guardas."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ces outils fonctionnent quand tu les utilises, pas quand tu les ranges."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "ये टूल तब काम करते हैं जब आप इन्हें इस्तेमाल करते हैं, जब आप इन्हें सहेजकर रखते हैं तब नहीं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questi strumenti funzionano quando li usi, non quando li conservi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "このツールは、しまっておくのではなく、使ってこそ効果があります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 도구들은 간직할 때가 아니라 사용할 때 효과가 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Estas ferramentas funcionam quando você as usa, não quando as guarda."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Эти инструменты работают, когда ты ими пользуешься, а не когда они лежат без дела."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "这些工具要用起来才有效，收着不用是没有用的。"
     }
    }
   }
  },
