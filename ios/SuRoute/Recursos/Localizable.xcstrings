  "brujula_cam_af": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا أصعد وحدي: مرشدي وفريقي وشبكتي يسندونني."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ich steige nicht allein: Mentor, Seilschaft und Netzwerk tragen mich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "I don't climb alone: my mentor, my rope team and my network hold me up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No subo solo: mi mentor, mi cordada y mi red me sostienen."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Je ne grimpe pas seul : mon mentor, ma cordée et mon réseau me soutiennent."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "मैं अकेला नहीं चढ़ता: मेरे मेंटर, मेरी टोली और मेरा नेटवर्क मुझे थामते हैं।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non salgo da solo: il mio mentore, la mia cordata e la mia rete mi sostengono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "一人では登らない。メンター、ザイルパーティ、仲間が支えてくれる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "혼자 오르지 않아요. 멘토, 자일 파티, 네트워크가 나를 받쳐 줘요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Não subo sozinho: meu mentor, minha cordada e minha rede me sustentam."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Я не иду один: меня держат наставник, связка и моя сеть."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "我不独自攀登：导师、绳队和人脉支撑着我。"
     }
    }
   }
  },
  "brujula_cam_foto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صورة مع مرشدك أو مجموعتك أو من يصعدون معك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Foto mit deinem Mentor, deiner Gruppe oder den Menschen, die mit dir steigen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A photo with your mentor, your group or the people who climb with you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una foto con tu mentor, tu grupo o las personas que te acompañan a subir."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une photo avec ton mentor, ton groupe ou les personnes qui montent avec toi."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अपने मेंटर, समूह या साथ चढ़ने वालों के साथ एक तस्वीर।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una foto con il tuo mentore, il tuo gruppo o chi sale con te."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "メンターや仲間、一緒に登る人たちとの写真。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "멘토, 그룹, 함께 오르는 사람들과의 사진."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma foto com seu mentor, seu grupo ou as pessoas que sobem com você."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Фото с наставником, группой или теми, кто поднимается с тобой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "一张和导师、团队或与你同行者的合照。"
     }
    }
   }
  },
