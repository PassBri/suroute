  "cu_bola_d": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كرة الثلج: أصغر دين أولًا. انتصارات سريعة تبقيك على الطريق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Schneeball: zuerst die kleinste Schuld. Schnelle Erfolge, die dich dranbleiben lassen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Snowball: smallest debt first. Quick wins that keep you going."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bola de nieve: primero la deuda más pequeña. Victorias rápidas que te mantienen en el camino."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Boule de neige : d’abord la plus petite dette. Des victoires rapides pour tenir le cap."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "स्नोबॉल: सबसे छोटा कर्ज़ पहले। जल्दी जीतें जो आपको आगे बढ़ाएँ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Palla di neve: prima il debito più piccolo. Vittorie rapide che ti tengono sul sentiero."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "雪だるま法：小さい借金から。早い成功で続けられます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "눈덩이: 가장 작은 빚부터. 빠른 성취로 계속 나아가요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Bola de neve: primeiro a menor dívida. Vitórias rápidas que mantêm você no caminho."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Снежный ком: сначала самый маленький долг. Быстрые победы помогают не сдаваться."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "雪球法：先还最小的债。快速的胜利让你坚持下去。"
     }
    }
   }
  },
