  "cuenta_eliminar_texto": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيُحذف نهائيًا ملفك ومنشوراتك وتعليقاتك ورسائلك ومسارك في السحابة والحواسيب المرتبطة. ما هو محفوظ في هذا الهاتف يبقى. اكتب %1$@ للتأكيد."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Profil, Beiträge, Kommentare, Nachrichten, deine Route in der Cloud und verknüpfte Computer werden endgültig gelöscht. Was auf diesem Telefon gespeichert ist, bleibt hier. Gib %1$@ ein, um zu bestätigen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This permanently deletes your profile, posts, comments, messages, your cloud route and linked computers. What’s saved on this phone stays here. Type %1$@ to confirm."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se borran para siempre tu perfil, tus publicaciones, comentarios, mensajes, tu ruta en la nube y los computadores vinculados. Lo que está guardado en este teléfono se queda aquí. Escribe %1$@ para confirmar."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ton profil, tes publications, commentaires, messages, ta route dans le cloud et les ordinateurs liés seront supprimés définitivement. Ce qui est sur ce téléphone y reste. Écris %1$@ pour confirmer."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "आपकी प्रोफ़ाइल, पोस्ट, टिप्पणियाँ, संदेश, क्लाउड में आपका मार्ग और जुड़े कंप्यूटर हमेशा के लिए हट जाएँगे। इस फ़ोन में सहेजा गया यहीं रहेगा। पुष्टि के लिए %1$@ लिखें।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Profilo, post, commenti, messaggi, la tua rotta nel cloud e i computer collegati verranno eliminati per sempre. Ciò che è su questo telefono resta qui. Scrivi %1$@ per confermare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "プロフィール、投稿、コメント、メッセージ、クラウドのルート、連携したパソコンが完全に削除されます。この端末に保存されたものは残ります。確認のため %1$@ と入力してください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "프로필, 게시물, 댓글, 메시지, 클라우드의 경로와 연결된 컴퓨터가 영구 삭제됩니다. 이 휴대폰에 저장된 내용은 남아요. 확인하려면 %1$@ 를 입력하세요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Seu perfil, publicações, comentários, mensagens, sua rota na nuvem e computadores vinculados serão apagados para sempre. O que está neste telefone continua aqui. Digite %1$@ para confirmar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Профиль, публикации, комментарии, сообщения, маршрут в облаке и привязанные компьютеры будут удалены навсегда. Сохранённое на этом телефоне останется. Введите %1$@ для подтверждения."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "你的个人资料、帖子、评论、消息、云端路线和已关联的电脑将被永久删除。本手机上保存的内容会保留。输入 %1$@ 以确认。"
     }
    }
   }
  },
