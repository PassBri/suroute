  "orse_ayuda": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الهدف الجيد هو ORSE: ملحوظ، وثيق الصلة، محدّد، ومدعوم بدليل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein gutes Ziel ist ORSE: Observierbar, Relevant, Spezifisch und mit Evidenz."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A good goal is ORSE: Observable, Relevant, Specific and backed by Evidence."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Una buena meta es ORSE: Observable, Relevante, Específica y con Evidencia."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un bon objectif est ORSE : Observable, Réaliste, Spécifique et Évaluable."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अच्छा लक्ष्य ORSE होता है: दिखने योग्य, प्रासंगिक, स्पष्ट और प्रमाण के साथ।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un buon obiettivo è ORSE: Osservabile, Rilevante, Specifico ed Evidente."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "よい目標はORSE: 観察できる(Observable)、意味がある(Relevante)、具体的(Específica)、証拠がある(Evidencia)。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "좋은 목표는 ORSE예요: 관찰 가능하고, 적절하고, 구체적이며, 증거가 있어야 해요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma boa meta é ORSE: Observável, Relevante, Específica e com Evidência."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Хорошая цель — ORSE: наблюдаемая, актуальная, конкретная и с подтверждением."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "好目标要符合 ORSE：可观察、相关、具体、有证据。"
     }
    }
   }
  },
