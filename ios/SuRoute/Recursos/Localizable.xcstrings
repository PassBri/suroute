  "fg_no_puede": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حاليًا يُشعل نيران المخيّم المدرّبون الموثَّقون. قريبًا جدًا ستتمكن من إشعال نارك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Vorerst entzünden verifizierte Coaches Lagerfeuer. Bald kannst du deins entzünden."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "For now, verified coaches light campfires. Very soon you'll be able to light yours."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Por ahora encienden fogatas los coaches verificados. Muy pronto podrás encender la tuya."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pour l'instant, les coachs vérifiés allument les feux de camp. Bientôt, vous pourrez allumer le vôtre."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "अभी सत्यापित कोच ही अलाव जलाते हैं। बहुत जल्द आप भी अपना जला सकेंगे।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Per ora accendono i falò i coach verificati. Molto presto potrai accendere il tuo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "いまは認証済みのコーチがたき火をともします。もうすぐあなたもともせるようになります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지금은 인증된 코치가 모닥불을 피웁니다. 곧 당신도 모닥불을 피울 수 있어요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Por enquanto, coaches verificados acendem fogueiras. Em breve você poderá acender a sua."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока костры разжигают проверенные коучи. Совсем скоро вы сможете разжечь свой."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "目前由已认证的教练点燃篝火。很快你也能点燃自己的篝火。"
     }
    }
   }
  },
