  "prioridad_a_desc": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عاجل ومهم. إجراء فوري. أثر مباشر على أهدافك الرئيسية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dringend und wichtig. Sofort handeln. Direkter Einfluss auf deine Hauptziele."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgent and important. Act immediately. Direct impact on your main goals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgente e importante. Acción inmediata. Impacto directo en tus objetivos principales."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgent et important. Action immédiate. Impact direct sur tes objectifs principaux."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "तुरंत और ज़रूरी। फ़ौरन कार्रवाई करें। आपके मुख्य उद्देश्यों पर सीधा असर।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgente e importante. Azione immediata. Impatto diretto sui tuoi obiettivi principali."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "緊急かつ重要。すぐに行動を。主な目標に直接影響します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "긴급하고 중요해요. 즉시 행동하세요. 핵심 목표에 직접 영향을 줘요."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Urgente e importante. Ação imediata. Impacto direto nos seus objetivos principais."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Срочно и важно. Действуй немедленно. Прямое влияние на твои главные цели."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "紧急且重要。立即行动。直接影响你的主要目标。"
     }
    }
   }
  },
