  "coach_rep_explica": {
   "extractionState": "manual",
   "localizations": {
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يراجعه شخص من فريق الإشراف لتحسين ضوابط المدرّب. يُرسل هذا الرد ورسالتك السابقة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Eine Person aus der Moderation prüft sie, um die Schutzmechanismen des Coachs zu verbessern. Diese Antwort und Ihre vorherige Nachricht werden gesendet."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A moderator reviews it to improve the coach's safeguards. This response and your previous message are sent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La revisa una persona de moderación para mejorar los controles del coach. Se envían esta respuesta y tu mensaje anterior."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une personne de la modération l’examine pour améliorer les garde-fous du coach. Cette réponse et votre message précédent sont envoyés."
     }
    },
    "hi": {
     "stringUnit": {
      "state": "translated",
      "value": "कोच की सुरक्षा व्यवस्था सुधारने के लिए मॉडरेशन टीम इसे देखती है। यह जवाब और आपका पिछला संदेश भेजा जाता है।"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una persona della moderazione la esamina per migliorare i controlli del coach. Vengono inviati questa risposta e il tuo messaggio precedente."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コーチの安全対策を改善するため、モデレーターが確認します。この回答と直前のあなたのメッセージが送信されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "코치의 안전 장치를 개선하기 위해 운영자가 검토합니다. 이 답변과 이전 메시지가 전송됩니다."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Uma pessoa da moderação a revisa para melhorar os controles do coach. São enviadas esta resposta e sua mensagem anterior."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Модератор проверит его, чтобы улучшить защитные механизмы коуча. Отправляются этот ответ и ваше предыдущее сообщение."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "审核人员会查看它，以改进教练的安全控制。将发送此回复和你上一条消息。"
     }
    }
   }
  },
  "coach_rep_gracias": {
